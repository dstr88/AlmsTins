---
import Layout from '../layouts/Layout.astro';
import { getAuthSession } from '../lib/authSession';

const session = await getAuthSession(Astro.request);
const displayName = session?.user?.name ? String(session.user.name).trim() : '';
const firstName = displayName ? displayName.split(/\s+/)[0] : '';
const currentPath = Astro.url.pathname;
---

<Layout>
	<section class="transition">
		<header>
			<h1>{firstName ? `Welcome back, ${firstName}.` : 'Choose your view'}</h1>
			<p>Jump into crypto vaults or traditional finance insights.</p>
			<div class="options">
				<a class={`option-link ${currentPath === '/transition' ? 'active' : ''}`} href="/transition">Option 1</a>
				<a class={`option-link ${currentPath === '/transition1' ? 'active' : ''}`} href="/transition1">Option 2</a>
				<a class={`option-link ${currentPath === '/transition2' ? 'active' : ''}`} href="/transition2">Option 3</a>
				<a class={`option-link ${currentPath === '/transition3' ? 'active' : ''}`} href="/transition3">Option 4</a>
				<a class={`option-link ${currentPath === '/transition4' ? 'active' : ''}`} href="/transition4">Option 5</a>
			</div>
		</header>

		<div class="grid">
			<a class="card crypto" href="/dashboard/vault">
				<span class="eyebrow">Crypto</span>
				<strong>Vault</strong>
				<p>Onchain positions, DeFi health, and wallets.</p>
			</a>
			<a class="card tradfi" href="/dashboard/tradfi">
				<span class="eyebrow">TradFi</span>
				<strong>Traditional Finance</strong>
				<p>Banking, loans, and offchain holdings.</p>
			</a>
		</div>
	</section>
</Layout>

<style>
	.transition {
		max-width: 900px;
		margin: 3rem auto;
		padding: 0 1.5rem;
	}

	.transition header {
		margin-bottom: 2rem;
	}

	.transition h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 3vw, 2.6rem);
		letter-spacing: -0.02em;
	}

	.transition p {
		margin: 0;
		color: rgba(255, 255, 255, 0.7);
	}

	.options {
		display: flex;
		gap: 0.75rem;
		margin-top: 1rem;
		flex-wrap: wrap;
	}

	.option-link {
		text-decoration: none;
		color: rgba(255, 255, 255, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.2);
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		font-size: 0.85rem;
		transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
	}

	.option-link:hover {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.4);
		background: rgba(255, 255, 255, 0.08);
	}

	.option-link.active {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.45);
		background: rgba(255, 255, 255, 0.16);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.8rem;
		border-radius: 18px;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(8, 12, 22, 0.85);
		box-shadow: 0 24px 50px rgba(0, 0, 0, 0.3);
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 28px 60px rgba(0, 0, 0, 0.4);
	}

	.card strong {
		font-size: 1.25rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.6);
	}

	.crypto {
		background: linear-gradient(135deg, rgba(25, 146, 130, 0.3), rgba(12, 18, 32, 0.9));
	}

	.tradfi {
		background: linear-gradient(135deg, rgba(235, 197, 102, 0.28), rgba(12, 18, 32, 0.9));
	}
	@media (max-width: 720px) {
		.transition {
			margin: 2.5rem auto;
		}
	}
</style>
