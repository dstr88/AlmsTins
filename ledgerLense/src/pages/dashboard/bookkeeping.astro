---
import Layout from '../../layouts/Layout.astro';
import NetWorthHero from '../../components/dashboard/NetWorthHero.astro';
import SalmonTin from '@/components/dashboard/SalmonTin.astro';
import Tin0AllTransactions from '../../components/dashboard/Tin0AllTransactions.astro';
import Tin2Wallet from '../../components/dashboard/Tin2Wallet.astro';
import OnchainWalletTransactions from '../../components/dashboard/OnchainWalletTransactions.astro';
import AaveHealthSummary from '../../components/dashboard/AaveHealthSummary';
import WalletSummary from '../../components/dashboard/WalletSummary';
---

<Layout title="Bookkeeping">
	<section class="bookkeeping-page">
		<div class="hero-bleed">
			<NetWorthHero title="Bookkeeping" subtitle="TradFi + DeFi vault overview" />
		</div>

		<section class="tins-grid">
			<Tin0AllTransactions walletId="fa58b" />
			<OnchainWalletTransactions walletId="fa58b" title="fa58b — All Transactions" />
			<div class="placeholder-card">Placeholder</div>
			<div class="stacked-tins">
				<SalmonTin label="FA58B DeFi">
					<div class="tin-health-body">
						<AaveHealthSummary client:load walletId="fa58b" />
					</div>
					<div class="tin-wallet-coins">
						<WalletSummary client:load walletId="fa58b" />
					</div>
				</SalmonTin>
				<Tin2Wallet />
				<SalmonTin label="Tin 3"></SalmonTin>
				<SalmonTin label="Tin 4"></SalmonTin>
			</div>
			<div class="placeholder-card">Empty slot</div>
		</section>

		<section class="bookkeeping-table">
			<h2>Table placeholder</h2>
			<div class="placeholder-area">Transactions table coming soon</div>
		</section>
	</section>

	<style>
		.bookkeeping-page {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			padding: 1rem 0 2rem;
		}

		.tins-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 24px;
			align-items: stretch;
		}

		@media (min-width: 720px) {
			.tins-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (min-width: 1080px) {
			.tins-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}
		}

		.stacked-tins {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.tin-health {
			margin: 0;
			font-size: 1.1rem;
			text-align: center;
		}

		.tin-health-body {
			margin-top: 0.5rem;
			text-align: left;
		}

		.tin-wallet-coins {
			margin-top: 0.6rem;
			font-size: var(--font-sm);
			text-align: left;
		}

		:global(.tin-health-body .stat-row.health) {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 0.25rem;
			margin-bottom: 0.75rem;
		}

		:global(.tin-health-body .stat-row.health .label),
		:global(.tin-health-body .stat-row.health .value) {
			justify-self: center;
			text-align: center;
		}

		:global(.tin-health-body .stat-row) {
			display: grid;
			grid-template-columns: 1fr auto;
			column-gap: var(--space-md);
			align-items: baseline;
		}

		:global(.tin-health-body .stat-row .label) {
			text-align: left;
		}

		:global(.tin-health-body .stat-row .value) {
			text-align: right;
			padding-right: 5rem;
		}

		:global(.tin-health-body .stat-row.debt .value) {
			color: #f59e0b;
		}

		:global(.tin-health-body .breakdown) {
			display: flex;
			flex-direction: column;
			gap: var(--space-xs);
			margin-top: var(--space-xs);
		}

		:global(.tin-health-body .breakdown-row) {
			display: grid;
			grid-template-columns: 1fr 9.5rem auto;
			column-gap: 2.5rem;
			align-items: baseline;
		}

		:global(.tin-health-body .breakdown-row.breakdown-header .col-qty) {
			display: block;
			text-align: center;
		}

		:global(.tin-health-body .breakdown-row:not(.breakdown-header) .col-qty) {
			display: inline-flex;
			justify-content: flex-end;
			font-variant-numeric: tabular-nums;
		}

		:global(.tin-health-body .breakdown-row:not(.breakdown-header) .col-qty .qty) {
			display: grid;
			grid-template-columns: var(--qty-int-width, 1ch) auto var(--qty-frac-width, 4ch);
			justify-content: end;
			font-variant-numeric: tabular-nums;
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
		}

		:global(.tin-health-body .breakdown-row:not(.breakdown-header) .col-qty .qty-whole) {
			text-align: right;
		}

		:global(.tin-health-body .breakdown-row:not(.breakdown-header) .col-qty .qty-dot) {
			padding-inline: 0.1ch;
		}

		:global(.tin-health-body .breakdown-row:not(.breakdown-header) .col-qty .qty-decimal) {
			text-align: left;
			opacity: 0.85;
		}

		:global(.tin-health-body .breakdown-row .col-usd) {
			text-align: right;
			padding-right: 5rem;
		}

		.bookkeeping-table {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}

		.placeholder-card,
		.placeholder-area {
			min-height: 120px;
			border: 1px dashed rgba(255, 255, 255, 0.4);
			border-radius: 12px;
			padding: 1rem;
			color: #f7f2eb;
			background: rgba(47, 65, 59, 0.6);
		}

		h2 {
			margin: 0;
			font-size: 1.1rem;
			font-weight: 600;
		}

	</style>
</Layout>
