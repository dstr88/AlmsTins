---
import Layout from '../../layouts/Layout.astro';

type TaxRow = {
	category: string | null;
	tokenSymbol: string | null;
	txType: string | null;
	value: string | number | null;
	timestamp: string;
};

type TaxPayload = {
	ok: boolean;
	year?: number;
	group?: string;
	rows: TaxRow[];
	error?: string;
};

const year = new Date().getFullYear();
const response = await fetch(new URL(`/api/tax/summary?year=${year}&group=personal`, Astro.request.url));
const payload: TaxPayload = response.ok ? await response.json() : { ok: false, rows: [] };
---

<Layout>
	<h1 class="text-2xl font-bold mb-4">Tax Summary</h1>

	{!payload.ok ? (
		<p>Unable to load tax summary for {year}.</p>
	) : (
		<>
			<p class="text-sm text-gray-600 mb-4">Year: {payload.year}</p>
			<table class="min-w-full text-sm border">
				<thead>
					<tr class="text-left border-b bg-slate-100">
						<th class="px-3 py-2">Date</th>
						<th class="px-3 py-2">Token</th>
						<th class="px-3 py-2">Value</th>
						<th class="px-3 py-2">Type</th>
						<th class="px-3 py-2">Category</th>
					</tr>
				</thead>
				<tbody>
					{payload.rows.map((row: TaxRow) => (
						<tr class="border-b">
							<td class="px-3 py-2">{new Date(row.timestamp).toLocaleDateString()}</td>
							<td class="px-3 py-2">{row.tokenSymbol ?? 'native'}</td>
							<td class="px-3 py-2 font-mono">{row.value}</td>
							<td class="px-3 py-2 uppercase text-xs">{row.txType ?? '—'}</td>
							<td class="px-3 py-2 uppercase text-xs tracking-wide">{row.category ?? '—'}</td>
						</tr>
					))}
				</tbody>
			</table>
		</>
	)}
</Layout>
