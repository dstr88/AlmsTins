---
import { getAuthSession } from '../lib/authSession';
import { getPostLoginRedirect } from '../lib/postLoginRedirect';

const { searchParams } = Astro.url;
const error = searchParams.get('error');
const next = searchParams.get('next');
const callbackParam = searchParams.get('callbackUrl');
const nextPath = typeof next === 'string' ? next : typeof callbackParam === 'string' ? callbackParam : null;
const callbackUrl = getPostLoginRedirect(nextPath);
const message =
	error === 'missing'
		? 'Sign in to continue.'
		: error
			? 'Sign-in failed. Please try again.'
			: '';
const signup = searchParams.get('signup');
const verified = searchParams.get('verified');
const notice =
	signup === 'success'
		? 'Account created. Check your inbox to verify your email.'
		: verified === 'success'
			? 'Email verified. You can sign in now.'
			: verified === 'expired'
				? 'Verification link expired. Please sign in to request a new one.'
				: verified === 'failed'
					? 'Verification failed. Please try again.'
					: '';

const session = await getAuthSession(Astro.request);
if (session) {
	return Astro.redirect(callbackUrl, 303);
}

const googleUrl = `/api/auth/signin/google?callbackUrl=${encodeURIComponent(callbackUrl)}`;
const githubUrl = `/api/auth/signin/github?callbackUrl=${encodeURIComponent(callbackUrl)}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Dashboard Sign-in</title>
		<style>
			:root {
				color-scheme: dark;
				font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
				background: radial-gradient(circle at top, #131628, #05060c 65%);
				min-height: 100vh;
				color: #f5f8ff;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			main {
				width: min(400px, calc(100% - 2rem));
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 20px;
				padding: 2rem;
				box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
			}

			h1 {
				margin-top: 0;
				margin-bottom: 0.5rem;
				font-size: 1.35rem;
				font-weight: 600;
			}

			p {
				margin-top: 0;
				margin-bottom: 1.5rem;
				color: rgba(255, 255, 255, 0.75);
				font-size: 0.95rem;
			}

			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.providers {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				margin-bottom: 1.25rem;
			}

			.provider-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				text-decoration: none;
				border-radius: 12px;
				padding: 0.85rem 1rem;
				border: 1px solid rgba(255, 255, 255, 0.15);
				background: rgba(255, 255, 255, 0.08);
				color: #fff;
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
			}

			.provider-button:hover {
				opacity: 0.92;
				transform: translateY(-1px);
				border-color: rgba(255, 255, 255, 0.35);
			}

			.provider-button.google {
				background: linear-gradient(135deg, #3b82f6, #2563eb);
				border: none;
			}

			.provider-button.github {
				background: linear-gradient(135deg, #0f172a, #1f2937);
				border: none;
			}

			.divider {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin: 1.25rem 0;
				color: rgba(255, 255, 255, 0.55);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}

			.divider::before,
			.divider::after {
				content: '';
				flex: 1;
				height: 1px;
				background: rgba(255, 255, 255, 0.12);
			}

			label {
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
				color: rgba(255, 255, 255, 0.85);
				font-weight: 500;
			}

			input {
				border-radius: 12px;
				border: 1px solid rgba(255, 255, 255, 0.18);
				background: rgba(255, 255, 255, 0.08);
				backdrop-filter: blur(4px);
				color: #fff;
				padding: 0.75rem 1rem;
				font-size: 1rem;
			}

			input:focus {
				outline: 2px solid rgba(84, 144, 255, 0.9);
				outline-offset: 1px;
			}

			button {
				border-radius: 12px;
				padding: 0.85rem 1rem;
				border: none;
				background: linear-gradient(135deg, #5767ff, #934dff);
				color: #fff;
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.2s ease;
			}

			button:hover {
				opacity: 0.92;
			}

			.notice {
				background: rgba(255, 107, 107, 0.12);
				border: 1px solid rgba(255, 107, 107, 0.35);
				color: #ffb5b5;
				padding: 0.75rem 1rem;
				border-radius: 12px;
				font-size: 0.9rem;
			}

			.notice.success {
				background: rgba(60, 179, 113, 0.12);
				border: 1px solid rgba(60, 179, 113, 0.35);
				color: #b6f3c4;
			}

			.helper {
				margin: 0.5rem 0 1.5rem;
				font-size: 0.9rem;
				color: rgba(255, 255, 255, 0.7);
			}

			.helper a {
				color: #c7d2ff;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Sign in</h1>
			<p>Use Google, GitHub, or a magic link to access the dashboard.</p>

			{message && <p class="notice">{message}</p>}
			{notice && <p class="notice success">{notice}</p>}

			<div class="providers">
				<a class="provider-button google" href={googleUrl}>Continue with Google</a>
				<a class="provider-button github" href={githubUrl}>Continue with GitHub</a>
			</div>

			<div class="divider">or password</div>

			<form method="POST" action="/api/auth/callback/credentials">
				<input type="hidden" name="callbackUrl" value={callbackUrl} />
				<label>
					<span>Email address</span>
					<input type="email" name="email" placeholder="you@company.com" required />
				</label>
				<label>
					<span>Password</span>
					<input type="password" name="password" minlength="10" required />
				</label>
				<button type="submit">Sign in with password</button>
			</form>

			<p class="helper">
				No account yet? <a href="/signup">Create one</a>
			</p>

			<div class="divider">or magic link</div>

			<form method="POST" action="/api/auth/signin/email">
				<input type="hidden" name="callbackUrl" value={callbackUrl} />
				<label>
					<span>Email address</span>
					<input type="email" name="email" placeholder="you@company.com" required autofocus />
				</label>
				<button type="submit">Send magic link</button>
			</form>
		</main>
	</body>
</html>
