---
import { getAuthSession } from '../lib/authSession';

const { searchParams } = Astro.url;
const error = searchParams.get('error');
const message =
	error === 'email'
		? 'Enter a valid email address.'
		: error === 'first_name'
			? 'First name is required.'
			: error === 'password'
				? 'Password must be at least 10 characters.'
				: error === 'exists'
					? 'An account already exists for that email.'
					: '';

const session = await getAuthSession(Astro.request);
if (session) {
	return Astro.redirect('/transition', 303);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Create your account</title>
		<style>
			:root {
				color-scheme: dark;
				font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
				background: radial-gradient(circle at top, #141630, #070910 65%);
				min-height: 100vh;
				color: #f5f8ff;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			main {
				width: min(460px, calc(100% - 2rem));
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 20px;
				padding: 2rem;
				box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
			}

			h1 {
				margin-top: 0;
				margin-bottom: 0.5rem;
				font-size: 1.45rem;
				font-weight: 600;
			}

			p {
				margin-top: 0;
				margin-bottom: 1.5rem;
				color: rgba(255, 255, 255, 0.75);
				font-size: 0.95rem;
			}

			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
				gap: 0.75rem;
			}

			label {
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
				color: rgba(255, 255, 255, 0.85);
				font-weight: 500;
			}

			input {
				border-radius: 12px;
				border: 1px solid rgba(255, 255, 255, 0.18);
				background: rgba(255, 255, 255, 0.08);
				backdrop-filter: blur(4px);
				color: #fff;
				padding: 0.75rem 1rem;
				font-size: 1rem;
			}

			input:focus {
				outline: 2px solid rgba(84, 144, 255, 0.9);
				outline-offset: 1px;
			}

			button {
				border-radius: 12px;
				padding: 0.85rem 1rem;
				border: none;
				background: linear-gradient(135deg, #5767ff, #934dff);
				color: #fff;
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.2s ease;
			}

			button:hover {
				opacity: 0.92;
			}

			.notice {
				background: rgba(255, 107, 107, 0.12);
				border: 1px solid rgba(255, 107, 107, 0.35);
				color: #ffb5b5;
				padding: 0.75rem 1rem;
				border-radius: 12px;
				font-size: 0.9rem;
			}

			.helper {
				margin: 0.5rem 0 0;
				font-size: 0.9rem;
				color: rgba(255, 255, 255, 0.7);
			}

			.helper a {
				color: #c7d2ff;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Create your account</h1>
			<p>We use your name and email to personalize your dashboard.</p>

			{message && <p class="notice">{message}</p>}

			<form method="POST" action="/api/signup">
				<div class="grid">
					<label>
						<span>First name</span>
						<input type="text" name="first_name" placeholder="Ada" required />
					</label>
					<label>
						<span>Last name</span>
						<input type="text" name="last_name" placeholder="Lovelace" />
					</label>
				</div>
				<label>
					<span>Email address</span>
					<input type="email" name="email" placeholder="you@company.com" required />
				</label>
				<label>
					<span>Password</span>
					<input type="password" name="password" minlength="10" required />
				</label>
				<button type="submit">Create account</button>
			</form>

			<p class="helper">
				Already have an account? <a href="/login">Sign in</a>
			</p>
		</main>
	</body>
</html>
