---
import Layout from '../layouts/Layout.astro';
import { getAuthSession } from '../lib/authSession';
import Minerva from '../assets/Minerva.jpeg';
import KingSolomon from '../assets/KingSolomon.jpeg';

const session = await getAuthSession(Astro.request);
const displayName = session?.user?.name ? String(session.user.name).trim() : '';
const firstName = displayName ? displayName.split(/\s+/)[0] : '';
---

<Layout>
	<section class="transition">
		<header>
			<h1>{firstName ? `Welcome back, ${firstName}.` : 'Choose your view'}</h1>
			<p>Jump into crypto vaults or traditional finance insights.</p>
		</header>

		<div class="columns">
			<div class="column">
				<div class="portrait-wrap">
					<img class="portrait tilt-left" src={Minerva.src} alt="Minerva" loading="lazy" />
				</div>
				<a class="card tradfi slide-left" href="/dashboard/tradfi">
					<span class="eyebrow">TradFi</span>
					<strong>Traditional Finance</strong>
					<p>Banking, loans, and offchain holdings.</p>
				</a>
			</div>
			<div class="column">
				<div class="portrait-wrap">
					<img class="portrait" src={KingSolomon.src} alt="King Solomon" loading="lazy" />
				</div>
				<a class="card crypto slide-right" href="/dashboard/vault">
					<span class="eyebrow">Crypto</span>
					<strong>Vault</strong>
					<p>Onchain positions, DeFi health, and wallets.</p>
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.transition {
		max-width: 900px;
		margin: 3rem auto;
		padding: 0 1.5rem;
	}

	.transition header {
		margin-bottom: 2rem;
	}

	.transition h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 3vw, 2.6rem);
		letter-spacing: -0.02em;
	}

	.transition p {
		margin: 0;
		color: rgba(255, 255, 255, 0.7);
	}

	.columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		align-items: start;
	}

	.column {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.portrait-wrap {
		padding: 1.2rem;
		border-radius: 20px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(8, 12, 22, 0.9);
		box-shadow: 0 30px 70px rgba(0, 0, 0, 0.35);
	}

	.portrait {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 16px;
	}

	.tilt-left {
		transform: rotate(-2.5deg);
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.8rem;
		border-radius: 18px;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(8, 12, 22, 0.85);
		box-shadow: 0 24px 50px rgba(0, 0, 0, 0.3);
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	@media (prefers-reduced-motion: no-preference) {
		.card {
			opacity: 0;
			animation: card-slide-in 0.55s ease forwards;
		}

		.slide-left {
			animation-delay: 0.15s;
		}

		.slide-right {
			animation-delay: 0.35s;
		}
	}

	@keyframes card-slide-in {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 28px 60px rgba(0, 0, 0, 0.4);
	}

	.card strong {
		font-size: 1.25rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.6);
	}

	.crypto {
		background: linear-gradient(135deg, rgba(25, 146, 130, 0.3), rgba(12, 18, 32, 0.9));
	}

	.tradfi {
		background: linear-gradient(135deg, rgba(235, 197, 102, 0.28), rgba(12, 18, 32, 0.9));
	}
	@media (max-width: 720px) {
		.transition {
			margin: 2.5rem auto;
		}

		.columns {
			grid-template-columns: 1fr;
		}
	}
</style>
