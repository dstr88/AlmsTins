---
import Layout from '../layouts/Layout.astro';
import { getSession } from '@auth/astro';

const session = await getSession(Astro.request);
const displayName = session?.user?.name ? String(session.user.name).trim() : '';
const firstName = displayName ? displayName.split(/\s+/)[0] : '';
---

<Layout>
	<section class="transition">
		<header>
			<h1>{firstName ? `Welcome back, ${firstName}.` : 'Choose your view'}</h1>
			<p>Jump into crypto vaults or traditional finance insights.</p>
		</header>

		<div class="grid">
			<a class="card crypto" href="/dashboard/vault">
				<span class="eyebrow">Crypto</span>
				<strong>Vault</strong>
				<p>Onchain positions, DeFi health, and wallets.</p>
			</a>
			<a class="card tradfi" href="/dashboard/tradfi">
				<span class="eyebrow">TradFi</span>
				<strong>Traditional Finance</strong>
				<p>Banking, loans, and offchain holdings.</p>
			</a>
		</div>
	</section>
</Layout>

<style>
	.transition {
		max-width: 900px;
		margin: 3rem auto;
		padding: 0 1.5rem;
	}

	.transition header {
		margin-bottom: 2rem;
	}

	.transition h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 3vw, 2.6rem);
		letter-spacing: -0.02em;
	}

	.transition p {
		margin: 0;
		color: rgba(255, 255, 255, 0.7);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.8rem;
		border-radius: 18px;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(8, 12, 22, 0.85);
		box-shadow: 0 24px 50px rgba(0, 0, 0, 0.3);
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 28px 60px rgba(0, 0, 0, 0.4);
	}

	.card strong {
		font-size: 1.25rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.6);
	}

	.crypto {
		background: linear-gradient(135deg, rgba(25, 146, 130, 0.3), rgba(12, 18, 32, 0.9));
	}

	.tradfi {
		background: linear-gradient(135deg, rgba(235, 197, 102, 0.28), rgba(12, 18, 32, 0.9));
	}
	@media (max-width: 720px) {
		.transition {
			margin: 2.5rem auto;
		}
	}
</style>
