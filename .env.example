# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Set to "true" to bypass auth locally (never use in production)
AUTH_DISABLED="false"

# Email magic link (SMTP)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Titanium Hut <no-reply@titaniumhut.com>"

# OAuth providers
GOOGLE_ID="your-google-client-id"
GOOGLE_SECRET="your-google-client-secret"

GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Public URL for Auth.js
AUTH_URL="https://your-domain.com"

# Google Analytics 4 Data API (admin dashboard traffic stats) — optional, admin
# dashboard shows "unavailable" for GA sections if unset. Service account needs
# Viewer access on the GA4 property (Admin > Property access management).
GA4_PROPERTY_ID="123456789"
# PEM private key from the service account's downloaded JSON key file, as a single
# line with literal \n sequences (copy only the "private_key" field's value, not
# the whole JSON file or its surrounding quotes). Starts with the standard PEM
# private-key header line, ends with the matching footer line.
GA4_PRIVATE_KEY="change-me"
# Optional — only needed if different from the default service account baked into ga4.ts
GA4_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
