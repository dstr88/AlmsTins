---
/*
 * prices.astro — public pricing page (renders at /prices).
 *
 * Built to match what the app ACTUALLY enforces, so nothing here over-promises:
 *  - Wallet plans (src/lib/subscriptions.ts PLANS): Free 3 · Starter 8 · Pro 20 · Unlimited ∞.
 *    Live Stripe prices: $7/$70 · $19/$200 · $39/$400 (monthly/yearly) — already wired.
 *  - Premium features (AI Triage, receipt validation, price backfill) gate BINARY free-vs-paid
 *    in the API routes, so they unlock at the first paid tier (Starter). Year-Summary PDF is the
 *    Unlimited differentiator. We do NOT claim per-tier feature gating the code doesn't do.
 *  - Verify is FREE / early access. Monitoring is best-effort and rolling out — no paid store
 *    tiers, no "hourly / 24-7 camera" claims. 3 monitored destinations; UNLIMITED placements
 *    (you watch the address behind the QR, not each printed sticker). More → "Let's talk".
 *  - Exchanges = sales-led / negotiated, no self-serve Stripe.
 *
 * English-only draft — i18n (EN/ES/FR) is a follow-up. CTAs: free → signup; paid → in-app billing.
 */
const SIGNUP = '/';
const BILLING = '/dashboard/billing';
const VERIFY = '/verify';
const CONTACT = 'mailto:hello@almstins.com?subject=Almstins%20—%20more%20Verify%20destinations';
const EXCHANGE = 'mailto:hello@almstins.com?subject=Verify%20for%20Exchanges';
---

<header class="prices-top">
  <a class="prices-top__brand" href="/">Almstins</a>
  <nav class="prices-top__nav">
    <a href="/login">Log in</a>
    <a class="prices-top__cta" href="/signup">Sign up free</a>
  </nav>
</header>

<section class="pricing">
  <header class="pricing__intro">
    <h1>Start free. Pay only for more capacity.</h1>
    <p>The safety tools cost nothing — and always will. You only pay when you need to track or watch more.</p>
  </header>

  <!-- ─── FREE — FOR EVERYONE ───────────────────────────── -->
  <h2 class="pricing__group">Free — for everyone</h2>
  <div class="pricing__grid">
    <article class="card">
      <h3 class="card__name">Wallet &amp; Site Checker</h3>
      <p class="card__price">$0 <span class="card__unit">· no login</span></p>
      <p class="card__desc">Paste any wallet address or website and check it for scams, honeypots, phishing, and sanctions — before you send a thing.</p>
      <a class="card__cta" href="/wallet-checker">Check an address →</a>
    </article>

    <article class="card">
      <h3 class="card__name">Wallet tracking</h3>
      <p class="card__price">$0 <span class="card__unit">· up to 3 wallets</span></p>
      <p class="card__desc">Everything you own across wallets, exchanges, and DeFi — with cost basis, realized gains, and a full tax breakdown. Read-only, no wallet connection.</p>
      <a class="card__cta" href={SIGNUP}>Start free →</a>
    </article>

    <article class="card">
      <h3 class="card__name">Verify for store owners</h3>
      <p class="card__price">$0 <span class="card__unit">· early access</span></p>
      <p class="card__desc">Register the addresses and payment QR you publish and verify them before you trust them — so a swapped address never reaches your customers.</p>
      <a class="card__cta" href={VERIFY}>Get early access →</a>
    </article>
  </div>

  <!-- ─── WALLET PLANS (paid) ───────────────────────────── -->
  <h2 class="pricing__group">Track more — wallet plans</h2>
  <p class="pricing__sub">Every plan includes the full bookkeeping &amp; tax breakdown, all exchange imports, and auto-classify. Paid plans add the done-for-you automation.</p>
  <div class="pricing__grid">
    <article class="card">
      <h3 class="card__name">Starter</h3>
      <p class="card__price">$7<span class="card__unit">/mo</span></p>
      <p class="card__yearly">or $70/year</p>
      <ul class="card__list">
        <li>Up to <strong>8 wallets</strong></li>
        <li>AI Triage, receipt validation &amp; price backfill</li>
        <li>Email support</li>
      </ul>
      <a class="card__cta" href={BILLING}>Choose Starter →</a>
    </article>

    <article class="card card--featured">
      <p class="card__badge">Recommended</p>
      <h3 class="card__name">Pro</h3>
      <p class="card__price">$19<span class="card__unit">/mo</span></p>
      <p class="card__yearly">or $200/year</p>
      <ul class="card__list">
        <li>Up to <strong>20 wallets</strong></li>
        <li>Everything in Starter</li>
        <li>Priority support &amp; early access</li>
      </ul>
      <a class="card__cta card__cta--solid" href={BILLING}>Choose Pro →</a>
    </article>

    <article class="card">
      <h3 class="card__name">Unlimited</h3>
      <p class="card__price">$39<span class="card__unit">/mo</span></p>
      <p class="card__yearly">or $400/year</p>
      <ul class="card__list">
        <li><strong>Unlimited</strong> wallets</li>
        <li>Everything in Pro</li>
        <li>Year-Summary tax PDF + white-glove onboarding</li>
      </ul>
      <a class="card__cta" href={BILLING}>Choose Unlimited →</a>
    </article>
  </div>

  <!-- ─── VERIFY — early access ─────────────────────────── -->
  <h2 class="pricing__group">Verify — protect your payment destinations <span class="pricing__tag">early access</span></h2>
  <p class="pricing__sub pricing__sub--lead">
    Post your QR on every table and every register — print a hundred. Verify checks the
    <em>address behind it</em>, not the paper. Scan or paste any sign and we'll tell you instantly
    whether it still matches what you registered — with automatic swap alerts rolling out.
  </p>
  <div class="pricing__grid">
    <article class="card">
      <h3 class="card__name">Store · Free</h3>
      <p class="card__price">$0 <span class="card__unit">· early access</span></p>
      <ul class="card__list">
        <li>Up to <strong>3 destinations</strong> — e.g. your Stripe link, ETH, and BTC</li>
        <li><strong>Unlimited placements</strong> — same QR on as many tables as you like</li>
        <li>Best-effort checks + email alerts</li>
      </ul>
      <a class="card__cta" href={VERIFY}>Get early access →</a>
    </article>

    <article class="card">
      <h3 class="card__name">Need to watch more?</h3>
      <p class="card__price">Let's talk</p>
      <p class="card__desc">Running several distinct wallets or payment links — a multi-currency or multi-location operation? Tell us what you publish and we'll sort out a plan that fits.</p>
      <a class="card__cta" href={CONTACT}>Get in touch →</a>
    </article>

    <article class="card card--enterprise">
      <h3 class="card__name">Exchanges</h3>
      <p class="card__price">Let's talk</p>
      <p class="card__desc">Connect your API so your users can verify your <em>official</em> deposit addresses before they send — your defense against deposit-address phishing. Annual license + setup.</p>
      <a class="card__cta" href={EXCHANGE}>Book a call →</a>
    </article>
  </div>

  <p class="pricing__foot">Read-only. No wallet connection, ever. We never hold your keys or move your funds.</p>
</section>

<style>
  .prices-top { max-width: 1080px; margin: 0 auto; padding: 1.25rem 1rem .25rem; display: flex; align-items: center; justify-content: space-between; }
  .prices-top__brand { font-weight: 700; font-size: 1.1rem; color: var(--text-primary); text-decoration: none; }
  .prices-top__nav { display: flex; align-items: center; gap: 1.1rem; }
  .prices-top__nav a { font-size: .9rem; color: var(--text-secondary); text-decoration: none; }
  .prices-top__nav a:hover { color: var(--text-primary); }
  .prices-top__cta { background: var(--accent); color: var(--surface-bg) !important; padding: .45rem .9rem; border-radius: 8px; font-weight: 600; }
  .pricing { color: var(--text-primary); max-width: 1080px; margin: 0 auto; padding: 2rem 1rem; }
  .pricing__intro { text-align: center; margin-bottom: 2rem; }
  .pricing__intro h1 { font-size: 1.9rem; margin: 0 0 .5rem; }
  .pricing__intro p { color: var(--text-secondary); max-width: 48ch; margin: 0 auto; }
  .pricing__group { font-size: 1.05rem; font-weight: 600; color: var(--text-secondary); margin: 2.25rem 0 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: .5rem; }
  .pricing__sub { color: var(--text-secondary); font-size: .9rem; line-height: 1.55; margin: -.4rem 0 1rem; max-width: 70ch; }
  .pricing__sub--lead { color: var(--text-primary); font-size: .95rem; }
  .pricing__sub em, .pricing__tag, .pricing__grid .card em { color: var(--accent); font-style: normal; }
  .pricing__tag { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; background: var(--accent-soft); padding: 2px 8px; border-radius: 20px; vertical-align: middle; }
  .pricing__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .card { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 14px; padding: 1.25rem; display: flex; flex-direction: column; }
  .card--featured { border: 1px solid var(--accent); }
  .card--enterprise { background: var(--surface-card-2); }
  .card__badge { color: var(--accent); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 .4rem; }
  .card__name { font-size: 1.05rem; margin: 0 0 .4rem; }
  .card__price { font-size: 1.7rem; font-weight: 600; margin: 0; color: var(--text-primary); }
  .card__unit { font-size: .9rem; font-weight: 400; color: var(--text-muted); }
  .card__yearly { font-size: .82rem; color: var(--accent-dim); margin: .2rem 0 0; }
  .card__desc { font-size: .9rem; line-height: 1.55; color: var(--text-secondary); margin: .75rem 0 1.1rem; flex: 1; }
  .card__list { list-style: none; padding: 0; margin: .85rem 0 1.1rem; flex: 1; display: flex; flex-direction: column; gap: .5rem; }
  .card__list li { font-size: .88rem; line-height: 1.45; color: var(--text-secondary); padding-left: 1.1rem; position: relative; }
  .card__list li::before { content: '✓'; color: var(--accent); position: absolute; left: 0; font-weight: 700; }
  .card__list strong { color: var(--text-primary); font-weight: 600; }
  .card__cta { margin-top: auto; font-size: .9rem; color: var(--accent); text-decoration: none; font-weight: 500; }
  .card__cta--solid { background: var(--accent); color: var(--surface-bg); text-align: center; padding: .6rem; border-radius: 8px; }
  .pricing__foot { text-align: center; color: var(--text-muted); font-size: .85rem; margin-top: 2rem; }
</style>
