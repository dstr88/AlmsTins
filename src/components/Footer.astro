---
import DonnieSelfie from "../assets/DonnieSelfie.jpeg";
import TitaniumHut from "../assets/TitaniumHut.png";
import Faq from "./faq.astro";
import Welcome from "./Welcome.astro";
import PrivacyPolicy from "./privacy-policy.astro";
import TermsOfService from "./terms-of-service.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <section class="footer-col footer-license">
      <div class="license-media">
        <img
          src={DonnieSelfie.src}
          alt="Donnie selfie"
          class="license-photo"
          width={120}
          height={120}
          loading="lazy"
        />
        <div class="license-copy">
          <h3>MIT License</h3>
          <p>Open-source under the MIT License.</p>
          <p>© {year} Titanium Hut</p>
        </div>
      </div>
      <a
        href="https://www.titaniumhut.com"
        target="_blank"
        rel="noreferrer"
        class="license-logo-link"
        aria-label="Titanium Hut"
      >
        <img
          src={TitaniumHut.src}
          alt="Titanium Hut"
          class="license-logo"
          width="140"
          height="40"
          loading="lazy"
        />
      </a>
    </section>

    <section class="footer-col footer-faq">
      <Faq />
      <div class="footer-legal">
        <button class="footer-legal-link" type="button" data-footer-modal="privacy-modal">
          privacy-policy
        </button>
        <button class="footer-legal-link" type="button" data-footer-modal="terms-modal">
          terms of service
        </button>
      </div>
    </section>

    <section class="footer-col footer-welcome">
      <Welcome compact />
    </section>
  </div>

  <div class="footer-modal" id="privacy-modal" aria-hidden="true">
    <div class="footer-modal-content" role="dialog" aria-modal="true" aria-label="Privacy Policy">
      <button class="footer-modal-close" type="button" data-footer-close="privacy-modal">×</button>
      <PrivacyPolicy variant="modal" />
    </div>
  </div>

  <div class="footer-modal" id="terms-modal" aria-hidden="true">
    <div class="footer-modal-content" role="dialog" aria-modal="true" aria-label="Terms of Service">
      <button class="footer-modal-close" type="button" data-footer-close="terms-modal">×</button>
      <TermsOfService variant="modal" />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #2f4f4f;
    color: #f7f2eb;
    padding: 3rem clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    align-items: start;
    width: calc(100% - 2rem);
    margin: 0 1rem;
  }

  .footer-col {
    min-width: 0;
  }

  .footer-license {
    display: flex;
    flex-direction: column;
    padding-bottom: 3rem;
  }

  .license-media {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .license-photo {
    width: 96px;
    height: 96px;
    border-radius: 16px;
    object-fit: cover;
    border: 3px solid salmon;
  }

  .license-copy h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    color: #f7f2eb;
  }

  .license-copy p {
    margin: 0.2rem 0;
    color: rgba(247, 242, 235, 0.85);
  }

  .license-logo {
    display: block;
    margin-top: 0;
    max-width: 140px;
    height: auto;
  }

  .license-logo-link {
    display: inline-block;
    margin-top: 14rem;
  }

  .license-logo-link:hover .license-logo {
    filter: brightness(1.1);
  }

  .footer-legal {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: rgba(247, 242, 235, 0.7);
  }

  .footer-legal-link {
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    color: rgba(247, 242, 235, 0.8);
    cursor: pointer;
    font: inherit;
  }

  .footer-legal-link:hover {
    color: salmon;
  }

  .footer-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 2rem;
  }

  .footer-modal.is-open {
    display: flex;
  }

  .footer-modal-content {
    background: #0a0f1a;
    color: #f7f2eb;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 1.5rem 1.5rem 1rem;
    max-width: 720px;
    width: 100%;
    max-height: 80vh;
    overflow: auto;
    position: relative;
  }

  .footer-modal-close {
    position: absolute;
    top: 10px;
    right: 12px;
    background: none;
    border: none;
    color: rgba(247, 242, 235, 0.8);
    font-size: 1.5rem;
    cursor: pointer;
  }

  @media (max-width: 1000px) {
    .footer-grid {
      grid-template-columns: 1fr;
      width: calc(100% - 2rem);
      margin: 0 1rem;
    }

    .license-media {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-footer-modal]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("data-footer-modal");
      if (!id) return;
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
      }
    });
  });

  document.querySelectorAll("[data-footer-close]").forEach((closeButton) => {
    closeButton.addEventListener("click", () => {
      const id = closeButton.getAttribute("data-footer-close");
      if (!id) return;
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
      }
    });
  });
</script>
