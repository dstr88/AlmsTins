---
import DonnieSelfie from "../assets/DonnieSelfie.jpeg";
import TitaniumHut from "../assets/TitaniumHut.png";
import Faq from "./faq.astro";
import Welcome from "./Welcome.astro";
import PrivacyPolicy from "./privacy-policy.astro";
import TermsOfService from "./terms-of-service.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <section class="footer-col footer-license">
      <div class="license-media">
        <img
          src={DonnieSelfie.src}
          alt="Donnie selfie"
          class="license-photo"
          width={120}
          height={120}
          loading="lazy"
        />
        <div class="license-copy">
          <h3>MIT License</h3>
          <p>Open-source under the MIT License.</p>
          <p>© {year} Titanium Hut</p>
          <a
            href="https://www.titaniumhut.com"
            target="_blank"
            rel="noreferrer"
            class="license-logo-link"
            aria-label="Titanium Hut"
          >
            <img
              src={TitaniumHut.src}
              alt="Titanium Hut"
              class="license-logo"
              width="140"
              height="40"
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </section>

    <section class="footer-col footer-faq">
      <Faq />
      <PrivacyPolicy />
      <TermsOfService />
    </section>

    <section class="footer-col footer-welcome">
      <Welcome compact />
    </section>
  </div>
</footer>

<style>
  .site-footer {
    background: #2f4f4f;
    color: #f7f2eb;
    padding: 3rem clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    align-items: start;
    width: calc(100% - 2rem);
    margin: 0 1rem;
  }

  .footer-col {
    min-width: 0;
  }

  .license-media {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .license-photo {
    width: 96px;
    height: 96px;
    border-radius: 16px;
    object-fit: cover;
    border: 3px solid salmon;
  }

  .license-copy h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    color: #f7f2eb;
  }

  .license-copy p {
    margin: 0.2rem 0;
    color: rgba(247, 242, 235, 0.85);
  }

  .license-logo {
    display: block;
    margin-top: 1rem;
    max-width: 140px;
    height: auto;
  }

  .license-logo-link {
    display: inline-block;
  }

  .license-logo-link:hover .license-logo {
    filter: brightness(1.1);
  }

  @media (max-width: 1000px) {
    .footer-grid {
      grid-template-columns: 1fr;
      width: calc(100% - 2rem);
      margin: 0 1rem;
    }

    .license-media {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
