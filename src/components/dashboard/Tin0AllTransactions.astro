---
import { db } from '@/lib/db';
import { requireTenantSession } from '@/lib/requireTenantSession';
import walletIn from '@/assets/walletIn.webp';
import walletOut from '@/assets/walletOut.webp';
import yearDivide2023 from '@/assets/2023yearlyDivide.webp';
import yearDivide2024 from '@/assets/2024yearlyDivide.webp';
import yearDivide2025 from '@/assets/2025yearlyDivide.webp';
import yearDivideEarlier from '@/assets/EarlieryearlyDivide.webp';

const lostIcon = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;

const { walletId } = Astro.props as { walletId?: string };
const { tenantId } = await requireTenantSession(Astro.request);

const sourcesArgs: any[] = [tenantId, tenantId];
const sourcesWalletClause = walletId ? 'AND wallet_id = ?' : '';
if (walletId) sourcesArgs.push(walletId);

const sourcesResult = await db.execute({
	sql: `SELECT DISTINCT source FROM import_transactions WHERE tenant_id = ?
		UNION
		SELECT DISTINCT 'onchain_' || chain AS source
		FROM transactions
		WHERE tenant_id = ? ${sourcesWalletClause}
		ORDER BY source`,
	args: sourcesArgs,
});

const sources = sourcesResult.rows
	.map((row) => String(row.source))
	.filter(Boolean);

type UnifiedRow = {
	id: string;
	source: string;
	import_batch_id: string | null;
	timestamp_utc: string;
	description: string | null;
	currency: string | null;
	amount: number | null;
	to_currency: string | null;
	to_amount: number | null;
	native_currency: string | null;
	native_amount: number | null;
	native_usd: number | null;
	kind: string | null;
	tx_hash: string | null;
	direction: string | null;
	asset_symbol: string | null;
	notes: string | null;
	category: string | null;
	group_id: string | null;
	fee_usd: number | null;
	fee_native: number | null;
	fee_currency: string | null;
	fee_paid: string | null;
	onchain_value: string | null;
	onchain_decimals: number | null;
	onchain_chain: string | null;
};

const rowsArgs: any[] = [tenantId, tenantId];
const rowsWalletClause = walletId ? 'AND t.wallet_id = ?' : '';
if (walletId) rowsArgs.push(walletId);

const result = await db.execute({
	sql: `SELECT id, source, import_batch_id, timestamp_utc, description, currency, amount, to_currency, to_amount,
		native_currency, native_amount, native_usd, kind, tx_hash, direction, asset_symbol, notes, category, group_id,
		fee_usd, fee_native, fee_currency, NULL AS fee_paid,
		NULL AS onchain_value, NULL AS onchain_decimals, NULL AS onchain_chain
		FROM import_transactions
		WHERE tenant_id = ?
		UNION ALL
		SELECT
			t.id,
			'onchain_' || t.chain AS source,
			NULL AS import_batch_id,
			t.timestamp AS timestamp_utc,
			t.tx_type AS description,
			CASE
				WHEN t.token_symbol = 'native' AND t.chain = 'ethereum' THEN 'ETH'
				WHEN t.token_symbol = 'native' AND t.chain = 'polygon' THEN 'POL'
				WHEN t.token_symbol = 'native' AND t.chain = 'avalanche' THEN 'AVAX'
				ELSE t.token_symbol
			END AS currency,
			NULL AS amount,
			NULL AS to_currency,
			NULL AS to_amount,
			NULL AS native_currency,
			NULL AS native_amount,
			NULL AS native_usd,
			t.tx_type AS kind,
			t.hash AS tx_hash,
			CASE
				WHEN t.tx_type IN ('incoming', 'token_in') THEN 'in'
				WHEN t.tx_type IN ('outgoing', 'token_out') THEN 'out'
				ELSE NULL
			END AS direction,
			CASE
				WHEN t.token_symbol = 'native' AND t.chain = 'ethereum' THEN 'ETH'
				WHEN t.token_symbol = 'native' AND t.chain = 'polygon' THEN 'POL'
				WHEN t.token_symbol = 'native' AND t.chain = 'avalanche' THEN 'AVAX'
				ELSE t.token_symbol
			END AS asset_symbol,
			a.note AS notes,
			a.category AS category,
			NULL AS group_id,
			NULL AS fee_usd,
			NULL AS fee_native,
			CASE
				WHEN t.chain = 'ethereum' THEN 'ETH'
				WHEN t.chain = 'polygon' THEN 'POL'
				WHEN t.chain = 'avalanche' THEN 'AVAX'
				ELSE NULL
			END AS fee_currency,
			t.fee_paid AS fee_paid,
			t.value AS onchain_value,
			t.token_decimals AS onchain_decimals,
			t.chain AS onchain_chain
		FROM transactions t
		LEFT JOIN transaction_annotations a ON a.transaction_id = t.id AND a.tenant_id = t.tenant_id
		WHERE t.tenant_id = ? ${rowsWalletClause}
		ORDER BY timestamp_utc DESC`,
	args: rowsArgs,
});

const rows = result.rows as UnifiedRow[];

const yearDividerAssets: Record<number, string> = {
	2023: yearDivide2023.src,
	2024: yearDivide2024.src,
	2025: yearDivide2025.src,
};

const dividerForYear = (year: number) => yearDividerAssets[year] ?? yearDivideEarlier.src;

const parseNumber = (value: number | string | null | undefined) => {
	if (value === null || value === undefined) return null;
	if (typeof value === 'number') return Number.isFinite(value) ? value : null;
	const cleaned = value.replace(/,/g, '');
	const num = Number(cleaned);
	return Number.isFinite(num) ? num : null;
};

const formatAmount = (
	value: number | string | null | undefined,
	options?: Intl.NumberFormatOptions
) => {
	const num = parseNumber(value);
	if (num === null) return '—';
	return new Intl.NumberFormat('en-US', options).format(num);
};

const formatDate = (value: string) => {
	if (!value) return '';
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return value;
	return date.toLocaleString('en-US', { month: 'short', day: 'numeric' });
};

const formatTokenAmount = (value: string | null, decimals = 18) => {
	if (!value) return '0';
	const safeDecimals = Number.isFinite(decimals) ? decimals : 18;
	const padded = value.padStart(safeDecimals + 1, '0');
	const whole = padded.slice(0, -safeDecimals);
	const fraction = padded.slice(-safeDecimals).replace(/0+$/, '');
	const formattedWhole = Number(whole).toLocaleString();
	return fraction ? `${formattedWhole}.${fraction}` : formattedWhole;
};

const normalizeDisplaySymbol = (symbol: string) => {
	const upper = symbol.toUpperCase();
	if (upper === 'MATIC' || upper === 'WMATIC') return 'POL';
	return upper;
};

const pickSymbol = (row: UnifiedRow) => {
	const raw = row.asset_symbol || row.to_currency || row.currency || '';
	return raw ? normalizeDisplaySymbol(raw) : '';
};

const resolvePriceSymbol = (symbol: string) => {
	const upper = symbol.toUpperCase();
	if (upper === 'APOLWETH') return 'WETH';
	if (upper === 'APOLWMATIC') return 'POL';
	if (upper === 'APOLUSDC') return 'USDC';
	if (upper === 'APOLUSDT') return 'USDT';
	if (upper === 'APOLDAI') return 'DAI';
	if (upper === 'MATIC' || upper === 'WMATIC') return 'POL';
	return upper;
};

const isOnchainRow = (row: UnifiedRow) => row.source.startsWith('onchain_');

const resolveChain = (row: UnifiedRow) => row.onchain_chain || (row.source.startsWith('onchain_') ? row.source.replace('onchain_', '') : '');

const pickTokenAmount = (row: UnifiedRow) => {
	const symbol = pickSymbol(row);
	if (symbol && row.to_currency && symbol === row.to_currency) return row.to_amount;
	if (symbol && row.currency && symbol === row.currency) return row.amount;
	return row.to_amount ?? row.amount;
};

const pickUsdAmount = (row: UnifiedRow) => row.native_usd ?? row.native_amount;

const normalizeDirection = (row: UnifiedRow) => row.direction ?? null;

const latestRowId = rows[0]?.id ?? null;

const isUnwrapRow = (row: UnifiedRow) => {
	const text = `${row.kind ?? ''} ${row.description ?? ''}`.toLowerCase();
	return text.includes('unwrap');
};

const resolveFee = (row: UnifiedRow) => {
	if (row.fee_usd !== null && row.fee_usd !== undefined) {
		return `$${formatAmount(row.fee_usd, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
	}
	if (row.fee_native !== null && row.fee_native !== undefined) {
		const symbol = row.fee_currency || pickSymbol(row) || '';
		return `${formatAmount(row.fee_native, { maximumFractionDigits: 8 })}${symbol ? ` ${symbol}` : ''}`;
	}
	if (row.fee_paid) {
		const symbol = row.fee_currency || '';
		return `${formatTokenAmount(row.fee_paid)}${symbol ? ` ${symbol}` : ''}`;
	}
	return null;
};

const aaveLabel = (row: UnifiedRow) => {
	if (row.source !== 'aave') return null;
	const symbol = pickSymbol(row) || 'assets';
	return `Deposited ${symbol} into Aave (collateral — non-taxable)`;
};

const rowsWithDividers = rows.map((row) => ({ type: 'row' as const, row }));
---

<article class="tin0-all">
	<header class="tin0-all__header">
		<h3 class="tin0-all__title">All Transactions</h3>
		<label class="tin0-all__filter">
			<span>Source</span>
			<select class="tin0-all__select" aria-label="Filter by source">
				<option value="all">All sources</option>
				{sources.map((source) => (
					<option value={source}>{source}</option>
				))}
			</select>
		</label>
	</header>

	<div class="tin0-all__list" data-filter="all">
		{rowsWithDividers.map((item) => (
			<div
				class="tx-card"
				data-type="row"
				data-source={item.row.source}
				data-year={new Date(item.row.timestamp_utc).getUTCFullYear()}
				data-hash={item.row.tx_hash ?? ''}
				data-chain={resolveChain(item.row)}
				data-timestamp={item.row.timestamp_utc}
				data-symbol={pickSymbol(item.row)}
				data-direction={normalizeDirection(item.row) ?? ''}
				data-onchain={isOnchainRow(item.row) ? 'true' : 'false'}
				data-raw={item.row.onchain_value ?? ''}
				data-decimals={item.row.onchain_decimals ?? ''}
				data-import-amount={item.row.amount ?? ''}
				data-import-usd={item.row.native_usd ?? ''}
			>
					<span class="tx-date">{formatDate(item.row.timestamp_utc)}</span>
					<span class="tx-symbol">{pickSymbol(item.row) || '—'}</span>
					{isUnwrapRow(item.row) && pickTokenAmount(item.row) === null ? (
						<span class="tx-amount">
							<span class="tx-na" data-tooltip="Token unwrapped, no funds exchanged.">N/A?</span>
						</span>
					) : (
						<span class="tx-amount">
							{formatAmount(pickTokenAmount(item.row), { maximumFractionDigits: 8 })}
						</span>
					)}
					{isUnwrapRow(item.row) && pickUsdAmount(item.row) === null ? (
						<span class="tx-usd" data-role="usd">
							<span class="tx-na" data-tooltip="Token unwrapped, no funds exchanged.">N/A?</span>
						</span>
					) : (
						<span class="tx-usd" data-role="usd">
							{formatAmount(pickUsdAmount(item.row), { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
						</span>
					)}
					<span class="tx-icon">
						<span class="tx-icon-stack">
							{normalizeDirection(item.row) === 'lost' ? (
								<span class="tx-icon-svg" set:html={lostIcon} />
							) : normalizeDirection(item.row) === 'out' ? (
								<img class="tx-icon-img" src={walletOut.src} alt="Sold" />
							) : (
								<img class="tx-icon-img" src={walletIn.src} alt="Bought" />
							)}
						</span>
					</span>
					{aaveLabel(item.row) ? <div class="tx-meta">{aaveLabel(item.row)}</div> : null}
					{item.row.id === latestRowId ? (
						<div class="tx-detail">
							<span>
								Token:{' '}
								{formatAmount(pickTokenAmount(item.row), { maximumFractionDigits: 8 })}{' '}
								{pickSymbol(item.row)}
							</span>
							<span>
								USD:{' '}
								{formatAmount(pickUsdAmount(item.row), { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
							</span>
							{resolveFee(item.row) ? <span>Fee: {resolveFee(item.row)}</span> : null}
						</div>
					) : null}
					<textarea
						class="tx-notes"
						placeholder="Notes..."
						data-id={item.row.id}
						data-initial={item.row.notes ?? ''}
						data-category={item.row.category ?? ''}
						data-group-id={item.row.group_id ?? ''}
					>{item.row.notes ?? ''}</textarea>
					<span class="tx-saved" aria-live="polite">Saved</span>
			</div>
		))}
	</div>
</article>

<script>
	const list = document.querySelector('.tin0-all__list');
	const select = document.querySelector('.tin0-all__select');

	select?.addEventListener('change', () => {
		const value = select.value;
		if (!list) return;
		const rows = list.querySelectorAll('[data-type="row"]');
		rows.forEach((row) => {
			if (!(row instanceof HTMLElement)) return;
			const matches = value === 'all' || row.dataset.source === value;
			row.toggleAttribute('hidden', !matches);
		});
		fifoGroupPolSells(list);
	});

	const saveNote = async (target) => {
		if (!(target instanceof HTMLTextAreaElement) || !target.classList.contains('tx-notes')) return;
		const id = target.dataset.id;
		if (!id) return;
		const initial = target.dataset.initial ?? '';
		if (target.value === initial) return;
		const saved = target.nextElementSibling;
		const row = target.closest('.tx-card');
		const source = row instanceof HTMLElement ? row.dataset.source ?? '' : '';
		const isOnchain = source.startsWith('onchain_');
		const endpoint = isOnchain ? '/api/transactions/annotate' : '/api/import/transactions/annotate';
		const payload = isOnchain
			? {
					transactionId: id,
					note: target.value,
					category: target.dataset.category || null,
				}
			: {
					id,
					note: target.value,
					category: target.dataset.category || null,
					group_id: target.dataset.groupId || null,
				};
		try {
			const response = await fetch(endpoint, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			if (!response.ok) throw new Error('Failed to save.');
			target.dataset.initial = target.value;
			if (saved instanceof HTMLElement) {
				saved.classList.add('is-visible');
				setTimeout(() => saved.classList.remove('is-visible'), 1500);
			}
		} catch {
			if (saved instanceof HTMLElement) {
				saved.textContent = 'Save failed';
				saved.classList.add('is-visible');
				setTimeout(() => {
					saved.classList.remove('is-visible');
					saved.textContent = 'Saved';
				}, 2000);
			}
		}
	};

	const saveTimers = new WeakMap();
	const queueSave = (target) => {
		if (!(target instanceof HTMLTextAreaElement)) return;
		const current = saveTimers.get(target);
		if (current) clearTimeout(current);
		const handle = setTimeout(() => saveNote(target), 600);
		saveTimers.set(target, handle);
	};

	list?.addEventListener('input', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLTextAreaElement) || !target.classList.contains('tx-notes')) return;
		queueSave(target);
	});

	list?.addEventListener('blur', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLTextAreaElement) || !target.classList.contains('tx-notes')) return;
		const current = saveTimers.get(target);
		if (current) clearTimeout(current);
		saveNote(target);
	}, true);

	const normalizePriceSymbol = (symbol) => {
		if (!symbol) return '';
		const upper = String(symbol).toUpperCase();
		if (upper === 'APOLWETH') return 'WETH';
		if (upper === 'APOLWMATIC') return 'POL';
		if (upper === 'APOLUSDC') return 'USDC';
		if (upper === 'APOLUSDT') return 'USDT';
		if (upper === 'APOLDAI') return 'DAI';
		if (upper === 'MATIC' || upper === 'WMATIC') return 'POL';
		return upper;
	};

	const parseAmount = (raw, decimals) => {
		if (!raw) return 0;
		const safeDecimals = Number.isFinite(decimals) ? decimals : 18;
		const padded = String(raw).padStart(safeDecimals + 1, '0');
		const whole = padded.slice(0, -safeDecimals) || '0';
		const fraction = padded.slice(-safeDecimals).replace(/0+$/, '');
		const numeric = Number(fraction ? `${whole}.${fraction}` : whole);
		return Number.isFinite(numeric) ? numeric : 0;
	};

	const formatUsd = (value) => {
		if (!Number.isFinite(value) || value <= 0) return '—';
		return `$${value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
	};

	const hydrateOnchainUsd = async () => {
		if (!list) return;
		const rows = Array.from(list.querySelectorAll('[data-type="row"][data-onchain="true"]'));
		if (!rows.length) return;
		const symbols = new Set();
		rows.forEach((row) => {
			if (!(row instanceof HTMLElement)) return;
			const symbol = normalizePriceSymbol(row.dataset.symbol);
			if (symbol) symbols.add(symbol);
		});
		if (!symbols.size) return;

		let priceMap = {};
		try {
			const response = await fetch(`/api/market/coingecko-prices?symbols=${encodeURIComponent(Array.from(symbols).join(','))}`);
			if (response.ok) {
				const payload = await response.json();
				priceMap = payload.prices ?? {};
			}
		} catch {
			priceMap = {};
		}

		rows.forEach((row) => {
			if (!(row instanceof HTMLElement)) return;
			const raw = row.dataset.raw ?? '';
			const decimals = Number(row.dataset.decimals ?? 18);
			const symbol = normalizePriceSymbol(row.dataset.symbol);
			const price = Number(priceMap[symbol] ?? 0);
			const amount = parseAmount(raw, decimals);
			const usd = amount * (Number.isFinite(price) ? price : 0);
			const usdEl = row.querySelector('[data-role="usd"]');
			if (usdEl) {
				usdEl.textContent = usd > 0 ? formatUsd(usd) : '—';
				row.dataset.usd = String(usd);
			}
		});
	};

	function fifoGroupPolSells(listEl) {
		if (!listEl) {
			console.log('[fifo] list missing');
			return;
		}

		const existingGroups = Array.from(listEl.querySelectorAll('.tx-group'));
		existingGroups.forEach((group) => {
			while (group.firstChild) {
				listEl.insertBefore(group.firstChild, group);
			}
			group.remove();
		});

		const all = Array.from(listEl.querySelectorAll('[data-type="row"]')).filter(
			(n) => n instanceof HTMLElement,
		);

		console.log('[fifo] start', all.length);

		const fullDate = (iso) => {
			const d = new Date(iso);
			if (Number.isNaN(d.getTime())) return iso || '';
			return d.toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'short',
				day: '2-digit',
			});
		};

		const getRowSymbol = (row) => normalizePriceSymbol(row.dataset.symbol || '');
		const getDir = (row) => (row.dataset.direction || '').toLowerCase();
		const getTime = (row) => Date.parse(row.dataset.timestamp || '') || 0;

		const getTokenQty = (row) => {
			if (row.dataset.onchain === 'true') {
				return parseAmount(row.dataset.raw || '', Number(row.dataset.decimals || 18));
			}
			const v = Number(row.dataset.importAmount || 0);
			return Number.isFinite(v) ? Math.abs(v) : 0;
		};

		const getUsd = (row) => {
			const usd1 = Number(row.dataset.usd || 0);
			if (Number.isFinite(usd1) && usd1 > 0) return Math.abs(usd1);

			const usd2 = Number(row.dataset.importUsd || 0);
			if (Number.isFinite(usd2) && usd2 > 0) return Math.abs(usd2);

			return 0;
		};

		const buys = all
			.filter((row) => getRowSymbol(row) === 'POL' && getDir(row) === 'in')
			.sort((a, b) => getTime(a) - getTime(b))
			.map((row) => ({
				row,
				ts: getTime(row),
				dateIso: row.dataset.timestamp || '',
				remaining: getTokenQty(row),
				usdTotal: getUsd(row),
			}))
			.filter((lot) => lot.remaining > 0);

		const sells = all
			.filter((row) => getRowSymbol(row) === 'POL' && getDir(row) === 'out')
			.sort((a, b) => getTime(b) - getTime(a));

		let groupsCount = 0;

		for (const sellRow of sells) {
			const sellQty = getTokenQty(sellRow);
			const sellUsd = getUsd(sellRow);

			if (!(sellQty > 0)) continue;

			let need = sellQty;
			let costUsd = 0;
			let usedQty = 0;
			let lastBuyIso = '';

			const matched = [];

			for (const lot of buys) {
				if (need <= 0) break;
				if (lot.remaining <= 0) continue;

				const take = Math.min(need, lot.remaining);
				const lotQty = getTokenQty(lot.row);
				const lotUsd = lot.usdTotal;
				const perToken = lotQty > 0 ? lotUsd / lotQty : 0;
				const takeUsd = perToken > 0 ? perToken * take : 0;

				lot.remaining -= take;
				need -= take;

				usedQty += take;
				costUsd += takeUsd;

				lastBuyIso = lot.dateIso || lastBuyIso;

				matched.push({ row: lot.row, take, takeUsd });
			}

			if (usedQty <= 0) continue;

			const weightedBuy = costUsd > 0 && usedQty > 0 ? costUsd / usedQty : 0;
			const sellPrice = sellUsd > 0 && sellQty > 0 ? sellUsd / sellQty : 0;
			const pnl = sellUsd > 0 && costUsd > 0 ? sellUsd - costUsd : null;

			const wrapper = document.createElement('div');
			wrapper.className = 'tx-group';

			const header = document.createElement('div');
			header.className = 'tx-group__header';
			const plClass = pnl === null ? '' : pnl >= 0 ? 'is-profit' : 'is-loss';
			const plText = pnl === null ? '—' : `${pnl >= 0 ? '+' : ''}${formatUsd(pnl)}`;
			header.innerHTML = `
				<span>Sold: <strong>${fullDate(sellRow.dataset.timestamp || '')}</strong></span>
				<span>Last buy: <strong>${lastBuyIso ? fullDate(lastBuyIso) : '—'}</strong></span>
				<span>Wtd buy: <strong>${formatUsd(weightedBuy)}</strong></span>
				<span>Sell: <strong>${formatUsd(sellPrice)}</strong></span>
				<span class="tx-pl ${plClass}">P/L: <strong>${plText}</strong></span>
			`.trim();

			wrapper.appendChild(header);
			sellRow.parentElement?.insertBefore(wrapper, sellRow);
			wrapper.appendChild(sellRow);
			groupsCount += 1;

			matched
				.slice()
				.sort((a, b) => getTime(a.row) - getTime(b.row))
				.forEach(({ row, take, takeUsd }) => {
					const buyQty = getTokenQty(row);
					const buyUsd = getUsd(row);
					const buyPx = buyQty > 0 ? buyUsd / buyQty : 0;

					const lotLine = document.createElement('div');
					lotLine.className = 'tx-lotline';
					lotLine.innerHTML = `
						<span class="tx-lotline__label">Buy lot</span>
						<span class="tx-lotline__muted">${fullDate(row.dataset.timestamp || '')}</span>
						<span>Used: ${take.toLocaleString(undefined, { maximumFractionDigits: 6 })} POL</span>
						<span>Lot px: ${formatUsd(buyPx)}</span>
						<span>Basis used: ${formatUsd(takeUsd)}</span>
					`.trim();

					wrapper.appendChild(lotLine);
					wrapper.appendChild(row);
				});
		}

		console.log('[fifo] groups made', groupsCount);
	}

	hydrateOnchainUsd().then(() => fifoGroupPolSells(list));
</script>

