---
interface Props {
	label: string;
	class?: string;
}

const { label, class: className = '' } = Astro.props;
const hasSummary = Astro.slots.has('summary');
// Temporary test for bookkeeping tins: minimal styles to avoid border/scroll conflicts.
---

<div class={`salmon-tin ${className}`}>
	<span class="salmon-tin__label">{label}</span>
	{hasSummary && (
		<div class="salmon-tin__summary">
			<slot name="summary" />
		</div>
	)}
	<div class="salmon-tin__body">
		<slot />
	</div>
</div>

<style>
	.salmon-tin {
		position: relative;
		background: darkslategray;
		color: #f7f2eb;
		border: 2px solid salmon !important;
		border-radius: 12px;
		padding: 2.5rem 1.25rem 1.25rem;
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
	}

	.salmon-tin__label {
		position: absolute;
		top: -12px;
		left: 1rem;
		background: salmon;
		color: #0b0f1a;
		font-weight: 700;
		font-size: 1rem;
		padding: 0.4rem 0.8rem;
		border-radius: 8px;
		z-index: 2;
	}

	.salmon-tin__summary {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		margin-top: 0.2rem;
	}

	.salmon-tin__body {
		position: relative;
		z-index: 1;
		flex: 1;
		overflow-y: auto !important;
		padding: 1rem 0;
		-webkit-overflow-scrolling: touch;
	}

	.salmon-tin::before,
	.salmon-tin::after {
		display: none !important;
	}
</style>
