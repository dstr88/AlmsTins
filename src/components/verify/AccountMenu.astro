---
// Account menu for the Verify role desks.
//
// The desks are standalone pages outside the dashboard chrome, so they had no way to see
// who you are signed in as and no way to sign out — which makes it impossible to switch
// between the client and financier accounts on one machine.
//
// Mirrors the main site's account dropdown: signed-in email, tenant UUID with a copy
// button, and sign out. Adds a switch link between the two desks, since the same account
// can open either.
interface Props {
  tenantId: string;
  email?: string | null;
  /** Which desk is showing, so the switch link points at the other one. */
  current: 'client' | 'desk';
}
const { tenantId, email = null, current } = Astro.props;
const other = current === 'client'
  ? { href: '/verify/desk', label: 'Financing Desk' }
  : { href: '/verify/client', label: 'Client Portal' };
---

<details class="acct">
  <summary class="acct__trigger">
    <span class="acct__dot" aria-hidden="true"></span>
    <span class="acct__who">{email ?? 'Account'}</span>
    <span class="acct__caret" aria-hidden="true">▾</span>
  </summary>

  <div class="acct__menu">
    <div class="acct__row">
      <span class="acct__k">Signed in as</span>
      <span class="acct__v">{email ?? '—'}</span>
    </div>

    <div class="acct__row">
      <span class="acct__k">Account ID</span>
      <span class="acct__v acct__v--mono">
        <code>{tenantId.slice(0, 8)}&hellip;</code>
        <button type="button" class="acct__copy" data-copy={tenantId} title="Copy full account ID">Copy</button>
      </span>
    </div>

    <hr class="acct__hr" />

    <a class="acct__link" href={other.href}>Switch to {other.label}</a>
    <a class="acct__link" href="/verify/registry">Public receivable check</a>

    <hr class="acct__hr" />

    <a class="acct__signout" href="/api/auth/signout">Sign out</a>
  </div>
</details>

<style>
  .acct { position: relative; }
  .acct__trigger {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: .45rem;
    background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 99px;
    padding: .38rem .75rem; font-size: .82rem; color: var(--text-secondary); max-width: 15rem;
  }
  .acct__trigger::-webkit-details-marker { display: none; }
  .acct__trigger:hover { background: var(--surface-hover); }
  .acct__dot { width: .48rem; height: .48rem; border-radius: 50%; background: var(--gain); flex: 0 0 auto; }
  .acct__who { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .acct__caret { color: var(--text-muted); font-size: .7rem; }

  .acct__menu {
    position: absolute; right: 0; top: calc(100% + .4rem); z-index: 40; width: 17rem;
    background: var(--surface-card); border: 1px solid var(--border-bright); border-radius: 12px;
    padding: .8rem .9rem; display: flex; flex-direction: column; gap: .5rem;
    box-shadow: 0 18px 44px -18px rgba(0,0,0,.65);
  }
  .acct__row { display: flex; flex-direction: column; gap: .12rem; }
  .acct__k { font-size: .64rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); }
  .acct__v { font-size: .84rem; color: var(--text-primary); word-break: break-word; }
  .acct__v--mono { display: flex; align-items: center; gap: .45rem; }
  .acct__v--mono code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8rem; }
  .acct__copy {
    background: transparent; border: 1px solid var(--border-bright); border-radius: 6px;
    color: var(--text-secondary); font-size: .68rem; font-weight: 600; padding: .12rem .4rem;
    cursor: pointer; font-family: inherit;
  }
  .acct__copy:hover { background: var(--surface-hover); }
  .acct__hr { border: none; border-top: 1px solid var(--border-subtle); margin: .15rem 0; }
  .acct__link { font-size: .85rem; color: var(--accent); text-decoration: none; }
  .acct__link:hover { text-decoration: underline; }
  .acct__signout {
    font-size: .85rem; font-weight: 700; color: var(--loss); text-decoration: none;
    border: 1px solid var(--loss-border); background: var(--loss-bg);
    border-radius: 8px; padding: .42rem .7rem; text-align: center;
  }
  .acct__signout:hover { filter: brightness(1.1); }
</style>

<script>
  document.querySelectorAll('.acct__copy').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget as HTMLElement;
      const text = el.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const prev = el.textContent;
        el.textContent = 'Copied';
        setTimeout(() => { el.textContent = prev; }, 1400);
      } catch { /* clipboard unavailable — the code stays selectable */ }
    });
  });

  // Close the menu when clicking outside it.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.acct[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) (d as HTMLDetailsElement).open = false;
    });
  });
</script>
