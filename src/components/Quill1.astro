---
// Quill.astro
import Feather from '../assets/feather.png';
---

<section class="purpose-section">
  <img src={Feather.src} alt="Feather Quill" class="feather-img" />

  <div class="purpose-text">
    <p>
      Our purpose is rooted in the belief that creativity can heal, inspire, and
      awaken the human spirit. Through storytelling, movement, and presence, we
      bring light to untold truths and shadowed emotions, offering space for
      transformation.
    </p>
    <p>
      This work is a calling — to create, to connect, and to carry the beauty of
      vulnerability into the world.
    </p>
  </div>
</section>

<style>
.purpose-section {
  position: relative;
  top: 2rem;
  margin-left: 20rem;
  right: 5rem;
  width: 800px;
  opacity: 0.95;
  z-index: 2;
  pointer-events: none;

  padding: 4rem 2rem;
  color: #F7F2EB; /* Pale Linen */
  font-family: var(--font-accent);
  line-height: 1.8;
  max-width: 75rem;
  margin: 0 auto;
  overflow: hidden;
}

.feather-img {
 
}

.purpose-section {
  background: rgba(255, 255, 255, 0.05); /* light overlay to test space */
}


.purpose-text {
  padding-top: 8rem;
  position: relative;
  z-index: 2;
  font-size: 2rem;
}
</style>
