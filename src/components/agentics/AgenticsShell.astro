---
/**
 * The page for every Agentics screen in the app (the agents, one agent, the reports): a document of
 * its own, the way the Agentics door (src/pages/agentics/index.astro) and the welcome letter
 * (src/pages/dashboard/agentics/index.astro) are. It does not use the app's Layout, so nothing of the
 * crypto tracker is on it: no tracker navigation, no "Titanium Hut" brand, no tracker account menu
 * (its billing, tenant id and alert email), no site footer whose questions are about wallets. A person
 * who came to check an agent's payments sees Agentics' bar, the page, and a small footer.
 *
 * The bar holds the name, the places an account goes (its agents, the live feed, their reports and its account), a small
 * meter of the plan (what the account uses and what the plan covers) and the way out. An account without the
 * Vault (the account page before the Vault is open) sees the account link and the way out, and nothing that
 * would 404. The meter is given the
 * plan by the page, which read it for the account in the session; the shell reads only who is signed in,
 * to tell the analytics tag that the owner's own visits are internal (as the app's Layout does).
 *
 * The title of a page is a fixed word the page names ("Agents", "Reports"), never text an account chose:
 * an agent's name is the account's own words, and the title is one of the few things the analytics tag
 * sends out. The same goes for the web address, which carries an agent's id and no name.
 *
 * The page is never indexed, and its stylesheet is Agentics' own (agentics.css). Everything is a
 * design token (src/styles/tokens.css).
 */
import '@/styles/tokens.css';
import './agentics.css';
import Analytics from '@/components/Analytics.astro';
import LogoutButton from '@/components/LogoutButton.astro';
import { en as door } from '@/i18n/agentics';
import { isInternalAgenticsViewer } from '@/lib/agenticsAccess';
import { getAuthSession } from '@/lib/authSession';
import type { PlanSummary } from '@/lib/agentVault/entitlements';
import { copy } from './copy';
import PlanMeter from './PlanMeter';
import { ACCOUNT_PATH, FEED_PATH, HOME_PATH, REPORTS_PATH } from './paths';

interface Props {
  /** The page's own fixed name. Never an account's text (see above). */
  title: string;
  /** Which entry of the Agentics bar is the current one. */
  active?: 'agents' | 'feed' | 'reports' | 'account';
  /** The account's plan and use, for the meter. Without it there is no meter. */
  plan?: PlanSummary;
  /** Whether the account has the Vault. When it does not (the account page, before the Vault is open) the bar has no link to its pages and no meter. */
  vault?: boolean;
}
const { title, active, plan, vault = true } = Astro.props;

const session = await getAuthSession(Astro.request).catch(() => null);
const internal = isInternalAgenticsViewer(session);
const links = door.landing.footerLinks;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{`${title} | ${copy.brand}`}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.webp" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <Analytics owner={internal} />
</head>
<body class="ag-body">
  <div class="ag-shell">
    <header class="ag-shell__bar">
      <div class="ag-shell__bar-in">
        <a class="ag-shell__brand" href={HOME_PATH}>{copy.brand}</a>
        <nav class="ag-shell__nav" aria-label={copy.brand}>
          {vault && <a href={HOME_PATH} aria-current={active === 'agents' ? 'page' : undefined}>{copy.nav.agents}</a>}
          {vault && <a href={FEED_PATH} aria-current={active === 'feed' ? 'page' : undefined}>{copy.nav.live}</a>}
          {vault && <a href={REPORTS_PATH} aria-current={active === 'reports' ? 'page' : undefined}>{copy.nav.reports}</a>}
          <a href={ACCOUNT_PATH} aria-current={active === 'account' ? 'page' : undefined}>{copy.nav.account}</a>
        </nav>
        {vault && plan && <PlanMeter client:load plan={plan} />}
        <LogoutButton class="ag-shell__out" next="/agentics">{door.welcome.signOut}</LogoutButton>
      </div>
    </header>
    <main class="ag-shell__main">
      <slot />
    </main>
    <footer class="ag-shell__foot">
      <p>
        {door.landing.footer}
        <span class="ag-shell__foot-links">
          <a href="/agentics/docs">{links.docs}</a>
          <a href="/wallet-checker">{links.checker}</a>
          <a href="/privacy">{links.privacy}</a>
        </span>
      </p>
    </footer>
  </div>
</body>
</html>
