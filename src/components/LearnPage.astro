---
/*
 * LearnPage.astro: the template for /learn, the public page that lays out everything Almstins
 * offers, tool by tool, with a link on every item. Copy: src/i18n/learn.ts (one LearnCopy per
 * language; English today). Wrapper: src/pages/learn.astro.
 *
 * One template, three copies (en, es, fr): the language switch in the top bar lists every copy
 * (LEARN_LANGS) and marks the current one.
 *
 * Public and indexable: LoginLayout with noindex={false} and the page's canonical URL. The layout
 * renders the one Analytics tag and the Footer, so this file renders neither. The path is public
 * through isPublicPath (src/middleware/auth.ts) and the sitemap submits it by the default rule
 * (src/lib/seo/sitemapFilter.mjs).
 *
 * The page is a grid of tiles (one per tool, one per principle, one per resource) above detail
 * sections the tiles link to. Styles are scoped and use only design tokens (src/styles/tokens.css):
 * the one accent family, the four surfaces, the three text levels.
 */
import LoginLayout from '@/layouts/LoginLayout.astro';
import { LEARN_LANGS, type LearnCopy } from '@/i18n/learn';

interface Props {
	t: LearnCopy;
}
const { t } = Astro.props;
---

<LoginLayout title={t.meta.title} description={t.meta.description} lang={t.lang} noindex={false} canonical={t.canonical}>
	<Fragment slot="head">
		{LEARN_LANGS.map((l) => <link rel="alternate" hreflang={l.code} href={`https://almstins.com${l.href}`} />)}
		<link rel="alternate" hreflang="x-default" href="https://almstins.com/learn" />
	</Fragment>
	<header class="top">
		<a class="top__brand" href="/">{t.nav.brand}</a>
		<nav class="top__nav" aria-label="Site">
			<span class="top__langs">
				{LEARN_LANGS.map((l) => (
					<a href={l.href} lang={l.code} hreflang={l.code} aria-current={l.code === t.lang ? 'true' : undefined}>{l.label}</a>
				))}
			</span>
			{t.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
	</header>

	<div class="learn">
		<section class="hero" aria-labelledby="learn-h1">
			<p class="eyebrow">{t.hero.eyebrow}</p>
			<h1 id="learn-h1">{t.hero.h1}</h1>
			<p class="lede">{t.hero.lede}</p>
			<div class="hero__actions">
				<a class="btn btn--primary" href={t.hero.primary.href}>{t.hero.primary.label}</a>
				<a class="btn btn--ghost" href={t.hero.secondary.href}>{t.hero.secondary.label}</a>
			</div>
			<p class="stance">{t.hero.stance}</p>
		</section>

		<!-- The five tools, as tiles. Each tile jumps to its detail section below. -->
		<section class="section" aria-labelledby="tools-h">
			<h2 id="tools-h">{t.tools.heading}</h2>
			<p class="section__lede">{t.tools.lede}</p>
			<div class="grid grid--tools">
				{t.tools.items.map((tool) => (
					<a class="tile tile--tool" href={`#${tool.id}`}>
						<span class="tile__kicker">{tool.audience}</span>
						<span class="tile__title">{tool.name}<span class="tile__arrow" aria-hidden="true">↓</span></span>
						<span class="tile__body">{tool.tagline}</span>
						<span class="pill">{tool.price}</span>
					</a>
				))}
			</div>
		</section>

		<!-- One detail card per tool. -->
		{t.tools.items.map((tool) => (
			<section class="section detail" id={tool.id} aria-labelledby={`${tool.id}-h`}>
				<div class="detail__head">
					<div>
						<p class="eyebrow">{tool.audience}</p>
						<h2 id={`${tool.id}-h`}>{tool.name}</h2>
					</div>
					<span class="pill pill--lg">{tool.price}</span>
				</div>
				<p class="detail__what">{tool.what}</p>
				<ul class="points">
					{tool.points.map((p) => <li>{p}</li>)}
				</ul>
				<p class="detail__limit">{tool.limit}</p>
				<div class="detail__links">
					<a class="btn btn--primary" href={tool.open.href}>{tool.open.label}<span aria-hidden="true"> →</span></a>
					{tool.learnMore.map((l) => <a class="btn btn--ghost" href={l.href}>{l.label}</a>)}
				</div>
			</section>
		))}

		<!-- Principles -->
		<section class="section" aria-labelledby="principles-h">
			<h2 id="principles-h">{t.principles.heading}</h2>
			<p class="section__lede">{t.principles.lede}</p>
			<div class="grid grid--principles">
				{t.principles.items.map((p, i) => (
					<div class="tile tile--principle">
						<span class="num">{i + 1}</span>
						<span class="tile__title">{p.title}</span>
						<span class="tile__body">{p.body}</span>
					</div>
				))}
			</div>
			<blockquote class="quote">{t.principles.quote}</blockquote>
		</section>

		<!-- Pricing, in brief -->
		<section class="section" aria-labelledby="pricing-h">
			<h2 id="pricing-h">{t.pricing.heading}</h2>
			<p class="section__lede">{t.pricing.lede}</p>
			<div class="grid grid--pricing">
				{t.pricing.rows.map((r) => (
					<a class="tile tile--price" href={t.pricing.link.href}>
						<span class="tile__title">{r.plan}</span>
						<span class="price">{r.price}</span>
						<span class="tile__body">{r.body}</span>
					</a>
				))}
			</div>
			<p class="section__foot">
				<a class="inline" href={t.pricing.link.href}>{t.pricing.link.label}<span aria-hidden="true"> →</span></a>
				<span class="muted"> {t.pricing.note}</span>
			</p>
		</section>

		<!-- What it is not -->
		<section class="section" aria-labelledby="not-h">
			<h2 id="not-h">{t.not.heading}</h2>
			<ul class="not">
				{t.not.items.map((n) => <li>{n}</li>)}
			</ul>
		</section>

		<!-- Tutorials, guides and demos -->
		<section class="section" id="tutorials" aria-labelledby="resources-h">
			<h2 id="resources-h">{t.resources.heading}</h2>
			<p class="section__lede">{t.resources.lede}</p>
			<div class="grid grid--resources">
				{t.resources.items.map((r) => (
					<a class="tile tile--resource" href={r.href} rel={r.href.startsWith('/api/') ? 'nofollow' : undefined}>
						<span class="tile__kicker">{r.kind}</span>
						<span class="tile__title">{r.title}<span class="tile__arrow" aria-hidden="true">→</span></span>
						<span class="tile__body">{r.body}</span>
					</a>
				))}
			</div>
		</section>

		<section class="closing" aria-labelledby="closing-h">
			<h2 id="closing-h">{t.closing.heading}</h2>
			<p>{t.closing.body}</p>
			<div class="closing__links">
				{t.closing.links.map((l) => <a class="btn btn--primary" href={l.href}>{l.label}</a>)}
			</div>
			<p class="muted small">{t.updated}</p>
		</section>
	</div>
</LoginLayout>

<style>
	.top {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		padding: 1.25rem 1rem 0.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.top__brand { font-weight: 700; font-size: 1.1rem; color: var(--text-primary); text-decoration: none; }
	.top__nav { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
	.top__nav a { color: var(--text-secondary); text-decoration: none; font-size: 0.92rem; font-weight: 500; }
	.top__nav a:hover, .top__nav a:focus-visible { color: var(--accent); }
	.top__langs { display: inline-flex; gap: 0.5rem; padding-right: 0.75rem; border-right: 1px solid var(--border-subtle); }
	.top__langs a { font-size: 0.8rem; color: var(--text-muted); }
	.top__langs a[aria-current="true"] { color: var(--text-primary); font-weight: 700; }

	.learn { width: 100%; max-width: 1080px; margin: 0 auto; padding: 1rem 1rem 4rem; }

	.eyebrow { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.5rem; }
	h1 { font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.08; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); margin: 0 0 1rem; max-width: 14ch; }
	h2 { font-size: clamp(1.35rem, 2.6vw, 1.75rem); line-height: 1.2; font-weight: 700; letter-spacing: -0.01em; color: var(--text-primary); margin: 0 0 0.4rem; }
	.lede, .section__lede { color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; max-width: 62ch; margin: 0 0 1.25rem; }
	.muted { color: var(--text-muted); }
	.small { font-size: 0.85rem; }

	.hero { padding: 2.5rem 0 2rem; border-bottom: 1px solid var(--border-subtle); }
	.hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
	.stance { color: var(--text-secondary); font-size: 0.95rem; max-width: 62ch; margin: 0; padding-left: 0.9rem; border-left: 3px solid var(--accent); }

	.btn { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.6rem 1rem; border-radius: 10px; font-size: 0.92rem; font-weight: 600; text-decoration: none; border: 1px solid transparent; transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
	.btn--primary { background: var(--accent); color: var(--surface-bg); }
	.btn--primary:hover, .btn--primary:focus-visible { background: var(--accent-dim); color: var(--surface-bg); }
	.btn--ghost { background: transparent; color: var(--text-primary); border-color: var(--border-bright); }
	.btn--ghost:hover, .btn--ghost:focus-visible { border-color: var(--accent); color: var(--accent); background: var(--surface-hover); }
	.inline { color: var(--accent); text-decoration: none; font-weight: 600; }
	.inline:hover { text-decoration: underline; }

	.section { padding: 2.5rem 0 0; }
	.section__foot { margin: 1rem 0 0; font-size: 0.92rem; }

	.grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
	@media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
	@media (min-width: 960px) {
		.grid--tools { grid-template-columns: repeat(3, 1fr); }
		.grid--principles { grid-template-columns: repeat(3, 1fr); }
		.grid--pricing { grid-template-columns: repeat(3, 1fr); }
		.grid--resources { grid-template-columns: repeat(3, 1fr); }
	}

	.tile {
		display: flex; flex-direction: column; gap: 0.4rem;
		background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 16px;
		padding: 1.1rem 1.15rem; text-decoration: none; color: inherit;
		transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
	}
	a.tile:hover, a.tile:focus-visible { border-color: var(--accent); background: var(--surface-card-2); transform: translateY(-1px); }
	.tile__kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
	.tile__title { display: flex; align-items: center; gap: 0.5rem; font-size: 1.02rem; font-weight: 700; color: var(--text-primary); line-height: 1.3; }
	.tile__arrow { margin-left: auto; color: var(--accent); font-weight: 700; }
	.tile__body { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.55; }
	.tile--tool .pill { margin-top: auto; }
	.tile--principle .num { display: inline-flex; width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 800; font-size: 0.85rem; align-items: center; justify-content: center; }
	.tile--price .price { font-size: 1.3rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em; }

	.pill { display: inline-flex; align-self: flex-start; align-items: center; font-size: 0.78rem; font-weight: 700; color: var(--accent); background: var(--accent-soft); border-radius: 999px; padding: 0.2rem 0.65rem; white-space: nowrap; }
	.pill--lg { font-size: 0.86rem; padding: 0.3rem 0.8rem; }

	.detail { scroll-margin-top: 1.25rem; }
	.detail__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
	.detail__what { color: var(--text-secondary); font-size: 1rem; line-height: 1.6; max-width: 70ch; margin: 0 0 1rem; }
	.points { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.45rem 1.5rem; grid-template-columns: 1fr; }
	@media (min-width: 720px) { .points { grid-template-columns: 1fr 1fr; } }
	.points li { position: relative; padding-left: 1.1rem; font-size: 0.93rem; color: var(--text-secondary); line-height: 1.5; }
	.points li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
	.detail__limit { color: var(--text-muted); font-size: 0.9rem; max-width: 70ch; margin: 0 0 1rem; }
	.detail__links { display: flex; gap: 0.6rem; flex-wrap: wrap; }

	.quote { margin: 1.25rem 0 0; background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-left: 3px solid var(--accent); border-radius: 12px; padding: 1rem 1.25rem; color: var(--text-primary); font-size: 1.02rem; line-height: 1.6; }

	.not { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 0.5rem 1.5rem; grid-template-columns: 1fr; }
	@media (min-width: 640px) { .not { grid-template-columns: 1fr 1fr; } }
	.not li { position: relative; padding-left: 1.3rem; color: var(--text-secondary); font-size: 0.95rem; }
	.not li::before { content: "\2715"; position: absolute; left: 0; color: var(--loss); font-weight: 700; font-size: 0.8rem; top: 0.15em; }

	.closing { margin-top: 3rem; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 18px; padding: 1.75rem 1.5rem; }
	.closing p { color: var(--text-secondary); margin: 0 0 1rem; max-width: 62ch; }
	.closing__links { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
	.closing .small { margin: 0; }
</style>
