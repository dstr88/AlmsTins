---
interface Props {
  title?: string;
  eyebrow?: string;
  hook?: string;
  cta?: string;
  href?: string;
  className?: string;
}

const {
  title = "",
  eyebrow = "",
  hook = "",
  cta = "",
  href = "",
  className = "",
} = Astro.props as Props;
---

<article class={`card ${className}`.trim()}>
  {eyebrow ? <p class="card-eyebrow">{eyebrow}</p> : null}
  {title ? <h3 class="card-title">{title}</h3> : null}
  {hook ? <p class="card-hook">{hook}</p> : <slot />}
  {cta && href ? (
    <a class="card-cta" href={href}>
      {cta}
    </a>
  ) : null}
</article>

<style>
  .card {
    border: 1px solid color-mix(in oklab, var(--brand, #587D71) 20%, transparent);
    border-radius: 1rem;
    padding: 1.25rem;
    background: darkslategray;
    box-shadow: 0 8px 24px rgba(0,0,0,.06);
    color: antiquewhite;
    max-height: 320px;
    overflow: auto;
  }

  .card-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    margin: 0 0 0.35rem;
    opacity: 0.7;
  }

  .card-title {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }

  .card-hook {
    margin: 0 0 0.85rem;
    line-height: 1.55;
  }

  .card :global(p) {
    line-height: 1.6;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  .card-cta:hover { text-decoration: underline; }
</style>
  
