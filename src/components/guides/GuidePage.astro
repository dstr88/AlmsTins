---
/*
 * GuidePage.astro: the template for every public guide (the weekly search series under
 * /guides/<slug>). A page under src/pages/guides/ passes one GuideCopy (src/i18n/guides/).
 *
 * Public and indexable: LoginLayout with noindex={false} and the guide's canonical URL. The
 * layout already renders the one Analytics tag and the Footer, so this file renders neither.
 * The path is public through isPublicPath (src/middleware/auth.ts, the /guides block) and the
 * sitemap submits it (src/lib/seo/sitemapFilter.mjs).
 *
 * Head: Article and FAQPage JSON-LD (src/lib/guides/jsonLd.ts). The FAQPage block is built from
 * the same t.faq.items the visible <details> list renders, so the two always match.
 *
 * The template renders only the GuideCopy and repeats none of it: the not-tax-advice line lives
 * in the guide's body where its reviewed draft puts it, so the page shows it once. Styles are
 * scoped and use only design tokens (src/styles/tokens.css).
 */
import LoginLayout from '@/layouts/LoginLayout.astro';
import type { GuideCopy } from '@/i18n/guides/types';
import { articleJsonLd, faqPageJsonLd, ldJson } from '@/lib/guides/jsonLd';
import GuideBlocks from './GuideBlocks.astro';
import GuideInline from './GuideInline.astro';

interface Props {
	t: GuideCopy;
}
const { t } = Astro.props;
---

<LoginLayout title={t.meta.title} description={t.meta.description} lang={t.lang} noindex={false} canonical={t.canonical}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={ldJson(articleJsonLd(t))} />
		<script type="application/ld+json" set:html={ldJson(faqPageJsonLd(t))} />
	</Fragment>

	<header class="guide-top">
		<a class="guide-top__brand" href="/">{t.nav.brand}</a>
		<nav class="guide-top__nav">
			{t.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
	</header>

	<article class="guide">
		<header class="guide__head">
			<p class="guide__eyebrow">{t.eyebrow}</p>
			<h1>{t.h1}</h1>
			<p class="guide__reviewed"><time datetime={t.reviewed.iso}>{t.reviewed.label}</time></p>
		</header>

		<GuideBlocks blocks={t.intro} variant="lead" />

		{t.sections.map((s) => (
			<section class="guide__section" id={s.id} aria-labelledby={`${s.id}-h`}>
				<h2 id={`${s.id}-h`}>{s.h2}</h2>
				<GuideBlocks blocks={s.blocks} />
			</section>
		))}

		<section class="guide__section" id={t.faq.id} aria-labelledby={`${t.faq.id}-h`}>
			<h2 id={`${t.faq.id}-h`}>{t.faq.heading}</h2>
			<div class="faq">
				{t.faq.items.map((f) => (
					<details class="faq__item">
						<summary>{f.q}</summary>
						<p class="faq__a"><GuideInline md={f.a} /></p>
					</details>
				))}
			</div>
		</section>

		<section class="guide__section" id={t.sources.id} aria-labelledby={`${t.sources.id}-h`}>
			<h2 id={`${t.sources.id}-h`}>{t.sources.heading}</h2>
			<p class="sources__intro">{t.sources.intro}</p>
			{t.sources.groups.map((g) => (
				<Fragment>
					<h3 class="sources__group">{g.heading}</h3>
					<ul class="sources__list">
						{g.items.map((it) => <li><GuideInline md={it} /></li>)}
					</ul>
				</Fragment>
			))}
		</section>
	</article>
</LoginLayout>

<style>
	.guide-top {
		width: 100%;
		max-width: 1080px;
		margin: 0 auto;
		padding: 1.25rem 1rem 0.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.guide-top__brand {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text-primary);
		text-decoration: none;
	}
	.guide-top__nav {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.guide-top__nav a {
		font-size: 0.9rem;
		color: var(--text-secondary);
		text-decoration: none;
	}
	.guide-top__nav a:hover,
	.guide-top__nav a:focus-visible {
		color: var(--text-primary);
	}

	.guide {
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		padding: 2rem 1rem 4rem;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		color: var(--text-secondary);
	}

	.guide__head {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.guide__eyebrow {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}
	h1 {
		margin: 0;
		font-size: clamp(1.9rem, 4.6vw, 2.5rem);
		line-height: 1.15;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text-primary);
	}
	.guide__reviewed {
		margin: 0;
		font-size: 0.88rem;
		/* --text-secondary, not --text-muted: small text needs 4.5:1 on the page background. */
		color: var(--text-secondary);
	}

	.guide__section {
		border-top: 1px solid var(--border-subtle);
		padding-top: 1.4rem;
		scroll-margin-top: 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	h2 {
		margin: 0;
		font-size: 1.35rem;
		line-height: 1.3;
		font-weight: 700;
		color: var(--text-primary);
	}

	.faq__item {
		border-top: 1px solid var(--border-subtle);
	}
	.faq__item:last-of-type {
		border-bottom: 1px solid var(--border-subtle);
	}
	.faq__item summary {
		cursor: pointer;
		padding: 0.85rem 0;
		font-weight: 650;
		color: var(--text-primary);
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}
	.faq__item summary::-webkit-details-marker {
		display: none;
	}
	.faq__item summary::after {
		content: '+';
		color: var(--text-muted);
		font-size: 1.15rem;
		line-height: 1;
		flex: none;
	}
	.faq__item[open] summary::after {
		content: '\2212';
	}
	.faq__item summary:hover,
	.faq__item summary:focus-visible {
		color: var(--accent);
	}
	.faq__a {
		margin: 0;
		padding: 0 0 1rem;
		font-size: 0.98rem;
		color: var(--text-secondary);
	}

	.sources__intro {
		margin: 0;
	}
	.sources__group {
		margin: 0.4rem 0 0;
		font-size: 1rem;
		font-weight: 650;
		color: var(--text-primary);
	}
	.sources__list {
		margin: 0;
		padding-left: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-size: 0.92rem;
		overflow-wrap: anywhere;
	}
</style>
