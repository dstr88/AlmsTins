---
/*
 * The body blocks of a guide section: paragraphs, bulleted and numbered lists, and a row of
 * call-to-action links. Copy is inline markup, rendered by GuideInline.astro.
 */
import type { GuideBlock } from '@/i18n/guides/types';
import GuideInline from './GuideInline.astro';

interface Props {
	blocks: GuideBlock[];
	/** 'lead' frames the blocks as the page's short answer. */
	variant?: 'lead';
}
const { blocks, variant } = Astro.props;
---
<div class:list={['blocks', { 'blocks--lead': variant === 'lead' }]}>
	{blocks.map((b) => {
		if (b.kind === 'p') return <p><GuideInline md={b.md} /></p>;
		if (b.kind === 'ul') return <ul class="list">{b.items.map((it) => <li><GuideInline md={it} /></li>)}</ul>;
		if (b.kind === 'ol') return <ol class="list">{b.items.map((it) => <li><GuideInline md={it} /></li>)}</ol>;
		return (
			<p class="cta">
				{b.links.map((l) => (
					<a class:list={['cta__link', { 'cta__link--primary': l.primary }]} href={l.href} rel={l.nofollow ? 'nofollow' : undefined}>{l.label}</a>
				))}
			</p>
		);
	})}
</div>

<style>
	.blocks {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.blocks--lead {
		background: var(--surface-card);
		border: 1px solid var(--border-bright);
		border-left: 3px solid var(--accent);
		border-radius: 12px;
		padding: 1.1rem 1.25rem;
	}
	p {
		margin: 0;
		color: var(--text-secondary);
	}
	.blocks--lead p {
		color: var(--text-primary);
	}
	.list {
		margin: 0;
		padding-left: 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		color: var(--text-secondary);
	}
	.list li::marker {
		color: var(--accent);
		font-weight: 650;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.cta__link {
		display: inline-block;
		padding: 0.6rem 1.1rem;
		border-radius: 10px;
		border: 1px solid var(--border-bright);
		background: var(--surface-card);
		color: var(--text-primary);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
	}
	.cta__link:hover,
	.cta__link:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}
	.cta__link--primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--surface-bg);
	}
	.cta__link--primary:hover,
	.cta__link--primary:focus-visible {
		color: var(--surface-bg);
		filter: brightness(1.06);
	}
	.cta__link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>
