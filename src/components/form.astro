---
import Layout from '@/layouts/Layout.astro';
---

<Layout>
  <main class="wrap">
    <h1>Get in touch</h1>

    <form method="POST" class="lead-form" autocomplete="on" novalidate>
      <div class="grid">
        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe" />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required inputmode="email" autocomplete="email" placeholder="you@example.com" />
        </div>

        <div class="field">
          <label for="phone">Phone (optional)</label>
          <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(555) 555-5555" />
        </div>

        <div class="field">
          <label for="city">City (optional)</label>
          <input id="city" name="city" type="text" autocomplete="address-level2" placeholder="Nashville" />
        </div>

        <div class="field">
          <label for="state">State (optional)</label>
          <input id="state" name="state" type="text" autocomplete="address-level1" placeholder="TN" />
        </div>

        <div class="field field--full">
          <label for="comments">Comments (optional)</label>
          <textarea id="comments" name="comments" rows="4" placeholder="Tell us what you need…"></textarea>
        </div>

        <div class="actions">
          <button type="submit" class="btn">Send</button>
        </div>
      </div>

      <!-- Honeypot anti-spam (hidden) -->
      <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
    </form>
  </main>

  <style>
    .wrap { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }

    .lead-form {
      background: inherit;
      color: antiquewhite;
      border-radius: 1rem;
      padding: 1rem;
      box-shadow: 0 8px 24px rgba(0,0,0,.06);
    }

    .lead-form .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.9rem 1rem;
    }

    .field label {
      display: inline-block;
      font-size: .95rem;
      font-weight: 600;
      margin-bottom: .35rem;
    }
    .field input, .field textarea {
      width: 100%;
      border: 1px solid color-mix(in oklab, var(--brand, #587D71) 25%, transparent);
      border-radius: .6rem;
      padding: .7rem .85rem;
      background: color-mix(in oklab, var(--bg, #fff) 95%, transparent);
      color: inherit;
    }
    .field input:focus, .field textarea:focus {
      outline: 3px solid color-mix(in oklab, var(--brand, #587D71) 30%, transparent);
      outline-offset: 1px;
    }
    .field--full { grid-column: 1; }

    .actions { display: flex; justify-content: flex-end; margin-top: .5rem; grid-column: 1; }
    .btn {
      background: var(--cta, #852E2F);
      color: var(--bg, #fff);
      border: 0;
      padding: .75rem 1.2rem;
      border-radius: .7rem;
      font-weight: 700;
      cursor: pointer;
    }
    .btn:hover { background: var(--cta-dark, #652024); }

    @media (min-width: 600px) {
      .lead-form .grid { grid-template-columns: repeat(2, 1fr); }
      .field--full, .actions { grid-column: 1 / -1; }
    }

    .hp { position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; }
  </style>
</Layout>
