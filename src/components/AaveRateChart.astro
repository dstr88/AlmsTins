---
import chartScript from '../scripts/aaveChartClient.ts?url';
const reserves = [
	{
		label: 'USDC · Ethereum (v3)',
		reserveId: '0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48',
		poolId: 'mainnet_v3',
		color: '#2d7cf7',
	},
	{
		label: 'USDT · Ethereum (v3)',
		reserveId: '0xdac17f958d2ee523a2206206994597c13d831ec7',
		poolId: 'mainnet_v3',
		color: '#f5b431',
	},
	{
		label: 'USDC · Polygon (v3)',
		reserveId: '0x3c499c542cef5e3811e1192ce70d8cc03d5c3359',
		poolId: 'polygon_v3',
		color: '#8247e5',
	},
	{
		label: 'USDT · Polygon (v3)',
		reserveId: '0xc2132d05d31c914a87c6611c10748aeb04b58e8f',
		poolId: 'polygon_v3',
		color: '#26a17b',
	},
];
const defaultReserve = reserves[0];
const DEFAULT_WINDOW_DAYS = 30;
const windows = [
	{ label: '7 days', value: 7 },
	{ label: '30 days', value: 30 },
	{ label: '90 days', value: 90 },
];
---

<section class="page" data-default-window={DEFAULT_WINDOW_DAYS}>
	<div class="panel">
		<header class="panel__header">
			<div>
				<p class="eyebrow">Aave Protocol v3 · Live Rates</p>
				<h1>Track supply & borrow yields</h1>
				<p class="lede">
					Pull historical APY data directly from the public Aave API and visualize how variable rates shift across
					top reserves.
				</p>
			</div>
			<div class="meta">
				<p>
					Latest sample:
					<span data-updated>—</span>
				</p>
				<p class="note">Data is returned in RAY (1e27) and converted to APY % client-side.</p>
			</div>
		</header>

		<div class="controls">
			<label class="control">
				<span>Market reserve</span>
				<select id="reserve-select">
					{reserves.map((reserve) => (
						<option value={reserve.reserveId} selected={reserve.reserveId === defaultReserve.reserveId}>
							{reserve.label}
						</option>
					))}
				</select>
			</label>

			<label class="control">
				<span>Lookback window</span>
				<select id="window-select">
					{windows.map((window) => (
						<option value={window.value} selected={window.value === DEFAULT_WINDOW_DAYS}>{window.label}</option>
					))}
				</select>
			</label>
		</div>

		<details class="custom">
			<summary>Load any other market</summary>
			<p class="custom__help">
				Copy the pool identifier (e.g. <code>arbitrum_v3</code>) and reserve address from the
				<a href="https://docs.aave.com/developers/deployed-contracts/deployed-contracts" target="_blank" rel="noreferrer">
					Aave docs
				</a>
				or your own registry. Paste them below to fetch rates without editing code.
			</p>
			<div class="custom__grid">
				<label class="control">
					<span>Pool ID</span>
					<input id="custom-pool" placeholder="e.g. polygon_v3" />
				</label>
				<label class="control">
					<span>Reserve address</span>
					<input id="custom-reserve" placeholder="0x…" />
				</label>
				<label class="control">
					<span>Label (optional)</span>
					<input id="custom-label" placeholder="USDC · Optimism" />
				</label>
				<button type="button" class="custom__button" id="custom-load">Load market</button>
			</div>
		</details>

		<p class="status" data-status>Loading rates...</p>
		<div class="chart-shell">
			<canvas id="aave-rate-chart" width="600" height="360" aria-label="Interest rate chart" role="img"></canvas>
		</div>
		<ul class="legend">
			<li>
				<span class="dot supply"></span>
				<div>
					<p>Supply APY</p>
					<small>Earned by depositors</small>
				</div>
			</li>
			<li>
				<span class="dot variable"></span>
				<div>
					<p>Variable borrow APY</p>
					<small>Dynamic rate borrowers pay</small>
				</div>
			</li>
			<li>
				<span class="dot stable"></span>
				<div>
					<p>Stable borrow APY</p>
					<small>Optional fixed-style rate</small>
				</div>
			</li>
		</ul>
	</div>

	<script type="application/json" id="reserve-data" set:html={JSON.stringify(reserves)}></script>
</section>

<script type="module" src={chartScript}></script>

<style>
	:global(body) {
		font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		background: radial-gradient(circle at top, #141727 0%, #090b12 55%);
		color: #f4f7ff;
		min-height: 100vh;
	}

	.page {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.panel {
		width: min(960px, 100%);
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
		border-radius: 24px;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.panel__header {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	@media (min-width: 720px) {
		.panel__header {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
			gap: 2rem;
		}
	}

	h1 {
		margin: 0.25rem 0;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
	}

	.lede {
		margin: 0;
		color: rgba(255, 255, 255, 0.82);
		max-width: 540px;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.16em;
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.6);
		margin: 0;
	}

	.meta {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.72);
	}

	.meta .note {
		margin-top: 0.4rem;
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.6);
	}

	.controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.controls {
			flex-direction: row;
		}
	}

	.control {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.86);
		flex: 1;
	}

	.custom {
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 16px;
		padding: 0.75rem 1rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.custom summary {
		cursor: pointer;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.custom__help {
		margin: 0 0 0.75rem;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.7);
	}

	.custom__help a {
		color: #78a1ff;
	}

	.custom__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.75rem;
		align-items: end;
	}

	.custom__button {
		align-self: stretch;
		padding: 0.85rem 1rem;
		border-radius: 12px;
		border: none;
		background: #2d7cf7;
		color: white;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.25s ease;
	}

	.custom__button:hover {
		background: #1b5ed6;
	}

	select {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		backdrop-filter: blur(6px);
		color: #fff;
		padding: 0.65rem 0.9rem;
		font-size: 1rem;
		border-radius: 12px;
	}

	select:focus {
		outline: 2px solid rgba(54, 153, 255, 0.8);
		outline-offset: 1px;
	}

	input {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		backdrop-filter: blur(6px);
		color: #fff;
		padding: 0.65rem 0.9rem;
		font-size: 1rem;
		border-radius: 12px;
	}

	input::placeholder {
		color: rgba(255, 255, 255, 0.55);
	}

	input:focus {
		outline: 2px solid rgba(54, 153, 255, 0.8);
		outline-offset: 1px;
	}

	.status {
		margin: 0;
		font-size: 0.95rem;
		padding: 0.75rem 1rem;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.status[data-mode='error'] {
		border-color: rgba(255, 107, 107, 0.6);
		color: #ff9b9b;
	}

	.status[data-mode='success'] {
		border-color: rgba(62, 194, 160, 0.6);
		color: #93ffd8;
	}

	.chart-shell {
		width: 100%;
		height: 360px;
	}

	.legend {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 1rem;
	}

	.legend li {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		padding: 0.75rem;
		border-radius: 12px;
	}

	.legend p {
		margin: 0;
		font-weight: 600;
		font-size: 0.95rem;
	}

	.legend small {
		color: rgba(255, 255, 255, 0.65);
	}

	.dot {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		display: inline-block;
	}

	.dot.supply {
		background: #2d7cf7;
		box-shadow: 0 0 16px rgba(45, 124, 247, 0.5);
	}

	.dot.variable {
		background: #ff6a3d;
		box-shadow: 0 0 16px rgba(255, 106, 61, 0.5);
	}

	.dot.stable {
		background: #8f43ee;
		box-shadow: 0 0 16px rgba(143, 67, 238, 0.5);
	}
</style>
