      flex: 1;
      text-decoration: none;
      font-size: 0.8rem;
      padding: 0.55rem;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      color: white;
      transition: all 0.2s ease;
      text-align: center;
    }

    .hero-links a:hover {
      background: rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
    }

    .faq-list {
      display: grid;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }

    .faq-question {
      width: 100%;
      text-align: left;
      padding: 0.85rem 1rem;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      font-size: 0.98rem;
      cursor: pointer;
      transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .faq-question:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.28);
      transform: translateY(-1px);
    }

    /* modal */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    .welcome-modal {
      display: none;
    }

    .welcome-modal.is-open {
      display: flex;
    }

    .modal-content {
      background: #121212;
      color: #ffffff;
      max-width: 600px;
      width: 90%;
      padding: 2rem;
      border-radius: 14px;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
      position: relative;
      animation: modalFadeIn 0.3s ease;
    }

    .modal-close {
      position: absolute;
      top: 12px;
      right: 14px;
      background: none;
      border: none;
      font-size: 1.5rem;
      color: #aaa;
      cursor: pointer;
    }

    .modal-close:hover {
      color: #fff;
    }

    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: scale(0.95);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
  </style>

  <script>
    const modals = Array.from(document.querySelectorAll(".welcome-modal"));

    /** @param {Event} event */
    function closeWelcomeModal(event:any) {
      const targetModal =
        event?.currentTarget instanceof HTMLElement
          ? event.currentTarget.closest(".welcome-modal")
          : null;

      if (targetModal) {
        targetModal.classList.remove("is-open");
      }
    }

    document.querySelectorAll("[data-modal]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const id = trigger.getAttribute("data-modal");
        if (!id) return;
        const modal = document.getElementById(id);
        if (modal) {
          modal.classList.add("is-open");
        }
      });
    });
  </script>
</section>
