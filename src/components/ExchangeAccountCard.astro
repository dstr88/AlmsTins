---
type Props = {
	accountId: string;
	accountIndex: number;
	name: string;
	source: string;
};

const { accountId, accountIndex, name, source } = Astro.props as Props;
const hasHoldings = Astro.slots.has('holdings');
---

<div class="exchange-account" data-account-index={accountIndex}>
	<div class="exchange-account__row">
		<input
			class="exchange-account__name"
			type="text"
			value={name}
			data-account-id={accountId}
			data-exchange-source={source}
			placeholder={`Account #${accountIndex}`}
		/>
	</div>
	<form
		class="exchange-account__upload"
		data-account-id={accountId}
		data-account-index={accountIndex}
		data-exchange-source={source}
	>
		<label class="exchange-account__file">
			<input type="file" name="file" accept=".csv" required />
			<span>Choose CSV</span>
		</label>
		<button type="submit" class="exchange-account__button">Upload</button>
		<span class="exchange-account__status" aria-live="polite"></span>
	</form>
	<div class="exchange-holdings">
		<div class="exchange-holdings__summary">
			<span class="exchange-holdings__summary-label">Total crypto holdings</span>
			<span class="exchange-holdings__summary-value" data-holdings-total-usd>$0.00</span>
		</div>
		<div class="exchange-holdings__head">
			<span>Days</span>
			<span>Ticker</span>
			<span>Amount</span>
			<span>USD value</span>
			<span>Profit/Loss</span>
		</div>
		{hasHoldings ? <slot name="holdings" /> : <div class="exchange-holdings__empty">No holdings yet.</div>}
	</div>
</div>

<script>
	if (document.documentElement.dataset.exchangeHoldingsTotalsInit !== 'true') {
		document.documentElement.dataset.exchangeHoldingsTotalsInit = 'true';

		const parseUsd = (value) => {
			if (!value) return 0;
			const cleaned = value.replace(/[$,]/g, '').trim();
			const num = Number.parseFloat(cleaned);
			return Number.isFinite(num) ? num : 0;
		};

		const updateTotalForAccount = (accountEl) => {
			const totalEl = accountEl.querySelector('[data-holdings-total-usd]');
			if (!totalEl) return;
			let total = 0;
			let hasValue = false;
			accountEl.querySelectorAll('.exchange-holdings__row').forEach((row) => {
				const usdSpan = row.querySelector('.usd-value') ?? row.querySelector('span:nth-child(4)');
				if (!usdSpan) return;
				const value = parseUsd(usdSpan.textContent ?? '');
				if (value > 0) hasValue = true;
				total += value;
			});
			totalEl.textContent = hasValue
				? total.toLocaleString('en-US', { style: 'currency', currency: 'USD' })
				: 'No funds yet';
		};

		const observeHoldings = () => {
			document.querySelectorAll('.exchange-account').forEach((accountEl) => {
				const holdings = accountEl.querySelector('.exchange-holdings');
				if (!holdings) return;
				updateTotalForAccount(accountEl);
				const observer = new MutationObserver(() => updateTotalForAccount(accountEl));
				observer.observe(holdings, { childList: true, subtree: true, characterData: true });
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', observeHoldings);
		} else {
			observeHoldings();
		}
	}
</script>

<style>
	.exchange-account {
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 12px;
		padding: var(--space-sm);
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		background: rgba(0, 0, 0, 0.18);
	}

	.exchange-account__row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.exchange-account__name {
		border-radius: 0.65rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.08);
		color: inherit;
		padding: 0.4rem 0.65rem;
		font-size: 0.85rem;
		width: min(240px, 100%);
	}

	.exchange-account__upload {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.exchange-account__file {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.6rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		cursor: pointer;
		font-size: var(--font-sm);
	}

	.exchange-account__file input {
		display: none;
	}

	.exchange-account__button {
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.08);
		color: inherit;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		cursor: pointer;
		font-size: var(--font-sm);
	}

	.exchange-account__status {
		font-size: var(--font-sm);
		opacity: 0.7;
	}

	.exchange-holdings {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.exchange-holdings__head,
	.exchange-holdings__row {
		/* added gap to exchange data */
		display: grid;
		grid-template-columns:
			minmax(4ch, 0.65fr)
			minmax(6ch, 1fr)
			minmax(10ch, 1.1fr)
			minmax(12ch, 1.1fr)
			minmax(12ch, 1.1fr);
		column-gap: 2.75rem;
		align-items: baseline;
		font-size: var(--font-sm);
		padding: 0 0.5rem;
		font-variant-numeric: tabular-nums;
	}

	.exchange-holdings__head {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.7;
		font-size: 0.7rem;
	}

	.exchange-holdings__row {
		padding: 0.3rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.exchange-holdings__row span:nth-child(3),
	.exchange-holdings__row span:nth-child(4),
	.exchange-holdings__row span:nth-child(5) {
		text-align: right;
	}

	.exchange-holdings__head span:nth-child(5),
	.exchange-holdings__row span:nth-child(5) {
		padding-right: 3px;
	}

	.exchange-holdings__summary {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 0.1rem 0.25rem 0.4rem;
		font-size: var(--font-sm);
	}

	.exchange-holdings__summary-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.7;
		font-size: 0.7rem;
	}

	.exchange-holdings__summary-value {
		font-weight: 600;
	}

	.exchange-holdings__empty {
		font-size: var(--font-sm);
		opacity: 0.7;
	}

	.exchange-holdings__row .is-positive {
		color: #16a34a;
	}

	.exchange-holdings__row .is-negative {
		color: #f97316;
	}

	@media (max-width: 720px) {
		.exchange-holdings__head,
		.exchange-holdings__row {
			grid-template-columns: 1fr 0.8fr 1fr;
			row-gap: 0.3rem;
		}

		.exchange-holdings__head span:nth-child(4),
		.exchange-holdings__head span:nth-child(5),
		.exchange-holdings__row span:nth-child(4),
		.exchange-holdings__row span:nth-child(5) {
			display: none;
		}
	}
</style>
