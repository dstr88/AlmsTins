---
type Props = {
	accountId: string;
	accountIndex: number;
	name: string;
	source: string;
};

const { accountId, accountIndex, name, source } = Astro.props as Props;
const hasHoldings = Astro.slots.has('holdings');
---

<div class="exchange-account" data-account-index={accountIndex}>
	<div class="exchange-account__row">
		<input
			class="exchange-account__name"
			type="text"
			value={name}
			data-account-id={accountId}
			data-exchange-source={source}
			placeholder={`Account #${accountIndex}`}
		/>
		<button
			class="exchange-account__delete"
			type="button"
			data-exchange-delete
			data-account-id={accountId}
			data-exchange-source={source}
			aria-label="Delete account"
			title="Delete account"
		>✕</button>
	</div>
	<form
		class="exchange-account__upload"
		data-account-id={accountId}
		data-account-index={accountIndex}
		data-exchange-source={source}
	>
		<label class="exchange-account__file">
			<input type="file" name="file" accept=".csv" required />
			<span class="exchange-account__file-label">Choose CSV</span>
		</label>
		<button type="submit" class="exchange-account__button">Upload</button>
		<button
			type="button"
			class="exchange-account__button exchange-account__batches-toggle"
			data-batches-toggle
			data-account-id={accountId}
			data-exchange-source={source}
		>Batches</button>
		<span class="exchange-account__status" aria-live="polite"></span>
	</form>

	<div
		class="exchange-batches"
		data-batches-panel
		data-account-id={accountId}
		data-exchange-source={source}
		hidden
	>
		<div class="exchange-batches__list" data-batches-list>
			<span class="exchange-batches__loading">Loading…</span>
		</div>
	</div>
	<div class="exchange-holdings">
		<div class="exchange-holdings__summary">
			<span class="exchange-holdings__summary-label">Total crypto holdings</span>
			<span class="exchange-holdings__summary-value" data-holdings-total-usd>$0.00</span>
		</div>
		{hasHoldings ? (
			<div class="exchange-holdings__list">
				<slot name="holdings" />
			</div>
		) : (
			<div class="exchange-holdings__empty">No holdings yet.</div>
		)}
	</div>
</div>

<script>
	// ── Batch management ─────────────────────────────────────────────────────
	document.addEventListener('click', async (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;

		// Toggle batches panel
		const toggleBtn = target.closest('[data-batches-toggle]');
		if (toggleBtn instanceof HTMLElement) {
			const accountId = toggleBtn.dataset.accountId ?? '';
			const source = toggleBtn.dataset.exchangeSource ?? '';
			const panel = toggleBtn.closest('.exchange-account')?.querySelector('[data-batches-panel]');
			if (!(panel instanceof HTMLElement)) return;
			const isOpen = !panel.hidden;
			panel.hidden = isOpen;
			toggleBtn.textContent = isOpen ? 'Batches' : 'Hide batches';
			if (!isOpen) await loadBatches(panel, accountId, source);
			return;
		}

		// Delete a batch
		const delBtn = target.closest('[data-batch-delete]');
		if (delBtn instanceof HTMLElement) {
			const batchId = delBtn.dataset.batchId ?? '';
			const source = delBtn.dataset.exchangeSource ?? '';
			const panel = delBtn.closest('[data-batches-panel]');
			const accountId = panel instanceof HTMLElement ? (panel.dataset.accountId ?? '') : '';
			if (!batchId || !source) return;
			if (!confirm(`Delete this import batch (${delBtn.dataset.batchCount} rows)? This cannot be undone.`)) return;
			delBtn.textContent = '…';
			delBtn.setAttribute('disabled', '');
			try {
				const res = await fetch(
					`/api/import/batches?batchId=${encodeURIComponent(batchId)}&source=${encodeURIComponent(source)}`,
					{ method: 'DELETE' },
				);
				if (!res.ok) throw new Error('Delete failed');
				if (panel instanceof HTMLElement) await loadBatches(panel, accountId, source);
				setTimeout(() => window.location.reload(), 800);
			} catch (err) {
				delBtn.textContent = 'Error';
			}
		}
	});

	async function loadBatches(panel, accountId, source) {
		const list = panel.querySelector('[data-batches-list]');
		if (!list) return;
		list.innerHTML = '<span class="exchange-batches__loading">Loading…</span>';
		try {
			const res = await fetch(
				`/api/import/batches?accountId=${encodeURIComponent(accountId)}&source=${encodeURIComponent(source)}`,
			);
			const data = await res.json();
			const batches = data.batches ?? [];
			if (!batches.length) {
				list.innerHTML = '<span class="exchange-batches__loading">No import batches yet.</span>';
				return;
			}
			list.innerHTML = '';
			for (const b of batches) {
				const row = document.createElement('div');
				row.className = 'exchange-batch-row';
				const importedAt = b.importedAt ? new Date(b.importedAt).toLocaleDateString() : '—';
				const earliest = b.earliestTx ? new Date(b.earliestTx).toLocaleDateString() : '—';
				const latest = b.latestTx ? new Date(b.latestTx).toLocaleDateString() : '—';
				row.innerHTML = `
					<div class="exchange-batch-row__info">
						<span class="exchange-batch-row__count">${b.rowCount} rows</span>
						<span class="exchange-batch-row__range">${earliest} – ${latest}</span>
						<span class="exchange-batch-row__imported">imported ${importedAt}</span>
					</div>
					<button
						type="button"
						class="exchange-account__delete exchange-batch-row__delete"
						data-batch-delete
						data-batch-id="${b.batchId}"
						data-batch-count="${b.rowCount}"
						data-exchange-source="${source}"
						title="Delete this batch"
					>✕</button>
				`;
				list.appendChild(row);
			}
		} catch {
			list.innerHTML = '<span class="exchange-batches__loading">Failed to load batches.</span>';
		}
	}

	// Show selected filename in the Choose CSV label
	document.addEventListener('change', (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement) || input.type !== 'file') return;
		const label = input.closest('.exchange-account__file')?.querySelector('.exchange-account__file-label');
		if (!(label instanceof HTMLElement)) return;
		label.textContent = input.files?.[0]?.name ?? 'Choose CSV';
	});

	if (document.documentElement.dataset.exchangeHoldingsTotalsInit !== 'true') {
		document.documentElement.dataset.exchangeHoldingsTotalsInit = 'true';

		const parseUsd = (value) => {
			if (!value) return 0;
			const cleaned = value.replace(/[$,]/g, '').trim();
			const num = Number.parseFloat(cleaned);
			return Number.isFinite(num) ? num : 0;
		};

		const updateTotalForAccount = (accountEl) => {
			const totalEl = accountEl.querySelector('[data-holdings-total-usd]');
			if (!totalEl) return;
			let total = 0;
			let hasValue = false;
			accountEl.querySelectorAll('.exchange-holding').forEach((row) => {
				const usdSpan = row.querySelector('.usd-value');
				if (!usdSpan) return;
				const value = parseUsd(usdSpan.textContent ?? '');
				if (value > 0) hasValue = true;
				total += value;
			});
			totalEl.textContent = hasValue
				? total.toLocaleString('en-US', { style: 'currency', currency: 'USD' })
				: 'No funds yet';
		};

		const observeHoldings = () => {
			document.querySelectorAll('.exchange-account').forEach((accountEl) => {
				const holdings = accountEl.querySelector('.exchange-holdings');
				if (!holdings) return;
				updateTotalForAccount(accountEl);
				const observer = new MutationObserver(() => updateTotalForAccount(accountEl));
				observer.observe(holdings, { childList: true, subtree: true, characterData: true });
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', observeHoldings);
		} else {
			observeHoldings();
		}
	}
</script>

<style>
	.exchange-account {
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 12px;
		padding: var(--space-sm);
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		background: rgba(0, 0, 0, 0.18);
	}

	.exchange-account__row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.exchange-account__name {
		border-radius: 0.65rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.08);
		color: inherit;
		padding: 0.4rem 0.65rem;
		font-size: 0.85rem;
		width: min(240px, 100%);
	}

	.exchange-account__delete {
		margin-left: auto;
		border-radius: 999px;
		border: 1px solid rgba(239, 68, 68, 0.35);
		background: rgba(239, 68, 68, 0.08);
		color: #f87171;
		width: 1.75rem;
		height: 1.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		cursor: pointer;
		flex-shrink: 0;
		transition: background 0.15s, border-color 0.15s;
	}

	.exchange-account__delete:hover {
		background: rgba(239, 68, 68, 0.22);
		border-color: rgba(239, 68, 68, 0.7);
	}

	.exchange-account__upload {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.exchange-account__file {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.6rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		cursor: pointer;
		font-size: var(--font-sm);
	}

	.exchange-account__file input {
		display: none;
	}

	.exchange-account__button {
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.08);
		color: inherit;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		cursor: pointer;
		font-size: var(--font-sm);
	}

	.exchange-account__status {
		font-size: var(--font-sm);
		opacity: 1;
		font-weight: 500;
		flex-basis: 100%;
		min-height: 1.2em;
	}

	.exchange-batches {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding-top: var(--space-sm);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.exchange-batches__list {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.exchange-batches__loading {
		font-size: var(--font-sm);
		opacity: 0.6;
	}

	:global(.exchange-batch-row) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.4rem 0.5rem;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	:global(.exchange-batch-row__info) {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	:global(.exchange-batch-row__count) {
		font-size: 0.8rem;
		font-weight: 600;
	}

	:global(.exchange-batch-row__range) {
		font-size: 0.75rem;
		opacity: 0.8;
	}

	:global(.exchange-batch-row__imported) {
		font-size: 0.7rem;
		opacity: 0.5;
	}

	:global(.exchange-batch-row__delete) {
		flex-shrink: 0;
	}

	.exchange-holdings {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.exchange-holdings__list {
		max-height: 280px;
		overflow-y: auto;
		padding-right: 0.25rem;
	}

	:global(.exchange-holding) {
		padding: 0.6rem 0.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		margin-bottom: 0.65rem;
	}

	:global(.exchange-holding:last-child) {
		margin-bottom: 0;
		border-bottom: none;
	}

	:global(.exchange-holding__row) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
		align-items: baseline;
		font-size: var(--font-sm);
		font-variant-numeric: tabular-nums;
	}

	:global(.exchange-holding__row--bottom) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 0.35rem;
	}

	:global(.exchange-holding__field) {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	:global(.exchange-holding__field--numeric) {
		text-align: right;
		align-items: flex-end;
	}

	:global(.exchange-holding__label) {
		display: block;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.7;
	}

	:global(.exchange-holding__value) {
		display: block;
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
	}

	:global(.exchange-holding__value--truncate) {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.exchange-holdings__summary {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 0.1rem 0.25rem 0.4rem;
		font-size: var(--font-sm);
	}

	.exchange-holdings__summary-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.7;
		font-size: 0.7rem;
	}

	.exchange-holdings__summary-value {
		font-weight: 600;
	}

	.exchange-holdings__empty {
		font-size: var(--font-sm);
		opacity: 0.7;
	}

	:global(.exchange-holding .is-positive) {
		color: #16a34a;
	}

	:global(.exchange-holding .is-negative) {
		color: #f97316;
	}

	@media (max-width: 720px) {
		.exchange-holdings {
			max-height: 16rem;
			overflow-y: auto;
		}

		:global(.exchange-holding__row) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		:global(.exchange-holding__row--bottom) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
