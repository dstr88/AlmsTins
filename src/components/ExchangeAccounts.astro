---
import ExchangeTin from '@/components/dashboard/ExchangeTin.astro';
import ExchangeAccountCard from '@/components/ExchangeAccountCard.astro';
import { db } from '@/lib/db';
import { requireTenantSession } from '@/lib/requireTenantSession';
import { getTickersUSD } from '@/lib/coinpaprikaProvider';
import { formatCurrency, formatDaysSince, formatNumber } from '@/lib/exchangeTin';
import { sanitizeSymbols } from '@/lib/prices/sanitizeSymbols';

type AccountRow = { id: string; name: string };

type ImportRow = {
	timestamp_utc: string;
	asset_symbol: string | null;
	direction: string | null;
	currency: string | null;
	amount: number | null;
	to_currency: string | null;
	to_amount: number | null;
	native_usd: number | null;
	kind: string | null;
	description: string | null;
};

type Holding = {
	symbol: string;
	balance: number;        // liquid (not in staking)
	staked: number;         // currently locked in staking
	stakingYtd: number;     // coins earned from staking this calendar year
	stakingYtdUsd: number | null; // USD value of YTD staking income
	lastPurchaseAt: string | null;
	costBasis: number | null;
};

type AccountWithHoldings = AccountRow & { holdings: Holding[] };

type DbRow = Record<string, unknown>;

const toStr = (v: unknown) => (typeof v === 'string' ? v : '');
const toStrOrNull = (v: unknown) => (typeof v === 'string' ? v : null);
const toNumOrNull = (v: unknown) => (typeof v === 'number' ? v : null);

const toAccountRow = (row: unknown): AccountRow | null => {
	if (!row || typeof row !== 'object') return null;
	const r = row as DbRow;
	return { id: toStr(r.id), name: toStr(r.name) };
};

const toImportRow = (row: unknown): ImportRow | null => {
	if (!row || typeof row !== 'object') return null;
	const r = row as DbRow;
	return {
		timestamp_utc: toStr(r.timestamp_utc),
		asset_symbol: toStrOrNull(r.asset_symbol),
		direction: toStrOrNull(r.direction),
		currency: toStrOrNull(r.currency),
		amount: toNumOrNull(r.amount),
		to_currency: toStrOrNull(r.to_currency),
		to_amount: toNumOrNull(r.to_amount),
		native_usd: toNumOrNull(r.native_usd),
		kind: toStrOrNull(r.kind),
		description: toStrOrNull(r.description),
	};
};

const parseNum = (v: unknown) => {
	if (typeof v === 'number') return Number.isFinite(v) ? v : null;
	if (typeof v === 'string') { const n = Number(v.replace(/,/g, '')); return Number.isFinite(n) ? n : null; }
	return null;
};

const normalizeSymbol = (s: string) => {
	const u = s.trim().toUpperCase();
	if (u === 'MATIC' || u === 'WMATIC') return 'POL';
	return u;
};

const pickSymbol = (row: ImportRow) => row.asset_symbol || row.to_currency || row.currency || '';
const pickQty = (row: ImportRow) => {
	const sym = pickSymbol(row);
	if (!sym) return null;
	if (row.to_currency && sym === row.to_currency) return row.to_amount;
	if (row.currency && sym === row.currency) return row.amount;
	return row.to_amount ?? row.amount;
};

const CURRENT_YEAR = String(new Date().getFullYear()); // e.g. '2026'

const computeHoldings = (rows: ImportRow[]): Holding[] => {
	const balanceMap      = new Map<string, number>();   // liquid
	const stakedMap       = new Map<string, number>();   // in staking custody
	const stakingYtdMap   = new Map<string, number>();   // coins earned from staking this year
	const stakingYtdUsdMap= new Map<string, number>();   // USD value of YTD staking income
	const lastPurchaseMap = new Map<string, string>();
	const lastSeenMap     = new Map<string, string>();
	const lotsMap = new Map<string, Array<{ qty: number; cost: number }>>();
	const unknownCost = new Set<string>();

	for (const row of rows) {
		const raw = pickSymbol(row);
		if (!raw) continue;
		const sym = normalizeSymbol(raw);
		if (row.timestamp_utc) lastSeenMap.set(sym, row.timestamp_utc);
		const qtyRaw = parseNum(pickQty(row));
		if (qtyRaw === null || qtyRaw === 0) continue;
		const qty = Math.abs(qtyRaw);
		const dir = row.direction ?? (qtyRaw < 0 ? 'out' : 'in');
		const kindLower = (row.kind ?? '').toLowerCase();

		// ── Staking transfer (Coinbase) ──────────────────────────────────────
		// Positive 'Retail Staking Transfer': asset moved from liquid → staking.
		// Positive 'Retail Unstaking Transfer': asset returned from staking → liquid.
		const isStakingIn   = kindLower.includes('retail staking transfer')   && dir === 'in';
		const isUnstakingIn = kindLower.includes('retail unstaking transfer') && dir === 'in';

		if (isStakingIn) {
			// Move from liquid to staked — do NOT add to liquid balance
			stakedMap.set(sym, (stakedMap.get(sym) ?? 0) + qty);
		} else if (isUnstakingIn) {
			// Move from staked back to liquid
			balanceMap.set(sym, (balanceMap.get(sym) ?? 0) + qty);
			stakedMap.set(sym, Math.max(0, (stakedMap.get(sym) ?? 0) - qty));
			lastPurchaseMap.set(sym, row.timestamp_utc);
		} else if (dir === 'in') {
			balanceMap.set(sym, (balanceMap.get(sym) ?? 0) + qty);
			lastPurchaseMap.set(sym, row.timestamp_utc);
			const cost = parseNum(row.native_usd);
			if (cost === null) { unknownCost.add(sym); }
			else { const lots = lotsMap.get(sym) ?? []; lots.push({ qty, cost: Math.abs(cost) }); lotsMap.set(sym, lots); }

			// ── Staking income earned this calendar year ─────────────────────
			if (kindLower === 'staking income' && row.timestamp_utc.startsWith(CURRENT_YEAR)) {
				stakingYtdMap.set(sym, (stakingYtdMap.get(sym) ?? 0) + qty);
				const usd = parseNum(row.native_usd);
				if (usd !== null) stakingYtdUsdMap.set(sym, (stakingYtdUsdMap.get(sym) ?? 0) + Math.abs(usd));
			}
		} else if (dir === 'out' || dir === 'lost') {
			balanceMap.set(sym, (balanceMap.get(sym) ?? 0) - qty);
			const lots = lotsMap.get(sym);
			if (lots?.length) {
				let rem = qty;
				while (rem > 0 && lots.length) {
					const lot = lots[0];
					if (lot.qty <= rem) { rem -= lot.qty; lots.shift(); }
					else { const r = rem / lot.qty; lot.qty -= rem; lot.cost -= lot.cost * r; rem = 0; }
				}
			}
		}
	}

	const seenSyms = new Set<string>([...balanceMap.keys(), ...stakedMap.keys(), ...stakingYtdMap.keys()]);
	const out: Holding[] = [];
	for (const sym of seenSyms) {
		let bal    = balanceMap.get(sym) ?? 0;
		let staked = stakedMap.get(sym)  ?? 0;

		// If sends exceeded liquid balance, the deficit was drawn from staked.
		// Coinbase doesn't emit an explicit unstaking event in this case.
		if (bal < 0 && staked > 0) {
			const draw = Math.min(staked, Math.abs(bal));
			staked -= draw;
			bal    += draw;
		}
		bal    = Math.max(0, bal);
		staked = Math.max(0, staked);
		const stakingYtd    = stakingYtdMap.get(sym)    ?? 0;
		const stakingYtdUsd = stakingYtdUsdMap.get(sym) ?? null;
		if (bal <= 0 && staked <= 0 && stakingYtd <= 0) continue;
		const lots = lotsMap.get(sym) ?? [];
		out.push({
			symbol: sym,
			balance: Math.max(0, bal),
			staked,
			stakingYtd,
			stakingYtdUsd: stakingYtdUsdMap.has(sym) ? (stakingYtdUsd ?? 0) : null,
			lastPurchaseAt: lastPurchaseMap.get(sym) ?? lastSeenMap.get(sym) ?? null,
			costBasis: unknownCost.has(sym) || !lots.length ? null : lots.reduce((s, l) => s + l.cost, 0),
		});
	}
	return out.sort((a, b) => (b.balance + b.staked) - (a.balance + a.staked));
};

const { source, title } = Astro.props as { source: string; title: string };
const { tenantId } = await requireTenantSession(Astro.request);

const accountsResult = await db.execute({
	sql: `SELECT id, name FROM exchange_accounts WHERE tenant_id = ? AND source = ? ORDER BY created_at ASC`,
	args: [tenantId, source],
});

const accounts = accountsResult.rows.map(toAccountRow).filter((r): r is AccountRow => r !== null);
const priceSymbols = new Set<string>();

const accountsWithHoldings: AccountWithHoldings[] = [];
for (const account of accounts) {
	const txResult = await db.execute({
		sql: `SELECT timestamp_utc, asset_symbol, direction, currency, amount, to_currency, to_amount, native_usd, kind, description
			FROM import_transactions
			WHERE tenant_id = ? AND source = ? AND account_id = ?
			ORDER BY timestamp_utc ASC`,
		args: [tenantId, source, account.id],
	});
	const rows = txResult.rows.map(toImportRow).filter((r): r is ImportRow => r !== null);
	const holdings = computeHoldings(rows);
	holdings.forEach((h) => priceSymbols.add(h.symbol));
	accountsWithHoldings.push({ ...account, holdings });
}

const priceMap: Record<string, number> = {};
if (priceSymbols.size) {
	const tickers = (await getTickersUSD()) as Array<{ symbol?: string; quotes?: { USD?: { price?: number } } }>;
	const syms = new Set(sanitizeSymbols(Array.from(priceSymbols)));
	for (const t of tickers) {
		const sym = String(t.symbol ?? '').trim().toUpperCase();
		if (syms.has(sym) && typeof t.quotes?.USD?.price === 'number') priceMap[sym] = t.quotes.USD.price;
	}
}

// "Data through" — most recent transaction timestamp in imported data for this source
const freshnessResult = await db.execute({
	sql: `SELECT MAX(timestamp_utc) as data_through, MAX(created_at) as last_imported
	      FROM import_transactions WHERE tenant_id = ? AND source = ?`,
	args: [tenantId, source],
});
const freshnessRow = freshnessResult.rows[0] as Record<string, unknown> | undefined;
const dataThrough = (freshnessRow?.data_through as string | null) ?? null;
const lastImported = (freshnessRow?.last_imported as string | null) ?? null;
---

<ExchangeTin title={title} class="tile tile--exchange" dataThrough={dataThrough} lastImported={lastImported}>
	<button slot="header-actions" type="button" class="exchange-tin__add" data-exchange-add data-exchange-source={source}>
		Add account
	</button>

	{accountsWithHoldings.length ? (
		<div class="exchange-accounts__list">
			{accountsWithHoldings.map((account, index) => {
				const accountIndex = index + 1;
				return (
					<ExchangeAccountCard
						accountId={account.id}
						accountIndex={accountIndex}
						name={account.name}
						source={source}
					>
						{account.holdings.length ? (
							<div slot="holdings">
								{account.holdings.map((holding) => {
									const price = priceMap[holding.symbol] ?? 0;
									const totalCoins = holding.balance + holding.staked;
								const usdValue = price > 0 ? totalCoins * price : null;
									const pnl = price > 0 && holding.costBasis !== null ? usdValue! - holding.costBasis : null;
									const pnlClass = pnl !== null && pnl >= 0 ? 'is-positive' : 'is-negative';
									return (
										<div class="exchange-holding">
											<div class="exchange-holding__row exchange-holding__row--top">
												<div class="exchange-holding__field">
													<span class="exchange-holding__label">Days</span>
													<span class="exchange-holding__value">{formatDaysSince(holding.lastPurchaseAt) ?? '—'}</span>
												</div>
												<div class="exchange-holding__field">
													<span class="exchange-holding__label">Ticker</span>
													<span class="exchange-holding__value exchange-holding__value--truncate">{holding.symbol}</span>
												</div>
												<div class="exchange-holding__field exchange-holding__field--numeric">
													<span class="exchange-holding__label">Coins</span>
													<span class="exchange-holding__value">{formatNumber(holding.balance, { maximumFractionDigits: 2 })}</span>
												</div>
											</div>
											<div class="exchange-holding__row exchange-holding__row--bottom">
												<div class="exchange-holding__field exchange-holding__field--numeric">
													<span class="exchange-holding__label">USD value</span>
													<span class="exchange-holding__value usd-value">{usdValue === null ? '—' : formatCurrency(usdValue)}</span>
												</div>
												<div class="exchange-holding__field exchange-holding__field--numeric">
													<span class="exchange-holding__label">P/L</span>
													<span class={`exchange-holding__value ${pnl === null ? '' : pnlClass}`}>{pnl === null ? '—' : formatCurrency(pnl)}</span>
												</div>
											</div>
											{(holding.staked > 0 || holding.stakingYtd > 0) && (
												<div class="exchange-holding__row exchange-holding__row--staking">
													{holding.staked > 0 && (
														<div class="exchange-holding__field exchange-holding__field--numeric">
															<span class="exchange-holding__label">🔒 Staked</span>
															<span class="exchange-holding__value">
																{formatNumber(holding.staked, { maximumFractionDigits: 8 })}
															</span>
														</div>
													)}
													{holding.stakingYtd > 0 && (
														<div class="exchange-holding__field exchange-holding__field--numeric">
															<span class="exchange-holding__label">Earned {CURRENT_YEAR}</span>
															<span class="exchange-holding__value">
																{formatNumber(holding.stakingYtd, { maximumFractionDigits: 8 })}
																{holding.stakingYtdUsd !== null && (
																	<span class="exchange-holding__staking-usd"> ({formatCurrency(holding.stakingYtdUsd)})</span>
																)}
															</span>
														</div>
													)}
												</div>
											)}
										</div>
									);
								})}
							</div>
						) : null}
					</ExchangeAccountCard>
				);
			})}
		</div>
	) : (
		<p class="exchange-accounts__empty">No accounts yet.</p>
	)}
</ExchangeTin>

<script>
	if (document.documentElement.dataset.exchangeAccountsInit !== 'true') {
		document.documentElement.dataset.exchangeAccountsInit = 'true';

		document.addEventListener('click', async (event) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;

			// ── Add account ───────────────────────────────────────────────
			const addBtn = target.closest('[data-exchange-add]');
			if (addBtn instanceof HTMLElement) {
				const source = addBtn.dataset.exchangeSource ?? '';
				if (!source) return;
				try {
					const response = await fetch(`/api/exchanges/${source}/accounts`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({}),
					});
					if (!response.ok) throw new Error('Failed to create account.');
					window.location.reload();
				} catch (error) {
					console.error(error);
				}
				return;
			}

			// ── Delete account ────────────────────────────────────────────
			const delBtn = target.closest('[data-exchange-delete]');
			if (delBtn instanceof HTMLElement) {
				const accountId = delBtn.dataset.accountId ?? '';
				const source = delBtn.dataset.exchangeSource ?? '';
				if (!accountId || !source) return;
				if (!confirm('Delete this account and all its imported transactions? This cannot be undone.')) return;
				try {
					const response = await fetch(`/api/exchanges/${source}/accounts/delete`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ accountId }),
					});
					if (!response.ok) throw new Error('Failed to delete account.');
					window.location.reload();
				} catch (error) {
					console.error(error);
				}
			}
		});

		document.addEventListener(
			'blur',
			async (event) => {
				const target = event.target;
				if (!(target instanceof HTMLInputElement) || !target.classList.contains('exchange-account__name')) {
					return;
				}
				const accountId = target.dataset.accountId ?? '';
				const source = target.dataset.exchangeSource ?? '';
				const name = target.value.trim();
				if (!accountId || !name || !source) return;
				try {
					await fetch(`/api/exchanges/${source}/accounts/update`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ accountId, name }),
					});
				} catch (error) {
					console.error(error);
				}
			},
			true,
		);

		document.addEventListener('submit', async (event) => {
			const form = event.target;
			if (!(form instanceof HTMLFormElement) || !form.classList.contains('exchange-account__upload')) {
				return;
			}
			event.preventDefault();
			const status = form.querySelector('.exchange-account__status');
			const fileInput = form.querySelector('input[type="file"]');
			const accountId = form.dataset.accountId ?? '';
			const source = form.dataset.exchangeSource ?? '';

			if (!fileInput || !(fileInput instanceof HTMLInputElement) || !fileInput.files?.[0]) {
				if (status instanceof HTMLElement) status.textContent = 'Select a CSV file first.';
				return;
			}

			if (status instanceof HTMLElement) status.textContent = 'Uploading...';
			const data = new FormData();
			data.append('file', fileInput.files[0]);
			data.append('accountId', accountId);

			try {
				const response = await fetch(`/api/import/${source}`, {
					method: 'POST',
					body: data,
				});
				const payload = await response.json();
				if (!response.ok) {
					throw new Error(payload?.error || 'Upload failed.');
				}
				if (status instanceof HTMLElement) {
					const msg = payload.insertedNormalized === 0
						? `⚠️ No new rows — ${payload.skippedDuplicates} duplicates skipped (already imported).`
						: `✅ Imported ${payload.insertedNormalized} rows, skipped ${payload.skippedDuplicates} duplicates.`;
					status.textContent = msg;
				}
				setTimeout(() => window.location.reload(), 3000);
			} catch (error) {
				if (status instanceof HTMLElement) {
					status.textContent = error instanceof Error ? error.message : 'Upload failed.';
				}
			}
		});
	}
</script>

<style>
	.exchange-accounts__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.exchange-accounts__empty {
		margin: 0;
		font-size: var(--font-sm);
		opacity: 0.7;
	}
</style>

<style>
	.exchange-holding__row--staking {
		display: flex;
		gap: var(--space-sm);
		padding-top: var(--space-xs, 0.25rem);
		border-top: 1px dashed color-mix(in srgb, currentColor 20%, transparent);
		font-size: var(--font-xs, 0.7rem);
		opacity: 0.8;
	}

	.exchange-holding__staking-usd {
		opacity: 0.7;
	}
</style>
