<script>
  // Agent tile demo: genuinely live, hits the real free/anonymous check endpoint —
  // no mock here, unlike the store-owner tile below, since this is exactly what an
  // agent developer landing on this tile would want to see actually work.
  const agentBtn = document.getElementById('agent-demo-btn') as HTMLButtonElement | null;
  const agentAddr = document.getElementById('agent-demo-addr') as HTMLInputElement | null;
  const agentDomain = document.getElementById('agent-demo-domain') as HTMLInputElement | null;
  const agentResult = document.getElementById('agent-demo-result') as HTMLElement | null;
  agentBtn?.addEventListener('click', async () => {
    const value = agentAddr?.value.trim();
    if (!value || !agentResult) return;
    const domain = agentDomain?.value.trim();
    agentBtn.disabled = true;
    agentResult.hidden = false;
    agentResult.textContent = '…';
    try {
      const url = new URL('/api/verify/check', window.location.origin);
      url.searchParams.set('value', value);
      if (domain) url.searchParams.set('expect', domain);
      const res = await fetch(url.toString());
      const data = await res.json();
      agentResult.textContent = JSON.stringify(data, null, 2);
    } catch {
      agentResult.textContent = '{ "error": "could not reach the check endpoint" }';
    } finally {
      agentBtn.disabled = false;
    }
  });

  // Store-owner tile demo: deliberately mocked, never a real network call — this tile
  // is about showing what claiming a wallet will look like, not checking a real address
  // (that would misleadingly suggest pasting any address here proves something).
  const storeBtn = document.getElementById('store-demo-btn') as HTMLButtonElement | null;
  const storeAddr = document.getElementById('store-demo-addr') as HTMLInputElement | null;
  const storeResult = document.getElementById('store-demo-result') as HTMLElement | null;
  storeBtn?.addEventListener('click', () => {
    if (!storeAddr?.value.trim() || !storeResult) return;
    storeBtn.disabled = true;
    storeResult.hidden = true;
    setTimeout(() => {
      storeResult.hidden = false;
      storeBtn.disabled = false;
    }, 500);
  });
</script>
