---
import LoginLayout from '../layouts/LoginLayout.astro';
import AlmstinsLogo from '../assets/logo.jpeg';
import VerifyLogo from '../assets/verify-logo.svg?url';
import { copy, LANGS, BRAND, BRAND_QUOTE, ALMSTINS_URL, type Lang } from '../i18n/verify';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];

const title = `${BRAND} — ${t.meta.tagline}`;
const here = LANGS.find((l) => l.code === lang) ?? LANGS[0];
const canonical = `https://almstins.com${here.href}`;

// Every Verify level lives behind the Verify login. It is titled for Verify and
// returns the merchant to their dashboard (the general /login would land them on
// the tracker vault). Already signed in, it forwards straight to the dashboard.
const LOGIN_HREF = '/verify/login?next=/dashboard/verify';

// Language-neutral integration contract shown to exchanges (code, not translated).
// The path is a deliberately UNBRANDED well-known URI — the standard must not carry
// a vendor's name. Legacy /almstins/addresses endpoints keep working unchanged.
const EXCHANGE_CONTRACT = `GET  https://<your-domain>/.well-known/payment-addresses
Authorization: Bearer <your-key>

200 OK
{
  "addresses": [
    { "address": "0xA1b2…", "chain": "ethereum" },
    { "address": "bc1q…",   "chain": "bitcoin"  }
  ]
}`;
---

<LoginLayout title={title} description={t.meta.description} noindex={false} lang={lang} canonical={canonical} favicon="/favicon-verify.png">

  <!-- Per-language SEO alternates -->
  <Fragment slot="head">
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l.code} href={`https://almstins.com${l.href}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://almstins.com/verify" />
  </Fragment>

  <!-- JSON-LD: WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: BRAND,
    url: canonical,
    description: t.jsonld.description,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    creator: { '@type': 'Organization', name: 'Almstins', url: 'https://almstins.com' },
    featureList: t.jsonld.featureList,
  })} />

  <!-- Top nav -->
  <nav class="vnav" aria-label="Almstins">
    <a class="vnav__brand" href="/" aria-label={t.nav.brandAria}>
      <span class="vnav__wordmark">{BRAND}</span>
      <span class="vnav__tagline">{t.nav.tagline}</span>
    </a>
    <div class="vnav__right">
      <div class="vnav__langs" aria-label="Language">
        {LANGS.map((l) => (
          <a class="vnav__lang" href={l.href} hreflang={l.code} aria-label={l.aria}
             aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a>
        ))}
      </div>
      <a class="vnav__logo" href="/" aria-label={t.nav.brandAria}>
        <img src={AlmstinsLogo.src} alt="AlmsTins" width="960" height="1104" loading="eager" decoding="async" />
      </a>
    </div>
  </nav>

  <div class="vpage">

    <!-- Section 1 — Hero -->
    <header class="vhero">
      <img class="vhero__mark" src={VerifyLogo} width="150" height="150" alt="Almstins Verify" loading="eager" decoding="async" />
      <div class="vhero__eyebrow">{t.hero.eyebrow}</div>
      <h1 class="vhero__title">{t.hero.title}</h1>
      <p class="vhero__sub">{t.hero.sub}</p>
      <div class="vhero__ctas">
        <a class="vbtn" href={LOGIN_HREF}>{t.hero.ctaPrimary}</a>
        <a class="vbtn vbtn--demo" href="/api/demo/start?next=/dashboard/verify" rel="nofollow">{t.hero.ctaDemo}</a>
        <a class="vbtn vbtn--ghost" href="#how">{t.hero.ctaSecondary}</a>
      </div>
    </header>

    <!-- Section 1b — The tools: three audiences, each with its own demo, the free scan, one login -->
    <section class="vsection vtools" aria-labelledby="vtools-h">
      <h2 id="vtools-h" class="vsection__heading">{t.tools.heading}</h2>
      <p class="vtools__lede">{t.tools.lede}</p>

      <!-- Mobile-only: jump straight to whichever tile applies, regardless of stack order. -->
      <nav class="vtools__banner" aria-label={t.tools.heading}>
        <a href="#tile-agent">{t.tools.bannerLabels[0]}</a>
        <a href="#tile-store">{t.tools.bannerLabels[1]}</a>
        <a href="#tile-dns">{t.tools.bannerLabels[2]}</a>
      </nav>

      <div class="vtools__levels">
        <!-- Tile 1 — Agents, deliberately first in source order (not just labeled first):
             mobile stacking inherits DOM order, and this is the audience being marketed. -->
        <article class="vtool" id="tile-agent">
          <span class="vtool__persona">{t.tools.levels[0].persona}</span>
          <span class="vtool__title">{t.tools.levels[0].title}</span>
          <span class="vtool__body">{t.tools.levels[0].body}</span>
          <span class="vtool__price">{t.tools.levels[0].price}</span>
          <a class="vtool__cta vtool__cta--ghost" href="/verify/agents">{t.tools.levels[0].cta} <span aria-hidden="true">→</span></a>
          <p class="vtool__key-hint">{t.tools.agentKeyLine}</p>
          <a class="vtool__cta" href="/verify/login?next=/verify/agent-keys">{t.tools.agentKeyBtn}</a>
          <div class="vdemo">
            <div class="vdemo__row">
              <input class="vdemo__input" id="agent-demo-addr" placeholder={t.tools.agentDemo.addrPlaceholder} spellcheck="false" autocomplete="off" />
              <input class="vdemo__input" id="agent-demo-domain" placeholder={t.tools.agentDemo.domainPlaceholder} spellcheck="false" autocomplete="off" />
              <button class="vdemo__btn" id="agent-demo-btn" type="button">{t.tools.agentDemo.button}</button>
            </div>
            <pre class="vdemo__result" id="agent-demo-result" hidden></pre>
            <p class="vdemo__hint">{t.tools.agentDemo.hint}</p>
          </div>
        </article>

        <!-- Tile 2 — Store owners: claim a wallet, optional satoshi test. -->
        <article class="vtool" id="tile-store">
          <span class="vtool__persona">{t.tools.levels[1].persona}</span>
          <span class="vtool__title">{t.tools.levels[1].title}</span>
          <span class="vtool__body">{t.tools.levels[1].body}</span>
          <span class="vtool__price">{t.tools.levels[1].price}</span>
          <a class="vtool__cta" href={LOGIN_HREF}>{t.tools.levels[1].cta} <span aria-hidden="true">→</span></a>
          <div class="vdemo">
            <div class="vdemo__row">
              <input class="vdemo__input" id="store-demo-addr" placeholder={t.tools.storeDemo.placeholder} spellcheck="false" autocomplete="off" />
              <button class="vdemo__btn" id="store-demo-btn" type="button">{t.tools.storeDemo.button}</button>
            </div>
            <p class="vdemo__result" id="store-demo-result" hidden>{t.tools.storeDemo.result}</p>
            <p class="vdemo__hint">{t.tools.storeDemo.hint}</p>
          </div>
        </article>

        <!-- Tile 3 — Small business, one or two addresses straight into DNS. -->
        <article class="vtool" id="tile-dns">
          <span class="vtool__persona">{t.tools.levels[2].persona}</span>
          <span class="vtool__title">{t.tools.levels[2].title}</span>
          <span class="vtool__body">{t.tools.levels[2].body}</span>
          <span class="vtool__price">{t.tools.levels[2].price}</span>
          <a class="vtool__cta" href={LOGIN_HREF}>{t.tools.levels[2].cta} <span aria-hidden="true">→</span></a>
          <div class="vdemo">
            <p class="vdemo__label">{t.tools.dnsDemo.label}</p>
            <code class="vdemo__code">_almstins-verify.yourdomain.com&nbsp;&nbsp;TXT&nbsp;&nbsp;"0x7a3b…41f0"</code>
            <p class="vdemo__hint">{t.tools.dnsDemo.hint}</p>
          </div>
        </article>
      </div>
      <a class="vtool vtool--scan" href="/verify/scan">
        <span class="vtool__badge">{t.tools.scan.badge}</span>
        <span class="vtool__title">{t.tools.scan.title}</span>
        <span class="vtool__body">{t.tools.scan.body}</span>
        <span class="vtool__cta">{t.tools.scan.cta} <span aria-hidden="true">→</span></span>
      </a>
      <div class="vtools__login">
        <div class="vtools__login-copy">
          <h3 class="vtools__login-heading">{t.tools.login.heading}</h3>
          <p class="vtools__login-body">{t.tools.login.body}</p>
        </div>
        <a class="vbtn" href={LOGIN_HREF}>{t.tools.login.button}</a>
      </div>
    </section>

    <!-- Section 2 — The problem -->
    <section class="vsection vproblem" aria-labelledby="vproblem-h">
      <h2 id="vproblem-h" class="vsection__heading">{t.problem.heading}</h2>
      {t.problem.body.map((p) => <p class="vproblem__p">{p}</p>)}
    </section>

    <!-- Section 3 — How it works -->
    <section id="how" class="vsection" aria-labelledby="vhow-h">
      <h2 id="vhow-h" class="vsection__heading">{t.how.heading}</h2>
      <ol class="vsteps">
        {t.how.steps.map((s, i) => (
          <li class="vstep">
            <span class="vstep__num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="vstep__title">{s.title}</h3>
              <p class="vstep__body">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Section 4 — What you get, free -->
    <section class="vsection vfree" aria-labelledby="vfree-h">
      <h2 id="vfree-h" class="vsection__heading">{t.free.heading}</h2>
      <ul class="vfree__list">
        {t.free.items.map((item) => <li class="vfree__item">{item}</li>)}
      </ul>
      <p class="vfree__note">{t.free.note}</p>
    </section>

    <!-- Section 5 — Why you can trust it -->
    <section class="vsection vtrust" aria-labelledby="vtrust-h">
      <h2 id="vtrust-h" class="vsection__heading">{t.trust.heading}</h2>
      <div class="vtrust__points">
        {t.trust.points.map((p) => (
          <div class="vtrust__point">
            <h3 class="vtrust__point-title">{p.title}</h3>
            <p class="vtrust__point-body">{p.body}</p>
          </div>
        ))}
      </div>
      <blockquote class="vtrust__quote">{BRAND_QUOTE}</blockquote>
    </section>

    <!-- Section 6 — Early & honest -->
    <section class="vsection vearly" aria-labelledby="vearly-h">
      <h2 id="vearly-h" class="vsection__heading">{t.early.heading}</h2>
      <p class="vearly__body">{t.early.body}</p>
    </section>

    <!-- Section 7 — Final CTA -->
    <section class="vfinal" aria-labelledby="vfinal-h">
      <h2 id="vfinal-h" class="vfinal__heading">{t.finalCta.heading}</h2>
      <a class="vbtn vbtn--lg" href={LOGIN_HREF}>{t.finalCta.button}</a>
      <p class="vfinal__sub">{t.finalCta.sub}</p>
      <a class="vfinal__footer" href="https://almstins.com" aria-label={t.finalCta.footerAria}>{ALMSTINS_URL}</a>
    </section>

    <!-- Section 8 — Verified vendors (how to get verified + the exchange path) -->
    <section class="vsection vexch" aria-labelledby="vexch-h">
      <h2 id="vexch-h" class="vsection__heading">{t.vendors.heading}</h2>
      <p class="vexch__intro">{t.vendors.intro}</p>

      <h3 class="vexch__sub">{t.vendors.howToLabel}</h3>
      <ol class="vexch__steps">
        {t.vendors.steps.map((s) => <li class="vexch__step">{s}</li>)}
      </ol>

      <h3 class="vexch__sub">{t.vendors.scaleLabel}</h3>
      <p class="vexch__intro">{t.vendors.scaleBody}</p>
      <p class="vexch__label">{t.vendors.contractLabel}</p>
      <pre class="vexch__code">{EXCHANGE_CONTRACT}</pre>

      <p class="vexch__note" set:html={t.vendors.earlyNote}></p>
    </section>

  </div>
</LoginLayout>

<style>
  /* All colors reference design tokens from src/styles/tokens.css (loaded by LoginLayout). */
  /* Same gradient as almstins.com's own landing page (login.astro's .landing) --
     an intentional, discussed extension of that pre-token background, not a
     one-off. Applied to the whole scroll area, not just .vpage's own width. */
  :global(body:has(.vpage)) {
    background: linear-gradient(160deg, #0d1525 0%, #0a0f1a 60%, #060b14 100%);
  }
  .vpage {
    width: 100%;
    box-sizing: border-box;
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.25rem 6rem;
    color: var(--text-primary);
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* ── Top nav ── */
  .vnav {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: color-mix(in srgb, var(--surface-bg) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .vnav__brand { display: flex; flex-direction: column; gap: 0.1rem; text-decoration: none; }
  .vnav__wordmark { font-size: 1.05rem; font-weight: 800; letter-spacing: -0.01em; color: var(--text-primary); }
  .vnav__tagline { font-size: 0.75rem; color: var(--text-muted); display: none; }
  @media (min-width: 560px) { .vnav__tagline { display: inline; } }
  .vnav__right { display: flex; align-items: center; gap: 0.75rem; }
  .vnav__langs { display: inline-flex; align-items: center; gap: 0.1rem; }
  .vnav__lang {
    font-size: 0.8rem; font-weight: 600; color: var(--text-muted);
    text-decoration: none; padding: 0.35rem 0.6rem; border-radius: 999px;
    transition: color 0.15s ease;
  }
  .vnav__lang:hover { color: var(--text-primary); }
  .vnav__lang[aria-current='true'] { color: var(--accent); }
  .vnav__logo { display: inline-flex; align-items: center; line-height: 0; flex-shrink: 0; }
  .vnav__logo img {
    height: 40px;
    width: auto;
    border-radius: 9px;
    border: 1px solid var(--border-subtle);
    display: block;
  }
  @media (max-width: 480px) { .vnav__logo img { height: 34px; } }

  /* ── Buttons (rounded-rect, matching almstins.com's hub-hero__cta -- pills
     stay reserved for badges/tags, same split the hub page itself uses) ── */
  .vbtn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 0.75rem;
    background: var(--accent);
    color: var(--surface-bg);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: filter 0.15s ease, transform 0.15s ease;
    box-shadow: 0 6px 22px var(--accent-glow);
  }
  .vbtn:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .vbtn--ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-bright);
    box-shadow: none;
    font-weight: 600;
  }
  .vbtn--ghost:hover { color: var(--text-primary); border-color: var(--accent); transform: none; }
  .vbtn--demo {
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-glow);
    box-shadow: none;
  }
  .vbtn--demo:hover { color: var(--text-primary); border-color: var(--accent); }
  .vbtn--lg { padding: 0.95rem 2rem; font-size: 1.05rem; }

  /* ── Hero ── */
  .vhero {
    text-align: center;
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 3rem;
  }
  .vhero__mark {
    display: block;
    width: 132px;
    height: 132px;
    margin: 0 auto 1.5rem;
    filter: drop-shadow(0 8px 26px var(--accent-glow));
  }
  .vhero__eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-glow);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }
  .vhero__title {
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: var(--text-primary);
    max-width: 18ch;
    margin-inline: auto;
  }
  .vhero__sub {
    font-size: 1.12rem;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  .vhero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    align-items: center;
  }

  /* ── Section shell ── */
  .vsection { margin-bottom: 3.25rem; }
  .vsection__heading {
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    color: var(--text-primary);
  }

  /* ── Section 1b: the tools ── */
  .vtools__lede { font-size: 0.97rem; color: var(--text-secondary); line-height: 1.75; margin: -0.5rem 0 1.25rem; }
  /* Mobile-only quick nav: three persona words, each jumping straight to its tile
     regardless of stack order. Desktop already shows all three at a glance. */
  .vtools__banner {
    display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;
  }
  @media (min-width: 800px) { .vtools__banner { display: none; } }
  .vtools__banner a {
    flex: 1 1 auto; text-align: center; text-decoration: none;
    font-size: 0.78rem; font-weight: 800; color: var(--accent);
    background: var(--accent-soft); border: 1px solid var(--accent-glow);
    border-radius: 999px; padding: 0.4rem 0.9rem;
  }
  .vtools__levels { display: grid; gap: 1rem; grid-template-columns: 1fr; margin-bottom: 1rem; }
  @media (min-width: 800px) { .vtools__levels { grid-template-columns: repeat(3, 1fr); } }
  .vtool {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 1.2rem 1.25rem;
    transition: border-color 0.15s ease, transform 0.1s ease;
  }
  /* Same hover-lift as almstins.com's .door cards; the accent border on
     hover/focus-within is kept on top of that -- unlike a .door (one big
     link), each tile holds several separately-focusable controls (demo
     inputs, the login button), so that feedback still earns its keep. */
  .vtool:hover { transform: translateY(-3px); }
  .vtool:focus-within, .vtool:hover { border-color: var(--accent); }
  .vtool__persona {
    font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  }
  .vtool__title { font-size: 1.05rem; font-weight: 800; color: var(--text-primary); }
  .vtool__body { font-size: 0.88rem; color: var(--text-secondary); line-height: 1.65; overflow-wrap: anywhere; }
  .vtool__price {
    align-self: flex-start;
    font-size: 0.75rem; font-weight: 700; color: var(--accent);
    background: var(--accent-soft); border: 1px solid var(--accent-glow);
    padding: 0.2rem 0.6rem; border-radius: 999px;
  }
  /* Each tile's own login/action button — same rounded-rect language as .vbtn,
     sized for a card rather than the hero. */
  .vtool__cta {
    display: inline-block; align-self: flex-start; margin-top: 0.3rem;
    padding: 0.55rem 1.1rem; border-radius: 0.65rem;
    background: var(--accent); color: var(--surface-bg);
    font-size: 0.85rem; font-weight: 700; text-decoration: none;
    transition: filter 0.15s ease;
  }
  .vtool__cta:hover { filter: brightness(1.08); }
  .vtool__cta--ghost {
    background: transparent; color: var(--accent); border: 1px solid var(--border-bright);
  }
  .vtool__cta--ghost:hover { border-color: var(--accent); filter: none; }
  .vtool__key-hint {
    font-size: 0.78rem; color: var(--text-muted); line-height: 1.5; margin: -0.1rem 0 0;
  }

  /* Per-tile demo: a small interactive or illustrative strip at the bottom of each
     card, distinct enough from the CTA link above it to not be mistaken for it. */
  .vdemo {
    margin-top: 0.4rem; padding-top: 0.75rem; border-top: 1px solid var(--border-subtle);
    display: flex; flex-direction: column; gap: 0.4rem;
  }
  .vdemo__row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .vdemo__input {
    flex: 1 1 120px; min-width: 0; font-family: inherit; font-size: 0.8rem; padding: 0.4rem 0.55rem;
    background: var(--surface-bg); border: 1px solid var(--border-bright); border-radius: 7px;
    color: var(--text-primary); outline: none;
  }
  .vdemo__input:focus { border-color: var(--accent); }
  .vdemo__input::placeholder { color: var(--text-muted); }
  .vdemo__btn {
    font-family: inherit; font-size: 0.78rem; font-weight: 700; padding: 0.4rem 0.75rem;
    background: var(--accent); color: var(--surface-bg); border: none; border-radius: 7px;
    cursor: pointer; white-space: nowrap;
  }
  .vdemo__btn:hover { filter: brightness(1.08); }
  .vdemo__btn:disabled { opacity: 0.6; cursor: default; }
  .vdemo__result {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.72rem; line-height: 1.5;
    background: var(--surface-bg); border: 1px solid var(--border-subtle); border-radius: 7px;
    padding: 0.55rem 0.7rem; margin: 0; overflow-x: auto; white-space: pre-wrap; color: var(--gain);
  }
  p.vdemo__result { font-family: inherit; }
  .vdemo__hint { font-size: 0.74rem; color: var(--text-muted); margin: 0; }
  .vdemo__label { font-size: 0.78rem; color: var(--text-secondary); margin: 0; }
  .vdemo__code {
    display: block; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.72rem;
    background: var(--surface-bg); border: 1px solid var(--border-subtle); border-radius: 7px;
    padding: 0.55rem 0.7rem; overflow-x: auto; white-space: pre; color: var(--text-primary);
  }
  .vtool--scan { background: var(--surface-card-2); border-style: dashed; border-color: var(--border-bright); }
  .vtool__badge {
    align-self: flex-start;
    font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-glow);
    padding: 0.2rem 0.55rem; border-radius: 999px;
  }
