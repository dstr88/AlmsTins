---
import Layout from "@/layouts/LoginLayout.astro";
import { getAuthSession } from "../lib/authSession";
import { getPostLoginRedirect } from "../lib/postLoginRedirect";
import Logo from "../assets/logo.jpeg";

const { searchParams } = Astro.url;
const error = searchParams.get("error");
const next = searchParams.get("next");
const callbackParam = searchParams.get("callbackUrl");
const nextPath =
  typeof next === "string"
    ? next
    : typeof callbackParam === "string"
      ? callbackParam
      : null;

const callbackUrl = getPostLoginRedirect(nextPath);
const safeCallbackUrl = callbackUrl.startsWith("/") ? callbackUrl : "/dashboard/vault";

const message =
  error === "missing"
    ? "Sign in to continue."
    : error === "Configuration"
      ? "Sign-in is temporarily unavailable. Please try again in a moment."
      : error
        ? "Sign-in failed. Please try again."
        : "";

const signup = searchParams.get("signup");
const verified = searchParams.get("verified");
const notice =
  signup === "success"
    ? "Account created. Check your inbox to verify your email."
    : verified === "success"
      ? "Email verified. You can sign in now."
      : verified === "expired"
        ? "Verification link expired. Please sign in to request a new one."
        : verified === "failed"
          ? "Verification failed. Please try again."
          : "";

const session = await getAuthSession(Astro.request);

let csrfToken = "";
try {
  // Use AUTH_URL (the public domain) instead of Astro.url to avoid
  // ECONNREFUSED when the server tries to reach itself via localhost on Render.
  const authBase = process.env.AUTH_URL
    ? (/^https?:\/\//i.test(process.env.AUTH_URL)
        ? process.env.AUTH_URL.replace(/\/$/, "")
        : `https://${process.env.AUTH_URL}`)
    : Astro.url.origin;
  const csrfResponse = await fetch(`${authBase}/api/auth/csrf`, {
    headers: {
      cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });
  if (csrfResponse.ok) {
    const data = await csrfResponse.json();
    csrfToken = data?.csrfToken ?? "";
  }
} catch (error) {
  console.warn("Failed to load CSRF token server-side", error);
}
---

<Layout>
  <main class="auth-page">
    <div class="auth-shell">
      <a class="auth-logo" href="/" aria-label="Almstins home">
        <img src={Logo.src} width="75" height="75" alt="Almstins logo" />
      </a>
      <!-- LEFT: Hero + copy + FAQ -->
      <section class="auth-left">

        <div class="welcome-copy">
        <h1>Welcome to Almstins — Your Financial Reality, Finally in One Place.</h1>
        <p>
          First of all, thanks for joining me on this journey. I am building a product that will track crypto, DeFi, traditional investments, and liabilities in a single intelligent dashboard.
          It is built for clarity and control. Almstins eliminates fragmented tools, hopping from one wallet to the next and the guesswork. This is the only open source tool that gives you real-time visibility into your net worth, performance, and risk exposure. See all of your wallets in one secure place. Whether you’re building wealth, managing multiple wallets, or optimizing strategies, Almstins helps you move faster, think smarter, keep track of everything in one convenient place and stay ahead.</p>
          <h3>Security</h3>
          <p>Built with your security in mind, there's no need to attach your wallet.  Just enter your public address. All the self-custody information is available to anyone who wants to dig for it.  Our database is encrypted, and your data is not for sale.</p> 
        </div>
      </section>

      <!-- RIGHT: Sign-in panel -->
      <section class="auth-right">
        <div class="signin-card">
        <header class="signin-head">
          <h2>Sign in</h2>
          <p>Use Google, GitHub, email + password, or a magic link.</p>

          {message && <p class="notice">{message}</p>}
          {notice && <p class="notice success">{notice}</p>}
          {session?.user?.id && (
            <a class="provider-button ghost" href={safeCallbackUrl}>Continue to Dashboard</a>
          )}
        </header>

        <div class="providers">
          <form class="provider-form" method="POST" action="/api/auth/signin/google">
            <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button class="provider-button google" type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>Continue with Google</button>
          </form>

          <form class="provider-form" method="POST" action="/api/auth/signin/github">
            <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button class="provider-button github" type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>Continue with GitHub</button>
          </form>
        </div>

        <div class="divider">or email</div>

        <form class="stack" method="POST" action="/api/auth/callback/credentials">
          <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
          <input type="hidden" name="csrfToken" value={csrfToken} />

          <label>
            <span>Email address</span>
            <input type="email" name="email" placeholder="you@company.com" required />
          </label>

          <label>
            <span>Password</span>
            <input type="password" name="password" minlength="10" required />
          </label>

          <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>Sign in with email</button>
        </form>

        <div class="divider">or magic link</div>

        <form class="stack" method="POST" action="/api/auth/signin/email">
          <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
          <input type="hidden" name="csrfToken" value={csrfToken} />

          <label>
            <span>Email address</span>
            <input type="email" name="email" placeholder="you@company.com" required />
          </label>

          <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>Send magic link</button>
        </form>

        <a class="provider-button ghost" href="/signup">Create an account</a>
        <a class="checker-link" href="/wallet-checker">🔍 Free Wallet Scam Checker — no account needed</a>
      </div>

      <script>
        (async () => {
          try {
            const res = await fetch("/api/auth/csrf", { credentials: "same-origin" });
            if (!res.ok) return;
            const data = await res.json();
            if (!data?.csrfToken) return;

            document.querySelectorAll('input[name="csrfToken"]').forEach((el) => {
              el.value = data.csrfToken;
            });

            // enable buttons once token is ready
            document.querySelectorAll("button[data-needs-csrf]").forEach((b) => {
              b.removeAttribute("disabled");
            });
          } catch (e) {
            console.warn("[login] csrf fetch failed", e);
          }
        })();
      </script>

    </section>
    </div>
  </main>

  <style>
    :root {
      color-scheme: dark;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #131628, #05060c 65%);
      min-height: 100vh;
      color: #f5f8ff;
    }

    /* ✅ stop vertical centering — allow the page to breathe and scroll naturally */
    .auth-page {
      width: 100%;
    }

    .auth-shell {
      width: 100%;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 100vh;
      background: #0a0f1a;
      color: #f7f2eb;
      position: relative;
    }

    @media (max-width: 900px) {
      .auth-shell {
        min-height: auto;
        width: calc(100% - 2rem);
        margin: 0 1rem;
        grid-template-columns: 1fr;
        padding-top: 1.5rem;
      }
    }

    .auth-left {
      padding: 5rem 3rem 3rem 5rem;
      display: flex;
      flex-direction: column;
      gap: 3rem;
      background: linear-gradient(to bottom right, #0d1525, #0a0f1a);
    }

    .auth-logo {
      position: absolute;
      top: 3rem;
      left: 1rem;
      width: 75px;
      height: 75px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
      z-index: 20;
    }

    .auth-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .welcome-copy h1 {
      margin: 15rem 0 0.5rem;
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.01em;
    }

    .welcome-copy {
      margin-left: 1.5rem;
      max-width: 680px;
    }

    @media (max-width: 900px) {
      .welcome-copy {
        margin-left: 0;
      }
    }

    .welcome-copy p {
      margin: 0;
      color: rgba(255, 255, 255, 0.76);
      line-height: 1.8;
      font-size: 1.15rem;
    }

    .auth-right {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: rgba(0, 0, 0, 0.25);
    }

    @media (max-width: 900px) {
      .auth-right {
        padding: 2rem;
      }
    }

    /* ✅ compact sign-in card */
    .signin-card {
      background: rgba(10, 15, 26, 0.92);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 3rem 2.5rem;
      width: 100%;
      max-width: 460px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
      display: grid;
      gap: 1.4rem;
    }

    .signin-head h2 {
      margin: 0 0 0.35rem;
      font-size: 1.2rem;
      font-weight: 650;
    }

    .signin-head p {
      margin: 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.95rem;
    }

    .providers {
      display: grid;
      gap: 1rem;
    }

    .provider-form {
      margin: 0;
    }

    .provider-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      text-decoration: none;
      border-radius: 12px;
      padding: 1.1rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 1.05rem;
      font-weight: 650;
      cursor: pointer;
      transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
    }

    .provider-button:hover {
      opacity: 0.92;
      transform: translateY(-1px);
      border-color: rgba(255, 255, 255, 0.35);
    }

    .provider-button.google {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      border: none;
    }

    .provider-button.github {
      background: linear-gradient(135deg, #0f172a, #1f2937);
      border: none;
    }

    .provider-button.ghost {
      background: rgba(255, 255, 255, 0.06);
    }

    .checker-link {
      display: block;
      text-align: center;
      margin-top: 1rem;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.45);
      text-decoration: none;
      transition: color 0.15s;
    }
    .checker-link:hover {
      color: rgba(255, 255, 255, 0.8);
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 2rem 0;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .divider::before,
    .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.12);
    }

    .stack {
      display: grid;
      gap: 0.9rem;
    }

    label {
      display: grid;
      gap: 0.45rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 520;
    }

    input {
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(4px);
      color: #fff;
      padding: 1rem 1.25rem;
      font-size: 1.05rem;
    }

    input:focus {
      outline: 2px solid rgba(84, 144, 255, 0.9);
      outline-offset: 1px;
    }

    button {
      border-radius: 14px;
      padding: 0.9rem 1rem;
      border: none;
      background: linear-gradient(135deg, #5865f2, #7c3aed);
      color: #fff;
      font-size: 1rem;
      font-weight: 750;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.18s ease, box-shadow 0.2s ease;
      box-shadow: 0 12px 30px rgba(124, 58, 237, 0.25);
    }

    button:hover {
      opacity: 0.95;
      transform: translateY(-2px);
      box-shadow: 0 20px 55px rgba(124, 58, 237, 0.4);
    }

    .notice {
      margin-top: 0.8rem;
      background: rgba(255, 107, 107, 0.12);
      border: 1px solid rgba(255, 107, 107, 0.35);
      color: #ffb5b5;
      padding: 0.65rem 0.85rem;
      border-radius: 12px;
      font-size: 0.9rem;
    }

    .notice.success {
      background: rgba(60, 179, 113, 0.12);
      border: 1px solid rgba(60, 179, 113, 0.35);
      color: #b6f3c4;
    }
  </style>
</Layout>
