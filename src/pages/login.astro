---
import { isAuthDisabled, isValidSession, SESSION_COOKIE_NAME } from '../lib/auth';
import { getPostLoginRedirect } from '../lib/postLoginRedirect';

const { searchParams } = Astro.url;
const error = searchParams.get('error');
const next = searchParams.get('next');
const nextPath = typeof next === 'string' ? next : '';
const message =
	error === 'invalid'
		? 'Incorrect passphrase. Double-check and try again.'
		: error === 'missing'
			? 'Enter your passphrase to continue.'
			: '';

const sessionToken = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
if (!isAuthDisabled() && isValidSession(sessionToken)) {
	return Astro.redirect(getPostLoginRedirect(nextPath), 303);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Dashboard Sign-in</title>
		<style>
			:root {
				color-scheme: dark;
				font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
				background: radial-gradient(circle at top, #131628, #05060c 65%);
				min-height: 100vh;
				color: #f5f8ff;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			main {
				width: min(400px, calc(100% - 2rem));
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 20px;
				padding: 2rem;
				box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
			}

			h1 {
				margin-top: 0;
				margin-bottom: 0.5rem;
				font-size: 1.35rem;
				font-weight: 600;
			}

			p {
				margin-top: 0;
				margin-bottom: 1.5rem;
				color: rgba(255, 255, 255, 0.75);
				font-size: 0.95rem;
			}

			form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			label {
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
				color: rgba(255, 255, 255, 0.85);
				font-weight: 500;
			}

			input {
				border-radius: 12px;
				border: 1px solid rgba(255, 255, 255, 0.18);
				background: rgba(255, 255, 255, 0.08);
				backdrop-filter: blur(4px);
				color: #fff;
				padding: 0.75rem 1rem;
				font-size: 1rem;
			}

			input:focus {
				outline: 2px solid rgba(84, 144, 255, 0.9);
				outline-offset: 1px;
			}

			button {
				border-radius: 12px;
				padding: 0.85rem 1rem;
				border: none;
				background: linear-gradient(135deg, #5767ff, #934dff);
				color: #fff;
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.2s ease;
			}

			button:hover {
				opacity: 0.92;
			}

			.notice {
				background: rgba(255, 107, 107, 0.12);
				border: 1px solid rgba(255, 107, 107, 0.35);
				color: #ffb5b5;
				padding: 0.75rem 1rem;
				border-radius: 12px;
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Sign in</h1>
			<p>Enter your private dashboard passphrase to continue.</p>

			{message && <p class="notice">{message}</p>}

			<form method="POST" action="/api/auth/login">
				<input type="hidden" name="next" value={nextPath} />
				<label>
					<span>Passphrase</span>
					<input type="password" name="passphrase" placeholder="••••••••••" required autofocus />
				</label>
				<button type="submit">Unlock dashboard</button>
			</form>
		</main>
	</body>
</html>
