---
import Layout from "@/layouts/LoginLayout.astro";
import { getAuthSession } from "../lib/authSession";
import { getPostLoginRedirect } from "../lib/postLoginRedirect";
import Logo from "../assets/logo.jpeg";
import DashImg from "../assets/AlmsTinspic.png";

const { searchParams } = Astro.url;
const error = searchParams.get("error");
const next = searchParams.get("next");
const callbackParam = searchParams.get("callbackUrl");
const nextPath =
  typeof next === "string"
    ? next
    : typeof callbackParam === "string"
      ? callbackParam
      : null;

const callbackUrl = getPostLoginRedirect(nextPath);
const safeCallbackUrl = callbackUrl.startsWith("/") ? callbackUrl : "/dashboard/vault";

const message =
  error === "missing"
    ? "Sign in to continue."
    : error === "Configuration"
      ? "Sign-in is temporarily unavailable. Please try again in a moment."
      : error === "OAuthAccountNotLinked"
        ? "LOCKED_OUT"
        : error
          ? "Sign-in failed. Please try again."
          : "";

const signup = searchParams.get("signup");
const verified = searchParams.get("verified");
const notice =
  signup === "success"
    ? "Account created. Check your inbox to verify your email."
    : verified === "success"
      ? "Email verified. You can sign in now."
      : verified === "expired"
        ? "Verification link expired. Please sign in to request a new one."
        : verified === "failed"
          ? "Verification failed. Please try again."
          : "";

const session = await getAuthSession(Astro.request);

let csrfToken = "";
try {
  const authBase = process.env.AUTH_URL
    ? (/^https?:\/\//i.test(process.env.AUTH_URL)
        ? process.env.AUTH_URL.replace(/\/$/, "")
        : `https://${process.env.AUTH_URL}`)
    : Astro.url.origin;
  const csrfResponse = await fetch(`${authBase}/api/auth/csrf`, {
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  if (csrfResponse.ok) {
    const data = await csrfResponse.json();
    csrfToken = data?.csrfToken ?? "";
  }
} catch (error) {
  console.warn("Failed to load CSRF token server-side", error);
}
---

<Layout>
  <main class="auth-page">
    <div class="auth-shell">

      <!-- ── LEFT PANEL ─────────────────────────────────────────── -->
      <section class="auth-left">

        <!-- Wordmark -->
        <a href="/" class="wordmark" aria-label="Almstins home">
          <img src={Logo.src} width="44" height="44" alt="Almstins logo" class="wordmark-img" />
          <span class="wordmark-text">Almstins</span>
        </a>

        <!-- Headline -->
        <div class="hero-copy">
          <h1>Your Financial Reality,<br/>Finally in One Place.</h1>
          <p class="hero-sub">Crypto, DeFi, and traditional investments — unified, private, and always up to date.</p>
        </div>

        <!-- Feature cards -->
        <div class="feature-grid">
          <div class="feature-card">
            <span class="fc-icon">🔐</span>
            <div>
              <div class="fc-title">No wallet connection</div>
              <div class="fc-desc">Read-only via public addresses. We never touch your keys.</div>
            </div>
          </div>
          <div class="feature-card">
            <span class="fc-icon">📊</span>
            <div>
              <div class="fc-title">Real net worth</div>
              <div class="fc-desc">Crypto + DeFi + loans + cash — one live dashboard.</div>
            </div>
          </div>
          <div class="feature-card">
            <span class="fc-icon">🧾</span>
            <div>
              <div class="fc-title">Year Summary export</div>
              <div class="fc-desc">Download realized gains and a full transaction ledger.</div>
            </div>
          </div>
          <div class="feature-card">
            <span class="fc-icon">🛡️</span>
            <div>
              <div class="fc-title">Encrypted & private</div>
              <div class="fc-desc">Your data is encrypted at rest and never sold.</div>
            </div>
          </div>
        </div>

        <!-- Trust bar -->
        <div class="trust-bar">
          <span>✓ Free to start</span>
          <span class="trust-dot">·</span>
          <span>✓ No credit card</span>
          <span class="trust-dot">·</span>
          <span>✓ No wallet connection</span>
        </div>

        <!-- Dashboard preview -->
        <div class="dash-preview">
          <img src={DashImg.src} alt="Almstins dashboard preview" class="dash-img" loading="lazy" />
          <div class="dash-preview-fade"></div>
        </div>

      </section>

      <!-- ── RIGHT PANEL ────────────────────────────────────────── -->
      <section class="auth-right">
        <div class="signin-card">

          <header class="signin-head">
            <h2>Sign in</h2>
            <p>New here? <a href="/signup" class="inline-link">Create a free account →</a></p>
            {message === "LOCKED_OUT" ? null : message ? (
              <p class="notice">{message}</p>
            ) : null}
            {notice && <p class="notice success">{notice}</p>}
            {session?.user?.id && (
              <a class="provider-button ghost" href={safeCallbackUrl}>Continue to Dashboard</a>
            )}
          </header>

          <!-- Primary providers -->
          <div class="providers">
            <form id="login-google" class="provider-form" method="POST" action="/api/auth/signin/google">
              <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
              <input type="hidden" name="csrfToken" value={csrfToken} />
              <button class="provider-button google" type="submit" data-provider="google"
                data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
                <svg class="provider-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#fff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="rgba(255,255,255,0.8)" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="rgba(255,255,255,0.6)" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                  <path fill="rgba(255,255,255,0.7)" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <span class="provider-label">Continue with Google</span>
                <span class="last-used-badge" data-badge="google" hidden>Last used</span>
              </button>
            </form>

            <form id="login-github" class="provider-form" method="POST" action="/api/auth/signin/github">
              <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
              <input type="hidden" name="csrfToken" value={csrfToken} />
              <button class="provider-button github" type="submit" data-provider="github"
                data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
                <svg class="provider-icon" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span class="provider-label">Continue with GitHub</span>
                <span class="last-used-badge" data-badge="github" hidden>Last used</span>
              </button>
            </form>
          </div>

          <!-- Demo CTA -->
          <div class="demo-divider">or explore first</div>
          <a class="provider-button demo-try" href="/api/demo/start">
            ▶ Try the demo — no account needed
          </a>

          <!-- Email toggle -->
          <div class="email-toggle-wrap">
            <button class="email-toggle-btn" id="emailToggle" type="button" aria-expanded="false">
              or sign in with email <span class="toggle-chevron">›</span>
            </button>

            <div class="email-panel" id="emailPanel" hidden>
              <!-- Tab bar -->
              <div class="email-tabs" role="tablist">
                <button class="email-tab active" id="tabPass" role="tab" aria-selected="true" type="button">Password</button>
                <button class="email-tab" id="tabMagic" role="tab" aria-selected="false" type="button">Magic link</button>
              </div>

              <!-- Email + Password form -->
              <form id="login-email-password" class="stack email-tab-panel" method="POST" action="/api/auth/callback/credentials">
                <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
                <input type="hidden" name="csrfToken" value={csrfToken} />
                <label>
                  <span>Email address</span>
                  <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
                </label>
                <label>
                  <span>Password</span>
                  <input type="password" name="password" minlength="10" required autocomplete="current-password" />
                </label>
                <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
                  Sign in with email
                </button>
              </form>

              <!-- Magic link form -->
              <form id="login-magic-link" class="stack email-tab-panel" method="POST" action="/api/auth/signin/email" hidden>
                <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
                <input type="hidden" name="csrfToken" value={csrfToken} />
                <label>
                  <span>Email address</span>
                  <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
                </label>
                <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
                  Send magic link
                </button>
              </form>
            </div>
          </div>

          <!-- New account link -->
          <a class="provider-button new-account" href="/signup">✦ New here? Create a free account</a>

        </div><!-- /signin-card -->
      </section>
    </div><!-- /auth-shell -->
  </main>

  <!-- ── Scam checker bar ──────────────────────────────────────────── -->
  <div class="checker-bar">
    <a class="checker-link" href="/wallet-checker">🔍 Free Wallet Scam Checker — no account needed</a>
  </div>

  <!-- ── Hesitation modal (shown after 30s of no interaction) ────────── -->
  <div class="hesitation-overlay hidden" id="hesitationOverlay" role="dialog" aria-modal="true" aria-labelledby="hesitationTitle">
    <div class="hesitation-modal">
      <button class="hesitation-close" id="hesitationClose" aria-label="Close">✕</button>
      <h3 id="hesitationTitle">Got a question before you sign up?</h3>
      <p>We read everything — great questions end up in the FAQ.</p>
      <form id="contact-form" autocomplete="off" novalidate>
        <input id="contact-subject" type="text" name="subject" maxlength="120"
          placeholder="Subject" class="contact-input" required />
        <div class="contact-body-wrap">
          <textarea id="contact-body" name="body" maxlength="500" rows="4"
            placeholder="Your question or thought…" class="contact-input contact-textarea" required></textarea>
          <div class="contact-char"><span id="contact-char-count">0</span> / 500</div>
        </div>
        <button type="submit" class="contact-submit">Submit anonymously</button>
        <p id="contact-status" class="contact-status" hidden></p>
      </form>
    </div>
  </div>

  {message === "LOCKED_OUT" && (
    <div class="session-overlay" id="session-overlay">
      <div class="session-popup" role="alertdialog" aria-modal="true" aria-labelledby="session-title">
        <div class="session-popup__icon">🔐</div>
        <h2 id="session-title">You're already signed in</h2>
        <p>It looks like you have an active session on another browser or device. Sign out first, then try again.</p>
        <div class="session-popup__actions">
          <a class="session-popup__btn session-popup__btn--primary" href="/api/auth/signout">Sign out &amp; try again</a>
          <button class="session-popup__btn session-popup__btn--ghost" id="session-dismiss">Dismiss</button>
        </div>
      </div>
    </div>
    <script is:inline>
      document.getElementById('session-dismiss')?.addEventListener('click', function() {
        document.getElementById('session-overlay')?.remove();
      });
    </script>
  )}

  <script>
    // ── CSRF refresh ──────────────────────────────────────────────────
    (async () => {
      try {
        const res = await fetch("/api/auth/csrf", { credentials: "same-origin" });
        if (!res.ok) return;
        const data = await res.json();
        if (!data?.csrfToken) return;
        document.querySelectorAll('input[name="csrfToken"]').forEach((el) => {
          (el as HTMLInputElement).value = data.csrfToken;
        });
        document.querySelectorAll("button[data-needs-csrf]").forEach((b) => {
          b.removeAttribute("disabled");
        });
      } catch (e) {
        console.warn("[login] csrf fetch failed", e);
      }
    })();

    // ── Last-used provider badge ──────────────────────────────────────
    (() => {
      const STORAGE_KEY = 'alms_last_provider';
      const lastProvider = localStorage.getItem(STORAGE_KEY);
      if (lastProvider) {
        const badge = document.querySelector(`[data-badge="${lastProvider}"]`);
        if (badge) {
          badge.removeAttribute('hidden');
          (badge.closest('button') as HTMLElement | null)?.classList.add('last-used');
        }
      }
      document.querySelectorAll('button[data-provider]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const provider = btn.getAttribute('data-provider');
          if (provider) localStorage.setItem(STORAGE_KEY, provider);
        });
      });
    })();

    // ── Email toggle ──────────────────────────────────────────────────
    (() => {
      const toggleBtn  = document.getElementById('emailToggle') as HTMLButtonElement;
      const panel      = document.getElementById('emailPanel');
      const tabPass    = document.getElementById('tabPass') as HTMLButtonElement;
      const tabMagic   = document.getElementById('tabMagic') as HTMLButtonElement;
      const formPass   = document.getElementById('login-email-password');
      const formMagic  = document.getElementById('login-magic-link');
      const chevron    = toggleBtn?.querySelector('.toggle-chevron') as HTMLElement;

      toggleBtn?.addEventListener('click', () => {
        const open = !panel?.hidden;
        if (panel) panel.hidden = open;
        toggleBtn.setAttribute('aria-expanded', String(!open));
        if (chevron) chevron.textContent = open ? '›' : '‹';
        toggleBtn.classList.toggle('active', !open);
        if (!open) panel?.querySelector('input')?.focus();
      });

      function switchTab(showPass: boolean) {
        tabPass?.classList.toggle('active', showPass);
        tabMagic?.classList.toggle('active', !showPass);
        tabPass?.setAttribute('aria-selected', String(showPass));
        tabMagic?.setAttribute('aria-selected', String(!showPass));
        if (formPass) (formPass as HTMLElement).hidden = !showPass;
        if (formMagic) (formMagic as HTMLElement).hidden = showPass;
      }

      tabPass?.addEventListener('click', () => switchTab(true));
      tabMagic?.addEventListener('click', () => switchTab(false));
    })();

    // ── Hesitation modal (30s timer, reset on interaction) ───────────
    (() => {
      const overlay = document.getElementById('hesitationOverlay');
      const closeBtn = document.getElementById('hesitationClose');
      const form     = document.getElementById('contact-form') as HTMLFormElement | null;
      const body     = document.getElementById('contact-body') as HTMLTextAreaElement | null;
      const counter  = document.getElementById('contact-char-count');
      const status   = document.getElementById('contact-status');

      if (!overlay) return;

      let timer: ReturnType<typeof setTimeout>;
      const DELAY = 30_000;
      let shown = false;

      function showModal() {
        if (shown) return;
        shown = true;
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function resetTimer() {
        clearTimeout(timer);
        if (!shown) timer = setTimeout(showModal, DELAY);
      }

      function dismiss() {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }

      closeBtn?.addEventListener('click', dismiss);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) dismiss();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') dismiss();
      });

      // Reset on meaningful interactions
      ['click','keydown','scroll','mousemove','touchstart'].forEach(ev => {
        document.addEventListener(ev, resetTimer, { passive: true });
      });
      resetTimer();

      // Char counter
      body?.addEventListener('input', () => {
        if (counter) counter.textContent = String(body.value.length);
      });

      // Form submit
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value.trim();
        const bodyVal = body?.value.trim();
        if (!subject || !bodyVal) return;
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subject, body: bodyVal }),
          });
          const data = await res.json();
          if (data.ok) {
            form.reset();
            if (counter) counter.textContent = '0';
            if (status) {
              status.textContent = '✓ Submitted — thanks!';
              (status as HTMLElement).style.color = '#4ade80';
              status.hidden = false;
            }
            setTimeout(dismiss, 2500);
          } else { throw new Error(data.error ?? 'Submit failed'); }
        } catch (err: unknown) {
          if (status) {
            status.textContent = err instanceof Error ? err.message : 'Something went wrong';
            (status as HTMLElement).style.color = '#f87171';
            status.hidden = false;
          }
        } finally {
          btn.disabled = false;
          btn.textContent = 'Submit anonymously';
        }
      });
    })();
  </script>

  <style>
    :root {
      color-scheme: dark;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #05060c;
      min-height: 100vh;
      color: #f5f8ff;
    }

    .auth-page { width: 100%; }

    /* ── Shell ─────────────────────────────────────────────────── */
    .auth-shell {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 100vh;
    }
    @media (max-width: 900px) {
      .auth-shell { grid-template-columns: 1fr; }
    }

    /* ── Left panel ────────────────────────────────────────────── */
    .auth-left {
      padding: 3rem 3rem 3rem 4rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      background: linear-gradient(160deg, #0d1525 0%, #0a0f1a 60%, #060b14 100%);
      overflow: hidden;
      position: relative;
    }
    @media (max-width: 900px) {
      .auth-left { padding: 2rem 1.5rem 1.5rem; }
    }

    /* Wordmark */
    .wordmark {
      display: inline-flex; align-items: center; gap: 0.75rem;
      text-decoration: none; width: fit-content;
    }
    .wordmark-img {
      width: 44px; height: 44px; border-radius: 10px;
      object-fit: cover;
      border: 1px solid rgba(255,255,255,0.18);
      box-shadow: 0 8px 20px rgba(0,0,0,0.4);
    }
    .wordmark-text {
      font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em;
      color: #f5f8ff;
      background: linear-gradient(135deg, #a5b4fc, #818cf8);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    /* Headline */
    .hero-copy h1 {
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      font-weight: 800; letter-spacing: -0.02em;
      line-height: 1.15; margin: 0 0 0.75rem;
    }
    .hero-sub {
      font-size: 1rem; color: rgba(255,255,255,0.55);
      line-height: 1.7; margin: 0;
    }

    /* Feature cards */
    .feature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    @media (max-width: 560px) {
      .feature-grid { grid-template-columns: 1fr; }
    }
    .feature-card {
      display: flex; align-items: flex-start; gap: 0.7rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 12px;
      padding: 0.85rem 1rem;
    }
    .fc-icon { font-size: 1.3rem; flex-shrink: 0; margin-top: 0.1rem; }
    .fc-title { font-size: 0.85rem; font-weight: 700; color: #f5f8ff; margin-bottom: 0.2rem; }
    .fc-desc  { font-size: 0.75rem; color: rgba(255,255,255,0.45); line-height: 1.5; }

    /* Trust bar */
    .trust-bar {
      display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
      font-size: 0.8rem; color: rgba(255,255,255,0.4);
    }
    .trust-dot { opacity: 0.3; }

    /* Dashboard preview */
    .dash-preview {
      position: relative; border-radius: 12px; overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 24px 60px rgba(0,0,0,0.5);
      max-height: 260px;
      flex-shrink: 0;
    }
    .dash-img { width: 100%; display: block; object-fit: cover; object-position: top; }
    .dash-preview-fade {
      position: absolute; bottom: 0; left: 0; right: 0; height: 80px;
      background: linear-gradient(to bottom, transparent, #0a0f1a);
    }

    /* ── Right panel ───────────────────────────────────────────── */
    .auth-right {
      display: flex; align-items: center; justify-content: center;
      padding: 2rem; background: rgba(0,0,0,0.3);
      border-left: 1px solid rgba(255,255,255,0.06);
    }

    .signin-card {
      background: rgba(10, 15, 26, 0.95);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 2.5rem 2rem;
      width: 100%; max-width: 420px;
      box-shadow: 0 30px 70px rgba(0,0,0,0.5);
      display: flex; flex-direction: column; gap: 1.1rem;
    }

    .signin-head h2 { margin: 0 0 0.25rem; font-size: 1.25rem; font-weight: 700; }
    .signin-head p  { margin: 0; color: rgba(255,255,255,0.5); font-size: 0.88rem; }
    .inline-link { color: #a5b4fc; text-decoration: none; }
    .inline-link:hover { text-decoration: underline; }

    /* Providers */
    .providers { display: grid; gap: 0.75rem; }
    .provider-form { margin: 0; }

    .provider-button {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
      width: 100%; text-decoration: none;
      border-radius: 12px; padding: 0.9rem 1rem;
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.07);
      color: #fff; font-size: 0.97rem; font-weight: 650;
      cursor: pointer;
      transition: transform 0.18s ease, opacity 0.18s ease, border-color 0.18s ease, background 0.18s ease;
      position: relative; flex-direction: column;
    }
    .provider-button:hover {
