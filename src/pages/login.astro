---
import Layout from "@/layouts/LoginLayout.astro";
import { getAuthSession } from "../lib/authSession";
import { getPostLoginRedirect } from "../lib/postLoginRedirect";
import Logo from "../assets/logo.jpeg";

const { searchParams } = Astro.url;
const error = searchParams.get("error");
const next = searchParams.get("next");
const callbackParam = searchParams.get("callbackUrl");
const nextPath =
  typeof next === "string"
    ? next
    : typeof callbackParam === "string"
      ? callbackParam
      : null;

const callbackUrl = getPostLoginRedirect(nextPath);
const safeCallbackUrl = callbackUrl.startsWith("/") ? callbackUrl : "/dashboard/vault";

const message =
  error === "missing"
    ? "Sign in to continue."
    : error === "Configuration"
      ? "Sign-in is temporarily unavailable. Please try again in a moment."
      : error === "OAuthAccountNotLinked"
        ? "LOCKED_OUT"
        : error
          ? "Sign-in failed. Please try again."
          : "";

const signup = searchParams.get("signup");
const verified = searchParams.get("verified");
const notice =
  signup === "success"
    ? "Account created. Check your inbox to verify your email."
    : verified === "success"
      ? "Email verified. You can sign in now."
      : verified === "expired"
        ? "Verification link expired. Please sign in to request a new one."
        : verified === "failed"
          ? "Verification failed. Please try again."
          : "";

const session = await getAuthSession(Astro.request);

let csrfToken = "";
try {
  // Use AUTH_URL (the public domain) instead of Astro.url to avoid
  // ECONNREFUSED when the server tries to reach itself via localhost on Render.
  const authBase = process.env.AUTH_URL
    ? (/^https?:\/\//i.test(process.env.AUTH_URL)
        ? process.env.AUTH_URL.replace(/\/$/, "")
        : `https://${process.env.AUTH_URL}`)
    : Astro.url.origin;
  const csrfResponse = await fetch(`${authBase}/api/auth/csrf`, {
    headers: {
      cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });
  if (csrfResponse.ok) {
    const data = await csrfResponse.json();
    csrfToken = data?.csrfToken ?? "";
  }
} catch (error) {
  console.warn("Failed to load CSRF token server-side", error);
}
---

<Layout>
  <main class="auth-page">
    <div class="auth-shell">
      <a class="auth-logo" href="/" aria-label="Almstins home">
        <img src={Logo.src} width="75" height="75" alt="Almstins logo" />
      </a>
      <!-- LEFT: Hero + copy + FAQ -->
      <section class="auth-left">

        <div class="welcome-copy">
        <h1>Welcome to Almstins — Your Financial Reality, Finally in One Place.</h1>
        <ul>
          <li>Track crypto, DeFi, traditional investments, and liabilities in one dashboard</li>
          <li>Real-time visibility into your net worth, performance, and risk exposure</li>
          <li>No wallet connection required — just your public address</li>
          <li>Encrypted database. Your data is never sold.</li>
        </ul>
        </div>
      </section>

      <!-- RIGHT: Sign-in panel -->
      <section class="auth-right">
        <div class="signin-card">
        <header class="signin-head">
          <h2>Sign in</h2>
          <p>Use Google, GitHub, email + password, or a magic link.</p>

          {message === "LOCKED_OUT" ? null : message ? (
            <p class="notice">{message}</p>
          ) : null}
          {notice && <p class="notice success">{notice}</p>}
          {session?.user?.id && (
            <a class="provider-button ghost" href={safeCallbackUrl}>Continue to Dashboard</a>
          )}
        </header>

        <div class="providers">
          <form id="login-google" class="provider-form" method="POST" action="/api/auth/signin/google">
            <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button class="provider-button google" type="submit" data-provider="google" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
              <span class="provider-label">Continue with Google</span>
              <span class="last-used-badge" data-badge="google" hidden>Last used</span>
            </button>
          </form>

          <form id="login-github" class="provider-form" method="POST" action="/api/auth/signin/github">
            <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button class="provider-button github" type="submit" data-provider="github" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
              <span class="provider-label">Continue with GitHub</span>
              <span class="last-used-badge" data-badge="github" hidden>Last used</span>
            </button>
          </form>
        </div>

        <a class="provider-button new-account" href="/signup">✦ New here? Create a free account</a>

        <div class="demo-divider">or explore first</div>
        <a class="provider-button demo-try" href="/api/demo/start">
          ▶ Try the demo — no account needed
        </a>

        <div class="divider">or sign in</div>

        <form id="login-email-password" class="stack" method="POST" action="/api/auth/callback/credentials">
          <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
          <input type="hidden" name="csrfToken" value={csrfToken} />

          <label>
            <span>Email address</span>
            <input type="email" name="email" placeholder="you@example.com" required />
          </label>

          <label>
            <span>Password</span>
            <input type="password" name="password" minlength="10" required />
          </label>

          <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>Sign in with email</button>
        </form>

        <div class="divider">or magic link</div>

        <form id="login-magic-link" class="stack" method="POST" action="/api/auth/signin/email">
          <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
          <input type="hidden" name="csrfToken" value={csrfToken} />

          <label>
            <span>Email address</span>
            <input type="email" name="email" placeholder="you@example.com" required />
          </label>

          <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>Send magic link</button>
        </form>

        <a class="provider-button ghost" href="/signup">Create an account</a>

      </div>
      <script>
        (async () => {
          try {
            const res = await fetch("/api/auth/csrf", { credentials: "same-origin" });
            if (!res.ok) return;
            const data = await res.json();
            if (!data?.csrfToken) return;

            document.querySelectorAll('input[name="csrfToken"]').forEach((el) => {
              el.value = data.csrfToken;
            });

            // enable buttons once token is ready
            document.querySelectorAll("button[data-needs-csrf]").forEach((b) => {
              b.removeAttribute("disabled");
            });
          } catch (e) {
            console.warn("[login] csrf fetch failed", e);
          }
        })();

        // "Last used" badge — remember which provider was used and highlight it on return
        (() => {
          const STORAGE_KEY = 'alms_last_provider';
          const lastProvider = localStorage.getItem(STORAGE_KEY);

          if (lastProvider) {
            const badge = document.querySelector(`[data-badge="${lastProvider}"]`);
            if (badge) {
              badge.removeAttribute('hidden');
              // Also add a visual ring to the button so it stands out
              badge.closest('button')?.classList.add('last-used');
            }
          }

          // Record the provider when the user clicks
          document.querySelectorAll('button[data-provider]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const provider = btn.getAttribute('data-provider');
              if (provider) localStorage.setItem(STORAGE_KEY, provider);
            });
          });
        })();
      </script>

    </section>
    </div>
  </main>

  <!-- ── Scam checker CTA ─────────────────────────────────────────────── -->
  <div class="checker-bar">
    <a class="checker-link" href="/wallet-checker">🔍 Free Wallet Scam Checker — no account needed</a>
  </div>

  <!-- ── Anonymous question / FAQ suggestion box ──────────────────────── -->
  <div class="contact-section">
    <div class="contact-card">
      <h3 class="contact-heading">What's keeping you from signing up today?</h3>
      <p class="contact-sub">Have a question? We read everything — great questions end up in the FAQ.</p>
      <form id="contact-form" autocomplete="off" novalidate>
        <input
          id="contact-subject"
          type="text"
          name="subject"
          maxlength="120"
          placeholder="Subject"
          class="contact-input"
          required
        />
        <div class="contact-body-wrap">
          <textarea
            id="contact-body"
            name="body"
            maxlength="500"
            rows="4"
            placeholder="Your question or thought…"
            class="contact-input contact-textarea"
            required
          ></textarea>
          <div class="contact-char"><span id="contact-char-count">0</span> / 500</div>
        </div>
        <button type="submit" class="contact-submit">Submit anonymously</button>
        <p id="contact-status" class="contact-status" hidden></p>
      </form>
    </div>
  </div>

  <script>
    (() => {
      const form    = document.getElementById('contact-form') as HTMLFormElement | null;
      const body    = document.getElementById('contact-body') as HTMLTextAreaElement | null;
      const counter = document.getElementById('contact-char-count');
      const status  = document.getElementById('contact-status');

      body?.addEventListener('input', () => {
        if (counter) counter.textContent = String(body.value.length);
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value.trim();
        const bodyVal = body?.value.trim();
        if (!subject || !bodyVal) return;

        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Sending…';

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subject, body: bodyVal }),
          });
          const data = await res.json();
          if (data.ok) {
            form.reset();
            if (counter) counter.textContent = '0';
            if (status) {
              status.textContent = '✓ Submitted — thanks!';
              status.style.color = '#4ade80';
              status.hidden = false;
            }
          } else {
            throw new Error(data.error ?? 'Submit failed');
          }
        } catch (err: unknown) {
          if (status) {
            status.textContent = err instanceof Error ? err.message : 'Something went wrong';
            status.style.color = '#f87171';
            status.hidden = false;
          }
        } finally {
          btn.disabled = false;
          btn.textContent = 'Submit anonymously';
        }
      });
    })();
  </script>

  {message === "LOCKED_OUT" && (
    <div class="session-overlay" id="session-overlay">
      <div class="session-popup" role="alertdialog" aria-modal="true" aria-labelledby="session-title">
        <div class="session-popup__icon">🔐</div>
        <h2 id="session-title">You're already signed in</h2>
        <p>It looks like you have an active session on another browser or device. Sign out first, then try again.</p>
        <div class="session-popup__actions">
          <a class="session-popup__btn session-popup__btn--primary" href="/api/auth/signout">Sign out &amp; try again</a>
          <button class="session-popup__btn session-popup__btn--ghost" id="session-dismiss">Dismiss</button>
        </div>
      </div>
    </div>
    <script is:inline>
      document.getElementById('session-dismiss')?.addEventListener('click', function() {
        document.getElementById('session-overlay')?.remove();
      });
    </script>
  )}

  <style>
    :root {
      color-scheme: dark;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #131628, #05060c 65%);
      min-height: 100vh;
      color: #f5f8ff;
    }

    /* ✅ stop vertical centering — allow the page to breathe and scroll naturally */
    .auth-page {
      width: 100%;
    }

    .auth-shell {
      width: 100%;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 100vh;
      background: #0a0f1a;
      color: #f7f2eb;
      position: relative;
    }

    @media (max-width: 900px) {
      .auth-shell {
        min-height: auto;
        width: calc(100% - 2rem);
        margin: 0 1rem;
        grid-template-columns: 1fr;
        padding-top: 1.5rem;
      }
    }

    .auth-left {
      padding: 5rem 3rem 3rem 5rem;
      display: flex;
      flex-direction: column;
      gap: 3rem;
      background: linear-gradient(to bottom right, #0d1525, #0a0f1a);
    }

    .auth-logo {
      position: absolute;
      top: 3rem;
      left: 1rem;
      width: 75px;
      height: 75px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
      z-index: 20;
    }

    .auth-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .welcome-copy h1 {
      margin: 3rem 0 0.5rem;
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.01em;
    }

    .welcome-copy {
      margin-left: 1.5rem;
      max-width: 680px;
    }

    @media (max-width: 900px) {
      .welcome-copy {
        margin-left: 0;
      }
    }

    .welcome-copy p {
      margin: 0;
      color: rgba(255, 255, 255, 0.76);
      line-height: 1.8;
      font-size: 1.15rem;
    }

    .welcome-copy ul {
      margin: 0.75rem 0 0;
      padding-left: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      color: rgba(255, 255, 255, 0.76);
      line-height: 1.7;
      font-size: 1.1rem;
    }

    .auth-right {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: rgba(0, 0, 0, 0.25);
    }

    @media (max-width: 900px) {
      .auth-right {
        padding: 2rem;
      }
    }

    /* ✅ compact sign-in card */
    .signin-card {
      background: rgba(10, 15, 26, 0.92);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 3rem 2.5rem;
      width: 100%;
      max-width: 460px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
      display: grid;
      gap: 1.4rem;
    }

    .signin-head h2 {
      margin: 0 0 0.35rem;
      font-size: 1.2rem;
      font-weight: 650;
    }

    .signin-head p {
      margin: 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.95rem;
    }

    .providers {
      display: grid;
      gap: 1rem;
    }

    .provider-form {
      margin: 0;
    }

    .provider-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      text-decoration: none;
      border-radius: 12px;
      padding: 1.1rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 1.05rem;
      font-weight: 650;
      cursor: pointer;
      transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
    }

    .provider-button:hover {
      opacity: 0.92;
      transform: translateY(-1px);
      border-color: rgba(255, 255, 255, 0.35);
    }

    .provider-button.google {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      border: none;
    }

    .provider-button.github {
      background: linear-gradient(135deg, #0f172a, #1f2937);
      border: none;
    }

    /* "Last used" badge — shown on the provider the user signed in with last */
    .provider-button {
      position: relative;
      flex-direction: column;
      gap: 0.1rem;
    }

    .provider-label {
      display: block;
    }

    .last-used-badge {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.15rem 0.55rem;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.22);
      color: #fff;
      margin-top: 0.15rem;
      width: fit-content;
      align-self: center;
    }

    .provider-button.last-used {
      outline: 2px solid rgba(255, 255, 255, 0.55);
      outline-offset: 2px;
    }

    .provider-button.ghost {
      background: rgba(255, 255, 255, 0.06);
    }

    .provider-button.new-account {
      background: linear-gradient(135deg, #0f7a55, #0d9466);
      border: none;
      font-size: 0.97rem;
    }

    .checker-link {
      display: block;
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      color: #7dd3fc;
      text-decoration: none;
      padding: 0.65rem 1rem;
      border-radius: 10px;
      border: 1px solid rgba(125, 211, 252, 0.25);
      background: rgba(125, 211, 252, 0.06);
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .checker-link:hover {
      color: #fff;
      background: rgba(125, 211, 252, 0.14);
      border-color: rgba(125, 211, 252, 0.5);
    }

    .demo-divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 0.5rem 0;
      color: rgba(255, 255, 255, 0.45);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .demo-divider::before,
    .demo-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.1);
    }

    .provider-button.demo-try {
      background: linear-gradient(135deg, #7c3aed, #5865f2);
      border: none;
      font-size: 0.97rem;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 2rem 0;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .divider::before,
    .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.12);
    }

    .stack {
      display: grid;
      gap: 0.9rem;
    }

    label {
      display: grid;
      gap: 0.45rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 520;
    }

    input {
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(4px);
      color: #fff;
      padding: 1rem 1.25rem;
      font-size: 1.05rem;
    }

    input:focus {
      outline: 2px solid rgba(84, 144, 255, 0.9);
      outline-offset: 1px;
    }

    button {
      border-radius: 14px;
      padding: 0.9rem 1rem;
      border: none;
      background: linear-gradient(135deg, #5865f2, #7c3aed);
      color: #fff;
      font-size: 1rem;
      font-weight: 750;
      cursor: pointer;
      transition: opacity 0.2s ease, transform 0.18s ease, box-shadow 0.2s ease;
      box-shadow: 0 12px 30px rgba(124, 58, 237, 0.25);
    }

    button:hover {
      opacity: 0.95;
      transform: translateY(-2px);
      box-shadow: 0 20px 55px rgba(124, 58, 237, 0.4);
    }

    .notice {
      margin-top: 0.8rem;
      background: rgba(255, 107, 107, 0.12);
      border: 1px solid rgba(255, 107, 107, 0.35);
      color: #ffb5b5;
      padding: 0.65rem 0.85rem;
      border-radius: 12px;
      font-size: 0.9rem;
    }

    .notice.success {
      background: rgba(60, 179, 113, 0.12);
      border: 1px solid rgba(60, 179, 113, 0.35);
      color: #b6f3c4;
    }

    .notice.locked-out {
      background: rgba(251, 191, 36, 0.1);
      border: 1px solid rgba(251, 191, 36, 0.4);
      color: #fde68a;
      padding: 0.9rem 1rem;
      border-radius: 8px;
      margin-top: 0.8rem;
      font-size: 0.9rem;
    }
    .notice.locked-out strong {
      display: block;
      margin-bottom: 0.3rem;
      font-size: 0.95rem;
    }
    .notice.locked-out p {
      margin: 0;
    }
    .notice.locked-out a {
      color: #fbbf24;
      text-decoration: underline;
    }
    .notice.locked-out a:hover {
      color: #fde68a;
    }

    /* ── Session conflict popup ─────────────────────────── */
    .session-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 1rem;
    }

    .session-popup {
      background: #0f1624;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 2.5rem 2rem;
      max-width: 420px;
      width: 100%;
      text-align: center;
      box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);
      animation: popup-in 0.25s ease;
    }

    @keyframes popup-in {
      from { opacity: 0; transform: scale(0.93) translateY(12px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    .session-popup__icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .session-popup h2 {
      font-size: 1.35rem;
      margin: 0 0 0.75rem;
      color: #f7f2eb;
    }

    .session-popup p {
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.65);
      margin: 0 0 1.75rem;
      line-height: 1.6;
    }

    .session-popup__actions {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .session-popup__btn {
      display: block;
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      border: none;
      transition: opacity 0.15s ease;
    }

    .session-popup__btn:hover { opacity: 0.85; }

    .session-popup__btn--primary {
      background: linear-gradient(135deg, #3b7ef8, #1d4ed8);
      color: #fff;
    }

    .session-popup__btn--ghost {
      background: rgba(255, 255, 255, 0.07);
      color: rgba(255, 255, 255, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* ── Scam checker bar ──────────────────────────────────────────── */
    .checker-bar {
      display: flex;
      justify-content: center;
      padding: 1.5rem 1.5rem 0;
      background: #05060c;
    }

    /* ── Contact / FAQ box ─────────────────────────────────────────── */
    .contact-section {
      display: flex;
      justify-content: center;
      padding: 3rem 1.5rem 5rem;
      background: #05060c;
    }

    .contact-card {
      width: 100%;
      max-width: 580px;
