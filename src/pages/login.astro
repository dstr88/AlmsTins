---
import Layout from "@/layouts/LoginLayout.astro";
import { getAuthSession } from "../lib/authSession";
import { getPostLoginRedirect } from "../lib/postLoginRedirect";
import Logo from "../assets/logo.jpeg";
import Faq from "@/components/faq.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import DonnieLori2025 from "@/assets/donnie&lori2025.jpeg";

const { searchParams } = Astro.url;
const error = searchParams.get("error");
const next = searchParams.get("next");
const callbackParam = searchParams.get("callbackUrl");
const nextPath =
  typeof next === "string"
    ? next
    : typeof callbackParam === "string"
      ? callbackParam
      : null;

const callbackUrl = getPostLoginRedirect(nextPath);

const message =
  error === "missing"
    ? "Sign in to continue."
    : error
      ? "Sign-in failed. Please try again."
      : "";

const signup = searchParams.get("signup");
const verified = searchParams.get("verified");
const notice =
  signup === "success"
    ? "Account created. Check your inbox to verify your email."
    : verified === "success"
      ? "Email verified. You can sign in now."
      : verified === "expired"
        ? "Verification link expired. Please sign in to request a new one."
        : verified === "failed"
          ? "Verification failed. Please try again."
          : "";

const session = await getAuthSession(Astro.request);
if (session) {
  return Astro.redirect(callbackUrl, 303);
}
---

<Layout>
  <main class="auth-page">
    <ProfileCard name="Donnie" photoSrc={DonnieLori2025} />
    <div class="auth-shell">
      <a class="auth-logo" href="/" aria-label="Almstins home">
        <img src={Logo.src} width="75" height="75" alt="Almstins logo" />
      </a>
      <!-- LEFT: Hero + copy + FAQ -->
      <section class="auth-left">

        <div class="welcome-copy">
        <h1>Welcome to Almstins — Your Financial Reality, Finally in One Place.</h1>
        <p>
          First of all, thanks for joining me on this journey. I am building a product that will track crypto, DeFi, traditional investments, and liabilities in a single intelligent dashboard.
          It is built for clarity and control. Almstins eliminates fragmented tools, hopping from one wallet to the next and the guesswork. This is the only open source tool that gives you real-time visibility into your net worth, performance, and risk exposure. See all of your wallets in one secure place. Whether you’re building wealth, managing multiple wallets, or optimizing strategies, Almstins helps you move faster, think smarter, keep track of everything in one convenient place and stay ahead.</p>
          <h3>Security</h3>
          <p>Built with your security in mind, there's no need to attach your wallet.  Just enter your public address. All the self-custody information is available to anyone who wants to dig for it.  Our database is encrypted, and your data is not for sale.</p> 
        </div>
        <Faq />
      </section>

      <!-- RIGHT: Sign-in panel -->
      <section class="auth-right">
        <div class="signin-card">
        <header class="signin-head">
          <h2>Sign in</h2>
          <p>Use Google, GitHub, email + password, or a magic link.</p>

          {message && <p class="notice">{message}</p>}
          {notice && <p class="notice success">{notice}</p>}
        </header>

        <div class="providers">
          <form class="provider-form" method="POST" action="/api/auth/signin/google">
            <input type="hidden" name="callbackUrl" value={callbackUrl} />
            <input type="hidden" name="csrfToken" value="" />
            <button class="provider-button google" type="submit">Continue with Google</button>
          </form>

          <form class="provider-form" method="POST" action="/api/auth/signin/github">
            <input type="hidden" name="callbackUrl" value={callbackUrl} />
            <input type="hidden" name="csrfToken" value="" />
            <button class="provider-button github" type="submit">Continue with GitHub</button>
          </form>
        </div>

        <div class="divider">or email</div>

        <form class="stack" method="POST" action="/api/auth/callback/credentials">
          <input type="hidden" name="callbackUrl" value={callbackUrl} />
          <input type="hidden" name="csrfToken" value="" />

          <label>
            <span>Email address</span>
            <input type="email" name="email" placeholder="you@company.com" required />
          </label>

          <label>
            <span>Password</span>
            <input type="password" name="password" minlength="10" required />
          </label>

          <button type="submit">Sign in with email</button>
        </form>

        <div class="divider">or magic link</div>

        <form class="stack" method="POST" action="/api/auth/signin/email">
          <input type="hidden" name="callbackUrl" value={callbackUrl} />
          <input type="hidden" name="csrfToken" value="" />

          <label>
            <span>Email address</span>
            <input type="email" name="email" placeholder="you@company.com" required />
          </label>

          <button type="submit">Send magic link</button>
        </form>

        <a class="provider-button ghost" href="/signup">Create an account</a>
      </div>

      <script lang="ts">
        (async () => {
          try {
            const response = await fetch("/api/auth/csrf", { credentials: "same-origin" });
            if (!response.ok) return;
            const data = await response.json();
            if (!data?.csrfToken) return;

            const inputs = document.querySelectorAll<HTMLInputElement>('input[name="csrfToken"]');
            inputs.forEach((input) => {
              input.value = data.csrfToken;
            });
          } catch (error) {
            console.warn("Failed to load CSRF token", error);
          }
        })();
      </script>
    </section>
    </div>
  </main>

  <style>
    :root {
      color-scheme: dark;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #131628, #05060c 65%);
      min-height: 100vh;
      color: #f5f8ff;
    }

    /* ✅ stop vertical centering — allow the page to breathe and scroll naturally */
    .auth-page {
      width: 100%;
    }

    .auth-shell {
      width: min(1100px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 2.25rem 0 3rem;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 2rem;
      align-items: start;
      position: relative;
    }

    @media (max-width: 900px) {
      .auth-shell {
        grid-template-columns: 1fr;
        padding-top: 1.5rem;
      }
    }

    .auth-left {
      display: grid;
      gap: 1.25rem;
      margin-top: 2rem;
    }

    .auth-logo {
      position: fixed;
      top: 5rem;
      left: 3rem;
      width: 75px;
      height: 75px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
      z-index: 20;
    }

    .auth-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .welcome-copy h1 {
      margin: 15rem 0 0.5rem;
      font-size: 1.35rem;
      font-weight: 650;
      letter-spacing: -0.01em;
    }

    .welcome-copy p {
      margin: 0;
      color: rgba(255, 255, 255, 0.76);
      line-height: 1.5;
      font-size: 0.98rem;
    }

    .auth-right {
      position: sticky;
      top: 1.25rem;
    }

    @media (max-width: 900px) {
      .auth-right {
        position: static;
      }
    }

    /* ✅ compact sign-in card */
    .signin-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      padding: 1.5rem;
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
      display: grid;
      gap: 1.1rem;
    }

    .signin-head h2 {
      margin: 0 0 0.35rem;
      font-size: 1.2rem;
      font-weight: 650;
    }

    .signin-head p {
      margin: 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.95rem;
    }

    .providers {
      display: grid;
      gap: 0.7rem;
    }

    .provider-form {
      margin: 0;
    }

    .provider-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      text-decoration: none;
      border-radius: 12px;
      padding: 0.78rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 0.98rem;
      font-weight: 650;
      cursor: pointer;
      transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
    }

    .provider-button:hover {
      opacity: 0.92;
      transform: translateY(-1px);
      border-color: rgba(255, 255, 255, 0.35);
    }

    .provider-button.google {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      border: none;
    }

    .provider-button.github {
      background: linear-gradient(135deg, #0f172a, #1f2937);
      border: none;
    }

    .provider-button.ghost {
      background: rgba(255, 255, 255, 0.06);
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 0.35rem 0;
      color: rgba(255, 255, 255, 0.55);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .divider::before,
    .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.12);
    }

    .stack {
      display: grid;
      gap: 0.9rem;
    }

    label {
      display: grid;
      gap: 0.45rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 520;
    }

    input {
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(4px);
      color: #fff;
      padding: 0.7rem 0.95rem;
      font-size: 1rem;
    }

    input:focus {
      outline: 2px solid rgba(84, 144, 255, 0.9);
      outline-offset: 1px;
    }

    button {
      border-radius: 12px;
      padding: 0.78rem 1rem;
      border: none;
      background: linear-gradient(135deg, #5767ff, #934dff);
      color: #fff;
      font-size: 0.98rem;
      font-weight: 650;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .notice {
      margin-top: 0.8rem;
      background: rgba(255, 107, 107, 0.12);
      border: 1px solid rgba(255, 107, 107, 0.35);
      color: #ffb5b5;
      padding: 0.65rem 0.85rem;
      border-radius: 12px;
      font-size: 0.9rem;
    }

    .notice.success {
      background: rgba(60, 179, 113, 0.12);
      border: 1px solid rgba(60, 179, 113, 0.35);
      color: #b6f3c4;
    }
  </style>
</Layout>
