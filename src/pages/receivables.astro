---
import LoginLayout from '../layouts/LoginLayout.astro';
import AlmstinsLogo from '../assets/logo.jpeg';
import VerifyLogo from '../assets/verify-logo.svg?url';

const title = 'Receivables — Almstins Verify';
const description =
  'A shared, checkable record for any receivable: what is already financed against it, whether the debtor has acknowledged it, and dated proof that stands up later. Read-only. Almstins never holds or moves the asset.';
const canonical = 'https://almstins.com/receivables';

// Every receivables service. The general Verify tools (safety scanner, publisher
// attestation, the payment-agent API) live on /verify; the private milestone desk is
// deliberately not listed here.
const groups = [
  {
    heading: 'Check & finance',
    note: 'The financier’s side.',
    cards: [
      { href: '/verify/desk', title: 'Financing Desk', body: 'Unencumbered headroom, a clear verdict, the claim register, and Verify now on any receivable.' },
      { href: '/verify/registry', title: 'Check a receivable', body: 'Paste a receivable ID to see what is already claimed against it. Public, no login.' },
    ],
  },
  {
    heading: 'Record & prove',
    note: 'The supplier’s side.',
    cards: [
      { href: '/verify/client', title: 'Client Portal', body: 'Record a receivable and hand its ID to the financiers you choose. Show it is real and unpledged.' },
    ],
  },
  {
    heading: 'Sign in & reference',
    note: null,
    cards: [
      { href: '/verify/login', title: 'Sign in', body: 'Log in as a client or a financier.' },
      { href: '/verify/guide', title: 'Using the desk', body: 'A short guide to the financing desk.' },
      { href: '/verify/runsheet', title: 'Pilot run sheet', body: 'Run one real receivable end to end.' },
      { href: '/verify/changelog', title: 'What changed', body: 'The build log for Almstins Verify.' },
    ],
  },
];

const demos = [
  { href: '/artifacts/registry', title: 'Receivables registry', body: 'Can two lenders finance the same invoice? Try the duplicate-financing check live, in your browser. No login.' },
  { href: '/artifacts/proof', title: 'A Bitcoin-anchored proof', body: 'See how a signed record earns a dated, tamper-evident timestamp on Bitcoin.' },
];

// The party-facing steps arrive as a secure link and can't be browsed to — visiting one
// without its token just shows "this link is not valid" — so they're named here, not linked.
const partySteps = 'Buyers and suppliers reach the confirmation steps by a secure link, not from here: acknowledging a debt, confirming an invoice, attesting a deal, confirming funds arrived, reviewing a financing offer, or accepting an invitation. Each opens only from the link it was sent with.';

const trust = [
  { title: 'Read-only. No custody.', body: 'Almstins reads and records. It never holds, signs for, or moves the invoice or the money, so a breach of Almstins cannot move a thing.' },
  { title: 'It organizes; it never decides.', body: 'The registry shows what is claimed and what is acknowledged. The financing call stays entirely yours.' },
  { title: 'Provable, not promised.', body: 'Every record is signed, and its date can be anchored to Bitcoin, so it holds up in a dispute instead of resting on anyone’s word.' },
];
---

<LoginLayout title={title} description={description} noindex={false} lang="en" canonical={canonical} favicon="/favicon-verify.png">

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Almstins Verify — Receivables',
    url: canonical,
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    creator: { '@type': 'Organization', name: 'Almstins', url: 'https://almstins.com' },
  })} />

  <!-- Top nav -->
  <nav class="rnav" aria-label="Almstins">
    <a class="rnav__brand" href="/verify">
      <span class="rnav__wordmark">Almstins Verify</span>
      <span class="rnav__tag">Receivables</span>
    </a>
    <div class="rnav__right">
      <a class="rnav__login" href="/verify/login">Sign in</a>
      <a class="rnav__logo" href="/" aria-label="Almstins home">
        <img src={AlmstinsLogo.src} alt="Almstins" width="960" height="1104" loading="eager" decoding="async" />
      </a>
    </div>
  </nav>

  <div class="rpage">

    <!-- Hero -->
    <header class="rhero">
      <div class="rhero__copy">
        <h1 class="rhero__title">Verify a receivable. Prove your own.</h1>
        <p class="rhero__sub">
          A shared, checkable record for any invoice: what is already financed against it, whether the
          debtor has acknowledged it, and dated proof that stands up later. Read-only. Almstins records
          and proves state; it never holds or moves the asset, and never makes the financing decision.
        </p>
        <div class="rhero__ctas">
          <a class="rbtn" href="/verify/desk">Open the desk</a>
          <a class="rbtn rbtn--demo" href="/artifacts/registry">Try the demo</a>
          <a class="rbtn rbtn--ghost" href="/verify/registry">Check a receivable</a>
        </div>
        <p class="rhero__who">For lenders, private-credit and factoring investors, the suppliers who raise the invoice, and the auditors who check it.</p>
      </div>

      <!-- Synthetic product preview (decorative; the demo entity, never real data) -->
      <div class="rhero__visual" aria-hidden="true">
        <div class="rpreview">
          <div class="rpreview__top">
            <img class="rpreview__mark" src={VerifyLogo} width="26" height="26" alt="" loading="eager" decoding="async" />
            <span class="rpreview__id">INV-4471</span>
            <span class="rpreview__rag">Partially encumbered</span>
          </div>
          <div class="rpreview__lead">₦80,000,000 <span>of ₦100,000,000 financed</span></div>
          <div class="rpreview__bar"><span></span></div>
          <div class="rpreview__legend"><span>Claimed ₦80m</span><span class="rpreview__free">Free ₦20m</span></div>
          <div class="rpreview__meta">Lagos Foods → MegaRetail</div>
          <ul class="rpreview__rows">
            <li><span class="rp-ok">✓</span> Debtor acknowledged the invoice</li>
            <li><span class="rp-seal">⛓</span> Anchored to Bitcoin · 2026-07-12</li>
            <li><span class="rp-warn">▲</span> A second claim would exceed the headroom</li>
          </ul>
        </div>
      </div>
    </header>

    <!-- Demos -->
    <section class="rsection" aria-labelledby="rdemo-h">
      <h2 id="rdemo-h" class="rsection__heading">See it work</h2>
      <p class="rsection__lede">Interactive, in your browser, no login. The mechanism, honestly shown.</p>
      <div class="rgrid">
        {demos.map((d) => (
          <a class="rcard rcard--demo" href={d.href}>
            <span class="rcard__title"><span class="rcard__tag">Demo</span>{d.title}</span>
            <span class="rcard__body">{d.body}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Tools -->
    {groups.map((g) => (
      <section class="rsection" aria-label={g.heading}>
        <h2 class="rsection__heading">{g.heading}</h2>
        {g.note && <p class="rsection__lede">{g.note}</p>}
        <div class="rgrid">
          {g.cards.map((c) => (
            <a class="rcard" href={c.href}>
              <span class="rcard__title">{c.title}<span class="rcard__arrow" aria-hidden="true">→</span></span>
              <span class="rcard__body">{c.body}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Party-facing steps: named, not linked (they only open from a sent token) -->
    <section class="rsection">
      <p class="rnote">{partySteps}</p>
    </section>

    <!-- Trust / bright lines -->
    <section class="rsection rtrust" aria-labelledby="rtrust-h">
      <h2 id="rtrust-h" class="rsection__heading">Why you can rely on it</h2>
      <div class="rgrid">
        {trust.map((p) => (
          <div class="rcard rcard--static">
            <span class="rcard__title">{p.title}</span>
            <span class="rcard__body">{p.body}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="rfoot">
      <a class="rfoot__link" href="/verify">Almstins Verify</a>
      <span class="rfoot__dot" aria-hidden="true">·</span>
      <a class="rfoot__link" href="https://almstins.com">almstins.com</a>
    </footer>

  </div>
</LoginLayout>

<style>
  /* All colors reference design tokens from src/styles/tokens.css (loaded by LoginLayout). */
  .rpage {
    width: 100%;
    box-sizing: border-box;
    max-width: 1080px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    color: var(--text-primary);
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* Nav */
  .rnav {
    position: sticky;
    top: 0;
    z-index: 50;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: color-mix(in srgb, var(--surface-bg) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .rnav__brand { display: flex; align-items: baseline; gap: 0.5rem; text-decoration: none; }
  .rnav__wordmark { font-size: 1.05rem; font-weight: 800; letter-spacing: -0.01em; color: var(--text-primary); }
  .rnav__tag {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-glow);
    padding: 0.15rem 0.5rem; border-radius: 999px;
  }
  .rnav__right { display: flex; align-items: center; gap: 0.75rem; }
  .rnav__login {
    font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-decoration: none;
    padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid var(--border-bright);
    transition: color 0.15s ease, border-color 0.15s ease; white-space: nowrap;
  }
  .rnav__login:hover { color: var(--text-primary); border-color: var(--accent); }
  .rnav__logo { display: inline-flex; align-items: center; line-height: 0; flex-shrink: 0; }
  .rnav__logo img { height: 38px; width: auto; border-radius: 9px; border: 1px solid var(--border-subtle); display: block; }

  /* Buttons */
  .rbtn {
    display: inline-block; padding: 0.8rem 1.5rem; border-radius: 999px;
    background: var(--accent); color: var(--surface-bg);
    font-size: 0.95rem; font-weight: 700; text-decoration: none;
    transition: filter 0.15s ease, transform 0.15s ease; box-shadow: 0 6px 22px var(--accent-glow);
  }
  .rbtn:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .rbtn--demo { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-glow); box-shadow: none; }
  .rbtn--demo:hover { color: var(--text-primary); border-color: var(--accent); }
  .rbtn--ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--border-bright); box-shadow: none; font-weight: 600; }
  .rbtn--ghost:hover { color: var(--text-primary); border-color: var(--accent); transform: none; }

  /* Hero — two columns: copy + a synthetic product preview */
  .rhero {
    display: grid; grid-template-columns: 1fr; gap: 2.25rem; align-items: center;
    padding: 1.5rem 0 3rem; border-bottom: 1px solid var(--border-subtle); margin-bottom: 3rem;
  }
  @media (min-width: 860px) { .rhero { grid-template-columns: 1.05fr 0.95fr; gap: 3rem; } }
  .rhero__copy { min-width: 0; }
  .rhero__title {
    font-size: clamp(1.9rem, 4.6vw, 2.9rem); font-weight: 800; line-height: 1.14; letter-spacing: -0.02em;
    margin: 0 0 1.1rem; color: var(--text-primary);
  }
  .rhero__sub { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin: 0 0 1.6rem; }
  .rhero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .rhero__who { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; margin: 1.5rem 0 0; }

  /* Synthetic product-preview card (decorative) */
  .rhero__visual { display: flex; justify-content: center; }
  .rpreview {
    width: 100%; max-width: 400px; box-sizing: border-box;
    background: var(--surface-card-2); border: 1px solid var(--border-bright);
    border-radius: 16px; padding: 1.2rem 1.3rem; box-shadow: 0 10px 40px var(--accent-glow);
  }
  .rpreview__top { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.95rem; }
  .rpreview__mark { border-radius: 6px; display: block; }
  .rpreview__id { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.72rem; letter-spacing: 0.04em; color: var(--text-muted); }
  .rpreview__rag {
    margin-left: auto; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--warning); background: var(--warning-bg); border: 1px solid var(--warning-border);
    padding: 0.2rem 0.5rem; border-radius: 999px;
  }
  .rpreview__lead { font-size: 1.15rem; font-weight: 800; color: var(--text-primary); }
  .rpreview__lead span { font-size: 0.82rem; font-weight: 500; color: var(--text-muted); }
  .rpreview__bar { height: 8px; border-radius: 999px; background: var(--surface-hover); overflow: hidden; margin: 0.7rem 0 0.45rem; }
  .rpreview__bar span { display: block; width: 80%; height: 100%; background: var(--warning); border-radius: 999px; }
  .rpreview__legend { display: flex; justify-content: space-between; font-size: 0.76rem; color: var(--text-secondary); }
  .rpreview__free { color: var(--gain); }
  .rpreview__meta { font-size: 0.85rem; color: var(--text-secondary); margin: 0.85rem 0 0.9rem; padding-top: 0.85rem; border-top: 1px solid var(--border-subtle); }
  .rpreview__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .rpreview__rows li { display: flex; align-items: center; gap: 0.55rem; font-size: 0.84rem; color: var(--text-secondary); }
  .rp-ok { color: var(--gain); font-weight: 800; }
  .rp-seal { color: var(--accent); }
  .rp-warn { color: var(--warning); font-weight: 800; }

  /* Sections */
  .rsection { margin-bottom: 2.75rem; }
  .rsection__heading { font-size: clamp(1.2rem, 2.5vw, 1.55rem); font-weight: 800; letter-spacing: -0.01em; margin: 0 0 0.4rem; color: var(--text-primary); }
  .rsection__lede { font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; margin: 0 0 1.25rem; }
  .rnote { font-size: 0.9rem; color: var(--text-muted); line-height: 1.75; margin: 0; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 1rem 1.25rem; }

  /* Card grid */
  .rgrid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 620px) { .rgrid { grid-template-columns: 1fr 1fr; } }
  .rcard {
    display: flex; flex-direction: column; gap: 0.4rem;
    background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 14px;
    padding: 1.2rem 1.35rem; text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  a.rcard:hover { border-color: var(--accent); transform: translateY(-2px); background: var(--surface-hover); }
  .rcard--static { cursor: default; }
  .rcard--demo { background: var(--accent-soft); border-color: var(--accent-glow); }
  a.rcard--demo:hover { background: var(--accent-soft); border-color: var(--accent); }
  .rcard__title { display: flex; align-items: center; gap: 0.5rem; font-size: 1rem; font-weight: 700; color: var(--text-primary); }
  .rcard__arrow { margin-left: auto; color: var(--accent); font-weight: 700; }
  .rcard__tag {
    font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--accent); background: var(--surface-bg); border: 1px solid var(--accent-glow);
    padding: 0.12rem 0.45rem; border-radius: 999px;
  }
  .rcard__body { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.65; }

  /* Trust */
  .rtrust { border-top: 1px solid var(--border-subtle); padding-top: 2.5rem; }

  /* Footer */
  .rfoot { text-align: center; border-top: 1px solid var(--border-subtle); padding-top: 2rem; margin-top: 1rem; display: flex; gap: 0.6rem; justify-content: center; align-items: center; }
  .rfoot__link { font-size: 0.85rem; color: var(--accent-dim); text-decoration: none; transition: color 0.15s ease; }
  .rfoot__link:hover { color: var(--accent); }
  .rfoot__dot { color: var(--text-muted); }

  @media (max-width: 480px) {
    .rpage { padding: 2rem 1rem 4rem; }
    .rnav { padding: 0.75rem 1rem; }
    .rhero__ctas .rbtn { width: 100%; text-align: center; }
  }
</style>
