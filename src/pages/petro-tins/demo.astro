---
/**
 * /petro-tins/demo
 *
 * Entry point for the PetroTins demo.
 *
 * 1. Clears any existing real-session cookies so a logged-in user isn't
 *    hijacked into their own dashboard instead of the demo.
 * 2. Redirects to /api/demo/start which re-seeds fresh demo data for
 *    DEMO_TENANT_ID, sets the demo cookie, and lands on the full
 *    interactive dashboard (/dashboard/petro-tins).
 *
 * Each visit re-seeds, so the next visitor always starts fresh.
 * The dashboard is fully interactive — visitors can edit, add, and delete.
 */

export const prerender = false;

const headers = new Headers();
headers.append('Location', '/api/demo/start?next=/dashboard/petro-tins');

// Clear all known session cookie names so the real session doesn't
// override the demo cookie in middleware.
const cookieNames = [
  'next-auth.session-token',
  'authjs.session-token',
  '__Secure-next-auth.session-token',
  '__Secure-authjs.session-token',
];
for (const name of cookieNames) {
  headers.append(
    'Set-Cookie',
    `${name}=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; SameSite=Lax`,
  );
}

return new Response(null, { status: 302, headers });
---
