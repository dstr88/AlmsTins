---
// Sign-up email confirmation. The verification email links here (older emails link to
// GET /api/verify-email, which redirects here). Rendering this page changes nothing; the
// Confirm button POSTs the token to /api/verify-email. That way a mail-security scanner
// that opens every link in an inbox cannot confirm a password someone else registered on
// the recipient's address. Public (isPublicPath); no analytics, since the URL carries the
// token.
import '@/styles/tokens.css';
import { getVerifyEmailPage } from '@/i18n/verifyEmailPage';
import { loginPathForLang } from '@/lib/authErrorRedirect';

export const prerender = false;

const params = Astro.url.searchParams;
const langRaw = params.get('lang');
const lang = langRaw === 'es' || langRaw === 'fr' ? langRaw : 'en';
const t = getVerifyEmailPage(lang);
const token = (params.get('token') ?? '').slice(0, 256);
const email = (params.get('email') ?? '').slice(0, 254);
const complete = Boolean(token && email);
const loginPath = loginPathForLang(lang);
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="same-origin" />
  <title>{t.title}</title>
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--surface-bg);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .card {
      width: 100%;
      max-width: 440px;
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 28px 24px;
    }
    h1 { font-size: 1.35rem; line-height: 1.3; margin-bottom: 12px; }
    p { color: var(--text-secondary); line-height: 1.55; margin-bottom: 16px; overflow-wrap: anywhere; }
    .address { color: var(--text-primary); font-weight: 600; }
    .confirm {
      width: 100%;
      padding: 12px 16px;
      border: 0;
      border-radius: 10px;
      background: var(--accent);
      color: var(--surface-bg);
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
    }
    .confirm:hover { box-shadow: 0 0 0 3px var(--accent-glow); }
    .warning { color: var(--text-muted); font-size: 0.9rem; margin: 16px 0 0; }
    .back { display: inline-block; margin-top: 16px; color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>
  <main class="card">
    <h1>{t.heading}</h1>
    {complete ? (
      <>
        <p>{t.body}</p>
        <p class="address">{email}</p>
        <form method="POST" action="/api/verify-email">
          <input type="hidden" name="token" value={token} />
          <input type="hidden" name="email" value={email} />
          <input type="hidden" name="lang" value={lang} />
          <button class="confirm" type="submit">{t.button}</button>
        </form>
        <p class="warning">{t.warning}</p>
      </>
    ) : (
      <>
        <p>{t.incomplete}</p>
        <a class="back" href={loginPath}>{t.signIn}</a>
      </>
    )}
  </main>
</body>
</html>
