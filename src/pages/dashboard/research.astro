    color: rgba(255,255,255,0.35);
    margin-bottom: 0.65rem;
  }
  .addr-info-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
  }
  .addr-info-chip {
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
