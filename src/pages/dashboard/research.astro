    transition: background 0.12s;
  }
  .wallet-picker-item:last-child { border-bottom: none; }
  .wallet-picker-item:hover { background: rgba(255,255,255,0.07); }
  .wpi-label { font-size: 0.88rem; font-weight: 600; color: rgba(255,255,255,0.85); }
  .wpi-addr  { font-size: 0.73rem; color: rgba(255,255,255,0.35); font-family: monospace; }

  /* ── Address lookup panel ────────────────────────────────────────────────── */
  .addr-panel {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 1rem 1.25rem;
