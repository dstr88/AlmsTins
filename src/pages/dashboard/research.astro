---
import Layout from '../../layouts/Layout.astro';
import { requireTenantSession } from '../../lib/requireTenantSession';
import { db } from '../../lib/db';

const session = await requireTenantSession(Astro.request);
if (!session) return Astro.redirect('/login');
const { tenantId } = session;

// Load all distinct symbols the user has data for (for the chip row)
const symbolResult = await db.execute({
  sql: `SELECT DISTINCT upper(asset_symbol) as sym
        FROM import_transactions
        WHERE tenant_id = ? AND asset_symbol IS NOT NULL
        ORDER BY upper(asset_symbol) ASC`,
  args: [tenantId],
});
const allSymbols = symbolResult.rows.map(r => String((r as any).sym ?? '')).filter(Boolean);
---

<Layout title="Research | Almstins" noindex={true}>
  <section class="research-page">

    <!-- ── Search card ─────────────────────────────────────────────────────── -->
    <div class="search-card">
      <div class="search-tier-1">
        <span class="search-icon">🔍</span>
        <input
          id="q"
          type="text"
          placeholder="Search by hash, symbol, keyword, or note…"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="search-tier-2">
        <select id="filter-symbol">
          <option value="">All symbols</option>
          {allSymbols.map(sym => <option value={sym}>{sym}</option>)}
        </select>

        <input id="filter-from" type="date" title="From date" />
        <span class="date-sep">→</span>
        <input id="filter-to"   type="date" title="To date"   />

        <input id="filter-note" type="text" placeholder="Note keyword…" autocomplete="off" />
      </div>

      <!-- Symbol chips -->
      <div class="chip-row" id="chip-row">
        {allSymbols.map(sym => (
          <button class="chip" data-sym={sym} type="button">{sym}</button>
        ))}
      </div>

      <div class="search-actions">
        <button id="btn-run-matching" class="btn-secondary" type="button">⚙ Re-run matching</button>
        <button id="btn-search"       class="btn-primary"   type="button">Search</button>
      </div>
    </div>

    <!-- ── Two-column body ─────────────────────────────────────────────────── -->
    <div class="research-body">

      <!-- Left: Needs Attention -->
      <div class="col-left">
        <div class="col-header">
          <h2>Needs Attention <span id="na-count" class="count-badge"></span></h2>
        </div>
        <div id="na-list" class="item-list">
          <div class="loading-msg">Loading…</div>
        </div>

        <!-- Resolved tin -->
        <div class="resolved-header" id="resolved-header" style="display:none">
          <span>Resolved</span>
          <span id="resolved-count" class="count-badge-green"></span>
          <button id="resolved-toggle" class="resolved-toggle" type="button">▾ show</button>
        </div>
        <div id="resolved-list" class="resolved-list" style="display:none"></div>
      </div>

      <!-- Right: Search results -->
      <div class="col-right">
        <div class="col-header">
          <h2>Results <span id="results-count" class="count-badge"></span></h2>
          <div id="results-label" class="results-label" style="display:none"></div>
        </div>
        <div id="results-list" class="item-list">
          <div class="empty-msg">Use the search above or click a symbol chip to explore your transactions.</div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<!-- ── Suggested match confirmation modal ──────────────────────────────────── -->
<div class="modal-overlay" id="match-modal" style="display:none">
  <div class="modal-content">
    <button class="modal-close" id="match-modal-close">×</button>
    <h2>Confirm Transfer Match?</h2>
    <div id="match-modal-body"></div>
    <div class="modal-actions">
      <button class="btn-danger"    id="match-reject">Reject</button>
      <button class="btn-primary"   id="match-confirm">Confirm Match</button>
    </div>
  </div>
</div>

<style>
  .research-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  /* ── Search card ──────────────────────────────────────────────────────────── */
  .search-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 1.25rem 1.4rem 1rem;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .search-tier-1 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .search-icon { font-size: 1.1rem; opacity: 0.5; flex-shrink: 0; }
  .search-tier-1 input {
    flex: 1;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 9px;
    color: #fff;
    font-size: 1rem;
    padding: 0.65rem 0.9rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .search-tier-1 input:focus {
    border-color: rgba(251,191,36,0.6);
    box-shadow: 0 0 0 3px rgba(251,191,36,0.08);
  }

  .search-tier-2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .search-tier-2 select,
  .search-tier-2 input {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    color: rgba(255,255,255,0.7);
    font-size: 0.86rem;
    padding: 0.45rem 0.7rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .search-tier-2 select:focus,
  .search-tier-2 input:focus { border-color: rgba(251,191,36,0.5); }
  .search-tier-2 input[type="date"] { color-scheme: dark; width: 140px; }
  .search-tier-2 input[type="text"] { flex: 1; min-width: 140px; }
  .date-sep { opacity: 0.4; font-size: 0.85rem; }

  /* ── Chip row ────────────────────────────────────────────────────────────── */
  .chip-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 2px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.15) transparent;
  }
  .chip {
    flex-shrink: 0;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.7);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .chip:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.28); }
  .chip.active {
    border-color: rgba(251,191,36,0.7);
    background: rgba(251,191,36,0.1);
    color: #fbbf24;
  }

  /* ── Search actions ──────────────────────────────────────────────────────── */
  .search-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    padding-top: 0.2rem;
  }
  .btn-primary {
    background: #fbbf24;
    color: #000;
    border: none;
    border-radius: 9px;
    padding: 0.55rem 1.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.88; }
  .btn-secondary {
    background: rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.65);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 9px;
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.12); }
  .btn-danger {
    background: rgba(239,68,68,0.15);
    color: #f87171;
    border: 1px solid rgba(239,68,68,0.3);
    border-radius: 9px;
    padding: 0.5rem 1rem;
    font-size: 0.88rem;
    cursor: pointer;
  }

  /* ── Two-column body ────────────────────────────────────────────────────── */
  .research-body {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .research-body { grid-template-columns: 1fr; }
  }

  .col-left, .col-right {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 14px;
    overflow: hidden;
  }
  .col-header {
    padding: 0.9rem 1.1rem 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .col-header h2 {
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .results-label {
    font-size: 0.75rem;
    color: rgba(251,191,36,0.6);
    margin-top: 0.25rem;
    font-style: italic;
  }

  .count-badge {
    background: rgba(251,191,36,0.15);
    color: #fbbf24;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .count-badge-green {
    background: rgba(52,211,153,0.12);
    color: #34d399;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* ── Item list ───────────────────────────────────────────────────────────── */
  .item-list {
    max-height: 55vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.12) transparent;
  }
  .loading-msg, .empty-msg {
    padding: 2rem 1.1rem;
    color: rgba(255,255,255,0.35);
    font-size: 0.88rem;
    text-align: center;
  }

  /* ── Section labels ───────────────────────────────────────────────────────── */
  .section-label {
    padding: 0.55rem 1.1rem 0.3rem;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.3);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  /* ── Unified transaction card (NA items + result cards share this) ─────────── */
  .tx-card {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    margin: 0 4px 6px;
    border-radius: 8px;
    background: rgba(255,255,255,0.06);
    border-left: 3px solid transparent;
    transition: background 0.12s;
  }
  .tx-card:last-child { margin-bottom: 6px; }

  /* NA-specific state */
  .tx-card.na-item { cursor: pointer; }
  .tx-card.na-item:hover { background: rgba(255,255,255,0.09); }
  .tx-card.na-item.selected {
    background: rgba(251,191,36,0.10);
    border-left-color: #fbbf24 !important;
    outline: 1.5px solid rgba(251,191,36,0.55);
    outline-offset: -1px;
  }

  /* Result-card hover */
  .tx-card.result-card:hover { background: rgba(255,255,255,0.09); }

  /* Direction accent borders */
  .tx-card.dir-out { border-left-color: rgba(239,68,68,0.4); }
  .tx-card.dir-in  { border-left-color: rgba(52,211,153,0.35); }

  /* Badge column — direction pill, fixed width */
  .tx-badge-col {
    flex-shrink: 0;
    padding-top: 3px;
    width: 34px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .tx-dir {
    font-size: 0.68rem;
    padding: 0.18rem 0.42rem;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .tx-dir.out { background: rgba(239,68,68,0.15); color: #f87171; }
  .tx-dir.in  { background: rgba(52,211,153,0.12); color: #34d399; }

  /* Body — three rows */
  .tx-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.28rem; }

  /* Row 1: symbol (left) + token amount (right) */
  .tx-row-1 { display: flex; align-items: baseline; gap: 0.45rem; }
  .tx-sym   { font-weight: 700; font-size: 1rem; color: #fff; }
  .tx-amt   {
    margin-left: auto;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    white-space: nowrap;
  }

  /* Row 2: source (left) + USD (right) */
  .tx-row-2 { display: flex; align-items: center; gap: 0.45rem; }
  .tx-src   { font-size: 0.78rem; color: rgba(255,255,255,0.4); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tx-usd   { margin-left: auto; font-size: 0.78rem; color: rgba(255,255,255,0.38); white-space: nowrap; }

  /* Row 3: description or hint (left) + datetime (right) */
  .tx-row-3 { display: flex; align-items: center; gap: 0.45rem; }
  .tx-desc  { font-size: 0.73rem; color: rgba(255,255,255,0.27); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .tx-hint  { font-size: 0.73rem; color: rgba(251,191,36,0.5); font-style: italic; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tx-dt    { margin-left: auto; font-size: 0.72rem; color: rgba(255,255,255,0.3); white-space: nowrap; }

  /* ── Annotate button + inline form ──────────────────────────────────────── */
  .btn-annotate {
    margin-top: 0.45rem;
    background: none;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 6px;
    color: rgba(255,255,255,0.4);
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-annotate:hover { border-color: rgba(251,191,36,0.4); color: #fbbf24; }
  .btn-annotate.has-note { border-color: rgba(251,191,36,0.35); color: rgba(251,191,36,0.7); }

  .annotate-form {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .annotate-form select,
  .annotate-form input {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 7px;
    color: rgba(255,255,255,0.8);
    font-size: 0.8rem;
    padding: 0.4rem 0.6rem;
    outline: none;
    width: 100%;
  }
  .annotate-form select:focus,
  .annotate-form input:focus { border-color: rgba(251,191,36,0.5); }
  .annotate-form-row { display: flex; gap: 0.4rem; }
  .btn-annotate-save {
    background: #fbbf24; color: #000; border: none;
    border-radius: 7px; padding: 0.38rem 0.9rem;
    font-size: 0.78rem; font-weight: 700; cursor: pointer;
    white-space: nowrap;
  }
  .btn-annotate-save:hover { opacity: 0.88; }
  .btn-annotate-cancel {
    background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.5);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 7px;
    padding: 0.38rem 0.7rem; font-size: 0.78rem; cursor: pointer;
  }
  .category-badge {
    display: inline-block;
    font-size: 0.68rem; padding: 0.12rem 0.45rem; border-radius: 4px;
    background: rgba(251,191,36,0.12); color: #fbbf24;
    margin-right: 0.35rem; vertical-align: middle;
  }

  /* Match badge (inline with symbol) */
  .match-badge {
    font-size: 0.68rem; padding: 0.1rem 0.38rem; border-radius: 4px;
    background: rgba(52,211,153,0.12); color: #34d399; flex-shrink: 0;
  }
  .match-badge.suggested { background: rgba(251,191,36,0.12); color: #fbbf24; }

  /* ── Suggested match items ───────────────────────────────────────────────── */
  .suggest-item {
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    border-left: 3px solid rgba(251,191,36,0.4);
    cursor: pointer;
    transition: background 0.12s;
  }
  .suggest-item:hover { background: rgba(251,191,36,0.04); }
  .suggest-top  { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem; }
  .suggest-sym  { font-weight: 700; font-size: 0.95rem; color: #fbbf24; }
  .suggest-score { font-size: 0.72rem; color: rgba(255,255,255,0.35); }
  .suggest-flow  { font-size: 0.8rem; color: rgba(255,255,255,0.65); margin-bottom: 0.2rem; }
  .suggest-dates { font-size: 0.73rem; color: rgba(255,255,255,0.3); }
  .suggest-amt   { font-size: 0.78rem; color: rgba(255,255,255,0.45); margin-top: 0.15rem; }

  /* ── Resolved section ────────────────────────────────────────────────────── */
  .resolved-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(52,211,153,0.8);
  }
  .resolved-toggle {
    margin-left: auto;
    background: none;
    border: none;
    color: rgba(255,255,255,0.35);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0.1rem 0.3rem;
  }
  .resolved-toggle:hover { color: rgba(255,255,255,0.6); }
  .resolved-list {
    max-height: 30vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
    border-top: 1px solid rgba(52,211,153,0.1);
  }
  .resolved-item {
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    border-left: 3px solid rgba(52,211,153,0.35);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .resolved-top { display: flex; align-items: center; gap: 0.5rem; }
  .resolved-sym  { font-weight: 700; font-size: 0.9rem; color: rgba(52,211,153,0.85); }
  .resolved-badge {
    font-size: 0.68rem; padding: 0.1rem 0.4rem; border-radius: 4px;
    background: rgba(52,211,153,0.1); color: #34d399; margin-left: auto;
  }
  .resolved-flow { font-size: 0.78rem; color: rgba(255,255,255,0.45); }
  .resolved-meta { font-size: 0.72rem; color: rgba(255,255,255,0.28); }


  /* ── Modal ───────────────────────────────────────────────────────────────── */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex; align-items: center; justify-content: center;
    z-index: 9999;
  }
  .modal-content {
    background: #141414;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 1.75rem;
    max-width: 520px;
    width: 92%;
    position: relative;
  }
  .modal-content h2 { margin: 0 0 1rem; font-size: 1.05rem; }
  .modal-close {
    position: absolute; top: 12px; right: 14px;
    background: none; border: none; color: #aaa;
    font-size: 1.4rem; cursor: pointer;
  }
  .modal-actions { display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 1.25rem; }
  .match-detail  { font-size: 0.88rem; color: rgba(255,255,255,0.7); line-height: 1.8; }
  .match-detail strong { color: #fff; }
</style>

<script>
// ── State ─────────────────────────────────────────────────────────────────────
let activeChip    = '';
let pendingMatch  = null;
let resolvedOpen  = false;
let naContext     = null;   // { sym, dir } when search was triggered from NA click

// ── Helpers ───────────────────────────────────────────────────────────────────
const $  = id => document.getElementById(id);
const fmt = n => n == null ? '—' : Number(n).toLocaleString(undefined, { maximumFractionDigits: 8 });
const fmtUsd = n => n == null ? '' : '$' + Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const fmtDT = s => {
  if (!s) return '';
  try {
    const d = new Date(s.replace(' UTC','Z').replace(' ','T'));
    const date = d.toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' });
    const time = d.toLocaleTimeString(undefined, { hour:'2-digit', minute:'2-digit' });
    return `${date} · ${time}`;
  } catch { return s.slice(0,16); }
};

const fmtDate = s => {
  if (!s) return '';
  try {
    return new Date(s.replace(' UTC','Z').replace(' ','T')).toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' });
  } catch { return s.slice(0,10); }
};

const srcName = s => ({
  coinbase:'Coinbase', crypto_com:'Crypto.com', gemini:'Gemini',
  kraken:'Kraken', exodus:'Exodus', venmo:'Venmo', cashapp:'Cash App', robinhood:'Robinhood',
})[s] ?? s;

// ── Load Needs Attention ──────────────────────────────────────────────────────
async function loadNeedsAttention() {
  const list = $('na-list');
  list.innerHTML = '<div class="loading-msg">Loading…</div>';
  try {
    const res  = await fetch('/api/research/needs-attention');
    const data = await res.json();
    renderNeedsAttention(data);
  } catch (e) {
    list.innerHTML = `<div class="empty-msg">Failed to load: ${e.message}</div>`;
  }
}

function renderNeedsAttention(data) {
  const list  = $('na-list');
  const count = $('na-count');
  const total = data.total ?? 0;
  count.textContent = total > 0 ? String(total) : '';

  let html = '';

  // ── Suggested matches ──────────────────────────────────────────────────────
  if (data.suggested?.length) {
    html += `<div class="section-label">Suggested matches</div>`;
    for (const m of data.suggested) {
      const safeM = JSON.stringify(m).replace(/'/g,"&#39;");
      html += `<div class="suggest-item" data-match-id="${m.match_id}" data-match='${safeM}'>
        <div class="suggest-top">
          <span class="suggest-sym">${m.asset_symbol}</span>
          <span class="suggest-score">confidence ${m.confidence_score}</span>
        </div>
        <div class="suggest-flow">${srcName(m.out_source)}${m.out_account_name ? ' · ' + m.out_account_name : ''} → ${srcName(m.in_source)}${m.in_account_name ? ' · ' + m.in_account_name : ''}</div>
        <div class="suggest-dates">${fmtDate(m.out_ts)} → ${fmtDate(m.in_ts)}</div>
        <div class="suggest-amt">Sent ${fmt(m.out_amount)} · Received ${fmt(m.in_amount)}${m.fee_amount ? ' · Fee ' + fmt(m.fee_amount) : ''}</div>
      </div>`;
    }
  }

  // ── Unresolved transactions ────────────────────────────────────────────────
  if (data.unmatched?.length) {
    html += `<div class="section-label">Unresolved transactions</div>`;
    for (const t of data.unmatched) {
      const dir    = (t.direction ?? '').toLowerCase();
      const absAmt = Math.abs(Number(t.amount));
      const amt    = dir === 'out' ? `−${fmt(absAmt)}` : `+${fmt(absAmt)}`;
      const hint    = t.address_label
        ? `Source: ${t.address_label}`
        : dir === 'out' ? 'Click to find where this landed →' : 'Click to find where this came from →';
      const src     = `${srcName(t.source)}${t.account_name ? ' · ' + t.account_name : ''}`;
      const catLabel = t.category ? `<span class="category-badge">${t.category}</span>` : '';
      const noteText = t.notes   ? `<span style="font-size:0.72rem;color:rgba(255,255,255,0.45);font-style:italic">${t.notes}</span>` : '';
      const hasAnnotation = !!(t.category || t.notes);
      html += `<div class="tx-card na-item dir-${dir}" data-sym="${t.asset_symbol}" data-dir="${dir}" data-id="${t.id}" data-ts="${t.timestamp_utc}">
        <div class="tx-badge-col"><span class="tx-dir ${dir}">${dir}</span></div>
        <div class="tx-body">
          <div class="tx-row-1">
            <span class="tx-sym">${t.asset_symbol}</span>
            <span class="tx-amt">${amt} ${t.asset_symbol}</span>
          </div>
          <div class="tx-row-2">
            <span class="tx-src">${src}</span>
            ${t.native_usd ? `<span class="tx-usd">${fmtUsd(t.native_usd)}</span>` : ''}
          </div>
          <div class="tx-row-3">
            <span class="tx-hint">${hint}</span>
            <span class="tx-dt">${fmtDT(t.timestamp_utc)}</span>
          </div>
          ${hasAnnotation ? `<div style="margin-top:0.3rem">${catLabel}${noteText}</div>` : ''}
          <button class="btn-annotate${hasAnnotation ? ' has-note' : ''}"
                  data-tx-id="${t.id}"
                  data-category="${t.category ?? ''}"
                  data-note="${(t.notes ?? '').replace(/"/g,'&quot;')}"
                  onclick="openAnnotateForm(event, this)">
            ${hasAnnotation ? '✏️ Edit note' : '📝 Add note'}
          </button>
          <div class="annotate-form" id="af-${t.id}" style="display:none"></div>
        </div>
      </div>`;
    }
  }

  if (!html) {
    const emptyMessages = [
      { icon: '✅', text: "You're all caught up." },
      { icon: '🎉', text: "Nothing to see here." },
      { icon: '😎', text: "Clean slate." },
      { icon: '🏖️', text: "Go touch grass — everything's matched." },
      { icon: '🔍', text: "Nothing left to investigate." },
      { icon: '💎', text: "Diamond hands, clean books." },
      { icon: '🤙', text: "All good. No loose ends." },
      { icon: '📭', text: "This list is empty." },
      { icon: '🚀', text: "Houston, we have no problems." },
      { icon: '🧘', text: "Zen mode. Every transfer accounted for." },
    ];
    const pick = emptyMessages[Math.floor(Math.random() * emptyMessages.length)];
    html = `<div class="empty-msg">${pick.icon} ${pick.text}</div>`;
  }

  list.innerHTML = html;

  // Wire NA item clicks → search for OPPOSITE direction (potential matches)
  list.querySelectorAll('.na-item').forEach(el => {
    el.addEventListener('click', () => {
      const sym = el.getAttribute('data-sym');
      const dir = el.getAttribute('data-dir');   // 'in' or 'out'
      const ts  = el.getAttribute('data-ts');    // ISO timestamp
      if (!sym) return;
      list.querySelectorAll('.na-item').forEach(i => i.classList.remove('selected'));
      el.classList.add('selected');
      // Search for the opposite side — that's where the match lives
      const opposite = dir === 'out' ? 'in' : 'out';
      naContext = { sym, dir, opposite };
      setActiveChip(sym);
      $('filter-symbol').value = sym;
      runSearchNa(sym, opposite, ts);
    });
  });

  // Wire suggested match clicks → modal
  list.querySelectorAll('.suggest-item').forEach(el => {
    el.addEventListener('click', () => {
      const raw = el.getAttribute('data-match');
      if (!raw) return;
      openMatchModal(JSON.parse(raw.replace(/&#39;/g,"'")));
    });
  });

  // ── Resolved tin ──────────────────────────────────────────────────────────
  const resolved = data.resolved ?? [];
  const rHeader  = $('resolved-header');
  const rList    = $('resolved-list');
  const rCount   = $('resolved-count');

  if (resolved.length) {
    rCount.textContent = String(resolved.length);
    rHeader.style.display = 'flex';

    let rHtml = '';
    for (const r of resolved) {
      const autoLabel = r.status === 'auto' ? 'auto' : '✓ confirmed';
      rHtml += `<div class="resolved-item">
        <div class="resolved-top">
          <span class="resolved-sym">${r.asset_symbol}</span>
          <span class="resolved-badge">${autoLabel}</span>
        </div>
        <div class="resolved-flow">${srcName(r.out_source)}${r.out_account_name ? ' · ' + r.out_account_name : ''} → ${srcName(r.in_source)}${r.in_account_name ? ' · ' + r.in_account_name : ''}</div>
        <div class="resolved-meta">${fmtDate(r.out_ts)} → ${fmtDate(r.in_ts)} &nbsp;·&nbsp; ${fmt(r.out_amount)} → ${fmt(r.in_amount)}</div>
      </div>`;
    }
    rList.innerHTML = rHtml;

    // Honour current open/closed state
    rList.style.display = resolvedOpen ? 'block' : 'none';
    $('resolved-toggle').textContent = resolvedOpen ? '▴ hide' : '▾ show';
  } else {
    rHeader.style.display = 'none';
    rList.style.display   = 'none';
  }
}

// Toggle resolved list
$('resolved-toggle').addEventListener('click', () => {
  resolvedOpen = !resolvedOpen;
  $('resolved-list').style.display  = resolvedOpen ? 'block' : 'none';
  $('resolved-toggle').textContent  = resolvedOpen ? '▴ hide' : '▾ show';
});

// ── Chip row ──────────────────────────────────────────────────────────────────
function setActiveChip(sym) {
  activeChip = sym;
  document.querySelectorAll('.chip').forEach(c => {
    c.classList.toggle('active', c.getAttribute('data-sym') === sym);
  });
}

document.querySelectorAll('.chip').forEach(chip => {
  chip.addEventListener('click', () => {
    const sym = chip.getAttribute('data-sym');
    if (activeChip === sym) {
      setActiveChip('');
      naContext = null;
      $('filter-symbol').value = '';
      $('results-label').textContent = '';
      $('results-label').style.display = 'none';
      $('results-list').innerHTML = '<div class="empty-msg">Search cleared.</div>';
      $('results-count').textContent = '';
    } else {
      setActiveChip(sym);
      naContext = null;
      $('results-label').textContent = '';
      $('results-label').style.display = 'none';
      $('filter-symbol').value = sym;
      runSearch();
    }
  });
});

// ── NA-triggered search (opposite direction, ±7-day window) ──────────────────
async function runSearchNa(sym, direction, ts) {
  const params = new URLSearchParams({ symbol: sym, direction });

  // Narrow results to ±7 days around the selected transaction's date
  // so the user only sees plausible matches, not their entire history.
  let windowLabel = '';
  if (ts) {
    const center = new Date(ts);
    const before = new Date(center); before.setDate(before.getDate() - 7);
    const after  = new Date(center); after.setDate(after.getDate()  + 7);
    const toDate  = d => d.toISOString().slice(0, 10);   // YYYY-MM-DD
    params.set('from', toDate(before));
    params.set('to',   toDate(after));
    // Also pre-fill the date inputs so the user can see / adjust the window
    $('filter-from').value = toDate(before);
    $('filter-to').value   = toDate(after);
    windowLabel = ` within 7 days of ${center.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' })}`;
  }

  const list = $('results-list');
  const fromLabel = direction === 'in'
    ? `Showing ${sym} received${windowLabel} — potential sources for your ${sym} send`
    : `Showing ${sym} sent${windowLabel} — potential destinations for your ${sym} deposit`;

  list.innerHTML = '<div class="loading-msg">Searching…</div>';
  $('results-count').textContent = '';
  $('results-label').textContent = fromLabel;
  $('results-label').style.display = 'block';

  try {
    const res  = await fetch('/api/research/search?' + params.toString());
    const data = await res.json();
    renderResults(data);
  } catch (e) {
    list.innerHTML = `<div class="empty-msg">Search failed: ${e.message}</div>`;
  }
}

// ── Search ────────────────────────────────────────────────────────────────────
async function runSearch() {
  const params = new URLSearchParams();
  const q      = $('q').value.trim();
  const symbol = $('filter-symbol').value.trim();
  const from   = $('filter-from').value;
  const to     = $('filter-to').value;
  const note   = $('filter-note').value.trim();

  if (q)      params.set('q', q);
  if (symbol) params.set('symbol', symbol);
  if (from)   params.set('from', from);
  if (to)     params.set('to', to);
  if (note)   params.set('note', note);

  if (!params.toString()) return;

  naContext = null;
  $('results-label').textContent = '';
  $('results-label').style.display = 'none';

  const list = $('results-list');
  list.innerHTML = '<div class="loading-msg">Searching…</div>';
  $('results-count').textContent = '';

  try {
    const res  = await fetch('/api/research/search?' + params.toString());
    const data = await res.json();
    renderResults(data);
  } catch (e) {
    list.innerHTML = `<div class="empty-msg">Search failed: ${e.message}</div>`;
  }
}

function renderResults(data) {
  const list  = $('results-list');
  const count = $('results-count');
  const rows  = data.rows ?? [];
  count.textContent = rows.length > 0 ? String(rows.length) : '';

  if (!rows.length) {
    list.innerHTML = '<div class="empty-msg">No transactions found.</div>';
    return;
  }

  let html = '';
  for (const t of rows) {
    const dir         = (t.direction ?? '').toLowerCase();
    const matchStatus = t.match_status_as_out ?? t.match_status_as_in ?? null;
    const matchDir    = t.match_id_as_out ? '→' : '←';
    const matchBadge  = (t.match_id_as_out || t.match_id_as_in)
      ? `<span class="match-badge${matchStatus === 'suggested' ? ' suggested' : ''}">${matchDir} matched</span>`
      : '';
    const label       = t.address_label
      ? `<span style="color:rgba(251,191,36,0.65);font-size:0.72rem"> · ${t.address_label}</span>`
      : '';
    const amtDisplay  = dir === 'out'
      ? `−${fmt(Math.abs(t.amount))}`
      : `+${fmt(t.amount)}`;
    const srcLine     = `${srcName(t.source)}${t.account_name ? ' · ' + t.account_name : ''}`;

    html += `<div class="tx-card result-card dir-${dir}">
      <div class="tx-badge-col"><span class="tx-dir ${dir}">${dir}</span></div>
      <div class="tx-body">
        <div class="tx-row-1">
          <span class="tx-sym">${t.asset_symbol ?? '?'}</span>${matchBadge}
          <span class="tx-amt">${amtDisplay} ${t.asset_symbol ?? ''}</span>
        </div>
        <div class="tx-row-2">
          <span class="tx-src">${srcLine}${label}</span>
          ${t.native_usd ? `<span class="tx-usd">${fmtUsd(t.native_usd)}</span>` : ''}
        </div>
        <div class="tx-row-3">
          <span class="tx-desc">${t.description ?? ''}</span>
          <span class="tx-dt">${fmtDT(t.timestamp_utc)}</span>
        </div>
      </div>
    </div>`;
  }
  list.innerHTML = html;
}

// ── Button wiring ─────────────────────────────────────────────────────────────
$('btn-search').addEventListener('click', runSearch);
$('q').addEventListener('keydown', e => { if (e.key === 'Enter') runSearch(); });

$('btn-run-matching').addEventListener('click', async () => {
  const btn = $('btn-run-matching');
  btn.disabled = true;
  btn.textContent = '⚙ Running…';
  try {
    const res  = await fetch('/api/research/run-matching', { method: 'POST' });
    const data = await res.json();
    btn.textContent = `✅ ${data.matched} matched`;
    await loadNeedsAttention();
    setTimeout(() => { btn.textContent = '⚙ Re-run matching'; btn.disabled = false; }, 3000);
  } catch {
    btn.textContent = '⚙ Re-run matching';
    btn.disabled = false;
  }
});

// ── Suggested match modal ─────────────────────────────────────────────────────
function openMatchModal(match) {
  pendingMatch = match;
  $('match-modal-body').innerHTML = `<div class="match-detail">
    <strong>${match.asset_symbol}</strong> transfer<br>
    <strong>From:</strong> ${srcName(match.out_source)}${match.out_account_name ? ' · ' + match.out_account_name : ''}<br>
    <strong>To:</strong> ${srcName(match.in_source)}${match.in_account_name ? ' · ' + match.in_account_name : ''}<br>
    <strong>Sent:</strong> ${fmtDT(match.out_ts)}<br>
    <strong>Received:</strong> ${fmtDT(match.in_ts)}<br>
    <strong>Amount out:</strong> ${fmt(match.out_amount)} &nbsp; <strong>Amount in:</strong> ${fmt(match.in_amount)}${match.fee_amount ? `&nbsp; <strong>Fee:</strong> ${fmt(match.fee_amount)}` : ''}<br>
    <strong>Confidence score:</strong> ${match.confidence_score}
  </div>`;
  $('match-modal').style.display = 'flex';
}

$('match-modal-close').addEventListener('click', () => { $('match-modal').style.display = 'none'; });
$('match-modal').addEventListener('click', e => { if (e.target === $('match-modal')) $('match-modal').style.display = 'none'; });

async function actOnMatch(action) {
  if (!pendingMatch) return;
  const res = await fetch(`/api/research/matches/${pendingMatch.match_id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action }),
  });
  if (res.ok) {
    $('match-modal').style.display = 'none';
    await loadNeedsAttention();
  }
}
$('match-confirm').addEventListener('click', () => actOnMatch('confirm'));
$('match-reject').addEventListener('click',  () => actOnMatch('reject'));

// ── Annotate inline form ──────────────────────────────────────────────────────
const DISPOSAL_TYPES = [
  { value: '',          label: '— select type —' },
  { value: 'sell',      label: 'Sell' },
  { value: 'trade',     label: 'Trade (crypto → crypto)' },
  { value: 'gift_out',  label: 'Gift out (sent to someone)' },
  { value: 'gift_in',   label: 'Gift in (received as gift)' },
  { value: 'lost',      label: 'Lost / stolen' },
  { value: 'donation',  label: 'Donation (charity)' },
  { value: 'other',     label: 'Other / explained' },
];

function openAnnotateForm(e, btn) {
  e.stopPropagation();          // don't trigger NA item search click
  const txId    = btn.getAttribute('data-tx-id');
  const curCat  = btn.getAttribute('data-category') ?? '';
  const curNote = btn.getAttribute('data-note') ?? '';
  const formEl  = document.getElementById('af-' + txId);
  if (!formEl) return;

  if (formEl.style.display !== 'none') {
    formEl.style.display = 'none';
    return;
  }

  const options = DISPOSAL_TYPES.map(d =>
    `<option value="${d.value}"${d.value === curCat ? ' selected' : ''}>${d.label}</option>`
  ).join('');

  formEl.innerHTML = `
    <select id="af-cat-${txId}">${options}</select>
    <div class="annotate-form-row">
      <input id="af-note-${txId}" type="text" placeholder="Add a note…" value="${curNote}" />
      <button class="btn-annotate-save" onclick="saveAnnotation(event,'${txId}')">Save</button>
      <button class="btn-annotate-cancel" onclick="document.getElementById('af-${txId}').style.display='none'">✕</button>
    </div>`;
  formEl.style.display = 'flex';
}

async function saveAnnotation(e, txId) {
  e.stopPropagation();
  const cat  = document.getElementById('af-cat-'  + txId)?.value  ?? '';
  const note = document.getElementById('af-note-' + txId)?.value  ?? '';
  const btn  = document.querySelector(`[data-tx-id="${txId}"].btn-annotate`);

  try {
    const res = await fetch(`/api/research/annotate/${txId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category: cat, note }),
    });
    if (!res.ok) throw new Error(await res.text());
    // Reload NA list — transaction may now auto-resolve off the list
    await loadNeedsAttention();
  } catch (err) {
    if (btn) btn.textContent = '⚠ Save failed';
  }
}

// ── Boot ──────────────────────────────────────────────────────────────────────
loadNeedsAttention();
</script>
