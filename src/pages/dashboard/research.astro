  }
  .wallet-picker-empty {
    padding: 0.75rem 0.85rem;
    font-size: 0.83rem;
    color: rgba(255,255,255,0.35);
  }
  .wallet-picker-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: inherit;
    padding: 0.6rem 0.85rem;
