    font-size: 0.72rem;
    color: rgba(255,255,255,0.3);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .addr-tx-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    font-size: 0.8rem;
  }
  .addr-tx-row:last-child { border-bottom: none; }
  .addr-tx-dir { font-size: 0.68rem; font-weight: 700; padding: 0.12rem 0.38rem; border-radius: 4px; }
  .addr-tx-dir.out { background: rgba(239,68,68,0.15); color: #f87171; }
  .addr-tx-dir.in  { background: rgba(52,211,153,0.12); color: #34d399; }
  .addr-tx-sym   { font-weight: 700; color: #fff; }
  .addr-tx-amt   { color: rgba(255,255,255,0.65); }
  .addr-tx-dt    { margin-left: auto; color: rgba(255,255,255,0.3); font-size: 0.73rem; white-space: nowrap; }
  .addr-loading  { font-size: 0.83rem; color: rgba(255,255,255,0.3); font-style: italic; }

  /* ── Add-wallet inline form ──────────────────────────────────────────────── */
  .btn-add-wallet {
    margin-top: 0.5rem;
    background: none;
    border: 1px dashed rgba(52,211,153,0.35);
    border-radius: 8px;
    color: rgba(52,211,153,0.75);
    font-size: 0.83rem;
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-add-wallet:hover { border-color: rgba(52,211,153,0.7); color: #34d399; background: rgba(52,211,153,0.06); }
  .add-wallet-form { margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .add-wallet-input {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 7px;
    color: rgba(255,255,255,0.85);
    font-size: 0.85rem;
    padding: 0.4rem 0.65rem;
    outline: none;
    width: 100%;
    max-width: 340px;
  }
  .add-wallet-input:focus { border-color: rgba(52,211,153,0.5); }
  .add-wallet-row { display: flex; align-items: center; gap: 0.4rem; }
</style>

<script>
// ── State ─────────────────────────────────────────────────────────────────────
let activeChip    = '';
let pendingMatch  = null;
let resolvedOpen  = false;
let naContext     = null;   // { sym, dir } when search was triggered from NA click

// ── Helpers ───────────────────────────────────────────────────────────────────
const $  = id => document.getElementById(id);
const fmt = n => n == null ? '—' : Number(n).toLocaleString(undefined, { maximumFractionDigits: 8 });
const fmtUsd = n => n == null ? '' : '$' + Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const fmtDT = s => {
  if (!s) return '';
  try {
    const d = new Date(s.replace(' UTC','Z').replace(' ','T'));
    const date = d.toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' });
    const time = d.toLocaleTimeString(undefined, { hour:'2-digit', minute:'2-digit' });
    return `${date} · ${time}`;
  } catch { return s.slice(0,16); }
};

const fmtDate = s => {
  if (!s) return '';
  try {
    return new Date(s.replace(' UTC','Z').replace(' ','T')).toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' });
  } catch { return s.slice(0,10); }
};

const srcName = s => ({
  coinbase:'Coinbase', crypto_com:'Crypto.com', gemini:'Gemini',
  kraken:'Kraken', exodus:'Exodus', venmo:'Venmo', cashapp:'Cash App', robinhood:'Robinhood',
})[s] ?? s;

// ── Load Needs Attention ──────────────────────────────────────────────────────
async function loadNeedsAttention() {
  const list = $('na-list');
  list.innerHTML = '<div class="loading-msg">Loading…</div>';
  try {
    const res  = await fetch('/api/research/needs-attention');
    const data = await res.json();
    renderNeedsAttention(data);
  } catch (e) {
    list.innerHTML = `<div class="empty-msg">Failed to load: ${e.message}</div>`;
  }
}

function renderNeedsAttention(data) {
  const list  = $('na-list');
  const count = $('na-count');
  const total = data.total ?? 0;
  count.textContent = total > 0 ? String(total) : '';

  let html = '';

  // ── Suggested matches ──────────────────────────────────────────────────────
  if (data.suggested?.length) {
    html += `<div class="section-label">Suggested matches</div>`;
    for (const m of data.suggested) {
      const safeM = JSON.stringify(m).replace(/'/g,"&#39;");
      html += `<div class="suggest-item" data-match-id="${m.match_id}" data-match='${safeM}'>
        <div class="suggest-top">
          <span class="suggest-sym">${m.asset_symbol}</span>
          <span class="suggest-score">confidence ${m.confidence_score}</span>
        </div>
        <div class="suggest-flow">${srcName(m.out_source)}${m.out_account_name ? ' · ' + m.out_account_name : ''} → ${srcName(m.in_source)}${m.in_account_name ? ' · ' + m.in_account_name : ''}</div>
        <div class="suggest-dates">${fmtDate(m.out_ts)} → ${fmtDate(m.in_ts)}</div>
        <div class="suggest-amt">Sent ${fmt(m.out_amount)} · Received ${fmt(m.in_amount)}${m.fee_amount ? ' · Fee ' + fmt(m.fee_amount) : ''}</div>
      </div>`;
    }
  }

  // ── Unresolved transactions ────────────────────────────────────────────────
  if (data.unmatched?.length) {
    html += `<div class="section-label">Unresolved transactions</div>`;
    for (const t of data.unmatched) {
      const dir    = (t.direction ?? '').toLowerCase();
      const absAmt = Math.abs(Number(t.amount));
      const amt    = dir === 'out' ? `−${fmt(absAmt)}` : `+${fmt(absAmt)}`;
      const hint    = t.address_label
        ? `Source: ${t.address_label}`
        : dir === 'out' ? 'Click to find where this landed →' : 'Click to find where this came from →';
      const src     = `${srcName(t.source)}${t.account_name ? ' · ' + t.account_name : ''}`;
      const catLabel = t.category ? `<span class="category-badge">${t.category}</span>` : '';
      const noteText = t.notes   ? `<span style="font-size:0.72rem;color:rgba(255,255,255,0.45);font-style:italic">${t.notes}</span>` : '';
      const hasAnnotation = !!(t.category || t.notes);
      html += `<div class="tx-card na-item dir-${dir}" data-sym="${t.asset_symbol}" data-dir="${dir}" data-id="${t.id}" data-ts="${t.timestamp_utc}">
        <div class="tx-badge-col"><span class="tx-dir ${dir}">${dir}</span></div>
        <div class="tx-body">
          <div class="tx-row-1">
            <span class="tx-sym">${t.asset_symbol}</span>
            <span class="tx-amt">${amt} ${t.asset_symbol}</span>
          </div>
          <div class="tx-row-2">
            <span class="tx-src">${src}</span>
            ${t.native_usd ? `<span class="tx-usd">${fmtUsd(t.native_usd)}</span>` : ''}
          </div>
          <div class="tx-row-3">
            <span class="tx-hint">${hint}</span>
            <span class="tx-dt">${fmtDT(t.timestamp_utc)}</span>
          </div>
          ${hasAnnotation ? `<div style="margin-top:0.3rem">${catLabel}${noteText}</div>` : ''}
          <div class="card-actions">
            <button class="btn-annotate${hasAnnotation ? ' has-note' : ''}"
                    data-tx-id="${t.id}"
                    data-category="${t.category ?? ''}"
                    data-note="${(t.notes ?? '').replace(/"/g,'&quot;')}"
                    onclick="openAnnotateForm(event, this)">
              ${hasAnnotation ? '✏️ Edit note' : '📝 Add note'}
            </button>
            ${dir === 'in' && t.category !== 'legacy_exchange' ? `
            <button class="btn-legacy"
                    onclick="markLegacy(event, '${t.id}')">
              🏚 Legacy exchange
            </button>` : ''}
            ${dir === 'out' && t.category !== 'own_wallet' ? `
            <button class="btn-transfer"
                    data-tx-id="${t.id}"
                    onclick="openTransferForm(event, this)">
              → Transfer to wallet
            </button>` : ''}
          </div>
          <div class="annotate-form" id="af-${t.id}" style="display:none"></div>
        </div>
      </div>`;
    }
  }

  if (!html) {
    const emptyMessages = [
      { icon: '✅', text: "You're all caught up." },
      { icon: '🎉', text: "Nothing to see here." },
      { icon: '😎', text: "Clean slate." },
      { icon: '🏖️', text: "Go touch grass — everything's matched." },
      { icon: '🔍', text: "Nothing left to investigate." },
      { icon: '💎', text: "Diamond hands, clean books." },
      { icon: '🤙', text: "All good. No loose ends." },
      { icon: '📭', text: "This list is empty." },
      { icon: '🚀', text: "Houston, we have no problems." },
      { icon: '🧘', text: "Zen mode. Every transfer accounted for." },
    ];
    const pick = emptyMessages[Math.floor(Math.random() * emptyMessages.length)];
    html = `<div class="empty-msg">${pick.icon} ${pick.text}</div>`;
  }

  list.innerHTML = html;

  // Wire NA item clicks → search for OPPOSITE direction (potential matches)
  list.querySelectorAll('.na-item').forEach(el => {
    el.addEventListener('click', () => {
      const sym = el.getAttribute('data-sym');
      const dir = el.getAttribute('data-dir');   // 'in' or 'out'
      const ts  = el.getAttribute('data-ts');    // ISO timestamp
      if (!sym) return;
      list.querySelectorAll('.na-item').forEach(i => i.classList.remove('selected'));
      el.classList.add('selected');
      // Search for the opposite side — that's where the match lives
      const opposite = dir === 'out' ? 'in' : 'out';
      naContext = { sym, dir, opposite };
      setActiveChip(sym);
      $('filter-symbol').value = sym;
      runSearchNa(sym, opposite, ts);
    });
  });

  // Wire suggested match clicks → modal
  list.querySelectorAll('.suggest-item').forEach(el => {
    el.addEventListener('click', () => {
      const raw = el.getAttribute('data-match');
      if (!raw) return;
      openMatchModal(JSON.parse(raw.replace(/&#39;/g,"'")));
    });
  });

  // ── Resolved tin ──────────────────────────────────────────────────────────
  const resolved = data.resolved ?? [];
  const rHeader  = $('resolved-header');
  const rList    = $('resolved-list');
  const rCount   = $('resolved-count');

  if (resolved.length) {
    rCount.textContent = String(resolved.length);
    rHeader.style.display = 'flex';

    let rHtml = '';
    for (const r of resolved) {
      const autoLabel = r.status === 'auto' ? 'auto' : '✓ confirmed';
      rHtml += `<div class="resolved-item">
        <div class="resolved-top">
          <span class="resolved-sym">${r.asset_symbol}</span>
          <span class="resolved-badge">${autoLabel}</span>
        </div>
        <div class="resolved-flow">${srcName(r.out_source)}${r.out_account_name ? ' · ' + r.out_account_name : ''} → ${srcName(r.in_source)}${r.in_account_name ? ' · ' + r.in_account_name : ''}</div>
        <div class="resolved-meta">${fmtDate(r.out_ts)} → ${fmtDate(r.in_ts)} &nbsp;·&nbsp; ${fmt(r.out_amount)} → ${fmt(r.in_amount)}</div>
      </div>`;
    }
    rList.innerHTML = rHtml;

    // Honour current open/closed state
    rList.style.display = resolvedOpen ? 'block' : 'none';
    $('resolved-toggle').textContent = resolvedOpen ? '▴ hide' : '▾ show';
  } else {
    rHeader.style.display = 'none';
    rList.style.display   = 'none';
  }
}

// Toggle resolved list
$('resolved-toggle').addEventListener('click', () => {
  resolvedOpen = !resolvedOpen;
  $('resolved-list').style.display  = resolvedOpen ? 'block' : 'none';
  $('resolved-toggle').textContent  = resolvedOpen ? '▴ hide' : '▾ show';
});

// ── Chip row ──────────────────────────────────────────────────────────────────
function setActiveChip(sym) {
  activeChip = sym;
  document.querySelectorAll('.chip').forEach(c => {
    c.classList.toggle('active', c.getAttribute('data-sym') === sym);
  });
}

document.querySelectorAll('.chip').forEach(chip => {
  chip.addEventListener('click', () => {
    const sym = chip.getAttribute('data-sym');
    if (activeChip === sym) {
      setActiveChip('');
      naContext = null;
      $('filter-symbol').value = '';
      $('results-label').textContent = '';
      $('results-label').style.display = 'none';
      $('results-list').innerHTML = '<div class="empty-msg">Search cleared.</div>';
      $('results-count').textContent = '';
    } else {
      setActiveChip(sym);
      naContext = null;
      $('results-label').textContent = '';
      $('results-label').style.display = 'none';
      $('filter-symbol').value = sym;
      runSearch();
    }
  });
});

// ── NA-triggered search (opposite direction, ±7-day window) ──────────────────
async function runSearchNa(sym, direction, ts) {
  const params = new URLSearchParams({ symbol: sym, direction });

  // Narrow results to ±7 days around the selected transaction's date
  // so the user only sees plausible matches, not their entire history.
  let windowLabel = '';
  if (ts) {
    const center = new Date(ts);
    const before = new Date(center); before.setDate(before.getDate() - 7);
    const after  = new Date(center); after.setDate(after.getDate()  + 7);
    const toDate  = d => d.toISOString().slice(0, 10);   // YYYY-MM-DD
    params.set('from', toDate(before));
    params.set('to',   toDate(after));
    // Also pre-fill the date inputs so the user can see / adjust the window
    $('filter-from').value = toDate(before);
    $('filter-to').value   = toDate(after);
    windowLabel = ` within 7 days of ${center.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' })}`;
  }

  const list = $('results-list');
  const fromLabel = direction === 'in'
    ? `Showing ${sym} received${windowLabel} — potential sources for your ${sym} send`
    : `Showing ${sym} sent${windowLabel} — potential destinations for your ${sym} deposit`;

  list.innerHTML = '<div class="loading-msg">Searching…</div>';
  $('results-count').textContent = '';
  $('results-label').textContent = fromLabel;
  $('results-label').style.display = 'block';

  try {
    const res  = await fetch('/api/research/search?' + params.toString());
    const data = await res.json();
    renderResults(data);
  } catch (e) {
    list.innerHTML = `<div class="empty-msg">Search failed: ${e.message}</div>`;
  }
}

// ── Search ────────────────────────────────────────────────────────────────────
async function runSearch() {
  const params = new URLSearchParams();
  const q      = $('q').value.trim();
  const symbol = $('filter-symbol').value.trim();
  const from   = $('filter-from').value;
  const to     = $('filter-to').value;
  const note   = $('filter-note').value.trim();

  if (q)      params.set('q', q);
  if (symbol) params.set('symbol', symbol);
  if (from)   params.set('from', from);
  if (to)     params.set('to', to);
  if (note)   params.set('note', note);

  if (!params.toString()) return;

  naContext = null;
  $('results-label').textContent = '';
  $('results-label').style.display = 'none';

  const list = $('results-list');
  list.innerHTML = '<div class="loading-msg">Searching…</div>';
  $('results-count').textContent = '';

  try {
    const res  = await fetch('/api/research/search?' + params.toString());
    const data = await res.json();
    renderResults(data);
  } catch (e) {
    list.innerHTML = `<div class="empty-msg">Search failed: ${e.message}</div>`;
  }
}

function renderResults(data) {
  const list  = $('results-list');
  const count = $('results-count');
  const rows  = data.rows ?? [];
  count.textContent = rows.length > 0 ? String(rows.length) : '';

  if (!rows.length) {
    list.innerHTML = '<div class="empty-msg">No transactions found.</div>';
    return;
  }

  let html = '';
  for (const t of rows) {
    const dir         = (t.direction ?? '').toLowerCase();
    const matchStatus = t.match_status_as_out ?? t.match_status_as_in ?? null;
    const matchDir    = t.match_id_as_out ? '→' : '←';
    const matchBadge  = (t.match_id_as_out || t.match_id_as_in)
      ? `<span class="match-badge${matchStatus === 'suggested' ? ' suggested' : ''}">${matchDir} matched</span>`
      : '';
    const label       = t.address_label
      ? `<span style="color:rgba(251,191,36,0.65);font-size:0.72rem"> · ${t.address_label}</span>`
      : '';
    const amtDisplay  = dir === 'out'
      ? `−${fmt(Math.abs(t.amount))}`
      : `+${fmt(t.amount)}`;
    const srcLine     = `${srcName(t.source)}${t.account_name ? ' · ' + t.account_name : ''}`;

    html += `<div class="tx-card result-card dir-${dir}">
      <div class="tx-badge-col"><span class="tx-dir ${dir}">${dir}</span></div>
      <div class="tx-body">
        <div class="tx-row-1">
          <span class="tx-sym">${t.asset_symbol ?? '?'}</span>${matchBadge}
          <span class="tx-amt">${amtDisplay} ${t.asset_symbol ?? ''}</span>
        </div>
        <div class="tx-row-2">
          <span class="tx-src">${srcLine}${label}</span>
          ${t.native_usd ? `<span class="tx-usd">${fmtUsd(t.native_usd)}</span>` : ''}
        </div>
        <div class="tx-row-3">
          <span class="tx-desc">${t.description ?? ''}</span>
          <span class="tx-dt">${fmtDT(t.timestamp_utc)}</span>
        </div>
      </div>
    </div>`;
  }
  list.innerHTML = html;
}

// ── Button wiring ─────────────────────────────────────────────────────────────
function maybeAddressLookup() {
  const stripped = ($('q').value ?? '').replace(/\s+/g, '');
  if (ADDRESS_RE.test(stripped)) {
    checkAddress(stripped);
    return true;
  }
  return false;
}

$('btn-search').addEventListener('click', () => { if (!maybeAddressLookup()) runSearch(); });
$('q').addEventListener('keydown', e => { if (e.key === 'Enter') { if (!maybeAddressLookup()) runSearch(); } });

$('btn-run-matching').addEventListener('click', async () => {
  const btn = $('btn-run-matching');
  btn.disabled = true;
  btn.textContent = '⚙ Running…';
  try {
    const res  = await fetch('/api/research/run-matching', { method: 'POST' });
    const data = await res.json();
    btn.textContent = `✅ ${data.matched} matched`;
    await loadNeedsAttention();
    setTimeout(() => { btn.textContent = '⚙ Re-run matching'; btn.disabled = false; }, 3000);
  } catch {
    btn.textContent = '⚙ Re-run matching';
    btn.disabled = false;
  }
});

// ── Suggested match modal ─────────────────────────────────────────────────────
function openMatchModal(match) {
  pendingMatch = match;
  $('match-modal-body').innerHTML = `<div class="match-detail">
    <strong>${match.asset_symbol}</strong> transfer<br>
    <strong>From:</strong> ${srcName(match.out_source)}${match.out_account_name ? ' · ' + match.out_account_name : ''}<br>
    <strong>To:</strong> ${srcName(match.in_source)}${match.in_account_name ? ' · ' + match.in_account_name : ''}<br>
    <strong>Sent:</strong> ${fmtDT(match.out_ts)}<br>
    <strong>Received:</strong> ${fmtDT(match.in_ts)}<br>
    <strong>Amount out:</strong> ${fmt(match.out_amount)} &nbsp; <strong>Amount in:</strong> ${fmt(match.in_amount)}${match.fee_amount ? `&nbsp; <strong>Fee:</strong> ${fmt(match.fee_amount)}` : ''}<br>
    <strong>Confidence score:</strong> ${match.confidence_score}
  </div>`;
  $('match-modal').style.display = 'flex';
}

$('match-modal-close').addEventListener('click', () => { $('match-modal').style.display = 'none'; });
$('match-modal').addEventListener('click', e => { if (e.target === $('match-modal')) $('match-modal').style.display = 'none'; });

async function actOnMatch(action) {
  if (!pendingMatch) return;
  const res = await fetch(`/api/research/matches/${pendingMatch.match_id}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action }),
  });
  if (res.ok) {
    $('match-modal').style.display = 'none';
    await loadNeedsAttention();
  }
}
$('match-confirm').addEventListener('click', () => actOnMatch('confirm'));
$('match-reject').addEventListener('click',  () => actOnMatch('reject'));

// ── Annotate inline form ──────────────────────────────────────────────────────
const DISPOSAL_TYPES = [
  { value: '',                 label: '— select type —' },
  { value: 'sell',             label: 'Sell' },
  { value: 'trade',            label: 'Trade (crypto → crypto)' },
  { value: 'gift_out',         label: 'Gift out (sent to someone)' },
  { value: 'gift_in',          label: 'Gift in (received as gift)' },
  { value: 'lost',             label: 'Lost / stolen' },
  { value: 'donation',         label: 'Donation (charity)' },
  { value: 'own_wallet',        label: 'Own wallet (self transfer)' },
  { value: 'legacy_exchange',  label: 'Legacy / defunct exchange (source unavailable)' },
  { value: 'other',            label: 'Other / explained' },
];

function openAnnotateForm(e, btn) {
  e.stopPropagation();          // don't trigger NA item search click
  const txId    = btn.getAttribute('data-tx-id');
  const curCat  = btn.getAttribute('data-category') ?? '';
  const curNote = btn.getAttribute('data-note') ?? '';
  const formEl  = document.getElementById('af-' + txId);
  if (!formEl) return;

  if (formEl.style.display !== 'none') {
    formEl.style.display = 'none';
    return;
  }

  const options = DISPOSAL_TYPES.map(d =>
    `<option value="${d.value}"${d.value === curCat ? ' selected' : ''}>${d.label}</option>`
  ).join('');

  formEl.innerHTML = `
    <select id="af-cat-${txId}">${options}</select>
    <div class="annotate-form-row">
      <input id="af-note-${txId}" type="text" placeholder="Add a note…" value="${curNote}" />
      <button class="btn-annotate-save" onclick="saveAnnotation(event,'${txId}')">Save</button>
      <button class="btn-annotate-cancel" onclick="document.getElementById('af-${txId}').style.display='none'">✕</button>
    </div>`;
  formEl.style.display = 'flex';
}

async function saveAnnotation(e, txId) {
  e.stopPropagation();
  const cat  = document.getElementById('af-cat-'  + txId)?.value  ?? '';
  const note = document.getElementById('af-note-' + txId)?.value  ?? '';
  const btn  = document.querySelector(`[data-tx-id="${txId}"].btn-annotate`);

  try {
    const res = await fetch(`/api/research/annotate/${txId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category: cat, note }),
    });
    if (!res.ok) throw new Error(await res.text());
    // Reload NA list — transaction may now auto-resolve off the list
    await loadNeedsAttention();
  } catch (err) {
    if (btn) btn.textContent = '⚠ Save failed';
  }
}

async function markLegacy(e, txId) {
  e.stopPropagation();
  const btn = e.currentTarget;
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try {
    const res = await fetch(`/api/research/annotate/${txId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category: 'legacy_exchange' }),
    });
    if (!res.ok) throw new Error(await res.text());
    await loadNeedsAttention();
  } catch {
    btn.disabled = false;
    btn.textContent = '🏚 Legacy exchange';
  }
}

async function markOwnWallet(e, txId) {
  e.stopPropagation();
  const btn = e.currentTarget;
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try {
    const res = await fetch(`/api/research/annotate/${txId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category: 'own_wallet' }),
    });
    if (!res.ok) throw new Error(await res.text());
    await loadNeedsAttention();
  } catch {
    btn.disabled = false;
    btn.textContent = '🏠 Own wallet';
  }
}

function openTransferForm(e, btn) {
  e.stopPropagation();
  const txId   = btn.getAttribute('data-tx-id');
  const formEl = document.getElementById('af-' + txId);
  if (!formEl) return;

  if (formEl.style.display !== 'none') {
    formEl.style.display = 'none';
    return;
  }

  // Build wallet options from the wallet-picker items already in the DOM
  const walletItems = Array.from(document.querySelectorAll('.wallet-picker-item'));
  const walletOptions = walletItems.map(el => {
    const id    = el.getAttribute('data-wallet-id') ?? '';
    const label = el.getAttribute('data-wallet-label') ?? id;
    const addr  = el.getAttribute('data-wallet-address') ?? '';
    return `<option value="${label}" data-addr="${addr}">${label}${addr ? '  (' + addr.slice(0,6) + '…' + addr.slice(-4) + ')' : ''}</option>`;
  }).join('');

  formEl.innerHTML = `
    <div style="font-size:0.78rem;opacity:0.55;margin-bottom:0.35rem">Where did this transfer go?</div>
    ${walletOptions ? `<select id="af-twallet-${txId}">
      <option value="">— pick a tracked wallet —</option>
      ${walletOptions}
    </select>` : ''}
    <input id="af-taddr-${txId}"  type="text" placeholder="Or enter an address or label…" />
    <input id="af-tnote-${txId}"  type="text" placeholder="Optional note…" />
    <div class="annotate-form-row">
      <button class="btn-annotate-save" onclick="saveTransfer(event,'${txId}')">Save</button>
      <button class="btn-annotate-cancel" onclick="document.getElementById('af-${txId}').style.display='none'">✕</button>
      <span id="af-tstatus-${txId}" style="font-size:0.78rem;opacity:0.55;margin-left:0.4rem"></span>
    </div>`;
  formEl.style.display = 'flex';
}

async function saveTransfer(e, txId) {
  e.stopPropagation();
  const walletSel  = document.getElementById('af-twallet-' + txId);
  const addrInput  = document.getElementById('af-taddr-'   + txId);
  const noteInput  = document.getElementById('af-tnote-'   + txId);
  const statusEl   = document.getElementById('af-tstatus-' + txId);

  const destination = walletSel?.value.trim() || addrInput?.value.trim() || '';
  const extra       = noteInput?.value.trim() ?? '';
  const note        = [destination ? `To: ${destination}` : '', extra].filter(Boolean).join(' · ');

  if (statusEl) statusEl.textContent = 'Saving…';

  try {
    const res = await fetch(`/api/research/annotate/${txId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category: 'own_wallet', note }),
    });
    if (!res.ok) throw new Error(await res.text());
    await loadNeedsAttention();
  } catch {
    if (statusEl) statusEl.textContent = '⚠ Save failed';
  }
}

// Expose to window so inline onclick="" attributes can find them
window.openAnnotateForm  = openAnnotateForm;
window.saveAnnotation    = saveAnnotation;
window.markLegacy        = markLegacy;
window.markOwnWallet     = markOwnWallet;
window.openTransferForm  = openTransferForm;
window.saveTransfer      = saveTransfer;

// ── Address lookup ────────────────────────────────────────────────────────────
const ADDRESS_RE = /^(0x[0-9a-fA-F]{40,}|bc1[a-zA-HJ-NP-Z0-9]{25,}|[13][a-zA-HJ-NP-Z0-9]{25,}|0x[0-9a-fA-F]{60,}|ltc1[a-z0-9]{25,})$/i;

function detectNetwork(address) {
  const lower = address.toLowerCase();
  if (lower.startsWith('ltc1'))                          return { symbol: 'LTC', chains: ['litecoin'] };
  if (lower.startsWith('bc1') || /^[13]/.test(address)) return { symbol: 'BTC', chains: ['bitcoin'] };
  if (/^0x[a-f0-9]{64}$/.test(lower))                   return { symbol: 'SUI', chains: ['sui'] };
  if (/^0x[a-f0-9]{40}$/.test(lower))                   return { symbol: 'ETH', chains: ['ethereum', 'polygon', 'avalanche'] };
  return { symbol: '', chains: [] };
}

let addrDebounce = null;

$('q').addEventListener('input', () => {
  clearTimeout(addrDebounce);
  const raw      = $('q').value.trim();
  const stripped = raw.replace(/\s+/g, '');   // drop mid-string spaces from multi-line copy-paste
  if (ADDRESS_RE.test(stripped)) {
    addrDebounce = setTimeout(() => checkAddress(stripped), 400);
  } else {
    $('addr-panel').style.display = 'none';
  }
});

async function checkAddress(address) {
  const panel = $('addr-panel');
  const inner = $('addr-panel-inner');
  panel.style.display = 'block';
  inner.innerHTML = `<div class="addr-loading">Looking up ${address.slice(0,10)}…</div>`;

  try {
    const res  = await fetch('/api/research/address-lookup?address=' + encodeURIComponent(address));
    const data = await res.json();
    renderAddressPanel(data);
  } catch (e) {
    inner.innerHTML = `<div class="addr-loading">Lookup failed: ${e.message}</div>`;
  }
}

// Store last lookup for the "Add wallet" flow
let lastLookupData = null;

function renderAddressPanel(data) {
  lastLookupData = data;
  const inner = $('addr-panel-inner');
  let html = `<div class="addr-panel-title">Address info</div>`;

  // Resolve the best label for this address
  const resolvedLabel = data.addressLabel || data.globalLabel || data.knownExchange || null;
  const labelSource   = data.addressLabel  ? (data.addressLabelSource === 'user' ? 'you' : 'auto')
                      : data.globalLabel   ? 'community'
                      : data.knownExchange ? 'known'
                      : null;

  // Copy-button row: [□ address] [□ label] whenever we have a label
  html += `<div class="addr-copy-row">
    <button class="addr-copy-btn" onclick="navigator.clipboard.writeText('${data.address}')" title="Copy address">
      ⧉ <span class="addr-copy-text">${data.address.slice(0,10)}…${data.address.slice(-6)}</span>
    </button>`;
  if (resolvedLabel) {
    html += `<button class="addr-copy-btn" onclick="navigator.clipboard.writeText('${resolvedLabel.replace(/'/g,"\\'")}')" title="Copy label">
      ⧉ <span class="addr-copy-text">${resolvedLabel}</span>
    </button>`;
    if (labelSource === 'community') {
      html += `<span class="addr-community-badge">🌐 community label</span>`;
    }
  }
  html += `</div>`;

  // Chips row
  html += `<div class="addr-info-grid">`;
  if (data.ownWallet) {
    const lbl = data.ownWallet.label || data.ownWallet.address.slice(0,8) + '…';
    html += `<span class="addr-info-chip own">🏠 Your wallet: ${lbl}</span>`;
  }
  if (data.knownExchange) {
    html += `<span class="addr-info-chip exchange">🏦 ${data.knownExchange}</span>`;
  }
  if (data.addressLabel && !data.ownWallet) {
    html += `<span class="addr-info-chip label">🏷 ${data.addressLabel}</span>`;
  }
  if (data.globalLabel && !data.addressLabel && !data.ownWallet && !data.knownExchange) {
    html += `<span class="addr-info-chip label">🌐 ${data.globalLabel}</span>`;
  }
  if (!data.ownWallet && !data.knownExchange && !data.addressLabel && !data.globalLabel) {
    html += `<span class="addr-info-chip unknown">Unknown address</span>`;
  }
  html += `</div>`;

  // "Add as wallet" button — only when it's not already a registered wallet
  if (!data.ownWallet) {
    html += `
      <div id="add-wallet-area">
        <button class="btn-add-wallet" type="button" id="btn-show-add-wallet">＋ Add as my wallet</button>
        <div id="add-wallet-form" style="display:none" class="add-wallet-form">
          <input id="add-wallet-label" type="text" placeholder="Wallet label (e.g. My LTC wallet)" class="add-wallet-input" />
          <input id="add-wallet-symbol" type="text" placeholder="Symbol (e.g. LTC, BTC, ETH)" class="add-wallet-input" style="margin-top:0.4rem" />
          <div class="add-wallet-row">
            <button class="btn-annotate-save" type="button" id="btn-confirm-add-wallet">Save</button>
            <button class="btn-annotate-cancel" type="button" id="btn-cancel-add-wallet">Cancel</button>
            <span id="add-wallet-status" style="font-size:0.8rem;opacity:0.6;margin-left:0.5rem"></span>
          </div>
        </div>
      </div>`;
  }

  // Recent transactions
  const txs = data.recentTxs ?? [];
  if (txs.length) {
    html += `<div class="addr-txs-label" style="margin-top:0.75rem">Recent transactions</div>`;
    for (const t of txs) {
      const dir    = (t.direction ?? '').toLowerCase();
      const absAmt = Math.abs(Number(t.amount ?? 0));
      const amt    = dir === 'out' ? `−${fmt(absAmt)}` : `+${fmt(absAmt)}`;
      const sym    = t.asset_symbol ?? '?';
      html += `<div class="addr-tx-row">
        <span class="addr-tx-dir ${dir}">${dir}</span>
        <span class="addr-tx-sym">${sym}</span>
        <span class="addr-tx-amt">${amt} ${sym}</span>
        <span class="addr-tx-dt">${fmtDate(t.timestamp_utc)}</span>
      </div>`;
    }
  }

  inner.innerHTML = html;

  // Wire add-wallet buttons after innerHTML is set
  const btnShow = $('btn-show-add-wallet');
  const form    = $('add-wallet-form');
  if (btnShow && form) {
    btnShow.addEventListener('click', () => {
      form.style.display = 'block';
      btnShow.style.display = 'none';
      // Auto-fill symbol from address prefix
      const symbolInput = $('add-wallet-symbol');
      if (symbolInput && !symbolInput.value) {
        symbolInput.value = detectNetwork(data.address).symbol;
      }
      $('add-wallet-label').focus();
    });
    $('btn-cancel-add-wallet').addEventListener('click', () => {
      form.style.display = 'none';
      btnShow.style.display = '';
      $('add-wallet-status').textContent = '';
    });
    $('btn-confirm-add-wallet').addEventListener('click', () => saveNewWallet(data.address));
    $('add-wallet-label').addEventListener('keydown', e => { if (e.key === 'Enter') saveNewWallet(data.address); });
  }
}

function symbolToChains(symbol, address) {
  const s = symbol.trim().toUpperCase();
  const knownMap = {
    LTC: ['litecoin'], BTC: ['bitcoin'], ETH: ['ethereum', 'polygon', 'avalanche'],
    SOL: ['solana'], SUI: ['sui'], AVAX: ['avalanche'], MATIC: ['polygon'],
  };
  if (knownMap[s]) return knownMap[s];
  // Fall back to auto-detected chains if user left symbol blank or unknown
  if (!s) return detectNetwork(address).chains;
  return [s.toLowerCase()];
}

async function saveNewWallet(address) {
  const label  = $('add-wallet-label')?.value.trim() ?? '';
  const symbol = $('add-wallet-symbol')?.value ?? '';
  const status = $('add-wallet-status');
  const btn    = $('btn-confirm-add-wallet');
  if (!label) { if (status) status.textContent = 'Label is required'; return; }

  const chains = symbolToChains(symbol, address);

  btn.disabled = true;
  if (status) status.textContent = 'Saving…';

  try {
    const res = await fetch('/api/wallets', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ address, label, chains }),
    });
    const data = await res.json();
    if (!res.ok) {
      if (status) status.textContent = data.message ?? 'Failed to save';
      btn.disabled = false;
      return;
    }
    // Re-run the lookup so the panel now shows "Your wallet"
    await checkAddress(address);
  } catch (e) {
    if (status) status.textContent = 'Error: ' + e.message;
    btn.disabled = false;
  }
}

// ── Add Transaction wallet picker ─────────────────────────────────────────────
const btnAddTx     = $('btn-add-tx');
const walletPicker = $('wallet-picker');

btnAddTx.addEventListener('click', (e) => {
  e.stopPropagation();
  const isOpen = walletPicker.style.display !== 'none';
  walletPicker.style.display = isOpen ? 'none' : 'block';
});

// Close picker when clicking outside
document.addEventListener('click', (e) => {
  if (!walletPicker.contains(e.target) && e.target !== btnAddTx) {
    walletPicker.style.display = 'none';
  }
});

// Wire wallet-picker items → open AddTransactionModal
walletPicker.querySelectorAll('.wallet-picker-item').forEach(item => {
  item.addEventListener('click', () => {
    const walletId    = item.getAttribute('data-wallet-id');
    const walletLabel = item.getAttribute('data-wallet-label');
    walletPicker.style.display = 'none';
    document.dispatchEvent(new CustomEvent('open-add-tx', {
      detail: { walletId, walletLabel },
    }));
  });
});

// ── Boot ──────────────────────────────────────────────────────────────────────
loadNeedsAttention();
</script>

<AddTransactionModal />
