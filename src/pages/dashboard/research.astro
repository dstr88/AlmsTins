  }
  .addr-copy-btn:hover { border-color: rgba(255,255,255,0.25); color: rgba(255,255,255,0.85); }
  .addr-copy-text { font-family: monospace; }
  .addr-community-badge {
    font-size: 0.72rem;
    opacity: 0.45;
