      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category: cat, ...(note ? { note } : {}) }),
    });
    if (!res.ok) throw new Error(await res.text());
    await loadNeedsAttention();
  } catch {
    btn.disabled = false;
    btn.textContent = '⚠ Failed';
  }
}

async function helpSaveNote(e, txId) {
  e.stopPropagation();
  const noteEl = document.getElementById('hp-note-' + txId);
  const note   = noteEl?.value.trim() ?? '';
  if (!note) return;
  const btn = e.currentTarget;
  btn.disabled = true;
  try {
    const res = await fetch(`/api/research/annotate/${txId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ note }),
    });
    if (!res.ok) throw new Error(await res.text());
    await loadNeedsAttention();
  } catch {
    btn.disabled = false;
    btn.textContent = '⚠ Failed';
  }
}

// ── Dataset Health Check ──────────────────────────────────────────────────────
async function loadHealthCheck() {
  try {
    const res  = await fetch('/api/research/diagnostics');
    const data = await res.json();
    if (data.ok) renderHealthCheck(data);
  } catch {}
}

function renderHealthCheck(d) {
  const grid = $('health-grid');
  if (!grid) return;

  const fmtV = n => n >= 1000 ? '$' + (n/1000).toFixed(0) + 'k' : '$' + n;

  const cards = [];

  // Import coverage
  const sources = d.coverage ?? [];
  if (sources.length) {
    const years = sources.map(r => {
      const e = String(r.earliest ?? '').slice(0, 4);
      const l = String(r.latest   ?? '').slice(0, 4);
      return `${r.source}: ${e}–${l}`;
    });
    cards.push({
      title:   'Import Coverage',
      body:    `${sources.length} source${sources.length !== 1 ? 's' : ''}`,
      detail:  years.slice(0, 4).join('<br>') + (years.length > 4 ? '<br>+more' : ''),
      status:  'ok',
    });
  }

  // Pre-2019 gaps
  const pre = d.pre2019 ?? {};
  if (Number(pre.total) > 0) {
    const noHash = Number(pre.no_hash ?? 0);
    cards.push({
      title:  'Pre-2019 Records',
      body:   `${pre.total} transactions`,
      detail: `${noHash} without tx hash · ${fmtV(Number(pre.value_usd ?? 0))} exposed`,
      status: noHash > 0 ? 'warn' : 'ok',
    });
  }

  // Non-EVM
  const nonEvm = (d.nonEvm ?? []).filter(r => Number(r.cnt) > 0);
  if (nonEvm.length) {
    const total = nonEvm.reduce((s, r) => s + Number(r.value_usd ?? 0), 0);
    const top   = nonEvm.slice(0, 3).map(r => `${r.asset_symbol} (${r.cnt})`).join(', ');
    cards.push({
      title:  'Non-EVM Unresolved',
      body:   `${nonEvm.length} asset${nonEvm.length !== 1 ? 's' : ''}`,
      detail: `${top}${nonEvm.length > 3 ? ', +more' : ''}<br>${fmtV(total)} total`,
      status: total > 5000 ? 'warn' : 'info',
    });
  }

  // P2P
  if (Number(d.p2p?.cnt) > 0) {
    cards.push({
      title:  'P2P Phone Transfers',
      body:   `${d.p2p.cnt} transactions`,
      detail: `${fmtV(Number(d.p2p.value_usd ?? 0))} · Need manual categorization`,
      status: 'info',
    });
  }

  // Price gaps
  const gaps = (d.priceGaps ?? []).filter(r => Number(r.cnt) > 0);
  if (gaps.length) {
    const total = gaps.reduce((s, r) => s + Number(r.cnt ?? 0), 0);
    cards.push({
      title:  'Missing Prices',
      body:   `${total} transactions`,
      detail: gaps.map(r => `${r.source}: ${r.cnt}`).slice(0, 4).join('<br>'),
      status: 'warn',
    });
  }

  // Orphaned INs
  const orphans = (d.orphanedIns ?? []).filter(r => Number(r.value_usd) >= 500);
  if (orphans.length) {
    const total = orphans.reduce((s, r) => s + Number(r.value_usd ?? 0), 0);
    cards.push({
      title:  'Unexplained Receipts',
      body:   `${orphans.length} asset${orphans.length !== 1 ? 's' : ''} · ${fmtV(total)}`,
      detail: orphans.slice(0, 4).map(r => `${r.asset_symbol} ${fmtV(Number(r.value_usd))}`).join('<br>'),
      status: 'warn',
    });
  }

  // Failed exchanges
  if (d.failedExchanges?.length) {
    cards.push({
      title:  'Failed Exchange Data',
      body:   d.failedExchanges.map(ex => ex.name).join(', '),
      detail: 'Records imported from failed platforms — verify loss claims and write-offs',
      status: 'warn',
    });
  }

  // Suspicious implied prices
  const suspPrices = (d.suspiciousPrices ?? []);
  if (suspPrices.length) {
    const sample = suspPrices.slice(0, 3).map(r => {
      const implied = Number(r.implied_price ?? 0);
      const max     = Number(r.max_price ?? 0);
      const ratio   = max > 0 ? Math.round(max / implied) : 0;
      return `${r.asset_symbol} · ${fmtUsd(r.native_usd)} (${ratio > 0 ? ratio + '× below max' : 'suspect'})`;
    }).join('<br>');
    cards.push({
      title:  'Suspect Price Data',
      body:   `${suspPrices.length} transaction${suspPrices.length !== 1 ? 's' : ''}`,
      detail: sample + '<br><span class="health-card-footnote">Cost basis may be understated</span>',
      status: 'warn',
    });
  }

  // Fiat noise
  if (Number(d.fiatNoise) > 0) {
    cards.push({
      title:  'Fiat as Asset',
      body:   `${d.fiatNoise} transactions`,
      detail: 'USD/EUR recorded as asset_symbol — likely noise from stablecoins or CSV quirks',
      status: 'info',
    });
  }

  if (!cards.length) {
    grid.innerHTML = '<div class="health-empty">No issues found — dataset looks clean.</div>';
    return;
  }

  grid.innerHTML = cards.map(c => `
    <div class="health-card health-card-${c.status}">
      <div class="health-card-title">${c.title}</div>
      <div class="health-card-body">${c.body}</div>
      <div class="health-card-detail">${c.detail}</div>
    </div>
  `).join('');

  // Top unresolved
  const top = d.topUnresolved ?? [];
  if (top.length) {
    const topHtml = top.map(t => {
      const dir = (t.direction ?? '').toLowerCase();
      const amt = dir === 'out' ? `−${fmt(Math.abs(Number(t.amount)))}` : `+${fmt(Number(t.amount))}`;
      return `<div class="health-tx-row">
        <span class="tx-dir ${dir}">${dir}</span>
        <span class="health-tx-sym">${t.asset_symbol}</span>
        <span class="health-tx-amt">${amt}</span>
        <span class="health-tx-usd">${t.native_usd ? fmtUsd(t.native_usd) : ''}</span>
        <span class="health-tx-src">${srcName(t.source)}</span>
        <span class="health-tx-dt">${fmtDate(t.timestamp_utc)}</span>
      </div>`;
    }).join('');
    grid.insertAdjacentHTML('beforeend', `
      <div class="health-unresolved-block">
        <div class="health-unresolved-title">Top unresolved by dollar value</div>
        ${topHtml}
      </div>
    `);
  }
}

