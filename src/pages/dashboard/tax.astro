---
/**
 * /dashboard/tax — Schedule D tax summary
 *
 * Shows a high-level breakdown of:
 *   • Ordinary income   (Aave interest, rebasing rewards — Form 1040 Schedule 1)
 *   • Disposal proceeds (capital events — Form 8949 / Schedule D)
 *   • Forced liquidations
 *   • Unpriced warning  (transactions that still need historical pricing)
 *
 * Exact FIFO per-lot gain/loss is computed client-side on the transactions page
 * and downloaded from there as a Form 8949 CSV.  This page gives the tax-season
 * overview at a glance.
 */

import Layout from '../../layouts/Layout.astro';

// ── Types ──────────────────────────────────────────────────────────────────
type AssetIncome = { symbol: string; amount: number; count: number };

type TaxPayload = {
	ok: boolean;
	error?: string;
	year?: number;
	availableYears?: number[];
	ordinaryIncome?: {
		total: number;
		count: number;
		byAsset: AssetIncome[];
	};
	disposals?: {
		totalProceeds:    number;
		count:            number;
		unpricedCount:    number;
		liquidationCount: number;
	};
	unpricedOnchain?: number;
	gains?: {
		shortTermGain:  number;
		longTermGain:   number;
		netGain:        number;
		shortTermCount: number;
		longTermCount:  number;
	};
	byAssetGains?: {
		asset:   string;
		stGain:  number;
		stLots:  number;
		ltGain:  number;
		ltLots:  number;
		netGain: number;
	}[];
	harvestLosses?: {
		asset:              string;
		totalQty:           number;
		totalCost:          number;
		currentPrice:       number | null;
		currentValue:       number | null;
		unrealizedGainLoss: number | null;
		shortTermQty:       number;
		longTermQty:        number;
		soonestLotDaysToLT: number | null;
	}[];
	missingBasis?: {
		asset:    string;
		date:     string;
		qty:      number;
		proceeds: number | null;
		issue:    'no_cost_basis' | 'no_matching_buy';
		daysHeld: number | null;
		term:     'short' | 'long' | null;
	}[];
};

// ── Fetch data ─────────────────────────────────────────────────────────────
const defaultYear = new Date().getFullYear() - 1; // prior tax year
const yearParam   = Astro.url.searchParams.get('year');
const year        = yearParam ? Number(yearParam) : defaultYear;

const apiUrl = new URL(`/api/tax/summary?year=${year}`, Astro.request.url);
const apiRes = await fetch(apiUrl);
const data: TaxPayload = apiRes.ok ? await apiRes.json() : { ok: false };

const payload        = data.ok ? data : null;
const availableYears = payload?.availableYears ?? [];

// ── Helpers ────────────────────────────────────────────────────────────────
const fmt = (n: number) =>
	n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });

const fmtDate = (iso: string) => {
	try { return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
	catch { return iso; }
};

// Accounting notation: losses in parentheses, gains with + prefix
const fmtGain = (n: number) => {
	const abs = Math.abs(n).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
	if (n < 0) return `(${abs})`;
	if (n > 0) return `+${abs}`;
	return abs;
};
---

<Layout title="Gains Center | Almstins" noindex={true}>
	<div class="max-w-4xl mx-auto px-4 py-8 space-y-8">

		<!-- Header + year picker -->
		<div class="flex items-center justify-between flex-wrap gap-4">
			<div>
				<h1 class="text-2xl font-bold">Gains Summary</h1>
				<p class="text-sm text-gray-500 mt-1">
					Realized gains overview for <strong>{year}</strong>.
					Detailed gain/loss per lot is in the
					<a href="/dashboard/transactions" class="underline text-blue-600 hover:text-blue-800">
						CSV export
					</a>.
				</p>
			</div>

			{availableYears.length > 0 && (
				<form id="gains-year-filter" method="get" class="flex items-center gap-2">
					<label for="year-select" class="text-sm font-medium text-gray-700">Calendar year</label>
					<select
						id="year-select"
						name="year"
						onchange="this.form.submit()"
						class="border border-gray-300 rounded-md px-3 py-1.5 text-sm shadow-sm
						       focus:outline-none focus:ring-2 focus:ring-blue-500"
					>
						{availableYears.map((y) => (
							<option value={y} selected={y === year}>{y}</option>
						))}
					</select>
				</form>
			)}
		</div>

		<!-- API / data error -->
		{!payload && (
			<div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
				Unable to load tax data for {year}. Try refreshing the page.
			</div>
		)}

		{payload && (
			<>
				<!-- Unpriced transactions warning -->
				{(payload.unpricedOnchain ?? 0) > 0 && (
					<div class="flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4">
						<span class="text-amber-500 text-xl leading-none mt-0.5">⚠</span>
						<div class="text-sm">
							<p class="font-semibold text-amber-800">
								{payload.unpricedOnchain} on-chain
								transaction{payload.unpricedOnchain !== 1 ? 's are' : ' is'} missing
								historical USD prices.
							</p>
							<p class="text-amber-700 mt-1">
								Cost basis and proceeds may be incomplete. Historical pricing runs
								automatically after each sync — check back shortly or trigger a
								re-sync from the
								<a href="/dashboard/wallets" class="underline">wallets page</a>.
							</p>
						</div>
					</div>
				)}

				<!-- ST / LT gain cards -->
				{payload.gains && (
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-gray-100">
							<h2 class="text-sm font-semibold text-gray-700">Realized Capital Gains</h2>
							<p class="text-xs text-gray-400 mt-0.5">FIFO cost basis · Schedule D</p>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-gray-100">

							<!-- Short-term -->
							<div class="p-5 space-y-1">
								<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
									Short-term &nbsp;<span class="normal-case font-normal text-gray-400">(held ≤ 1 yr)</span>
								</p>
								<p class={`text-2xl font-bold ${
									(payload.gains.shortTermGain ?? 0) >= 0 ? 'text-green-700' : 'text-red-600'
								}`}>
									{fmtGain(payload.gains.shortTermGain)}
								</p>
								<p class="text-xs text-gray-500">
									{payload.gains.shortTermCount} lot{payload.gains.shortTermCount !== 1 ? 's' : ''}
									&nbsp;·&nbsp;taxed as ordinary income
								</p>
							</div>

							<!-- Long-term -->
							<div class="p-5 space-y-1">
								<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
									Long-term &nbsp;<span class="normal-case font-normal text-gray-400">(held &gt; 1 yr)</span>
								</p>
								<p class={`text-2xl font-bold ${
									(payload.gains.longTermGain ?? 0) >= 0 ? 'text-green-700' : 'text-red-600'
								}`}>
									{fmtGain(payload.gains.longTermGain)}
								</p>
								<p class="text-xs text-gray-500">
									{payload.gains.longTermCount} lot{payload.gains.longTermCount !== 1 ? 's' : ''}
									&nbsp;·&nbsp;0% / 15% / 20% rate
								</p>
							</div>

							<!-- Net -->
							<div class="p-5 space-y-1">
								<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
									Net realized
								</p>
								<p class={`text-2xl font-bold ${
									(payload.gains.netGain ?? 0) >= 0 ? 'text-green-700' : 'text-red-600'
								}`}>
									{fmtGain(payload.gains.netGain)}
								</p>
								<p class="text-xs text-gray-500">
									ST + LT combined
								</p>
							</div>

						</div>
					</div>
				)}

				<!-- Per-asset breakdown -->
				{(payload.byAssetGains?.length ?? 0) > 0 && (
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
							<h2 class="text-sm font-semibold text-gray-700">Gain / Loss by Asset</h2>
							<span class="text-xs text-gray-400">FIFO · sorted by impact</span>
						</div>
						<table class="min-w-full text-sm">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-5 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Asset</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">ST Gain / Loss</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">ST Lots</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">LT Gain / Loss</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">LT Lots</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">Net</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100">
								{payload.byAssetGains!.map((row) => (
									<tr class="hover:bg-gray-50">
										<td class="px-5 py-3 font-mono font-semibold text-gray-800">{row.asset}</td>
										<td class={`px-5 py-3 text-right font-medium tabular-nums ${row.stGain < 0 ? 'text-red-600' : row.stGain > 0 ? 'text-green-700' : 'text-gray-400'}`}>
											{row.stLots > 0 ? fmtGain(row.stGain) : <span class="text-gray-300">—</span>}
										</td>
										<td class="px-5 py-3 text-right text-gray-500 tabular-nums">
											{row.stLots > 0 ? row.stLots : <span class="text-gray-300">—</span>}
										</td>
										<td class={`px-5 py-3 text-right font-medium tabular-nums ${row.ltGain < 0 ? 'text-red-600' : row.ltGain > 0 ? 'text-green-700' : 'text-gray-400'}`}>
											{row.ltLots > 0 ? fmtGain(row.ltGain) : <span class="text-gray-300">—</span>}
										</td>
										<td class="px-5 py-3 text-right text-gray-500 tabular-nums">
											{row.ltLots > 0 ? row.ltLots : <span class="text-gray-300">—</span>}
										</td>
										<td class={`px-5 py-3 text-right font-semibold tabular-nums ${row.netGain < 0 ? 'text-red-600' : row.netGain > 0 ? 'text-green-700' : 'text-gray-400'}`}>
											{fmtGain(row.netGain)}
										</td>
									</tr>
								))}
								<!-- Totals row -->
								<tr class="bg-gray-50 font-semibold border-t-2 border-gray-200">
									<td class="px-5 py-3 text-gray-700">Total</td>
									<td class={`px-5 py-3 text-right tabular-nums ${(payload.gains?.shortTermGain ?? 0) < 0 ? 'text-red-600' : 'text-green-700'}`}>
										{fmtGain(payload.gains?.shortTermGain ?? 0)}
									</td>
									<td class="px-5 py-3 text-right text-gray-500">{payload.gains?.shortTermCount}</td>
									<td class={`px-5 py-3 text-right tabular-nums ${(payload.gains?.longTermGain ?? 0) < 0 ? 'text-red-600' : 'text-green-700'}`}>
										{fmtGain(payload.gains?.longTermGain ?? 0)}
									</td>
									<td class="px-5 py-3 text-right text-gray-500">{payload.gains?.longTermCount}</td>
									<td class={`px-5 py-3 text-right tabular-nums ${(payload.gains?.netGain ?? 0) < 0 ? 'text-red-600' : 'text-green-700'}`}>
										{fmtGain(payload.gains?.netGain ?? 0)}
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				)}

				<!-- Tax-loss harvesting -->
				{(payload.harvestLosses?.length ?? 0) > 0 && (
					<div class="rounded-xl border border-amber-200 bg-amber-50 shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-amber-200 flex items-center justify-between">
							<div>
								<h2 class="text-sm font-semibold text-amber-900">Tax-Loss Harvesting Opportunities</h2>
								<p class="text-xs text-amber-700 mt-0.5">Open lots currently below cost basis · selling locks in a deductible loss</p>
							</div>
							<span class="text-xs text-amber-600 font-medium">{payload.harvestLosses!.length} asset{payload.harvestLosses!.length !== 1 ? 's' : ''} underwater</span>
						</div>
						<table class="min-w-full text-sm">
							<thead class="bg-amber-100">
								<tr>
									<th class="px-5 py-2.5 text-left   text-xs font-medium text-amber-800 uppercase tracking-wide">Asset</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Qty Held</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Cost Basis</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Current Value</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Unrealized Loss</th>
									<th class="px-5 py-2.5 text-center text-xs font-medium text-amber-800 uppercase tracking-wide">Term</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Days to LT</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-amber-100 bg-white">
								{payload.harvestLosses!.map((row) => {
									const termLabel = row.longTermQty > 0 && row.shortTermQty > 0
										? 'Mixed'
										: row.longTermQty > 0 ? 'Long' : 'Short';
									const termColor = termLabel === 'Long'
										? 'text-green-700 bg-green-50'
										: termLabel === 'Short'
											? 'text-amber-700 bg-amber-50'
											: 'text-purple-700 bg-purple-50';
									return (
										<tr class="hover:bg-amber-50">
											<td class="px-5 py-3 font-mono font-semibold text-gray-800">{row.asset}</td>
											<td class="px-5 py-3 text-right text-gray-600 tabular-nums">
												{row.totalQty.toLocaleString('en-US', { maximumFractionDigits: 6 })}
											</td>
											<td class="px-5 py-3 text-right text-gray-700 tabular-nums">{fmt(row.totalCost)}</td>
											<td class="px-5 py-3 text-right text-gray-700 tabular-nums">
												{row.currentValue !== null ? fmt(row.currentValue) : <span class="text-gray-300">—</span>}
											</td>
											<td class="px-5 py-3 text-right font-semibold text-red-600 tabular-nums">
												{row.unrealizedGainLoss !== null ? fmtGain(row.unrealizedGainLoss) : <span class="text-gray-300">—</span>}
											</td>
											<td class="px-5 py-3 text-center">
												<span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${termColor}`}>
													{termLabel}
												</span>
											</td>
											<td class="px-5 py-3 text-right text-gray-500 tabular-nums">
												{termLabel === 'Long'
													? <span class="text-green-600 font-medium">✓ LT</span>
													: row.soonestLotDaysToLT !== null
														? `${row.soonestLotDaysToLT}d`
														: '—'
												}
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
						<div class="px-5 py-3 border-t border-amber-200 bg-amber-50">
							<p class="text-xs text-amber-700">
								<strong>Note:</strong> Prices are live spot rates. Selling and immediately rebuying
								may trigger wash-sale–like treatment depending on IRS guidance for your situation.
								Consult a tax professional before harvesting.
							</p>
						</div>
					</div>
				)}

				<!-- Missing cost basis report -->
				{(payload.missingBasis?.length ?? 0) > 0 && (
					<div class="rounded-xl border border-red-200 bg-red-50 shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-red-200 flex items-center justify-between">
							<div>
								<h2 class="text-sm font-semibold text-red-900">Missing Cost Basis</h2>
								<p class="text-xs text-red-700 mt-0.5">These disposals have incomplete records — your gain/loss totals above may be wrong</p>
							</div>
							<span class="text-xs text-red-600 font-semibold bg-red-100 px-2 py-0.5 rounded-full">
								{payload.missingBasis!.length} issue{payload.missingBasis!.length !== 1 ? 's' : ''}
							</span>
						</div>
						<table class="min-w-full text-sm">
							<thead class="bg-red-100">
								<tr>
									<th class="px-5 py-2.5 text-left  text-xs font-medium text-red-800 uppercase tracking-wide">Asset</th>
									<th class="px-5 py-2.5 text-left  text-xs font-medium text-red-800 uppercase tracking-wide">Disposed</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-red-800 uppercase tracking-wide">Qty</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-red-800 uppercase tracking-wide">Proceeds</th>
									<th class="px-5 py-2.5 text-left  text-xs font-medium text-red-800 uppercase tracking-wide">Term</th>
									<th class="px-5 py-2.5 text-left  text-xs font-medium text-red-800 uppercase tracking-wide">Problem</th>
									<th class="px-5 py-2.5 text-left  text-xs font-medium text-red-800 uppercase tracking-wide">Fix</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-red-100 bg-white">
								{payload.missingBasis!.map((row) => {
									const isOrphan = row.issue === 'no_matching_buy';
									return (
										<tr class="hover:bg-red-50">
											<td class="px-5 py-3 font-mono font-semibold text-gray-800">{row.asset}</td>
											<td class="px-5 py-3 text-gray-600">{fmtDate(row.date)}</td>
											<td class="px-5 py-3 text-right text-gray-600 tabular-nums">
												{row.qty.toLocaleString('en-US', { maximumFractionDigits: 6 })}
											</td>
											<td class="px-5 py-3 text-right tabular-nums text-gray-700">
												{row.proceeds !== null ? fmt(row.proceeds) : <span class="text-gray-300">—</span>}
											</td>
											<td class="px-5 py-3">
												{row.term
													? <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${row.term === 'long' ? 'text-green-700 bg-green-50' : 'text-amber-700 bg-amber-50'}`}>
														{row.term === 'long' ? 'Long' : 'Short'}
													</span>
													: <span class="text-gray-300 text-xs">Unknown</span>
												}
											</td>
											<td class="px-5 py-3">
												{isOrphan
													? <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium text-red-700 bg-red-100">No matching buy</span>
													: <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium text-orange-700 bg-orange-50">Buy has no price</span>
												}
											</td>
											<td class="px-5 py-3 text-xs text-gray-500">
												{isOrphan
													? <a href="/dashboard/bookkeeping" class="underline text-blue-600 hover:text-blue-800">Find in Bookkeeping →</a>
													: <a href="/dashboard/bookkeeping" class="underline text-blue-600 hover:text-blue-800">Enter cost manually →</a>
												}
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
						<div class="px-5 py-3 border-t border-red-200 bg-red-50">
							<p class="text-xs text-red-700">
								<strong>Impact:</strong> "No matching buy" means the IRS may treat the full proceeds as gain.
								"Buy has no price" means cost basis is assumed $0, overstating your taxable gain.
								Resolve these in Bookkeeping before filing.
							</p>
						</div>
					</div>
				)}

				<!-- Estimated Tax Liability -->
				<div
					id="tax-estimator"
					class="rounded-xl border border-indigo-200 bg-white shadow-sm overflow-hidden"
					data-st-gain={payload.gains?.shortTermGain ?? 0}
					data-lt-gain={payload.gains?.longTermGain ?? 0}
					data-ordinary-income={payload.ordinaryIncome?.total ?? 0}
					data-year={year}
				>
					<div class="px-5 py-3 border-b border-indigo-100 flex items-center justify-between">
						<div>
							<h2 class="text-sm font-semibold text-indigo-900">Estimated Tax Liability</h2>
							<p class="text-xs text-indigo-600 mt-0.5">Based on {year} IRS brackets · estimate only</p>
						</div>
						<span class="text-xs text-indigo-400 font-medium">Not financial advice</span>
					</div>

					<!-- Inputs -->
					<div class="px-5 py-4 border-b border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50">
						<div>
							<label class="block text-xs font-semibold text-gray-600 mb-1">Filing Status</label>
							<select id="est-filing-status" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
								<option value="single">Single</option>
								<option value="mfj">Married Filing Jointly</option>
								<option value="mfs">Married Filing Separately</option>
								<option value="hoh">Head of Household</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-semibold text-gray-600 mb-1">
								Other Taxable Income (wages, salary, etc.)
							</label>
							<div class="relative">
								<span class="absolute left-3 top-2 text-gray-400 text-sm">$</span>
								<input
									id="est-other-income"
									type="number"
									min="0"
									step="1000"
									value="0"
									class="w-full border border-gray-300 rounded-lg pl-7 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
								/>
							</div>
						</div>
					</div>

					<!-- Output -->
					<div class="grid grid-cols-1 sm:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-gray-100">
						<div class="p-5 space-y-1">
							<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">ST Tax Est.</p>
							<p id="est-st-tax" class="text-2xl font-bold text-gray-900">—</p>
							<p id="est-st-rate" class="text-xs text-gray-500">marginal rate</p>
						</div>
						<div class="p-5 space-y-1">
							<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">LT Tax Est.</p>
							<p id="est-lt-tax" class="text-2xl font-bold text-gray-900">—</p>
							<p id="est-lt-rate" class="text-xs text-gray-500">capital gains rate</p>
						</div>
						<div class="p-5 space-y-1">
							<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Crypto Income Tax</p>
							<p id="est-income-tax" class="text-2xl font-bold text-gray-900">—</p>
							<p class="text-xs text-gray-500">staking / interest</p>
						</div>
						<div class="p-5 space-y-1 bg-indigo-50">
							<p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Total Estimate</p>
							<p id="est-total-tax" class="text-2xl font-bold text-indigo-900">—</p>
							<p class="text-xs text-indigo-500">crypto-related only</p>
						</div>
					</div>

					<div class="px-5 py-3 border-t border-gray-100 bg-gray-50">
						<p class="text-xs text-gray-400">
							This is a rough estimate using IRS marginal brackets. It does not account for deductions,
							AMT, NIIT, state taxes, or other income. Short-term gains are stacked on top of your
							other income. Consult a CPA for your actual liability.
						</p>
					</div>
				</div>

				<!-- Summary cards -->
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

					<!-- Ordinary Income -->
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm p-5 space-y-1">
						<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
							Ordinary Income
						</p>
						<p class="text-2xl font-bold text-gray-900">
							{fmt(payload.ordinaryIncome?.total ?? 0)}
						</p>
						<p class="text-xs text-gray-500">
							{payload.ordinaryIncome?.count ?? 0} interest
							event{(payload.ordinaryIncome?.count ?? 0) !== 1 ? 's' : ''}
							&nbsp;·&nbsp;Schedule 1 / Form 1040
						</p>
					</div>

					<!-- Disposal Proceeds -->
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm p-5 space-y-1">
						<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
							Disposal Proceeds
						</p>
						<p class="text-2xl font-bold text-gray-900">
							{fmt(payload.disposals?.totalProceeds ?? 0)}
						</p>
						<p class="text-xs text-gray-500">
							{payload.disposals?.count ?? 0}
							disposal{(payload.disposals?.count ?? 0) !== 1 ? 's' : ''}
							&nbsp;·&nbsp;gross proceeds
						</p>
					</div>

					<!-- Forced Liquidations -->
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm p-5 space-y-1">
						<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
							Forced Liquidations
						</p>
						<p class={`text-2xl font-bold ${
							(payload.disposals?.liquidationCount ?? 0) > 0
								? 'text-red-600'
								: 'text-gray-900'
						}`}>
							{payload.disposals?.liquidationCount ?? 0}
						</p>
						<p class="text-xs text-gray-500">
							Aave liquidations — treated as taxable sales
						</p>
					</div>

				</div>

				<!-- Ordinary Income breakdown by asset -->
				{(payload.ordinaryIncome?.byAsset?.length ?? 0) > 0 && (
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
							<h2 class="text-sm font-semibold text-gray-700">
								Ordinary Income by Asset
							</h2>
							<span class="text-xs text-gray-400">Schedule 1 · Form 1040</span>
						</div>
						<table class="min-w-full text-sm">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-5 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
										Asset
									</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">
										Events
									</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">
										Total Income
									</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100">
								{payload.ordinaryIncome!.byAsset.map((row) => (
									<tr class="hover:bg-gray-50">
										<td class="px-5 py-3 font-mono font-medium text-gray-800">
											{row.symbol}
										</td>
										<td class="px-5 py-3 text-right text-gray-500">{row.count}</td>
										<td class="px-5 py-3 text-right font-semibold text-gray-900">
											{fmt(row.amount)}
										</td>
									</tr>
								))}
								<tr class="bg-gray-50 font-semibold">
									<td class="px-5 py-3 text-gray-700">Total</td>
									<td class="px-5 py-3 text-right text-gray-500">
										{payload.ordinaryIncome!.count}
									</td>
									<td class="px-5 py-3 text-right text-green-700">
										{fmt(payload.ordinaryIncome!.total)}
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				)}

				<!-- Disposals missing prices warning -->
				{(payload.disposals?.unpricedCount ?? 0) > 0 && (
					<div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
						<strong>{payload.disposals!.unpricedCount}</strong>
						disposal{payload.disposals!.unpricedCount !== 1 ? 's' : ''} in {year}
						{payload.disposals!.unpricedCount !== 1 ? ' are' : ' is'} missing USD prices —
						the proceeds total above is understated. Open the
						<a href="/dashboard/transactions" class="underline font-medium">
							transactions page
						</a>
						and use the FIFO export to review and fill in missing cost basis manually.
					</div>
				)}

				<!-- No taxable activity message -->
				{(payload.ordinaryIncome?.total ?? 0) === 0 &&
				 (payload.disposals?.count ?? 0) === 0 && (
					<div class="rounded-lg border border-gray-200 bg-gray-50 p-5 text-sm text-gray-600 text-center">
						No taxable events found for {year}.
						If this seems wrong, check that your wallets and exchange imports are up to date.
					</div>
				)}

				<!-- Form 8949 CTA -->
				<div class="rounded-xl border border-blue-100 bg-blue-50 p-5 flex items-center justify-between flex-wrap gap-4">
					<div>
						<p class="font-semibold text-blue-900">Ready to export?</p>
						<p class="text-sm text-blue-700 mt-0.5">
							Download the line-by-line CSV with short-term vs long-term classification
							per lot from the transactions page.
						</p>
					</div>
					<a
						href="/dashboard/transactions"
						class="inline-flex items-center gap-2 rounded-lg bg-blue-600 hover:bg-blue-700
						       text-white text-sm font-medium px-4 py-2 transition-colors"
					>
						Open Transactions →
					</a>
				</div>
			</>
		)}

	</div>
</Layout>

<script>
// ── 2024 / 2025 IRS Tax Brackets ─────────────────────────────────────────────
// Ordinary income brackets [threshold, rate]  (marginal, single top of range)
const ORDINARY: Record<string, [number, number][]> = {
  single: [
    [11600,  0.10], [47150,  0.12], [100525, 0.22],
    [191950, 0.24], [243725, 0.32], [609350, 0.35], [Infinity, 0.37],
  ],
  mfj: [
    [23200,  0.10], [94300,  0.12], [201050, 0.22],
    [383900, 0.24], [487450, 0.32], [731200, 0.35], [Infinity, 0.37],
  ],
  mfs: [
    [11600,  0.10], [47150,  0.12], [100525, 0.22],
    [191950, 0.24], [243725, 0.32], [365600, 0.35], [Infinity, 0.37],
  ],
  hoh: [
    [16550,  0.10], [63100,  0.12], [100500, 0.22],
    [191950, 0.24], [243700, 0.32], [609350, 0.35], [Infinity, 0.37],
  ],
};

// Long-term capital gains rate thresholds [threshold, rate]
const LT_RATES: Record<string, [number, number][]> = {
  single: [[47025, 0.00], [518900, 0.15], [Infinity, 0.20]],
  mfj:    [[94050, 0.00], [583750, 0.15], [Infinity, 0.20]],
  mfs:    [[47025, 0.00], [291850, 0.15], [Infinity, 0.20]],
  hoh:    [[63000, 0.00], [551350, 0.15], [Infinity, 0.20]],
};

function marginalRate(income: number, brackets: [number, number][]): number {
  for (const [top, rate] of brackets) {
    if (income <= top) return rate;
  }
  return brackets[brackets.length - 1][1];
}

// Compute tax owed on `amount` stacked on top of `base` income using marginal brackets.
// Returns { tax, effectiveRate }.
function taxOnAmount(base: number, amount: number, brackets: [number, number][]): { tax: number; rate: number } {
  if (amount <= 0) return { tax: 0, rate: 0 };
  let tax = 0;
  let prev = 0;
  let remaining = amount;
  const totalTop = base + amount;

  for (const [top, rate] of brackets) {
    const sliceTop = Math.min(top, totalTop);
    if (sliceTop <= base) { prev = sliceTop; continue; }
    const sliceBottom = Math.max(prev, base);
    const slice = Math.min(sliceTop - sliceBottom, remaining);
    if (slice <= 0) { prev = sliceTop; continue; }
    tax += slice * rate;
    remaining -= slice;
    prev = sliceTop;
    if (remaining <= 0) break;
  }
  return { tax, rate: tax / amount };
}

function fmtUsd(n: number): string {
  return n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
}
function fmtPct(r: number): string {
  return (r * 100).toFixed(1) + '%';
}

function recalculate() {
  const el = document.getElementById('tax-estimator');
  if (!el) return;

  const stGain        = parseFloat(el.dataset.stGain  ?? '0') || 0;
  const ltGain        = parseFloat(el.dataset.ltGain  ?? '0') || 0;
  const cryptoIncome  = parseFloat(el.dataset.ordinaryIncome ?? '0') || 0;

  const filingEl = document.getElementById('est-filing-status') as HTMLSelectElement | null;
  const otherEl  = document.getElementById('est-other-income')  as HTMLInputElement  | null;

  const filing     = (filingEl?.value ?? 'single') as keyof typeof ORDINARY;
  const otherIncome = Math.max(0, parseFloat(otherEl?.value ?? '0') || 0);

  const ordBrackets = ORDINARY[filing] ?? ORDINARY.single;
  const ltBrackets  = LT_RATES[filing]  ?? LT_RATES.single;

  // Base = other income
  // ST gains stacked on top of base (ordinary income treatment)
  // Crypto income stacked on top of base + ST gains
  const stResult     = taxOnAmount(otherIncome,                          Math.max(0, stGain),       ordBrackets);
  const incomeResult = taxOnAmount(otherIncome + Math.max(0, stGain),    Math.max(0, cryptoIncome), ordBrackets);

  // LT gains: rate determined by total ordinary income stacked base
  const ltOrdinaryBase = otherIncome + Math.max(0, stGain) + Math.max(0, cryptoIncome);
  const ltRate = marginalRate(ltOrdinaryBase, ltBrackets);
  const ltTax  = Math.max(0, ltGain) * ltRate;

  // If gains are negative, they offset — show $0 but note the offset
  const stTax    = stGain    < 0 ? 0 : stResult.tax;
  const incomeTax = cryptoIncome < 0 ? 0 : incomeResult.tax;
  const totalTax = stTax + incomeTax + ltTax;

  const setText = (id: string, val: string) => {
    const node = document.getElementById(id);
    if (node) node.textContent = val;
  };

  setText('est-st-tax',     stGain    <= 0 ? '—' : fmtUsd(stTax));
  setText('est-st-rate',    stGain    <= 0 ? 'no ST gain this year' : `${fmtPct(stResult.rate)} effective rate`);
  setText('est-lt-tax',     ltGain    <= 0 ? '—' : fmtUsd(ltTax));
  setText('est-lt-rate',    ltGain    <= 0 ? 'no LT gain this year' : `${fmtPct(ltRate)} capital gains rate`);
  setText('est-income-tax', cryptoIncome <= 0 ? '—' : fmtUsd(incomeTax));
  setText('est-total-tax',  totalTax  <= 0 ? '$0' : fmtUsd(totalTax));
}

document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('est-filing-status')?.addEventListener('change', recalculate);
  document.getElementById('est-other-income')?.addEventListener('input', recalculate);
  recalculate();
});
</script>
