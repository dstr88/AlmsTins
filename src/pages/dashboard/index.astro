---
import Layout from '../../layouts/Layout.astro';
import TransactionsTable from '../../components/dashboard/TransactionsTable';
import { getAllActiveWallets } from '../../lib/wallets';
import { requireTenantSession } from '../../lib/requireTenantSession';

const { tenantId } = await requireTenantSession(Astro.request);
const wallets = await getAllActiveWallets(tenantId);
const defaultWallet = wallets[0] ?? null;
---

<Layout>
	<h1 class="text-2xl font-bold mb-4">Dashboard</h1>

	{defaultWallet ? (
		<>
			<p class="text-sm text-gray-600 mb-2">
				Showing transactions for <code>{defaultWallet.address}</code>
			</p>
			<TransactionsTable client:load walletId={defaultWallet.id} />
		</>
	) : (
		<p class="text-sm text-gray-500">No default wallet configured.</p>
	)}
</Layout>
