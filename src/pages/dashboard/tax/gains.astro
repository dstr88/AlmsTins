---
/**
 * /dashboard/tax — Schedule D tax summary
 *
 * Shows a high-level breakdown of:
 *   • Ordinary income   (Aave interest, rebasing rewards — Form 1040 Schedule 1)
 *   • Disposal proceeds (capital events — Form 8949 / Schedule D)
 *   • Forced liquidations
 *   • Unpriced warning  (transactions that still need historical pricing)
 *
 * Exact FIFO per-lot gain/loss is computed client-side on the transactions page
 * and downloaded from there as a Form 8949 CSV.  This page gives the tax-season
 * overview at a glance.
 */

import Layout from '../../layouts/Layout.astro';
import CompletenessScore from '@/components/tax/CompletenessScore.astro';

// ── Types ──────────────────────────────────────────────────────────────────
type AssetIncome = { symbol: string; amount: number; count: number };

type IncomeCategoryRow = {
	type:    string;
	label:   string;
	irsLine: string;
	count:   number;
	total:   number;
};

type WashSaleItem = {
	asset:             string;
	disposedAt:        string;
	lossAmount:        number;
	triggerAcquiredAt: string;
	disallowedLoss:    number;
};

type DefiTypeRow = { type: string; label: string; count: number; totalUsd: number };

type TaxPayload = {
	ok: boolean;
	error?: string;
	year?: number;
	availableYears?: number[];
	ordinaryIncome?: {
		total: number;
		count: number;
		byAsset: AssetIncome[];
		byCategory?: IncomeCategoryRow[];
	};
	disposals?: {
		totalProceeds:    number;
		count:            number;
		unpricedCount:    number;
		liquidationCount: number;
	};
	unpricedOnchain?: number;
	gains?: {
		shortTermGain:  number;
		longTermGain:   number;
		netGain:        number;
		shortTermCount: number;
		longTermCount:  number;
	};
	byAssetGains?: {
		asset:   string;
		stGain:  number;
		stLots:  number;
		ltGain:  number;
		ltLots:  number;
		netGain: number;
	}[];
	harvestLosses?: {
		asset:              string;
		totalQty:           number;
		totalCost:          number;
		currentPrice:       number | null;
		currentValue:       number | null;
		unrealizedGainLoss: number | null;
		shortTermQty:       number;
		longTermQty:        number;
		soonestLotDaysToLT: number | null;
	}[];
	missingBasis?: {
		asset:    string;
		date:     string;
		qty:      number;
		proceeds: number | null;
		issue:    'no_cost_basis' | 'no_matching_buy';
		daysHeld: number | null;
		term:     'short' | 'long' | null;
	}[];
	carryLedger?: {
		year:           number;
		netGainLoss:    number;
		deducted:       number;
		absorbedByGain: number;
		endingBalance:  number;
	}[];
	carryforwardAvailable?: number;
	yoyRows?: { year: number; stGain: number; ltGain: number; netGain: number }[];
	method?: 'fifo' | 'hifo' | 'lifo' | 'spec_id';
	washSaleShadow?: { totalDisallowed: number; items: WashSaleItem[] };
	defiEvents?: { count: number; byType: DefiTypeRow[] };
};

// ── Fetch data ─────────────────────────────────────────────────────────────
const defaultYear = new Date().getFullYear() - 1; // prior tax year
const yearParam   = Astro.url.searchParams.get('year');
const year        = yearParam ? Number(yearParam) : defaultYear;
const methodParam = Astro.url.searchParams.get('method');
const method =
	methodParam === 'hifo'    ? 'hifo'    :
	methodParam === 'lifo'    ? 'lifo'    :
	methodParam === 'spec_id' ? 'spec_id' : 'fifo';

const apiUrl = new URL(`/api/tax/summary?year=${year}&method=${method}`, Astro.request.url);
const apiRes = await fetch(apiUrl);
const data: TaxPayload = apiRes.ok ? await apiRes.json() : { ok: false };

const payload        = data.ok ? data : null;
const availableYears = payload?.availableYears ?? [];

// ── Helpers ────────────────────────────────────────────────────────────────
const fmt = (n: number) =>
	n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });

const fmtDate = (iso: string) => {
	try { return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
	catch { return iso; }
};

// Accounting notation: losses in parentheses, gains with + prefix
const fmtGain = (n: number) => {
	const abs = Math.abs(n).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
	if (n < 0) return `(${abs})`;
	if (n > 0) return `+${abs}`;
	return abs;
};
---

<Layout title="Gains Summary | almsTins" noindex={true}>
	<div class="max-w-4xl mx-auto px-4 py-8 space-y-8">

		<!-- Header + year picker -->
		<div class="flex items-center justify-between flex-wrap gap-4">
			<div>
				<a href="/dashboard/tax" class="text-xs text-indigo-500 hover:text-indigo-700 font-medium mb-1 inline-block">← Tax Center</a>
				<h1 class="text-2xl font-bold">Gains Summary</h1>
				<p class="text-sm text-gray-500 mt-1">
					Realized gains overview for <strong>{year}</strong>.
					Detailed gain/loss per lot is in the
					<a href="/dashboard/transactions" class="underline text-blue-600 hover:text-blue-800">
						CSV export
					</a>.
				</p>
			</div>

			<div class="flex items-center flex-wrap gap-3">
				<!-- Cost basis method toggle -->
				<div class="flex rounded-lg border border-gray-300 overflow-hidden text-sm font-medium">
					<a
						href={`?year=${year}&method=fifo`}
						class={`px-3 py-1.5 transition-colors ${method === 'fifo' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-50'}`}
						title="First In, First Out — IRS default"
					>FIFO</a>
					<a
						href={`?year=${year}&method=hifo`}
						class={`px-3 py-1.5 border-l border-gray-300 transition-colors ${method === 'hifo' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-50'}`}
						title="Highest In, First Out — minimizes taxable gain"
					>HIFO</a>
					<a
						href={`?year=${year}&method=lifo`}
						class={`px-3 py-1.5 border-l border-gray-300 transition-colors ${method === 'lifo' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-50'}`}
						title="Last In, First Out — preferred in down markets"
					>LIFO</a>
					<a
						href={`/dashboard/tax/lots?year=${year}`}
						class={`px-3 py-1.5 border-l border-gray-300 transition-colors ${method === 'spec_id' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-50'}`}
						title="Specific Identification — manually choose which lot to sell"
					>Spec ID</a>
				</div>

				{(method === 'hifo' || method === 'lifo' || method === 'spec_id') && (
					<span class="text-xs text-indigo-600 font-medium bg-indigo-50 border border-indigo-200 rounded-full px-2 py-0.5">
						{method === 'hifo' ? 'HIFO active — selling highest-cost lots first' :
						 method === 'lifo' ? 'LIFO active — selling most-recently-acquired lots first' :
						 'Spec ID active — using your pinned lot assignments'}
					</span>
				)}

				{availableYears.length > 0 && (
					<form id="gains-year-filter" method="get" class="flex items-center gap-2">
						<input type="hidden" name="method" value={method} />
						<label for="year-select" class="text-sm font-medium text-gray-700">Year</label>
						<select
							id="year-select"
							name="year"
							onchange="this.form.submit()"
							class="border border-gray-300 rounded-md px-3 py-1.5 text-sm shadow-sm
							       focus:outline-none focus:ring-2 focus:ring-indigo-500"
						>
							{availableYears.map((y) => (
								<option value={y} selected={y === year}>{y}</option>
							))}
						</select>
					</form>
				)}
			</div>
		</div>

		<!-- Completeness compact banner -->
		<CompletenessScore year={year} compact={true} />

		<!-- API / data error -->
		{!payload && (
			<div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
				Unable to load tax data for {year}. Try refreshing the page.
			</div>
		)}

		{payload && (
			<>
				<!-- Unpriced transactions warning -->
				{(payload.unpricedOnchain ?? 0) > 0 && (
					<div class="flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4">
						<span class="text-amber-500 text-xl leading-none mt-0.5">⚠</span>
						<div class="text-sm">
							<p class="font-semibold text-amber-800">
								{payload.unpricedOnchain} on-chain
								transaction{payload.unpricedOnchain !== 1 ? 's are' : ' is'} missing
								historical USD prices.
							</p>
							<p class="text-amber-700 mt-1">
								Cost basis and proceeds may be incomplete. Historical pricing runs
								automatically after each sync — check back shortly or trigger a
								re-sync from the
								<a href="/dashboard/wallets" class="underline">wallets page</a>.
							</p>
						</div>
					</div>
				)}

				<!-- ST / LT gain cards -->
				{payload.gains && (
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-gray-100">
							<h2 class="text-sm font-semibold text-gray-700">Realized Capital Gains</h2>
							<p class="text-xs text-gray-400 mt-0.5">FIFO cost basis · Schedule D</p>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-gray-100">

							<!-- Short-term -->
							<div class="p-5 space-y-1">
								<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
									Short-term &nbsp;<span class="normal-case font-normal text-gray-400">(held ≤ 1 yr)</span>
								</p>
								<p class={`text-2xl font-bold ${
									(payload.gains.shortTermGain ?? 0) >= 0 ? 'text-green-700' : 'text-red-600'
								}`}>
									{fmtGain(payload.gains.shortTermGain)}
								</p>
								<p class="text-xs text-gray-500">
									{payload.gains.shortTermCount} lot{payload.gains.shortTermCount !== 1 ? 's' : ''}
									&nbsp;·&nbsp;taxed as ordinary income
								</p>
							</div>

							<!-- Long-term -->
							<div class="p-5 space-y-1">
								<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
									Long-term &nbsp;<span class="normal-case font-normal text-gray-400">(held &gt; 1 yr)</span>
								</p>
								<p class={`text-2xl font-bold ${
									(payload.gains.longTermGain ?? 0) >= 0 ? 'text-green-700' : 'text-red-600'
								}`}>
									{fmtGain(payload.gains.longTermGain)}
								</p>
								<p class="text-xs text-gray-500">
									{payload.gains.longTermCount} lot{payload.gains.longTermCount !== 1 ? 's' : ''}
									&nbsp;·&nbsp;0% / 15% / 20% rate
								</p>
							</div>

							<!-- Net -->
							<div class="p-5 space-y-1">
								<p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
									Net realized
								</p>
								<p class={`text-2xl font-bold ${
									(payload.gains.netGain ?? 0) >= 0 ? 'text-green-700' : 'text-red-600'
								}`}>
									{fmtGain(payload.gains.netGain)}
								</p>
								<p class="text-xs text-gray-500">
									ST + LT combined
								</p>
							</div>

						</div>
					</div>
				)}

				<!-- Capital Loss Carryforward -->
				{(payload.carryforwardAvailable ?? 0) > 0 && (
					<div class="rounded-xl border border-emerald-200 bg-emerald-50 shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-emerald-200 flex items-center justify-between">
							<div>
								<h2 class="text-sm font-semibold text-emerald-900">Capital Loss Carryforward</h2>
								<p class="text-xs text-emerald-700 mt-0.5">Unused losses from prior years that can offset your {year} gains</p>
							</div>
							<div class="text-right">
								<p class="text-xl font-bold text-emerald-800">{fmtGain(-(payload.carryforwardAvailable ?? 0))}</p>
								<p class="text-xs text-emerald-600">available to apply</p>
							</div>
						</div>

						{(payload.carryLedger?.length ?? 0) > 0 && (
							<table class="min-w-full text-sm">
								<thead class="bg-emerald-100">
									<tr>
										<th class="px-5 py-2.5 text-left  text-xs font-medium text-emerald-800 uppercase tracking-wide">Year</th>
										<th class="px-5 py-2.5 text-right text-xs font-medium text-emerald-800 uppercase tracking-wide">Net Gain / Loss</th>
										<th class="px-5 py-2.5 text-right text-xs font-medium text-emerald-800 uppercase tracking-wide">Deducted vs Income</th>
										<th class="px-5 py-2.5 text-right text-xs font-medium text-emerald-800 uppercase tracking-wide">Absorbed by Gain</th>
										<th class="px-5 py-2.5 text-right text-xs font-medium text-emerald-800 uppercase tracking-wide">Ending Balance</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-emerald-100 bg-white">
									{payload.carryLedger!.filter(r => r.netGainLoss < 0 || r.absorbedByGain > 0 || r.deducted > 0).map((row) => (
										<tr class="hover:bg-emerald-50">
											<td class="px-5 py-3 font-semibold text-gray-700">{row.year}</td>
											<td class={`px-5 py-3 text-right font-medium tabular-nums ${row.netGainLoss < 0 ? 'text-red-600' : 'text-green-700'}`}>
												{fmtGain(row.netGainLoss)}
											</td>
											<td class="px-5 py-3 text-right tabular-nums text-gray-600">
												{row.deducted > 0 ? fmtGain(-row.deducted) : <span class="text-gray-300">—</span>}
											</td>
											<td class="px-5 py-3 text-right tabular-nums text-gray-600">
												{row.absorbedByGain > 0 ? fmtGain(-row.absorbedByGain) : <span class="text-gray-300">—</span>}
											</td>
											<td class={`px-5 py-3 text-right font-semibold tabular-nums ${row.endingBalance > 0 ? 'text-emerald-700' : 'text-gray-400'}`}>
												{row.endingBalance > 0 ? fmtGain(-row.endingBalance) : '$0'}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						)}

						<div class="px-5 py-3 border-t border-emerald-200 bg-emerald-50">
							<p class="text-xs text-emerald-700">
								<strong>How to use it:</strong> Apply this carryforward against your {year} net gain before calculating tax.
								Up to $3,000 per year can also offset ordinary income if your net is still negative after applying it.
								Your tax software or CPA will enter this on Schedule D.
							</p>
						</div>
					</div>
				)}

				<!-- No carryforward — small note if there were prior loss years -->
				{(payload.carryforwardAvailable ?? 0) === 0 && (payload.carryLedger?.some(r => r.netGainLoss < 0) ?? false) && (
					<div class="rounded-lg border border-gray-200 bg-gray-50 px-5 py-3 flex items-center gap-3">
						<span class="text-gray-400 text-lg">✓</span>
						<p class="text-xs text-gray-500">
							You had loss years in the past but the full balance has been used up — no carryforward available for {year}.
						</p>
					</div>
				)}

				<!-- Per-asset breakdown -->
				{(payload.byAssetGains?.length ?? 0) > 0 && (
					<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-gray-100 flex items-center justify-between">
							<h2 class="text-sm font-semibold text-gray-700">Gain / Loss by Asset</h2>
							<span class="text-xs text-gray-400">FIFO · sorted by impact</span>
						</div>
						<table class="min-w-full text-sm">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-5 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Asset</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">ST Gain / Loss</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">ST Lots</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">LT Gain / Loss</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">LT Lots</th>
									<th class="px-5 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">Net</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100">
								{payload.byAssetGains!.map((row) => (
									<tr class="hover:bg-gray-50">
										<td class="px-5 py-3 font-mono font-semibold text-gray-800">{row.asset}</td>
										<td class={`px-5 py-3 text-right font-medium tabular-nums ${row.stGain < 0 ? 'text-red-600' : row.stGain > 0 ? 'text-green-700' : 'text-gray-400'}`}>
											{row.stLots > 0 ? fmtGain(row.stGain) : <span class="text-gray-300">—</span>}
										</td>
										<td class="px-5 py-3 text-right text-gray-500 tabular-nums">
											{row.stLots > 0 ? row.stLots : <span class="text-gray-300">—</span>}
										</td>
										<td class={`px-5 py-3 text-right font-medium tabular-nums ${row.ltGain < 0 ? 'text-red-600' : row.ltGain > 0 ? 'text-green-700' : 'text-gray-400'}`}>
											{row.ltLots > 0 ? fmtGain(row.ltGain) : <span class="text-gray-300">—</span>}
										</td>
										<td class="px-5 py-3 text-right text-gray-500 tabular-nums">
											{row.ltLots > 0 ? row.ltLots : <span class="text-gray-300">—</span>}
										</td>
										<td class={`px-5 py-3 text-right font-semibold tabular-nums ${row.netGain < 0 ? 'text-red-600' : row.netGain > 0 ? 'text-green-700' : 'text-gray-400'}`}>
											{fmtGain(row.netGain)}
										</td>
									</tr>
								))}
								<!-- Totals row -->
								<tr class="bg-gray-50 font-semibold border-t-2 border-gray-200">
									<td class="px-5 py-3 text-gray-700">Total</td>
									<td class={`px-5 py-3 text-right tabular-nums ${(payload.gains?.shortTermGain ?? 0) < 0 ? 'text-red-600' : 'text-green-700'}`}>
										{fmtGain(payload.gains?.shortTermGain ?? 0)}
									</td>
									<td class="px-5 py-3 text-right text-gray-500">{payload.gains?.shortTermCount}</td>
									<td class={`px-5 py-3 text-right tabular-nums ${(payload.gains?.longTermGain ?? 0) < 0 ? 'text-red-600' : 'text-green-700'}`}>
										{fmtGain(payload.gains?.longTermGain ?? 0)}
									</td>
									<td class="px-5 py-3 text-right text-gray-500">{payload.gains?.longTermCount}</td>
									<td class={`px-5 py-3 text-right tabular-nums ${(payload.gains?.netGain ?? 0) < 0 ? 'text-red-600' : 'text-green-700'}`}>
										{fmtGain(payload.gains?.netGain ?? 0)}
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				)}

				<!-- Tax-loss harvesting -->
				{(payload.harvestLosses?.length ?? 0) > 0 && (
					<div class="rounded-xl border border-amber-200 bg-amber-50 shadow-sm overflow-hidden">
						<div class="px-5 py-3 border-b border-amber-200 flex items-center justify-between">
							<div>
								<h2 class="text-sm font-semibold text-amber-900">Tax-Loss Harvesting Opportunities</h2>
								<p class="text-xs text-amber-700 mt-0.5">Open lots currently below cost basis · selling locks in a deductible loss</p>
							</div>
							<span class="text-xs text-amber-600 font-medium">{payload.harvestLosses!.length} asset{payload.harvestLosses!.length !== 1 ? 's' : ''} underwater</span>
						</div>
						<table class="min-w-full text-sm">
							<thead class="bg-amber-100">
								<tr>
									<th class="px-5 py-2.5 text-left   text-xs font-medium text-amber-800 uppercase tracking-wide">Asset</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Qty Held</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Cost Basis</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Current Value</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Unrealized Loss</th>
									<th class="px-5 py-2.5 text-center text-xs font-medium text-amber-800 uppercase tracking-wide">Term</th>
									<th class="px-5 py-2.5 text-right  text-xs font-medium text-amber-800 uppercase tracking-wide">Days to LT</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-amber-100 bg-white">
								{payload.harvestLosses!.map((row) => {
									const termLabel = row.longTermQty > 0 && row.shortTermQty > 0
										? 'Mixed'
										: row.longTermQty > 0 ? 'Long' : 'Short';
									const termColor = termLabel === 'Long'
										? 'text-green-700 bg-green-50'
										: termLabel === 'Short'
											? 'text-amber-700 bg-amber-50'
											: 'text-purple-700 bg-purple-50';
									return (
										<tr class="hover:bg-amber-50">
											<td class="px-5 py-3 font-mono font-semibold text-gray-800">{row.asset}</td>
											<td class="px-5 py-3 text-right text-gray-600 tabular-nums">
												{row.totalQty.toLocaleString('en-US', { maximumFractionDigits: 6 })}
											</td>
											<td class="px-5 py-3 text-right text-gray-700 tabular-nums">{fmt(row.totalCost)}</td>
											<td class="px-5 py-3 text-right text-gray-700 tabular-nums">
												{row.currentValue !== null ? fmt(row.currentValue) : <span class="text-gray-300">—</span>}
											</td>
											<td class="px-5 py-3 text-right font-semibold text-red-600 tabular-nums">
												{row.unrealizedGainLoss !== null ? fmtGain(row.unrealizedGainLoss) : <span class="text-gray-300">—</span>}
											</td>
											<td class="px-5 py-3 text-center">
												<span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${termColor}`}>
													{termLabel}
												</span>
											</td>
