---
/**
 * /dashboard/tax/schedule-d
 *
 * Schedule D Summary — Capital Gains and Losses.
 * Summarises Form 8949 box totals into the Schedule D line-by-line format.
 *
 * Schedule D line mapping for crypto:
 *   Part I  Short-Term
 *     Line 1a → Box A totals (covered, no adjustments)
 *     Line 1b → Box B totals (uncovered)
 *     Line 2  → Box C totals  ← most crypto lands here pre-2025
 *     Line 6  → Capital loss carryover (ST portion)
 *     Line 7  → Net ST gain or (loss)
 *   Part II Long-Term
 *     Line 8a → Box D totals (covered, no adjustments)
 *     Line 8b → Box E totals (uncovered)
 *     Line 9  → Box F totals  ← most crypto lands here pre-2025
 *     Line 14 → Capital loss carryover (LT portion) — always $0 for crypto (all CL carryover is ST)
 *     Line 15 → Net LT gain or (loss)
 *   Part III Summary
 *     Line 16 → Combine lines 7 + 15
 *     Line 21 → Total capital loss carryover (from prior years, capped at $3,000 deduction)
 */
import Layout from '../../../layouts/Layout.astro';
import { requireTenantSession } from '@/lib/requireTenantSession';
import { hasTaxAccess } from '@/lib/taxAuth';


if (!hasTaxAccess(Astro.request)) return Astro.redirect('/tax-login', 302);
const _authSess = await requireTenantSession(Astro.request);
if (!_authSess) return Astro.redirect('/login');

const currentYear = new Date().getFullYear();
const defaultYear = currentYear - 1;
---

<Layout title="Schedule D | Almstins" noindex={true}>
	<div id="app">

		<!-- Header -->
		<div class="sd-header">
			<div>
				<a href="/dashboard/tax" class="sd-back">← Tax Center</a>
				<h1 class="sd-title">Schedule D Summary</h1>
				<p class="sd-subtitle">Capital Gains and Losses — IRS Schedule D line-by-line.</p>
			</div>
			<div class="sd-controls">
				<select id="year-sel" class="sd-select">
					{Array.from({ length: 8 }, (_, i) => currentYear - 1 - i).map(y => (
						<option value={y} selected={y === defaultYear}>{y}</option>
					))}
				</select>
				<select id="method-sel" class="sd-select">
					<option value="fifo">FIFO</option>
					<option value="hifo">HIFO</option>
					<option value="lifo">LIFO</option>
					<option value="spec_id">Spec ID</option>
				</select>
				<button id="btn-print" class="sd-btn sd-btn--dark hidden">🖨 Print</button>
			</div>
		</div>

		<div id="state-loading" class="sd-loading">
			<div class="sd-spinner"></div>
			<p>Loading Schedule D…</p>
		</div>
		<div id="state-error" class="sd-error hidden"></div>

		<!-- Schedule D Output -->
		<div id="sched-d-output" class="hidden sd-output">

			<!-- Print header (screen-hidden) -->
			<div class="sd-print-header">
				<p style="font-size:0.7rem; color:#6b7280; margin:0 0 2px; text-transform:uppercase; letter-spacing:.06em;">Schedule D Summary (Form 1040) — Prepared by Almstins</p>
				<p style="font-size:1.1rem; font-weight:800; margin:0 0 2px;">Schedule D — Capital Gains and Losses</p>
				<p id="print-year-method" style="font-size:0.8rem; color:#374151; margin:0;"></p>
			</div>

			<!-- Disclaimer -->
			<div class="sd-disclaimer">
				This summary maps your crypto transactions to Schedule D lines. The totals below flow
				from your Form 8949 data. Always verify with your CPA before filing.
			</div>

			<!-- Part I: Short-Term -->
			<section class="sd-section">
				<h2 class="sd-section-title">
					Part I — Short-Term Capital Gains and Losses
					<span class="sd-section-sub">(Assets held 1 year or less)</span>
				</h2>
				<div class="sd-table-card" id="part1-table"></div>
			</section>

			<!-- Part II: Long-Term -->
			<section class="sd-section">
				<h2 class="sd-section-title">
					Part II — Long-Term Capital Gains and Losses
					<span class="sd-section-sub">(Assets held more than 1 year)</span>
				</h2>
				<div class="sd-table-card" id="part2-table"></div>
			</section>

			<!-- Part III: Summary -->
			<section class="sd-section">
				<h2 class="sd-section-title">Part III — Summary</h2>
				<div class="sd-table-card" id="part3-table"></div>
			</section>

			<!-- Next steps panel -->
			<div class="sd-next-steps">
				<p class="sd-next-steps__title">Next steps for your CPA</p>
				<ul class="sd-next-steps__list">
					<li>Attach Form 8949 (both parts) to this Schedule D — download from the <a href="/dashboard/tax/form8949">Form 8949 page</a></li>
					<li>Enter the Schedule D totals on Form 1040, Line 7 (capital gain/loss)</li>
					<li>If Line 16 is a loss, also complete the Capital Loss Carryover Worksheet</li>
					<li>Ordinary crypto income (staking, interest) goes on Schedule 1, Line 8z — not Schedule D</li>
				</ul>
			</div>

		</div>

	</div>
</Layout>

<style>
