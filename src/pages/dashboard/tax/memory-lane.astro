---
import Layout from '../../../layouts/Layout.astro';
import { isDemoRequest } from '../../../lib/demo';
import { requireTenantSession } from '../../../lib/requireTenantSession';
import { buildAnnualBreakdown } from '../../../lib/annualBreakdown';
import { db } from '../../../lib/db';
import { getTickersUSD } from '../../../lib/coinpaprikaProvider';

const isDemo      = isDemoRequest(Astro.request);
const defaultYear = new Date().getFullYear() - 1;
const yearParam   = Astro.url.searchParams.get('year');
const year        = yearParam ? Number(yearParam) : defaultYear;

// ── Auth ───────────────────────────────────────────────────────────────────────
const session = await requireTenantSession(Astro.request).catch(() => null);
if (!session) return Astro.redirect('/login', 302);
const { tenantId } = session;

let fetchError: string | null = null;
let byAssetGains: any[]                 = [];
let lotDetails:   Record<string, any[]> = {};
let harvestLosses: any[]                = [];
let availableYears: number[]            = [defaultYear];

try {
	// ── Available years ──────────────────────────────────────────────────────
	const yearsRes = await db.execute({
		sql: `SELECT DISTINCT strftime('%Y', timestamp_utc) AS y
		      FROM asset_lifecycle_events
		      WHERE tenant_id = ?
		      ORDER BY y DESC`,
		args: [tenantId],
	});
	availableYears = yearsRes.rows
		.map((r: any) => Number(r.y))
		.filter((y: number) => y >= 2009 && y <= 2100);

	// ── FIFO breakdown ────────────────────────────────────────────────────────
	const bd = await buildAnnualBreakdown(tenantId, year, 'fifo', undefined, 'auto');

	// ── Per-asset gains (step 6) ──────────────────────────────────────────────
	type AssetRow = { asset: string; stGain: number; stLots: number; ltGain: number; ltLots: number; netGain: number };
	const assetMap = new Map<string, AssetRow>();
	const getRow = (asset: string): AssetRow => {
		if (!assetMap.has(asset)) assetMap.set(asset, { asset, stGain: 0, stLots: 0, ltGain: 0, ltLots: 0, netGain: 0 });
		return assetMap.get(asset)!;
	};
	for (const lot of bd.shortTerm) { const r = getRow(lot.asset); r.stGain += lot.gainLossUsd ?? 0; r.stLots++; }
	for (const lot of bd.longTerm)  { const r = getRow(lot.asset); r.ltGain += lot.gainLossUsd ?? 0; r.ltLots++; }
	byAssetGains = Array.from(assetMap.values())
		.map((r) => ({ ...r, netGain: r.stGain + r.ltGain }))
		.sort((a, b) => Math.abs(b.netGain) - Math.abs(a.netGain));

	// ── Per-lot detail (step 6b) ──────────────────────────────────────────────
	for (const lot of bd.shortTerm) (lotDetails[lot.asset] ??= []).push({ ...lot, term: 'short' });
	for (const lot of bd.longTerm)  (lotDetails[lot.asset] ??= []).push({ ...lot, term: 'long'  });
	for (const lots of Object.values(lotDetails)) lots.sort((a: any, b: any) => a.sellDate.localeCompare(b.sellDate));

	// ── Tax-loss harvesting (step 7) ──────────────────────────────────────────
	type HarvestRow = {
		asset: string; totalQty: number; totalCost: number;
		currentPrice: number | null; currentValue: number | null; unrealizedGainLoss: number | null;
		shortTermQty: number; longTermQty: number; soonestLotDaysToLT: number | null;
	};
	const harvestMap = new Map<string, HarvestRow>();
	for (const lot of bd.stillHolding) {
		if (!harvestMap.has(lot.asset)) {
			harvestMap.set(lot.asset, {
				asset: lot.asset, totalQty: 0, totalCost: 0,
				currentPrice: null, currentValue: null, unrealizedGainLoss: null,
				shortTermQty: 0, longTermQty: 0, soonestLotDaysToLT: null,
			});
		}
		const row = harvestMap.get(lot.asset)!;
		row.totalQty  += lot.amount;
		row.totalCost += lot.costUsd ?? 0;
		if (lot.daysHeld >= 365) {
			row.longTermQty += lot.amount;
		} else {
			row.shortTermQty += lot.amount;
			const daysLeft = 365 - lot.daysHeld;
			if (row.soonestLotDaysToLT === null || daysLeft < row.soonestLotDaysToLT) row.soonestLotDaysToLT = daysLeft;
		}
	}
	try {
		const heldAssets = Array.from(harvestMap.keys());
		if (heldAssets.length > 0) {
			const tickers = await getTickersUSD() as Array<{ symbol?: string; quotes?: { USD?: { price?: number } } }>;
			const priceMap = new Map<string, number>();
			for (const t of tickers) {
				const sym = String(t.symbol ?? '').toUpperCase();
				const price = t.quotes?.USD?.price;
				if (sym && typeof price === 'number' && price > 0) priceMap.set(sym, price);
			}
			for (const row of harvestMap.values()) {
				const price = priceMap.get(row.asset) ?? null;
				row.currentPrice = price;
				if (price !== null) { row.currentValue = price * row.totalQty; row.unrealizedGainLoss = row.currentValue - row.totalCost; }
			}
		}
		harvestLosses = Array.from(harvestMap.values())
			// Show ALL open positions — losses first (harvesting candidates), then gains
			.sort((a, b) => {
				const aGl = a.unrealizedGainLoss ?? Infinity;
				const bGl = b.unrealizedGainLoss ?? Infinity;
				return aGl - bGl;
			});
	} catch (e) {
		console.warn('[memory-lane] harvest price fetch failed', e);
	}
} catch (err: any) {
	fetchError = String(err?.message ?? err);
	console.error('[memory-lane] data load failed:', err);
}

// keep `data.ok` truthy when no fetchError so template error box stays hidden
const data = { ok: !fetchError };

// ── Coin classification ────────────────────────────────────────────────────────
type CoinType = 'L1' | 'DeFi' | 'Wrapped' | 'Stable' | 'Other';
function classifyCoin(symbol: string): CoinType {
	const s = symbol.toUpperCase().split('.')[0];
	const L1s     = new Set(['BTC','ETH','SOL','AVAX','SUI','LTC','MATIC','BNB','ADA','DOT','ATOM','NEAR','FTM','ALGO','RSK','RBTC','ONE','HBAR','APT']);
	const wrapped = new Set(['WBTC','WETH','WAVAX','WRBTC','WMATIC','WBNB','WSOL','SAVAX']);
	const stables = new Set(['USDC','USDT','DAI','BUSD','XUSD','DLLR','ZUSD','RUSDT','TUSD','FRAX','LUSD','USDD','GUSD','USDP']);
	const defi    = new Set(['AAVE','UNI','COMP','SOV','MOC','FISH','BPRO','RIF','CRV','MKR','SNX','YFI','SUSHI','PYTH','GMX','GNS','LINK','GRT']);
	if (wrapped.has(s)) return 'Wrapped';
	if (L1s.has(s))     return 'L1';
	if (stables.has(s)) return 'Stable';
	if (defi.has(s))    return 'DeFi';
	return 'Other';
}

// ── Grade from gain % ──────────────────────────────────────────────────────────
function getGrade(gainPct: number | null): { grade: string; cls: string } {
	if (gainPct === null) return { grade: '?',  cls: 'grade-unknown'    };
	if (gainPct >  100)   return { grade: 'A+', cls: 'grade-aplus'      };
	if (gainPct >   50)   return { grade: 'A',  cls: 'grade-a'          };
	if (gainPct >   20)   return { grade: 'B',  cls: 'grade-b'          };
	if (gainPct >    0)   return { grade: 'C+', cls: 'grade-c'          };
	if (gainPct >  -20)   return { grade: 'D',  cls: 'grade-d'          };
	return                       { grade: 'F',  cls: 'grade-f'          };
}

// ── Per-asset lot stats ────────────────────────────────────────────────────────
function getLotStats(asset: string) {
	const lots = lotDetails[asset] ?? [];
	let cost = 0, proceeds = 0, lastSell = '', firstBuy = '';
	for (const lot of lots) {
		cost     += lot.costUsd     ?? 0;
		proceeds += lot.proceedsUsd ?? 0;
		if (!lastSell || lot.sellDate > lastSell) lastSell = lot.sellDate;
		if (!firstBuy  || lot.buyDate  < firstBuy) firstBuy = lot.buyDate;
	}
	const gainPct = cost > 0 ? ((proceeds - cost) / cost) * 100 : null;
	return { cost, proceeds, lastSell, firstBuy, gainPct, lotCount: lots.length };
}

// ── Graduated vs Still Enrolled ────────────────────────────────────────────────
const heldSet     = new Set(harvestLosses.map((h: any) => h.asset));
const graduated   = byAssetGains.filter((a: any) => !heldSet.has(a.asset));
const enrolled    = harvestLosses;
const gainsByAsset = new Map(byAssetGains.map((a: any) => [a.asset, a]));

// ── Group by coin type ─────────────────────────────────────────────────────────
function groupByType<T>(arr: T[], key: (item: T) => string): Record<CoinType, T[]> {
	const out: Record<string, T[]> = { L1: [], DeFi: [], Wrapped: [], Stable: [], Other: [] };
	for (const item of arr) {
		out[classifyCoin(key(item))].push(item);
	}
	return out as Record<CoinType, T[]>;
}
const gradGroups   = groupByType(graduated,    (a: any) => a.asset);
const enrollGroups = groupByType(enrolled,     (h: any) => h.asset);

const TYPE_ORDER: CoinType[] = ['L1', 'DeFi', 'Wrapped', 'Stable', 'Other'];
const TYPE_META: Record<CoinType, { label: string; icon: string }> = {
	L1:      { label: 'Layer 1s',    icon: '⛓️' },
	DeFi:    { label: 'DeFi Tokens', icon: '⚡' },
	Wrapped: { label: 'Wrapped',     icon: '🎁' },
	Stable:  { label: 'Stablecoins', icon: '🏛️' },
	Other:   { label: 'Other',       icon: '🔮' },
};

// ── Totals ─────────────────────────────────────────────────────────────────────
const totalGradGain = graduated.reduce((s: number, a: any) => s + a.netGain, 0);

// ── Formatters ─────────────────────────────────────────────────────────────────
function fmt(n: number) {
	return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
}
function fmtDate(d: string) {
	if (!d) return '—';
	try {
		// If already a full ISO timestamp, parse directly; otherwise treat as YYYY-MM-DD
		const iso = d.length > 10 && d.includes('T') ? d : d.slice(0, 10) + 'T12:00:00Z';
		return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
	}
	catch { return d.slice(0, 10); }
}
function fmtQty(n: number) {
	return n.toLocaleString('en-US', { maximumFractionDigits: 8 });
}
function logoUrl(symbol: string) {
	return `https://cdn.jsdelivr.net/gh/spothq/cryptocurrency-icons@master/svg/color/${symbol.toLowerCase().split('.')[0]}.svg`;
}
function timelineId(asset: string) {
	return `tl-${asset.replace(/[^a-z0-9]/gi, '_')}`;
}
---

<Layout title={`Memory Lane ${year} | almsTins`} noindex={true}>
<div class="ml-page">

	<!-- ── Back link ─────────────────────────────────────────────────────── -->
	<a href="/dashboard/vault" class="ml-back">← Dashboard</a>

	{fetchError && !isDemo && (
		<div class="ml-error">
			<strong>⚠️ Could not load Memory Lane</strong>
			<p>{fetchError}</p>
			<a href={`?year=${year}`}>Try again</a>
		</div>
	)}

	{/* ── Demo preview ─────────────────────────────────────────────────── */}
	{isDemo && (
		<div class="ml-demo-wrap">

			<!-- Explainer banner -->
			<div class="ml-demo-banner">
				<div class="ml-demo-banner__icon">🎓</div>
				<div class="ml-demo-banner__body">
					<p class="ml-demo-banner__title">Your personal crypto yearbook</p>
					<p class="ml-demo-banner__text">
						Memory Lane turns your trading history into a report card — every coin you've ever bought
						gets a letter grade (A+ to F) based on realized returns, grouped into
						<strong>Graduated</strong> (fully exited) and <strong>Still Enrolled</strong> (open positions).
						Expand any coin to see a full buy → sell timeline, holding period, and whether each lot was
						short-term or long-term. Connect your wallet to unlock your own class of {year}.
					</p>
					<a href="/signup" class="ml-demo-banner__cta">Sign up free — see your grades →</a>
				</div>
			</div>

			<!-- Wireframe stats bar -->
			<div class="ml-stats ml-stats--wire">
				<div class="ml-stat">
					<span class="ml-wire-block ml-wire-block--num"></span>
					<span class="ml-stat__label">Graduated</span>
				</div>
				<div class="ml-stat">
					<span class="ml-wire-block ml-wire-block--num ml-wire-block--wide"></span>
					<span class="ml-stat__label">Realized P&L</span>
				</div>
				<div class="ml-stat">
					<span class="ml-wire-block ml-wire-block--num"></span>
					<span class="ml-stat__label">Still Enrolled</span>
				</div>
			</div>

			<!-- Wireframe graduated section -->
			<section class="ml-section">
				<div class="ml-section__header ml-section__header--grad ml-section__header--wire">
					<span class="ml-section__icon">🎓</span>
					<div>
						<h2 class="ml-section__title">Graduated</h2>
						<p class="ml-section__sub">Fully exited — the journey is complete</p>
					</div>
					<span class="ml-wire-block ml-wire-block--pill"></span>
				</div>

				<div class="ml-type-label">
					<span>⛓️</span><span>Layer 1s</span>
				</div>
				<div class="ml-cards">
					{/* Win card */}
					<div class="ml-card ml-card--grad ml-card--win ml-card--wire">
						<div class="ml-card__inner">
							<div class="ml-card__top">
								<div class="ml-logo-wrap">
									<div class="ml-wire-avatar"></div>
								</div>
								<div class="ml-card__nameblock">
									<span class="ml-wire-block ml-wire-block--ticker"></span>
									<span class="ml-wire-block ml-wire-block--date"></span>
								</div>
								<div class="ml-grade grade-aplus ml-grade--wire">A+</div>
							</div>
							<div class="ml-card__pnl">
								<span class="ml-wire-block ml-wire-block--pnl"></span>
								<span class="ml-wire-block ml-wire-block--pct"></span>
							</div>
							<div class="ml-card__meta">
								<span class="ml-wire-block ml-wire-block--meta"></span>
							</div>
							<div class="ml-wire-btn"></div>
						</div>
					</div>

					{/* Loss card */}
					<div class="ml-card ml-card--grad ml-card--loss ml-card--wire">
						<div class="ml-card__inner">
							<div class="ml-card__top">
								<div class="ml-logo-wrap">
									<div class="ml-wire-avatar"></div>
								</div>
								<div class="ml-card__nameblock">
									<span class="ml-wire-block ml-wire-block--ticker"></span>
									<span class="ml-wire-block ml-wire-block--date"></span>
								</div>
								<div class="ml-grade grade-d ml-grade--wire">D</div>
							</div>
							<div class="ml-card__pnl">
								<span class="ml-wire-block ml-wire-block--pnl"></span>
								<span class="ml-wire-block ml-wire-block--pct"></span>
							</div>
							<div class="ml-card__meta">
								<span class="ml-wire-block ml-wire-block--meta"></span>
							</div>
							<div class="ml-wire-btn"></div>
						</div>
					</div>

					{/* Another win card */}
					<div class="ml-card ml-card--grad ml-card--win ml-card--wire">
						<div class="ml-card__inner">
							<div class="ml-card__top">
								<div class="ml-logo-wrap">
									<div class="ml-wire-avatar"></div>
								</div>
								<div class="ml-card__nameblock">
									<span class="ml-wire-block ml-wire-block--ticker"></span>
									<span class="ml-wire-block ml-wire-block--date"></span>
								</div>
								<div class="ml-grade grade-b ml-grade--wire">B</div>
							</div>
							<div class="ml-card__pnl">
								<span class="ml-wire-block ml-wire-block--pnl"></span>
								<span class="ml-wire-block ml-wire-block--pct"></span>
							</div>
							<div class="ml-card__meta">
								<span class="ml-wire-block ml-wire-block--meta"></span>
							</div>
							<div class="ml-wire-btn"></div>
						</div>
					</div>
				</div>
			</section>

			<!-- Wireframe still-enrolled section -->
			<section class="ml-section">
				<div class="ml-section__header ml-section__header--enroll ml-section__header--wire">
					<span class="ml-section__icon">📚</span>
					<div>
						<h2 class="ml-section__title">Still Enrolled</h2>
						<p class="ml-section__sub">Open positions — grade still being calculated</p>
					</div>
					<span class="ml-wire-block ml-wire-block--pill"></span>
				</div>

				<div class="ml-type-label">
					<span>⛓️</span><span>Layer 1s</span>
				</div>
				<div class="ml-cards">
					<div class="ml-card ml-card--enroll ml-card--wire">
						<div class="ml-card__inner">
							<div class="ml-card__top">
								<div class="ml-logo-wrap">
									<div class="ml-wire-avatar"></div>
								</div>
								<div class="ml-card__nameblock">
									<span class="ml-wire-block ml-wire-block--ticker"></span>
									<span class="ml-wire-block ml-wire-block--date"></span>
								</div>
								<div class="ml-grade grade-incomplete ml-grade--wire">IP</div>
							</div>
							<div class="ml-card__pnl">
								<span class="ml-wire-block ml-wire-block--pnl"></span>
								<span class="ml-wire-block ml-wire-block--label"></span>
							</div>
							<div class="ml-card__meta">
								<span class="ml-wire-block ml-wire-block--meta"></span>
							</div>
						</div>
					</div>

					<div class="ml-card ml-card--enroll ml-card--wire">
						<div class="ml-card__inner">
							<div class="ml-card__top">
								<div class="ml-logo-wrap">
									<div class="ml-wire-avatar"></div>
								</div>
								<div class="ml-card__nameblock">
									<span class="ml-wire-block ml-wire-block--ticker"></span>
									<span class="ml-wire-block ml-wire-block--date"></span>
								</div>
								<div class="ml-grade grade-incomplete ml-grade--wire">IP</div>
							</div>
							<div class="ml-card__pnl">
								<span class="ml-wire-block ml-wire-block--pnl"></span>
								<span class="ml-wire-block ml-wire-block--label"></span>
							</div>
							<div class="ml-card__meta">
								<span class="ml-wire-block ml-wire-block--meta"></span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Bottom CTA -->
			<div class="ml-demo-footer">
				<p>Connect your wallet to generate your real {year} report card.</p>
				<a href="/signup" class="ml-demo-footer__cta">Get started free →</a>
			</div>

		</div>
	)}

	<!-- ── Hero ──────────────────────────────────────────────────────────── -->
	<header class="ml-hero">
		<div class="ml-hero__cap">🎓</div>
		<h1 class="ml-hero__title">Memory Lane</h1>
		<p class="ml-hero__sub">Class of {year} — every coin you've bought, held, and sold</p>

		<div class="ml-year-pills">
			{availableYears.map((y) => (
				<a href={`?year=${y}`} class={`ml-year-pill${y === year ? ' active' : ''}`}>{y}</a>
			))}
		</div>
	</header>

	<!-- ── Stats banner ──────────────────────────────────────────────────── -->
	{(graduated.length > 0 || enrolled.length > 0) && (
		<div class="ml-stats">
			<div class="ml-stat">
				<span class="ml-stat__num">{graduated.length}</span>
				<span class="ml-stat__label">Graduated</span>
			</div>
			<div class="ml-stat">
				<span class={`ml-stat__num ${totalGradGain >= 0 ? 'positive' : 'negative'}`}>
					{fmt(totalGradGain)}
				</span>
				<span class="ml-stat__label">Realized P&L</span>
			</div>
			<div class="ml-stat">
				<span class="ml-stat__num enrolled-num">{enrolled.length}</span>
				<span class="ml-stat__label">Still Enrolled</span>
			</div>
		</div>
	)}

	<!-- ══════════════════════════════════════════════════════════════════════
	     GRADUATED SECTION
	══════════════════════════════════════════════════════════════════════ -->
	{!isDemo && graduated.length > 0 && (
		<section class="ml-section">
			<div class="ml-section__header ml-section__header--grad">
				<span class="ml-section__icon">🎓</span>
				<div>
					<h2 class="ml-section__title">Graduated</h2>
					<p class="ml-section__sub">Fully exited — the journey is complete</p>
				</div>
				<span class="ml-section__count">{graduated.length} coin{graduated.length !== 1 ? 's' : ''}</span>
			</div>

			{TYPE_ORDER.map((type) => {
				const group = gradGroups[type];
				if (!group?.length) return null;
				const meta = TYPE_META[type];
				return (
					<div class="ml-type-group">
						<div class="ml-type-label">
							<span>{meta.icon}</span>
							<span>{meta.label}</span>
						</div>
						<div class="ml-cards">
							{group.map((asset: any) => {
								const stats  = getLotStats(asset.asset);
								const grade  = getGrade(stats.gainPct);
								const lots   = lotDetails[asset.asset] ?? [];
								const isWin  = asset.netGain >= 0;
								return (
									<div class={`ml-card ml-card--grad${isWin ? ' ml-card--win' : ' ml-card--loss'}`}
									     data-asset={asset.asset}>
										<div class="ml-card__inner">

											<!-- Coin identity -->
											<div class="ml-card__top">
												<div class="ml-logo-wrap">
													<img class="ml-coin-logo"
													     src={logoUrl(asset.asset)}
													     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
													     alt={asset.asset} />
													<div class="ml-coin-fallback" style="display:none">{asset.asset.slice(0, 3)}</div>
												</div>
												<div class="ml-card__nameblock">
													<span class="ml-coin-ticker">{asset.asset}</span>
													<span class="ml-grad-date">🎓 {fmtDate(stats.lastSell)}</span>
												</div>
												<div class={`ml-grade ${grade.cls}`} title={`Final grade: ${grade.grade}`}>
													{grade.grade}
												</div>
											</div>

											<!-- P&L -->
											<div class="ml-card__pnl">
												<span class={`ml-pnl-num ${isWin ? 'positive' : 'negative'}`}>
													{isWin ? '+' : ''}{fmt(asset.netGain)}
												</span>
												{stats.gainPct !== null && (
													<span class={`ml-pnl-pct ${isWin ? 'positive' : 'negative'}`}>
														{isWin ? '+' : ''}{stats.gainPct.toFixed(1)}%
													</span>
												)}
											</div>

											<!-- Meta -->
											<div class="ml-card__meta">
												{lots.length > 0 && <span>{lots.length} lot{lots.length !== 1 ? 's' : ''}</span>}
												{lots.length > 0 && (asset.stLots > 0 || asset.ltLots > 0) && <span>·</span>}
												{asset.stLots > 0 && <span class="st-tag">{asset.stLots} short-term</span>}
												{asset.stLots > 0 && asset.ltLots > 0 && <span>·</span>}
												{asset.ltLots > 0 && <span class="lt-tag">{asset.ltLots} long-term</span>}
											</div>

											{/* Transcript toggle */}
											{lots.length > 0 && (
												<button class="ml-transcript-btn" data-asset={asset.asset}>
													View Transcript <span class="ml-chevron">▾</span>
												</button>
											)}
										</div>

										{/* Expanded timeline */}
										{lots.length > 0 && (
											<div class="ml-timeline" id={timelineId(asset.asset)} hidden>
												<div class="ml-timeline__header">
													{asset.asset} · Full Trading History · {lots.length} disposal{lots.length !== 1 ? 's' : ''}
												</div>
												<div class="ml-timeline__track">
													{lots.map((lot: any) => {
														const gain = lot.gainLossUsd ?? 0;
														const isLotWin = gain >= 0;
														return (
															<div class="ml-tl-pair">
																<!-- BUY node -->
																<div class="ml-tl-node">
																	<div class="ml-tl-dot ml-tl-dot--buy"></div>
																	<div class="ml-tl-content">
																		<span class="ml-tl-action buy">BUY</span>
																		<span class="ml-tl-date">{fmtDate(lot.buyDate)}</span>
																		<span class="ml-tl-qty">{fmtQty(lot.amount)} {asset.asset}</span>
																		<span class="ml-tl-usd">{lot.costUsd != null ? fmt(lot.costUsd) : '—'}</span>
																	</div>
																</div>
																<!-- Connector -->
																<div class="ml-tl-connector">
																	<div class="ml-tl-line"></div>
																	<span class="ml-tl-held">
																		{lot.daysHeld}d held ·
																		<span class={lot.term === 'long' ? 'lt-badge' : 'st-badge'}>
																			{lot.term === 'long' ? 'Long-term' : 'Short-term'}
																		</span>
																	</span>
																</div>
																<!-- SELL node -->
																<div class="ml-tl-node">
																	<div class={`ml-tl-dot ml-tl-dot--sell ${isLotWin ? 'win' : 'loss'}`}></div>
																	<div class="ml-tl-content">
																		<span class="ml-tl-action sell">SELL</span>
																		<span class="ml-tl-date">{fmtDate(lot.sellDate)}</span>
																		<span class="ml-tl-qty">{fmtQty(lot.amount)} {asset.asset}</span>
																		<span class="ml-tl-usd">{lot.proceedsUsd != null ? fmt(lot.proceedsUsd) : '—'}</span>
																		{lot.gainLossUsd != null && (
																			<span class={`ml-tl-gain ${isLotWin ? 'positive' : 'negative'}`}>
																				{isLotWin ? '+' : ''}{fmt(lot.gainLossUsd)}
																			</span>
																		)}
																	</div>
																</div>
															</div>
														);
													})}
												</div>
											</div>
										)}
									</div>
								);
							})}
						</div>
					</div>
				);
			})}
		</section>
	)}

	<!-- ══════════════════════════════════════════════════════════════════════
	     STILL ENROLLED SECTION
	══════════════════════════════════════════════════════════════════════ -->
	{!isDemo && enrolled.length > 0 && (
		<section class="ml-section">
			<div class="ml-section__header ml-section__header--enroll">
				<span class="ml-section__icon">📚</span>
				<div>
					<h2 class="ml-section__title">Still Enrolled</h2>
					<p class="ml-section__sub">Open positions — grade still being calculated</p>
				</div>
				<span class="ml-section__count">{enrolled.length} coin{enrolled.length !== 1 ? 's' : ''}</span>
			</div>

			{TYPE_ORDER.map((type) => {
				const group = enrollGroups[type];
				if (!group?.length) return null;
				const meta = TYPE_META[type];
				return (
					<div class="ml-type-group">
						<div class="ml-type-label">
							<span>{meta.icon}</span>
							<span>{meta.label}</span>
						</div>
						<div class="ml-cards">
							{group.map((h: any) => {
								const soldGains = gainsByAsset.get(h.asset);
								const lots      = lotDetails[h.asset] ?? [];
								const isUp      = (h.unrealizedGainLoss ?? 0) >= 0;
								return (
									<div class="ml-card ml-card--enroll" data-asset={h.asset}>
										<div class="ml-card__inner">

											<div class="ml-card__top">
												<div class="ml-logo-wrap">
													<img class="ml-coin-logo"
													     src={logoUrl(h.asset)}
													     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
													     alt={h.asset} />
													<div class="ml-coin-fallback" style="display:none">{h.asset.slice(0, 3)}</div>
												</div>
												<div class="ml-card__nameblock">
													<span class="ml-coin-ticker">{h.asset}</span>
													<span class="ml-enroll-status">📚 In progress</span>
												</div>
												<div class="ml-grade grade-incomplete" title="Grade in progress">IP</div>
											</div>

											<div class="ml-card__pnl">
												{h.unrealizedGainLoss != null ? (
													<span class={`ml-pnl-num ${isUp ? 'positive' : 'negative'}`}>
														{isUp ? '+' : ''}{fmt(h.unrealizedGainLoss)}
													</span>
												) : (
													<span class="ml-pnl-num neutral">Unpriced</span>
												)}
												<span class="ml-pnl-label">unrealized</span>
											</div>

											<div class="ml-card__meta">
												<span>{fmtQty(h.totalQty)} held</span>
												{h.currentPrice != null && (
													<>
														<span>·</span>
														<span>${h.currentPrice.toLocaleString('en-US', { maximumFractionDigits: 2 })} / coin</span>
													</>
												)}
											</div>

											{soldGains && (
												<div class="ml-card__sold-note">
													Also sold {soldGains.stLots + soldGains.ltLots} lot(s) this year &middot; {fmt(soldGains.netGain)} realized
												</div>
											)}

											{lots.length > 0 && (
												<button class="ml-transcript-btn ml-transcript-btn--enroll" data-asset={h.asset}>
													View Sold Lots <span class="ml-chevron">▾</span>
												</button>
											)}
										</div>

										{lots.length > 0 && (
											<div class="ml-timeline ml-timeline--enroll" id={timelineId(h.asset)} hidden>
												<div class="ml-timeline__header">
													{h.asset} · Sold Lots This Year · {lots.length} disposal{lots.length !== 1 ? 's' : ''}
												</div>
												<div class="ml-timeline__track">
													{lots.map((lot: any) => {
														const gain = lot.gainLossUsd ?? 0;
														const isLotWin = gain >= 0;
														return (
															<div class="ml-tl-pair">
																<div class="ml-tl-node">
																	<div class="ml-tl-dot ml-tl-dot--buy"></div>
																	<div class="ml-tl-content">
																		<span class="ml-tl-action buy">BUY</span>
																		<span class="ml-tl-date">{fmtDate(lot.buyDate)}</span>
																		<span class="ml-tl-qty">{fmtQty(lot.amount)} {h.asset}</span>
																		<span class="ml-tl-usd">{lot.costUsd != null ? fmt(lot.costUsd) : '—'}</span>
																	</div>
																</div>
																<div class="ml-tl-connector">
																	<div class="ml-tl-line"></div>
																	<span class="ml-tl-held">
																		{lot.daysHeld}d ·
																		<span class={lot.term === 'long' ? 'lt-badge' : 'st-badge'}>
																			{lot.term === 'long' ? 'Long-term' : 'Short-term'}
																		</span>
																	</span>
																</div>
																<div class="ml-tl-node">
																	<div class={`ml-tl-dot ml-tl-dot--sell ${isLotWin ? 'win' : 'loss'}`}></div>
																	<div class="ml-tl-content">
																		<span class="ml-tl-action sell">SELL</span>
																		<span class="ml-tl-date">{fmtDate(lot.sellDate)}</span>
																		<span class="ml-tl-qty">{fmtQty(lot.amount)} {h.asset}</span>
																		<span class="ml-tl-usd">{lot.proceedsUsd != null ? fmt(lot.proceedsUsd) : '—'}</span>
																		{lot.gainLossUsd != null && (
																			<span class={`ml-tl-gain ${isLotWin ? 'positive' : 'negative'}`}>
																				{isLotWin ? '+' : ''}{fmt(lot.gainLossUsd)}
																			</span>
																		)}
																	</div>
																</div>
															</div>
														);
													})}
												</div>
											</div>
										)}
									</div>
								);
							})}
						</div>
					</div>
				);
			})}
		</section>
	)}

	<!-- ── Empty state ────────────────────────────────────────────────────── -->
	{!isDemo && graduated.length === 0 && enrolled.length === 0 && (
		<div class="ml-empty">
			<div class="ml-empty__icon">📭</div>
			<p class="ml-empty__title">No activity found for {year}</p>
			<p class="ml-empty__sub">Select a different year above, or make sure your transactions are synced.</p>
		</div>
	)}

</div>
</Layout>

<style>
/* ── Page shell ───────────────────────────────────────────────────────── */
.ml-page {
	max-width: 1040px;
	margin: 0 auto;
	padding: 1.5rem 1.25rem 6rem;
	color: var(--text-primary);
}

.ml-back {
	display: inline-block;
	font-size: 0.78rem;
	color: var(--text-muted);
	text-decoration: none;
	margin-bottom: 1.5rem;
	transition: color 0.15s;
}
.ml-back:hover { color: var(--text-secondary); }

/* ── Hero ─────────────────────────────────────────────────────────────── */
.ml-hero {
	text-align: center;
	padding: 2rem 0 2.5rem;
}
.ml-hero__cap {
	font-size: 4.5rem;
	display: inline-block;
	animation: float 3.5s ease-in-out infinite;
	margin-bottom: 0.4rem;
}
@keyframes float {
	0%, 100% { transform: translateY(0) rotate(-2deg); }
	50%       { transform: translateY(-12px) rotate(2deg); }
}
/* amber — "Graduated" brand color, no token equivalent */
.ml-hero__title {
	font-size: clamp(2.75rem, 7vw, 4.5rem);
	font-weight: 900;
	letter-spacing: -0.04em;
	line-height: 1;
	margin: 0 0 0.6rem;
	background: linear-gradient(135deg, #f59e0b 0%, #fcd34d 45%, #f59e0b 100%);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
	background-clip: text;
}
.ml-hero__sub {
	font-size: 1rem;
	color: var(--text-muted);
	margin: 0 0 1.75rem;
}

/* Year pills */
.ml-year-pills {
	display: flex;
	justify-content: center;
	flex-wrap: wrap;
	gap: 0.5rem;
}
.ml-year-pill {
	padding: 0.35rem 1.1rem;
	border-radius: 999px;
	border: 1px solid var(--border-bright);
	background: var(--surface-card);
	color: var(--text-muted);
	font-size: 0.82rem;
	font-weight: 600;
	text-decoration: none;
	transition: all 0.15s;
}
/* amber — active/hover year pill matches Graduated theme */
.ml-year-pill:hover { border-color: rgba(245,158,11,0.4); color: #fbbf24; }
.ml-year-pill.active {
	background: rgba(245,158,11,0.12);
	border-color: rgba(245,158,11,0.45);
	color: #fbbf24;
}

/* ── Stats banner ─────────────────────────────────────────────────────── */
.ml-stats {
	display: flex;
	justify-content: center;
	gap: 3rem;
	flex-wrap: wrap;
	padding: 1.75rem 2rem;
	background: var(--surface-card);
	border: 1px solid var(--border-subtle);
	border-radius: 20px;
	margin-bottom: 3.5rem;
}
.ml-stat {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.3rem;
}
.ml-stat__num {
	font-size: 2.25rem;
	font-weight: 900;
	line-height: 1;
	letter-spacing: -0.02em;
	color: var(--text-primary);
}
.ml-stat__num.positive  { color: var(--gain); text-shadow: 0 0 24px var(--gain-border); }
.ml-stat__num.negative  { color: var(--loss); text-shadow: 0 0 24px var(--loss-border); }
/* indigo — "Still Enrolled" concept color, no token equivalent */
.ml-stat__num.enrolled-num { color: #818cf8; }
.ml-stat__label {
	font-size: 0.68rem;
	text-transform: uppercase;
	letter-spacing: 0.12em;
	color: var(--text-muted);
	font-weight: 700;
}

/* ── Section ──────────────────────────────────────────────────────────── */
.ml-section { margin-bottom: 4.5rem; }

.ml-section__header {
	display: flex;
	align-items: center;
	gap: 1rem;
	padding: 1.25rem 1.5rem;
	border-radius: 18px;
	margin-bottom: 2rem;
}
/* amber — Graduated section identity */
.ml-section__header--grad {
	background: linear-gradient(135deg, rgba(245,158,11,0.1), rgba(251,191,36,0.04));
	border: 1px solid rgba(245,158,11,0.22);
}
/* indigo — Still Enrolled section identity */
.ml-section__header--enroll {
	background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(139,92,246,0.04));
	border: 1px solid rgba(99,102,241,0.22);
}
.ml-section__icon { font-size: 2.25rem; flex-shrink: 0; }
.ml-section__title {
	font-size: 1.6rem;
	font-weight: 900;
	margin: 0 0 0.15rem;
	letter-spacing: -0.02em;
}
.ml-section__sub { font-size: 0.82rem; color: var(--text-muted); margin: 0; }
.ml-section__count {
	margin-left: auto;
	font-size: 0.82rem;
	font-weight: 700;
	color: var(--text-muted);
	white-space: nowrap;
	flex-shrink: 0;
}

/* ── Type group ───────────────────────────────────────────────────────── */
.ml-type-group { margin-bottom: 2.25rem; }
.ml-type-label {
	display: flex;
	align-items: center;
	gap: 0.45rem;
	font-size: 0.68rem;
	font-weight: 800;
	text-transform: uppercase;
	letter-spacing: 0.14em;
	color: var(--text-muted);
	margin-bottom: 0.9rem;
	padding-left: 0.1rem;
}

/* ── Cards grid ───────────────────────────────────────────────────────── */
.ml-cards {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
	gap: 1.1rem;
}

/* ── Card ─────────────────────────────────────────────────────────────── */
.ml-card {
	border-radius: 22px;
	overflow: hidden;
	cursor: pointer;
	animation: cardIn 0.45s ease both;
	transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.ml-card:hover {
	transform: translateY(-6px);
	box-shadow: 0 20px 50px var(--surface-bg);
}
@keyframes cardIn {
	from { opacity: 0; transform: translateY(24px); }
	to   { opacity: 1; transform: translateY(0); }
}

/* amber — default graduated card (loss) */
.ml-card--grad {
	border: 2px solid rgba(245,158,11,0.25);
	background: linear-gradient(160deg,
		rgba(245,158,11,0.07) 0%,
		var(--surface-card)  55%);
}
.ml-card--grad.ml-card--win {
	border-color: var(--gain-border);
	background: linear-gradient(160deg,
		var(--gain-bg) 0%,
		var(--surface-card) 55%);
}
.ml-card--grad.ml-card--loss {
	border-color: var(--loss-border);
	background: linear-gradient(160deg,
		var(--loss-bg) 0%,
		var(--surface-card) 55%);
}

/* indigo — Still Enrolled card */
.ml-card--enroll {
	border: 2px solid rgba(99,102,241,0.22);
	background: linear-gradient(160deg,
		rgba(99,102,241,0.07) 0%,
		var(--surface-card) 55%);
}

.ml-card__inner {
	padding: 1.4rem 1.4rem 1.2rem;
	display: flex;
	flex-direction: column;
	gap: 0.9rem;
}

/* ── Card top row ─────────────────────────────────────────────────────── */
.ml-card__top {
	display: flex;
	align-items: center;
	gap: 0.9rem;
}
.ml-logo-wrap {
	flex-shrink: 0;
	width: 48px;
	height: 48px;
	position: relative;
}
.ml-coin-logo {
	width: 48px;
	height: 48px;
	border-radius: 50%;
	object-fit: contain;
	background: var(--border-subtle);
	padding: 5px;
	border: 1px solid var(--border-subtle);
}
/* indigo — fallback avatar gradient when coin logo is missing */
.ml-coin-fallback {
	width: 48px;
	height: 48px;
	border-radius: 50%;
	align-items: center;
	justify-content: center;
	font-size: 0.7rem;
	font-weight: 900;
	background: linear-gradient(135deg, #5767ff, #934dff);
	color: var(--text-primary);
	letter-spacing: -0.02em;
	border: 1px solid var(--border-bright);
}
.ml-card__nameblock {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 0.25rem;
}
.ml-coin-ticker {
	font-size: 1.5rem;
	font-weight: 900;
	color: var(--text-primary);
	letter-spacing: -0.03em;
	line-height: 1;
}
/* amber — graduation date label */
.ml-grad-date    { font-size: 0.72rem; color: #d97706; font-weight: 600; }
/* indigo — enrollment status label */
.ml-enroll-status { font-size: 0.72rem; color: #818cf8; font-weight: 600; }

/* ── Grade badge ──────────────────────────────────────────────────────── */
.ml-grade {
	width: 46px;
	height: 46px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 0.95rem;
	font-weight: 900;
	font-style: italic;
	flex-shrink: 0;
	border: 2.5px solid currentColor;
	transform: rotate(-8deg);
	animation: stampIn 0.5s 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}
@keyframes stampIn {
	from { opacity: 0; transform: rotate(-15deg) scale(0.5); }
	to   { opacity: 1; transform: rotate(-8deg)  scale(1);   }
}
/* grade palette — 5-level scale requires distinct hues; F and unknown map to tokens */
.grade-aplus   { color: #22c55e; background: rgba(34,197,94,0.12);   box-shadow: 0 0 14px rgba(34,197,94,0.3);   }
.grade-a       { color: #4ade80; background: rgba(74,222,128,0.1);   box-shadow: 0 0 12px rgba(74,222,128,0.25); }
.grade-b       { color: #86efac; background: rgba(134,239,172,0.08); }
.grade-c       { color: #fbbf24; background: rgba(251,191,36,0.1);   }
.grade-d       { color: #f97316; background: rgba(249,115,22,0.1);   }
.grade-f       { color: var(--loss); background: var(--loss-bg);   box-shadow: 0 0 12px var(--loss-border); }
.grade-unknown { color: var(--text-muted); background: var(--surface-card); }
/* indigo — in-progress grade for open positions */
.grade-incomplete {
	color: #818cf8;
	background: rgba(129,140,248,0.1);
	font-style: normal;
	font-size: 0.6rem;
	letter-spacing: 0.05em;
}

/* ── P&L ──────────────────────────────────────────────────────────────── */
.ml-card__pnl {
	display: flex;
	align-items: baseline;
	gap: 0.65rem;
	flex-wrap: wrap;
}
.ml-pnl-num {
	font-size: 1.9rem;
	font-weight: 900;
	letter-spacing: -0.03em;
	line-height: 1;
}
.ml-pnl-num.positive { color: var(--gain); text-shadow: 0 0 22px var(--gain-border); }
.ml-pnl-num.negative { color: var(--loss); text-shadow: 0 0 22px var(--loss-border); }
.ml-pnl-num.neutral  { color: var(--text-muted); }
.ml-pnl-pct {
	font-size: 0.95rem;
	font-weight: 700;
}
.ml-pnl-pct.positive { color: var(--gain); }
.ml-pnl-pct.negative { color: var(--loss); }
.ml-pnl-label { font-size: 0.72rem; color: var(--text-muted); font-style: italic; }

/* ── Meta / tags ──────────────────────────────────────────────────────── */
.ml-card__meta {
	display: flex;
	align-items: center;
	gap: 0.4rem;
	font-size: 0.75rem;
	color: var(--text-muted);
	flex-wrap: wrap;
}
/* amber / indigo — ST/LT lot tags match year-pill and enrolled palette */
.st-tag { color: #fbbf24; font-weight: 700; }
.lt-tag { color: #818cf8; font-weight: 700; }

/* indigo — sold-note for enrolled cards with partial exits */
.ml-card__sold-note {
	font-size: 0.72rem;
	color: #6366f1;
	background: rgba(99,102,241,0.08);
	border: 1px solid rgba(99,102,241,0.15);
	border-radius: 8px;
	padding: 0.45rem 0.7rem;
}

/* ── Transcript button ────────────────────────────────────────────────── */
.ml-transcript-btn {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.4rem;
	padding: 0.6rem 1rem;
	border-radius: 12px;
	border: 1px solid var(--border-subtle);
	background: var(--surface-card);
	color: var(--text-muted);
	font-size: 0.8rem;
	font-weight: 700;
	cursor: pointer;
	width: 100%;
	font-family: inherit;
	letter-spacing: 0.02em;
	transition: all 0.15s;
	margin-top: 0.1rem;
}
/* amber — graduated transcript hover */
.ml-transcript-btn:hover {
	border-color: rgba(245,158,11,0.35);
	color: #fbbf24;
	background: rgba(245,158,11,0.05);
}
/* indigo — enrolled transcript hover */
.ml-transcript-btn--enroll:hover {
	border-color: rgba(99,102,241,0.35);
	color: #818cf8;
