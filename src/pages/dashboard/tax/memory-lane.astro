</style>

<script>
// ── Staggered card entrance ───────────────────────────────────────────────────
document.querySelectorAll<HTMLElement>('.ml-card').forEach((card, i) => {
	card.style.animationDelay = `${i * 0.06}s`;
});

// ── Transcript toggle ─────────────────────────────────────────────────────────
function toggleTimeline(asset: string) {
	const id       = 'tl-' + asset.replace(/[^a-z0-9]/gi, '_');
	const timeline = document.getElementById(id);
	if (!timeline) return;
	const isOpen = !timeline.hidden;
	timeline.hidden = isOpen;
	// Update all buttons for this asset
	document.querySelectorAll<HTMLButtonElement>(`[data-asset="${CSS.escape(asset)}"].ml-transcript-btn`)
		.forEach(btn => btn.classList.toggle('open', !isOpen));
}

// Button clicks
document.querySelectorAll<HTMLButtonElement>('.ml-transcript-btn').forEach(btn => {
	btn.addEventListener('click', (e) => {
		e.stopPropagation();
		toggleTimeline(btn.dataset.asset!);
	});
});

// Card click (anywhere on the card) also toggles
document.querySelectorAll<HTMLElement>('.ml-card').forEach(card => {
	card.addEventListener('click', () => {
		const asset = card.dataset.asset;
		if (asset) toggleTimeline(asset);
	});
});
</script>
