---
import Layout from '../../layouts/Layout.astro';
import NetWorthHero from '../../components/dashboard/NetWorthHero.astro';
import { requireTenantSession } from '@/lib/requireTenantSession';

const session = await requireTenantSession(Astro.request);
if (!session) return Astro.redirect('/login');
---

<Layout title="DirtyTins | Almstins" noindex={true}>
  <section class="dt-page">
    <div class="hero-bleed">
      <NetWorthHero title="DirtyTins" subtitle="Debt, budget & business — the real numbers" />
    </div>

    <!-- Content wrapper adds breathing room without breaking full-width hero -->
    <div class="dt-content">

      <!-- Summary bar -->
      <div class="dt-summary-bar">
        <div class="dt-summary-item">
          <span class="dt-summary-label">Total Debt</span>
          <span class="dt-summary-value loss" id="dt-total-debt">—</span>
        </div>
        <div class="dt-summary-item">
          <span class="dt-summary-label">Monthly Interest</span>
          <span class="dt-summary-value loss" id="dt-monthly-interest">—</span>
        </div>
        <div class="dt-summary-item">
          <span class="dt-summary-label">Est. Annual Interest</span>
          <span class="dt-summary-value loss" id="dt-annual-interest">—</span>
        </div>
        <div class="dt-summary-item">
          <span class="dt-summary-label">Net Cash Flow</span>
          <span class="dt-summary-value" id="dt-net-cashflow">—</span>
        </div>
      </div>

      <!-- Monthly bills check-in panel -->
      <div class="dt-monthly-panel" id="dt-monthly-panel" style="display:none">
        <button class="dt-monthly-header" id="dt-monthly-toggle" aria-expanded="false">
          <span>📋 Monthly Bills Check-In</span>
          <span class="dt-monthly-meta" id="dt-monthly-meta"></span>
          <span class="dt-monthly-chevron" id="dt-monthly-chevron">▸</span>
        </button>
        <div class="dt-monthly-body" id="dt-monthly-body" style="display:none">
          <!-- rows rendered by JS -->
        </div>
      </div>

      <!-- Add Tin buttons -->
      <div class="dt-add-row">
        <button class="dt-add-btn" data-add-type="debt">＋ Debt Tin</button>
        <button class="dt-add-btn" data-add-type="budget">＋ Budget</button>
        <button class="dt-add-btn" data-add-type="business">＋ Business Tin</button>
      </div>

      <!-- Tins grid -->
      <div class="dt-grid" id="dt-grid">
        <div class="dt-empty" id="dt-empty">
          <p>No tins yet. Add a Debt Tin to start tracking what you owe.</p>
        </div>
      </div>

    </div><!-- /dt-content -->
  </section>

  <!-- Add / Edit Tin Modal -->
  <div class="dt-modal-overlay" id="dt-modal" style="display:none" aria-modal="true" role="dialog">
    <div class="dt-modal">
      <h2 id="dt-modal-title">Add Tin</h2>
      <form id="dt-modal-form">
        <input type="hidden" id="dt-modal-id" value="" />
        <input type="hidden" id="dt-modal-type" value="" />

        <label class="dt-label">
          Name
          <input class="dt-input" id="dt-modal-name" type="text" placeholder="e.g. Chase Sapphire, Chase Checking" maxlength="100" required />
        </label>

        <!-- Debt fields -->
        <div class="dt-fields-debt" style="display:none">
          <label class="dt-label">
            Current Balance ($)
            <input class="dt-input" id="dt-debt-balance" type="number" step="0.01" min="0" placeholder="0.00" />
          </label>
          <label class="dt-label">
            Credit Limit ($) <span class="dt-optional">(optional)</span>
            <input class="dt-input" id="dt-debt-limit" type="number" step="0.01" min="0" placeholder="0.00" />
          </label>
          <label class="dt-label">
            APR (%) <span class="dt-optional">e.g. 21.99</span>
            <input class="dt-input" id="dt-debt-apr" type="number" step="0.01" min="0" max="100" placeholder="0.00" />
          </label>
          <label class="dt-label">
            Minimum Payment ($)
            <input class="dt-input" id="dt-debt-min" type="number" step="0.01" min="0" placeholder="0.00" />
          </label>
        </div>

        <!-- Business fields -->
        <div class="dt-fields-business" style="display:none">
          <label class="dt-label">
            Monthly Revenue Goal ($) <span class="dt-optional">(optional)</span>
            <input class="dt-input" id="dt-biz-goal" type="number" step="0.01" min="0" placeholder="0.00" />
          </label>
        </div>

        <div class="dt-modal-actions">
          <button type="submit" class="dt-btn-primary" id="dt-modal-submit">Save</button>
          <button type="button" class="dt-btn-ghost" id="dt-modal-cancel">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Entry Modal -->
  <div class="dt-modal-overlay" id="dt-entry-modal" style="display:none" aria-modal="true" role="dialog">
    <div class="dt-modal">
      <h2 id="dt-entry-modal-title">Add Entry</h2>
      <form id="dt-entry-form">
        <input type="hidden" id="dt-entry-tin-id" value="" />
        <input type="hidden" id="dt-entry-tin-type" value="" />

        <label class="dt-label">
          Date
          <input class="dt-input" id="dt-entry-date" type="date" required />
        </label>

        <label class="dt-label">
          Type
          <select class="dt-input" id="dt-entry-kind">
            <option value="payment">Payment</option>
            <option value="charge">Charge / Purchase</option>
            <option value="income">Income</option>
            <option value="expense">Expense</option>
          </select>
        </label>

        <label class="dt-label">
          Amount ($)
          <input class="dt-input" id="dt-entry-amount" type="number" step="0.01" min="0.01" placeholder="0.00" required />
        </label>

        <label class="dt-label">
          Description <span class="dt-optional">(optional)</span>
          <input class="dt-input" id="dt-entry-desc" type="text" maxlength="200" placeholder="What was this for?" />
        </label>

        <div class="dt-modal-actions">
          <button type="submit" class="dt-btn-primary">Add</button>
          <button type="button" class="dt-btn-ghost" id="dt-entry-cancel">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <style>
    .dt-page {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0 0 3rem;
      width: 100%;
    }

    /* Padded content area — keeps hero-bleed full width but gives everything else room */
    .dt-content {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding: 1.5rem 1.5rem 0;
    }
    @media (min-width: 900px) {
      .dt-content { padding: 2rem 2.5rem 0; }
    }

    /* Monthly check-in panel */
    .dt-monthly-panel {
      background: var(--surface-card);
      border: 1px solid var(--border-bright);
      border-radius: 10px;
      overflow: hidden;
    }
    .dt-monthly-header {
      width: 100%;
      background: none;
      border: none;
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--text-primary);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
    }
    .dt-monthly-header:hover { background: var(--surface-hover); }
    .dt-monthly-meta {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 400;
      flex: 1;
    }
    .dt-monthly-chevron { color: var(--text-muted); font-size: 0.8rem; transition: transform 0.2s; }
    .dt-monthly-chevron.open { transform: rotate(90deg); }
    .dt-monthly-body {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--border-subtle);
    }
    .dt-monthly-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--border-subtle);
    }
    .dt-monthly-row:last-child { border-bottom: none; }
    .dt-monthly-row.logged { opacity: 0.5; pointer-events: none; }
    .dt-monthly-check {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex: 1;
      min-width: 0;
      cursor: pointer;
    }
    .dt-monthly-check input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--accent); flex-shrink: 0; cursor: pointer; }
    .dt-monthly-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dt-monthly-tin-name {
      font-size: 0.7rem;
      color: var(--text-muted);
      white-space: nowrap;
    }
    .dt-monthly-amount-input {
      background: var(--surface-card-2);
      border: 1px solid var(--border-bright);
      border-radius: 6px;
      padding: 0.3rem 0.6rem;
      color: var(--text-primary);
      font-size: 0.85rem;
      width: 100px;
      text-align: right;
      box-sizing: border-box;
    }
    .dt-monthly-amount-input:focus { outline: 2px solid var(--accent-glow); border-color: var(--accent); }
    .dt-monthly-log-btn {
      background: var(--accent-soft);
      border: 1px solid var(--accent-glow);
      color: var(--accent);
      border-radius: 6px;
      padding: 0.3rem 0.7rem;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .dt-monthly-log-btn:hover { background: var(--accent-glow); }
    .dt-monthly-logged-badge {
      font-size: 0.75rem;
      color: var(--gain);
      font-weight: 600;
      flex-shrink: 0;
    }
    .dt-monthly-empty {
      padding: 1rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      text-align: center;
    }

    /* Summary bar */
    .dt-summary-bar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
      background: var(--border-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      overflow: hidden;
    }
    @media (min-width: 640px) {
      .dt-summary-bar { grid-template-columns: repeat(4, 1fr); }
    }
    .dt-summary-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 1rem 1.25rem;
      background: var(--surface-card);
    }
    .dt-summary-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }
    .dt-summary-value {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
    }
    .dt-summary-value.loss { color: var(--loss); }
    .dt-summary-value.gain { color: var(--gain); }

    /* Add buttons */
    .dt-add-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
    }
    .dt-add-btn {
      background: var(--surface-card);
      border: 1px solid var(--border-bright);
      color: var(--text-secondary);
      border-radius: 8px;
      padding: 0.5rem 1.1rem;
      font-size: 0.875rem;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .dt-add-btn:hover {
      background: var(--surface-hover);
      color: var(--accent);
      border-color: var(--accent-glow);
    }

    /* Grid */
    .dt-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    @media (min-width: 720px) {
      .dt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (min-width: 1080px) {
      .dt-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    .dt-empty {
      grid-column: 1 / -1;
      text-align: center;
      color: var(--text-muted);
      padding: 3rem 1rem;
      font-size: 0.95rem;
    }

    /* Tin card */
    .dt-tin {
      background: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .dt-tin__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.875rem 1rem 0.5rem;
      gap: 0.5rem;
    }
    .dt-tin__name {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .dt-tin__badge {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 2px 7px;
      border-radius: 4px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .dt-tin__badge--debt     { background: var(--loss-bg);    color: var(--loss);   border: 1px solid var(--loss-border); }
    .dt-tin__badge--budget   { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-glow); }
    .dt-tin__badge--business { background: var(--gain-bg);    color: var(--gain);   border: 1px solid var(--gain-border); }

    .dt-tin__actions {
      display: flex;
      gap: 0.35rem;
    }
    .dt-tin__icon-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      padding: 4px 6px;
      border-radius: 5px;
      font-size: 0.85rem;
      line-height: 1;
      transition: background 0.12s, color 0.12s;
    }
    .dt-tin__icon-btn:hover { background: var(--surface-hover); color: var(--text-primary); }
    .dt-tin__icon-btn--delete:hover { color: var(--loss); }

    /* Progress bar (debt utilization or business revenue) */
    .dt-tin__progress-wrap {
      padding: 0 1rem 0.5rem;
    }
    .dt-tin__progress-track {
      height: 6px;
      background: var(--surface-card-2);
      border-radius: 3px;
      overflow: hidden;
    }
    .dt-tin__progress-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.4s ease;
    }
    .dt-tin__progress-fill--debt     { background: var(--loss); }
    .dt-tin__progress-fill--business { background: var(--gain); }
    .dt-tin__progress-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* Key numbers */
    .dt-tin__nums {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      padding: 0.5rem 1rem 0.75rem;
    }
    .dt-tin__num-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 0.85rem;
    }
    .dt-tin__num-label { color: var(--text-muted); }
    .dt-tin__num-value { color: var(--text-primary); font-weight: 500; }
    .dt-tin__num-value.loss { color: var(--loss); }
    .dt-tin__num-value.gain { color: var(--gain); }

    /* Accordion / entry list */
    .dt-tin__accordion {
      border-top: 1px solid var(--border-subtle);
    }
    .dt-tin__accordion-toggle {
      width: 100%;
      background: none;
      border: none;
      padding: 0.6rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-secondary);
      font-size: 0.8rem;
      cursor: pointer;
      text-align: left;
    }
    .dt-tin__accordion-toggle:hover { background: var(--surface-hover); }
    .dt-tin__accordion-toggle .chevron { transition: transform 0.2s; }
    .dt-tin__accordion-toggle[aria-expanded="true"] .chevron { transform: rotate(180deg); }

    .dt-tin__entries {
      padding: 0 1rem 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      max-height: 220px;
      overflow-y: auto;
    }
    .dt-tin__entry {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 0.8rem;
      padding: 0.3rem 0;
      border-bottom: 1px solid var(--border-subtle);
      gap: 0.5rem;
    }
    .dt-tin__entry:last-child { border-bottom: none; }
    .dt-tin__entry-left { display: flex; flex-direction: column; gap: 2px; }
    .dt-tin__entry-kind {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
    }
    .dt-tin__entry-desc { color: var(--text-secondary); }
    .dt-tin__entry-date { color: var(--text-muted); font-size: 0.7rem; }
    .dt-tin__entry-amount { font-weight: 600; flex-shrink: 0; }
    .dt-tin__entry-amount.payment  { color: var(--gain); }
    .dt-tin__entry-amount.charge   { color: var(--loss); }
    .dt-tin__entry-amount.income   { color: var(--gain); }
    .dt-tin__entry-amount.expense  { color: var(--loss); }
    .dt-tin__entry-del {
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); font-size: 0.75rem; padding: 0 4px;
      flex-shrink: 0;
    }
    .dt-tin__entry-del:hover { color: var(--loss); }
    .dt-tin__no-entries { font-size: 0.8rem; color: var(--text-muted); padding: 0.25rem 0; }

    /* Add entry button at bottom of tin */
    .dt-tin__footer {
      padding: 0.5rem 1rem 0.875rem;
      display: flex;
      gap: 0.5rem;
    }
    .dt-add-entry-btn {
      background: var(--accent-soft);
      border: 1px solid var(--accent-glow);
      color: var(--accent);
      border-radius: 6px;
      padding: 0.35rem 0.85rem;
      font-size: 0.78rem;
      cursor: pointer;
      transition: background 0.15s;
    }
    .dt-add-entry-btn:hover { background: var(--accent-glow); }

    /* Modal */
    .dt-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .dt-modal {
      background: var(--surface-card-2);
      border: 1px solid var(--border-bright);
      border-radius: 14px;
      padding: 1.5rem;
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .dt-modal h2 {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0;
    }
    .dt-label {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }
    .dt-optional { color: var(--text-muted); font-size: 0.75rem; }
    .dt-input {
      background: var(--surface-card);
      border: 1px solid var(--border-bright);
      border-radius: 7px;
      padding: 0.5rem 0.75rem;
      color: var(--text-primary);
      font-size: 0.9rem;
      width: 100%;
      box-sizing: border-box;
    }
    .dt-input:focus { outline: 2px solid var(--accent-glow); border-color: var(--accent); }
    #dt-modal-form, #dt-entry-form {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }
    .dt-fields-debt, .dt-fields-business {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }
    .dt-modal-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: flex-end;
      margin-top: 0.25rem;
    }
    .dt-btn-primary {
      background: var(--accent);
      color: var(--surface-bg);
      border: none;
      border-radius: 7px;
      padding: 0.5rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
    }
    .dt-btn-primary:hover { opacity: 0.9; }
    .dt-btn-ghost {
      background: none;
      border: 1px solid var(--border-bright);
      color: var(--text-secondary);
      border-radius: 7px;
      padding: 0.5rem 1.1rem;
      font-size: 0.875rem;
      cursor: pointer;
    }
    .dt-btn-ghost:hover { background: var(--surface-hover); }
  </style>

  <script is:inline>
    // ── Utilities ──────────────────────────────────────────────────────────────
    const $ = (sel, ctx = document) => ctx.querySelector(sel);
    const $$ = (sel, ctx = document) => [...ctx.querySelectorAll(sel)];
    const fmt  = n => '$' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtPct = n => (Number(n) * 100).toFixed(2) + '%';

    let _tins = [];

    // ── Load tins from API ─────────────────────────────────────────────────────
    async function loadTins() {
      try {
        const res = await fetch('/api/dirty-tins');
        const data = await res.json();
        _tins = data.tins ?? [];
      } catch { _tins = []; }
      renderAll();
      buildMonthlyCheckin();
    }

    // ── Summaries ──────────────────────────────────────────────────────────────
    function computeSummary() {
      let totalDebt = 0, monthlyInterest = 0, annualInterest = 0;
      let totalIncome = 0, totalExpense = 0;
      const now = new Date();
      const thisMonth = now.toISOString().slice(0, 7); // YYYY-MM

      for (const tin of _tins) {
        if (tin.type === 'debt') {
          const bal = tin.balance ?? 0;
          const apr = tin.apr ?? 0;
          totalDebt += bal;
          monthlyInterest += bal * (apr / 12);
          annualInterest  += bal * apr;
        }
        if (tin.type === 'budget' || tin.type === 'business') {
          for (const e of (tin.entries ?? [])) {
            if (!e.entryDate.startsWith(thisMonth)) continue;
            if (e.kind === 'income')  totalIncome  += e.amount;
            if (e.kind === 'expense') totalExpense += e.amount;
          }
        }
      }
      return { totalDebt, monthlyInterest, annualInterest, netCashflow: totalIncome - totalExpense };
    }

    function renderSummary() {
      const { totalDebt, monthlyInterest, annualInterest, netCashflow } = computeSummary();
      const debtEl = document.getElementById('dt-total-debt');
      const miEl   = document.getElementById('dt-monthly-interest');
      const aiEl   = document.getElementById('dt-annual-interest');
      const cfEl   = document.getElementById('dt-net-cashflow');
      if (debtEl) debtEl.textContent = fmt(totalDebt);
      if (miEl)   miEl.textContent   = fmt(monthlyInterest);
      if (aiEl)   aiEl.textContent   = fmt(annualInterest);
      if (cfEl) {
        cfEl.textContent = fmt(Math.abs(netCashflow));
        cfEl.classList.toggle('gain', netCashflow >= 0);
        cfEl.classList.toggle('loss', netCashflow < 0);
      }
    }

    // ── Render all tins ────────────────────────────────────────────────────────
    function renderAll() {
      renderSummary();
      const grid = document.getElementById('dt-grid');
      const emptyMsg = document.getElementById('dt-empty');
      if (!grid) return;

      // Remove existing tin cards (keep the empty message element)
      $$('.dt-tin', grid).forEach(el => el.remove());

      if (!_tins.length) {
        if (emptyMsg) emptyMsg.style.display = '';
        return;
      }
      if (emptyMsg) emptyMsg.style.display = 'none';

      for (const tin of _tins) {
        grid.insertAdjacentHTML('beforeend', buildTinHTML(tin));
      }

      // Bind accordion toggles
      $$('.dt-tin__accordion-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          const target = document.getElementById(btn.dataset.target);
          if (target) target.style.display = expanded ? 'none' : 'flex';
        });
      });

      // Bind delete entry buttons
      $$('.dt-tin__entry-del').forEach(btn => {
        btn.addEventListener('click', () => deleteEntry(btn.dataset.entryId));
      });
    }

    function buildTinHTML(tin) {
      const badgeClass = `dt-tin__badge--${tin.type}`;
      const badgeLabel = tin.type === 'debt' ? 'Debt' : tin.type === 'budget' ? 'Budget' : 'Business';

      let progressHTML = '';
      if (tin.type === 'debt' && tin.creditLimit) {
        const pct = Math.min(100, ((tin.balance ?? 0) / tin.creditLimit) * 100);
        progressHTML = `
          <div class="dt-tin__progress-wrap">
            <div class="dt-tin__progress-track">
              <div class="dt-tin__progress-fill dt-tin__progress-fill--debt" style="width:${pct.toFixed(1)}%"></div>
            </div>
            <div class="dt-tin__progress-labels">
              <span>${fmt(tin.balance ?? 0)} owed</span>
              <span>${pct.toFixed(0)}% of ${fmt(tin.creditLimit)}</span>
            </div>
          </div>`;
      }
      if (tin.type === 'business' && tin.goalRevenue) {
        const monthRevenue = (tin.entries ?? [])
          .filter(e => e.kind === 'income' && e.entryDate.startsWith(new Date().toISOString().slice(0,7)))
          .reduce((s, e) => s + e.amount, 0);
        const pct = Math.min(100, (monthRevenue / tin.goalRevenue) * 100);
        progressHTML = `
          <div class="dt-tin__progress-wrap">
            <div class="dt-tin__progress-track">
              <div class="dt-tin__progress-fill dt-tin__progress-fill--business" style="width:${pct.toFixed(1)}%"></div>
            </div>
            <div class="dt-tin__progress-labels">
              <span>${fmt(monthRevenue)} this month</span>
              <span>${pct.toFixed(0)}% of ${fmt(tin.goalRevenue)} goal</span>
            </div>
          </div>`;
      }

      let numsHTML = '';
      if (tin.type === 'debt') {
        const monthly = (tin.balance ?? 0) * ((tin.apr ?? 0) / 12);
        numsHTML = `
          <div class="dt-tin__nums">
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Balance</span>
              <span class="dt-tin__num-value loss">${fmt(tin.balance ?? 0)}</span>
            </div>
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">APR</span>
              <span class="dt-tin__num-value">${tin.apr ? fmtPct(tin.apr) : '—'}</span>
            </div>
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Monthly interest</span>
              <span class="dt-tin__num-value loss">${tin.apr ? fmt(monthly) : '—'}</span>
            </div>
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Min payment</span>
              <span class="dt-tin__num-value">${tin.minPayment ? fmt(tin.minPayment) : '—'}</span>
            </div>
          </div>`;
      } else if (tin.type === 'business') {
        const entries = tin.entries ?? [];
        const thisMonth = new Date().toISOString().slice(0,7);
        const revenue = entries.filter(e => e.kind === 'income'  && e.entryDate.startsWith(thisMonth)).reduce((s,e) => s+e.amount,0);
        const costs   = entries.filter(e => e.kind === 'expense' && e.entryDate.startsWith(thisMonth)).reduce((s,e) => s+e.amount,0);
        const profit  = revenue - costs;
        numsHTML = `
          <div class="dt-tin__nums">
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Revenue (this month)</span>
              <span class="dt-tin__num-value gain">${fmt(revenue)}</span>
            </div>
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Expenses (this month)</span>
              <span class="dt-tin__num-value loss">${fmt(costs)}</span>
            </div>
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Net profit</span>
              <span class="dt-tin__num-value ${profit >= 0 ? 'gain' : 'loss'}">${fmt(profit)}</span>
            </div>
          </div>`;
      } else {
        // Budget: show this month income vs expenses
        const entries = tin.entries ?? [];
        const thisMonth = new Date().toISOString().slice(0,7);
        const income  = entries.filter(e => e.kind === 'income'  && e.entryDate.startsWith(thisMonth)).reduce((s,e) => s+e.amount,0);
        const expense = entries.filter(e => e.kind === 'expense' && e.entryDate.startsWith(thisMonth)).reduce((s,e) => s+e.amount,0);
        const net = income - expense;
        numsHTML = `
          <div class="dt-tin__nums">
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Income (this month)</span>
              <span class="dt-tin__num-value gain">${fmt(income)}</span>
            </div>
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Expenses (this month)</span>
              <span class="dt-tin__num-value loss">${fmt(expense)}</span>
            </div>
            <div class="dt-tin__num-row">
              <span class="dt-tin__num-label">Net</span>
              <span class="dt-tin__num-value ${net >= 0 ? 'gain' : 'loss'}">${fmt(net)}</span>
            </div>
          </div>`;
      }

      const entries = tin.entries ?? [];
      const entriesId = `entries-${tin.id}`;
      const entriesLabel = tin.type === 'debt'
        ? 'Payments & charges'
        : tin.type === 'budget' ? 'Income & expenses' : 'Transactions';

      const entryRows = entries.length
        ? entries.slice(0, 30).map(e => {
            const sign = (e.kind === 'payment' || e.kind === 'income') ? '−' : '+';
            return `<div class="dt-tin__entry">
              <div class="dt-tin__entry-left">
                <span class="dt-tin__entry-kind">${e.kind}</span>
                <span class="dt-tin__entry-desc">${e.description ?? '—'}</span>
                <span class="dt-tin__entry-date">${e.entryDate}</span>
              </div>
              <span class="dt-tin__entry-amount ${e.kind}">${sign}${fmt(e.amount)}</span>
              <button class="dt-tin__entry-del" data-entry-id="${e.id}" title="Remove">✕</button>
            </div>`;
          }).join('')
        : '<p class="dt-tin__no-entries">No entries yet.</p>';

      const addEntryKind = tin.type === 'debt' ? 'payment' : 'income';

      return `
        <div class="dt-tin" data-tin-id="${tin.id}" data-tin-type="${tin.type}">
          <div class="dt-tin__header">
            <span class="dt-tin__name">${escHtml(tin.name)}</span>
            <span class="dt-tin__badge ${badgeClass}">${badgeLabel}</span>
            <div class="dt-tin__actions">
              <button class="dt-tin__icon-btn" title="Edit" onclick="openEditTin('${tin.id}')">✏️</button>
              <button class="dt-tin__icon-btn dt-tin__icon-btn--delete" title="Delete" onclick="deleteTin('${tin.id}')">🗑</button>
            </div>
          </div>
          ${progressHTML}
          ${numsHTML}
          <div class="dt-tin__accordion">
            <button class="dt-tin__accordion-toggle" aria-expanded="false" data-target="${entriesId}">
              ${entriesLabel} (${entries.length})
              <span class="chevron">▼</span>
            </button>
            <div class="dt-tin__entries" id="${entriesId}" style="display:none">
              ${entryRows}
            </div>
          </div>
          <div class="dt-tin__footer">
            <button class="dt-add-entry-btn" onclick="openAddEntry('${tin.id}', '${tin.type}')">＋ Add entry</button>
          </div>
        </div>`;
    }

    function escHtml(str) {
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Modal: Add / Edit Tin ─────────────────────────────────────────────────
    function openAddTin(type) {
      const modal = document.getElementById('dt-modal');
      document.getElementById('dt-modal-id').value = '';
      document.getElementById('dt-modal-type').value = type;
      document.getElementById('dt-modal-title').textContent = type === 'debt' ? 'Add Debt Tin' : type === 'budget' ? 'Add Budget' : 'Add Business Tin';
      document.getElementById('dt-modal-name').value = '';
      document.getElementById('dt-debt-balance').value = '';
      document.getElementById('dt-debt-limit').value = '';
      document.getElementById('dt-debt-apr').value = '';
      document.getElementById('dt-debt-min').value = '';
      document.getElementById('dt-biz-goal').value = '';
      document.querySelector('.dt-fields-debt').style.display     = type === 'debt'     ? 'flex' : 'none';
      document.querySelector('.dt-fields-business').style.display = type === 'business' ? 'flex' : 'none';
      modal.style.display = 'flex';
      document.getElementById('dt-modal-name').focus();
    }

    function openEditTin(tinId) {
      const tin = _tins.find(t => t.id === tinId);
      if (!tin) return;
      document.getElementById('dt-modal-id').value = tin.id;
      document.getElementById('dt-modal-type').value = tin.type;
      document.getElementById('dt-modal-title').textContent = 'Edit ' + tin.name;
      document.getElementById('dt-modal-name').value = tin.name;
      document.getElementById('dt-debt-balance').value = tin.balance ?? '';
      document.getElementById('dt-debt-limit').value = tin.creditLimit ?? '';
      document.getElementById('dt-debt-apr').value = tin.apr ? (tin.apr * 100).toFixed(2) : '';
      document.getElementById('dt-debt-min').value = tin.minPayment ?? '';
      document.getElementById('dt-biz-goal').value = tin.goalRevenue ?? '';
      document.querySelector('.dt-fields-debt').style.display     = tin.type === 'debt'     ? 'flex' : 'none';
      document.querySelector('.dt-fields-business').style.display = tin.type === 'business' ? 'flex' : 'none';
      document.getElementById('dt-modal').style.display = 'flex';
      document.getElementById('dt-modal-name').focus();
    }

    document.getElementById('dt-modal-cancel')?.addEventListener('click', () => {
      document.getElementById('dt-modal').style.display = 'none';
    });

    document.getElementById('dt-modal-form')?.addEventListener('submit', async e => {
      e.preventDefault();
      const id   = document.getElementById('dt-modal-id').value;
      const type = document.getElementById('dt-modal-type').value;
      const name = document.getElementById('dt-modal-name').value.trim();
      const aprRaw = parseFloat(document.getElementById('dt-debt-apr').value);

      const body = {
        name,
        type,
        balance:     parseFloat(document.getElementById('dt-debt-balance').value) || null,
        creditLimit: parseFloat(document.getElementById('dt-debt-limit').value)   || null,
        apr:         isNaN(aprRaw) ? null : aprRaw / 100,  // store as decimal
        minPayment:  parseFloat(document.getElementById('dt-debt-min').value)     || null,
        goalRevenue: parseFloat(document.getElementById('dt-biz-goal').value)     || null,
      };

      if (id) {
        await fetch(`/api/dirty-tins/${id}`, { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
      } else {
        await fetch('/api/dirty-tins', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
      }

      document.getElementById('dt-modal').style.display = 'none';
      await loadTins();
    });

    // Expose to onclick handlers
    window.openEditTin = openEditTin;

    // ── Delete tin ─────────────────────────────────────────────────────────────
    async function deleteTin(tinId) {
      const tin = _tins.find(t => t.id === tinId);
      if (!tin) return;
      if (!confirm(`Delete "${tin.name}"? This cannot be undone.`)) return;
      await fetch(`/api/dirty-tins/${tinId}`, { method: 'DELETE' });
      await loadTins();
    }
    window.deleteTin = deleteTin;

    // ── Add entry modal ────────────────────────────────────────────────────────
    function openAddEntry(tinId, tinType) {
      document.getElementById('dt-entry-tin-id').value = tinId;
      document.getElementById('dt-entry-tin-type').value = tinType;
      document.getElementById('dt-entry-modal-title').textContent = 'Add Entry';
      document.getElementById('dt-entry-date').value = new Date().toISOString().slice(0,10);
      document.getElementById('dt-entry-amount').value = '';
      document.getElementById('dt-entry-desc').value = '';

      // Set sensible default kind
      const kindSel = document.getElementById('dt-entry-kind');
      kindSel.value = tinType === 'debt' ? 'payment' : 'income';

      document.getElementById('dt-entry-modal').style.display = 'flex';
      document.getElementById('dt-entry-amount').focus();
    }
    window.openAddEntry = openAddEntry;

    document.getElementById('dt-entry-cancel')?.addEventListener('click', () => {
      document.getElementById('dt-entry-modal').style.display = 'none';
    });

    document.getElementById('dt-entry-form')?.addEventListener('submit', async e => {
      e.preventDefault();
      const tinId     = document.getElementById('dt-entry-tin-id').value;
      const kind      = document.getElementById('dt-entry-kind').value;
      const amount    = parseFloat(document.getElementById('dt-entry-amount').value);
      const entryDate = document.getElementById('dt-entry-date').value;
      const description = document.getElementById('dt-entry-desc').value.trim() || null;

      await fetch('/api/dirty-tins/entries', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ tinId, kind, amount, entryDate, description }),
      });

      document.getElementById('dt-entry-modal').style.display = 'none';
      await loadTins();
    });

    // ── Delete entry ───────────────────────────────────────────────────────────
    async function deleteEntry(entryId) {
      await fetch('/api/dirty-tins/entries', {
        method: 'DELETE',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ entryId }),
      });
      await loadTins();
    }

    // ── Monthly bills check-in ─────────────────────────────────────────────────
    function buildMonthlyCheckin() {
      const panel  = document.getElementById('dt-monthly-panel');
      const body   = document.getElementById('dt-monthly-body');
      const meta   = document.getElementById('dt-monthly-meta');
      const toggle = document.getElementById('dt-monthly-toggle');
      const chev   = document.getElementById('dt-monthly-chevron');
      if (!panel || !body) return;

      const now       = new Date();
      const today     = now.getDate();
      const thisMonth = now.toISOString().slice(0, 7);           // YYYY-MM
      const lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1).toISOString().slice(0, 7);

      // Collect last month's expense entries across all budget tins
      // Also collect last month's payment entries across all debt tins
      const rows = [];
      for (const tin of _tins) {
        const isDebt   = tin.type === 'debt';
        const isBudget = tin.type === 'budget';
        if (!isDebt && !isBudget) continue;

        const targetKind = isDebt ? 'payment' : 'expense';
        const lastEntries = (tin.entries ?? []).filter(e =>
          e.entryDate.startsWith(lastMonth) && e.kind === targetKind
        );

        // Deduplicate by description within this tin
        const seen = new Map();
        for (const e of lastEntries) {
          const key = (e.description ?? '').toLowerCase().trim() || `__unnamed_${e.id}`;
          if (!seen.has(key) || e.amount > seen.get(key).amount) seen.set(key, e);
        }

        for (const e of seen.values()) {
          rows.push({ tinId: tin.id, tinName: tin.name, kind: targetKind, description: e.description ?? '', lastAmount: e.amount });
        }
      }

      if (!rows.length) { panel.style.display = 'none'; return; }

      panel.style.display = '';
      if (meta) meta.textContent = `${rows.length} recurring item${rows.length === 1 ? '' : 's'} from last month`;

      // Auto-open on the 1st of the month
      const autoOpen = (today === 1);
      if (autoOpen) {
        toggle.setAttribute('aria-expanded', 'true');
        body.style.display = 'flex';
        chev.classList.add('open');
      }

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        body.style.display = expanded ? 'none' : 'flex';
        chev.classList.toggle('open', !expanded);
      });

      // Check if any of these have already been logged this month
      const loggedThisMonth = new Set();
      for (const tin of _tins) {
        for (const e of (tin.entries ?? [])) {
          if (e.entryDate.startsWith(thisMonth)) {
            loggedThisMonth.add(`${tin.id}::${(e.description ?? '').toLowerCase().trim()}`);
          }
        }
      }

      body.innerHTML = rows.length ? rows.map((row, idx) => {
        const alreadyLogged = loggedThisMonth.has(`${row.tinId}::${row.description.toLowerCase().trim()}`);
        return `
          <div class="dt-monthly-row${alreadyLogged ? ' logged' : ''}" id="dt-mrow-${idx}" data-idx="${idx}" data-tin-id="${row.tinId}" data-kind="${row.kind}" data-last="${row.lastAmount}" data-desc="${escHtml(row.description)}">
            <label class="dt-monthly-check" title="Check to use last month&#39;s amount">
              <input type="checkbox" class="dt-mrow-chk" data-idx="${idx}" ${alreadyLogged ? '' : 'checked'} />
              <span class="dt-monthly-desc">${escHtml(row.description || '(no description)')}</span>
            </label>
            <span class="dt-monthly-tin-name">${escHtml(row.tinName)}</span>
            <input type="number" class="dt-monthly-amount-input dt-mrow-amt" data-idx="${idx}"
              value="${row.lastAmount.toFixed(2)}" step="0.01" min="0.01"
              ${alreadyLogged ? 'disabled' : ''} />
            ${alreadyLogged
              ? '<span class="dt-monthly-logged-badge">✓ Logged</span>'
              : `<button class="dt-monthly-log-btn dt-mrow-btn" data-idx="${idx}">✓ Log</button>`}
          </div>`;
      }).join('') : '<div class="dt-monthly-empty">No recurring bills from last month.</div>';

      // Wire up interactions
      body.querySelectorAll('.dt-mrow-btn').forEach(btn => {
        btn.addEventListener('click', () => logMonthlyRow(parseInt(btn.dataset.idx), rows));
      });
      // Enter key on amount field triggers log
      body.querySelectorAll('.dt-mrow-amt').forEach(input => {
        input.addEventListener('keydown', e => {
          if (e.key === 'Enter') logMonthlyRow(parseInt(input.dataset.idx), rows);
        });
      });
    }

    async function logMonthlyRow(idx, rows) {
      const row      = rows[idx];
      const rowEl    = document.getElementById(`dt-mrow-${idx}`);
      const amtInput = rowEl?.querySelector('.dt-mrow-amt');
      const amount   = parseFloat(amtInput?.value ?? row.lastAmount);
      if (!amount || amount <= 0) { amtInput?.focus(); return; }

      const today = new Date().toISOString().slice(0, 10);
      await fetch('/api/dirty-tins/entries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tinId: row.tinId, kind: row.kind, amount, entryDate: today, description: row.description || null }),
      });

      // Mark row as logged without full reload
      if (rowEl) {
        rowEl.classList.add('logged');
        const btn = rowEl.querySelector('.dt-mrow-btn');
        if (btn) btn.outerHTML = '<span class="dt-monthly-logged-badge">✓ Logged</span>';
        if (amtInput) amtInput.disabled = true;
      }

      // Refresh tin data silently
      try {
        const res = await fetch('/api/dirty-tins');
        const data = await res.json();
        _tins = data.tins ?? [];
        renderSummary();
        renderAll();
      } catch {}
    }

    // ── Add tin buttons ────────────────────────────────────────────────────────
    document.querySelectorAll('.dt-add-btn').forEach(btn => {
      btn.addEventListener('click', () => openAddTin(btn.dataset.addType));
    });

    // ── Close modals on overlay click ──────────────────────────────────────────
    ['dt-modal', 'dt-entry-modal'].forEach(modalId => {
      document.getElementById(modalId)?.addEventListener('click', e => {
        if (e.target.id === modalId) e.target.style.display = 'none';
      });
    });

    // ── Boot ───────────────────────────────────────────────────────────────────
    loadTins();
  </script>
</Layout>
