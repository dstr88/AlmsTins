---
import Layout from '../../layouts/Layout.astro';
import NetWorthHero from '../../components/dashboard/NetWorthHero.astro';
import SalmonTin from '@/components/dashboard/SalmonTin.astro';
import PriceWatchlist from '@/components/dashboard/PriceWatchlist';
import WalletSummary from '../../components/dashboard/WalletSummary';
import AaveHealthSummary from '../../components/dashboard/AaveHealthSummary';
import VaultNftActivity from '@/components/dashboard/VaultNftActivity';
import CryptoComAccounts from '../../components/CryptoComAccounts.astro';
import ExchangeAccounts from '../../components/ExchangeAccounts.astro';
import NetWorthOverviewCard from '../../components/dashboard/NetWorthOverviewCard';
import Tin0AllTransactions from '../../components/dashboard/Tin0AllTransactions.astro';
import { getAllActiveWallets } from '@/lib/wallets';
import { requireTenantSession } from '@/lib/requireTenantSession';

const pageStart = Date.now();
const { tenantId } = await requireTenantSession(Astro.request);
console.log('[vault] auth ms', Date.now() - pageStart);
const walletsStart = Date.now();
const wallets = await getAllActiveWallets(tenantId);
console.log('[vault] wallets ms', Date.now() - walletsStart, 'count', wallets.length);
const defaultWallet = wallets[0] ?? null;
const walletsSorted = [...wallets].sort((a, b) => {
	const aTime = Date.parse(a.createdAt || '') || 0;
	const bTime = Date.parse(b.createdAt || '') || 0;
	return bTime - aTime;
});
console.log('[vault] total ms', Date.now() - pageStart);

const formatWalletLabel = (wallet: { label?: string | null; address: string }) => {
	const label = wallet.label?.trim();
	if (label) return label;
	return wallet.address.slice(-5);
};
---

<Layout title="Vault">
	<section class="vault-page">
		<div class="hero-bleed">
			<NetWorthHero title="Vault" subtitle="TradFi + DeFi vault overview" />
		</div>

		<section class="bk-grid">
			<SalmonTin label="Watchlist" class="tile tile--r1c1">
				<PriceWatchlist client:load />
			</SalmonTin>
			<SalmonTin label="Import" class="tile tile--r1c2 import-tile">
				<div class="import-tile__inner">
					<div class="import-tile__controls">
						<label class="import-tile__label">
							<span>Wallet address</span>
							<input data-import-value type="text" placeholder="0x…" />
						</label>

						<button type="button" class="import-tile__btn" data-import-submit>
							Add
						</button>

						<p class="import-tile__hint">
							Saved wallets load after sign-in and syncs.
						</p>
					</div>

					<div class="import-tile__networth">
						<NetWorthOverviewCard client:load endpoint="/api/networth/summary" />
					</div>

					<div class="import-tile__message" aria-live="polite"></div>
				</div>
			</SalmonTin>
			<div class="tile tile--r1c3">
				<Tin0AllTransactions />
			</div>
			<div class="vault-lane vault-lane--row2">
				{walletsSorted.slice(0, 2).map((wallet, index) => {
					const displayLabel = formatWalletLabel(wallet);
					const tileClass = index === 0 ? 'tile--r2c1' : 'tile--r2c2';
					return (
						<div class={`vault-stack-tin tile ${tileClass}`}>
							<div class="wallet-label-box">{displayLabel}</div>
							<div class="wallet-stack" data-accordion="wallet-stack">
								<SalmonTin label={displayLabel.toUpperCase()} class="wallet-summary-tin wallet-tin--wallet">
									<div slot="summary" class="tin-summary">
										<span class="tin-summary__label">Wallet value</span>
										<span class="tin-summary__value" data-wallet-summary-value>—</span>
									</div>
									<WalletSummary client:load walletId={wallet.id} />
								</SalmonTin>
								<SalmonTin label="DeFi" class="defi-summary-tin wallet-tin--defi">
									<div slot="summary" class="tin-summary">
										<span class="tin-summary__label" data-defi-summary-label>Health</span>
										<span class="tin-summary__value" data-defi-summary-value>—</span>
									</div>
									<AaveHealthSummary client:load walletId={wallet.id} />
								</SalmonTin>
								<SalmonTin label="NFTs" class="wallet-tin--future">
									<div slot="summary" class="tin-summary">
										<span class="tin-summary__label">NFTs</span>
										<span class="tin-summary__value" data-nft-summary-value>—</span>
									</div>
									<VaultNftActivity client:load walletId={wallet.id} />
								</SalmonTin>
							</div>
						</div>
					);
				})}
			</div>
			<div class="vault-lane vault-lane--row3 exchange-lane">
				<CryptoComAccounts />
				<ExchangeAccounts source="coinbase" title="Coinbase" />
				<ExchangeAccounts source="gemini" title="Gemini" />
				<ExchangeAccounts source="robinhood" title="Robinhood" />
			</div>
		</section>

		<section class="vault-table">
			<h2>Table placeholder</h2>
			<div class="placeholder-area">Transactions table coming soon</div>
		</section>
	</section>

	<script>
		const initWalletAccordion = (stack: HTMLElement): void => {
			if (stack.dataset.accordionInit === 'true') return;
			stack.dataset.accordionInit = 'true';
			const tins = Array.from(stack.querySelectorAll('.salmon-tin')).filter(
				(tin): tin is HTMLElement => tin instanceof HTMLElement,
			);

			const setExpanded = (tin: HTMLElement, expanded: boolean): void => {
				const label = tin.querySelector('.salmon-tin__label');
				if (label instanceof HTMLElement) {
					label.setAttribute('aria-expanded', expanded ? 'true' : 'false');
				}
			};

			const collapseAll = (): void => {
				tins.forEach((other) => {
					other.classList.add('is-collapsed');
					setExpanded(other, false);
				});
			};

			tins.forEach((tin, idx) => {
				tin.classList.remove('is-collapsed');
				if (idx !== 0) {
					tin.classList.add('is-collapsed');
				}
				setExpanded(tin, idx === 0);
				const label = tin.querySelector('.salmon-tin__label');
				if (label instanceof HTMLElement) {
					label.setAttribute('role', 'button');
					label.setAttribute('tabindex', '0');
					const toggle = (): void => {
						const isCollapsed = tin.classList.contains('is-collapsed');
						if (isCollapsed) {
							collapseAll();
							tin.classList.remove('is-collapsed');
							setExpanded(tin, true);
						} else {
							tin.classList.add('is-collapsed');
							setExpanded(tin, false);
						}
					};
					label.addEventListener('click', toggle);
					label.addEventListener('keydown', (event) => {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							toggle();
						}
					});
				}
			});
		};

		document.querySelectorAll('.wallet-stack').forEach((stack) => {
			if (stack instanceof HTMLElement) {
				initWalletAccordion(stack);
			}
		});

		// updated wallet total
		const updateWalletSummary = (tin) => {
			const valueEl = tin.querySelector('[data-wallet-summary-value]');
			if (!(valueEl instanceof HTMLElement)) return;
			let total = 0;
			let hasValue = false;
			tin.querySelectorAll('.wallet-summary__cell--value').forEach((cell) => {
				if (!(cell instanceof HTMLElement)) return;
				const raw = cell.textContent ?? '';
				const cleaned = raw.replace(/[$,]/g, '').trim();
				const num = Number.parseFloat(cleaned);
				if (!Number.isFinite(num) || num <= 0) return;
				hasValue = true;
				total += num;
			});
			valueEl.textContent = hasValue
				? total.toLocaleString('en-US', { style: 'currency', currency: 'USD' })
				: '—';
		};

		const updateDefiSummary = (tin) => {
			const labelEl = tin.querySelector('[data-defi-summary-label]');
			const valueEl = tin.querySelector('[data-defi-summary-value]');
			const sourceLabel = tin.querySelector('.stat-row.health .label');
			const sourceValue = tin.querySelector('.stat-row.health .value');
			if (labelEl instanceof HTMLElement && sourceLabel instanceof HTMLElement) {
				labelEl.textContent = sourceLabel.textContent?.trim() || 'Health';
			}
			if (valueEl instanceof HTMLElement && sourceValue instanceof HTMLElement) {
				valueEl.textContent = sourceValue.textContent?.trim() || '—';
			}
		};

		const updateNftSummary = (tin) => {
			const valueEl = tin.querySelector('[data-nft-summary-value]');
			if (!(valueEl instanceof HTMLElement)) return;
			const count = tin.querySelectorAll('.vault-nft').length;
			valueEl.textContent = count ? String(count) : '—';
		};

		const attachSummaryObserver = (tin, updater) => {
			const body = tin.querySelector('.salmon-tin__body');
			if (!(body instanceof HTMLElement)) return;
			updater(tin);
			const observer = new MutationObserver(() => updater(tin));
			observer.observe(body, { childList: true, subtree: true, characterData: true });
		};

		document.querySelectorAll('.wallet-summary-tin').forEach((tin) => attachSummaryObserver(tin, updateWalletSummary));
		document.querySelectorAll('.defi-summary-tin').forEach((tin) => attachSummaryObserver(tin, updateDefiSummary));
		document.querySelectorAll('.wallet-tin--future').forEach((tin) => attachSummaryObserver(tin, updateNftSummary));

		const importTile = document.querySelector('.import-tile');
		if (importTile instanceof HTMLElement) {
			const valueInput = importTile.querySelector('[data-import-value]');
			const submitButton = importTile.querySelector('[data-import-submit]');
			const messageEl = importTile.querySelector('.import-tile__message');

			const setMessage = (text: string) => {
				if (!(messageEl instanceof HTMLElement)) return;
				messageEl.textContent = text;
			};

			if (submitButton instanceof HTMLButtonElement) {
				submitButton.addEventListener('click', () => {
					const value = valueInput instanceof HTMLInputElement ? valueInput.value.trim() : '';

					if (!value) {
						setMessage('Enter a wallet address first.');
						return;
					}
					setMessage('Saving wallet...');
					fetch('/api/wallets', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ address: value }),
					})
						.then(async (response) => {
							const payload = await response.json().catch(() => ({}));
							if (!response.ok) {
								throw new Error(payload?.message ?? payload?.error ?? 'Unable to add wallet.');
							}
							if (valueInput instanceof HTMLInputElement) {
								valueInput.value = '';
							}
							// Reload to render saved wallets server-side.
							setMessage('Wallet added. Reloading...');
							window.location.reload();
						})
						.catch((error) => {
							setMessage(error?.message ?? 'Unable to add wallet.');
						});
				});
			}
		}
	</script>

	<style>
		:global(:root) {
			--font-xl: clamp(1.25rem, 1.1vw + 0.95rem, 1.5rem);
			--font-xl2: clamp(1.35rem, 1.2vw + 1rem, 1.6rem);
			--font-lg: clamp(1.125rem, 0.9vw + 0.85rem, 1.25rem);
			--font-lg2: clamp(1.2rem, 1vw + 0.9rem, 1.4rem);
			--font-md: clamp(1rem, 0.8vw + 0.75rem, 1.125rem);
			--font-md2: clamp(1.05rem, 0.85vw + 0.8rem, 1.2rem);
			--font-sm: clamp(0.875rem, 0.6vw + 0.65rem, 0.95rem);
			--lh-tight: clamp(1.15, 0.2vw + 1.1, 1.25);
			--lh-md: clamp(1.25, 0.25vw + 1.2, 1.4);
			--lh-loose: clamp(1.35, 0.3vw + 1.25, 1.55);
			--space-1: clamp(0.25rem, 0.3vw, 0.4rem);
			--space-2: clamp(0.5rem, 0.45vw, 0.75rem);
			--space-3: clamp(0.75rem, 0.7vw, 1.1rem);
			--space-4: clamp(1rem, 0.9vw, 1.5rem);
			--space-xs: var(--space-1);
			--space-sm: var(--space-2);
			--space-md: var(--space-3);
			--space-lg: var(--space-4);
		}

		.vault-page {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			padding: 1rem 0 2rem;
		}

		.bk-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 24px;
			align-items: stretch;
			position: relative;
			--row1-height: 360px;
			grid-template-areas:
				'r1c1'
				'r1c2'
				'r1c3'
				'row2'
				'row3';
		}

		@media (min-width: 720px) {
			.bk-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
				grid-template-areas:
					'r1c1 r1c2'
					'r1c3 r1c3'
					'row2 row2'
					'row3 row3';
			}
		}

		@media (min-width: 1080px) {
			.bk-grid {
				--row2-height: 520px;
				--row3-height: 420px;
				--grid-gap: 24px;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				grid-template-rows: var(--row1-height) var(--row2-height) var(--row3-height);
				grid-template-areas:
					'r1c1 r1c2 r1c3'
					'row2 row2 row2'
					'row3 row3 row3';
				grid-auto-flow: row;
			}
		}

		@media (min-width: 1080px) {
			.bk-grid::after {
				content: '';
				position: absolute;
				left: 0;
				right: 0;
				height: 1px;
				background: rgba(255, 255, 255, 0.18);
				top: calc(
					var(--row1-height) + var(--grid-gap) + var(--row2-height) + (var(--grid-gap) * 0.5)
				);
			}
		}

		.tile--r1c1 {
			grid-area: r1c1;
		}

		.tile--r1c2 {
			grid-area: r1c2;
		}

		.tile--r1c3 {
			grid-area: r1c3;
			min-height: 0;
			overflow: hidden;
			display: flex;
			flex-direction: column;
			height: var(--row1-height);
		}

		@media (min-width: 1080px) {
			.tile--r2c1 {
				grid-column: 1;
				grid-row: 2;
			}

			.tile--r2c2 {
				grid-column: 2;
				grid-row: 2;
			}

			.tile--r3c1 {
				grid-column: 1;
				grid-row: 3;
			}
		}

		.vault-lane {
			display: flex;
			gap: 24px;
			flex-wrap: wrap;
			min-height: 0;
		}

		.vault-lane > .tile {
			flex: 1 1 100%;
			min-width: 0;
		}

		@media (min-width: 720px) {
			.vault-lane > .tile {
				flex: 1 1 calc((100% - 24px) / 2);
			}
		}

		.vault-lane--row2 {
			grid-area: row2;
		}

		.vault-lane--row3 {
			grid-area: row3;
		}

		@media (min-width: 1080px) {
			.vault-lane--row3 {
				justify-content: flex-start;
			}

			.vault-lane > .tile {
				flex: 0 0 calc((100% - (var(--grid-gap, 24px) * 2)) / 3);
			}
		}

		.exchange-lane > .tile {
			flex: 1 1 100%;
		}

		@media (min-width: 720px) {
			.exchange-lane > .tile {
				flex: 1 1 calc((100% - 24px) / 2);
			}
		}

		@media (min-width: 1080px) {
			.exchange-lane > .tile {
				flex: 1 1 calc((100% - 24px) / 2);
			}
		}

		.exchange-empty {
			margin: 0;
			font-size: var(--font-sm);
			opacity: 0.7;
		}

		.exchange-controls {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			align-items: center;
		}

		.exchange-button {
			border-radius: 999px;
			border: 1px solid rgba(255, 255, 255, 0.2);
			background: rgba(255, 255, 255, 0.08);
			color: inherit;
			padding: 0.35rem 0.8rem;
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			cursor: pointer;
		}

		.exchange-button:hover {
			background: rgba(255, 255, 255, 0.16);
		}

		.exchange-file {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.35rem 0.6rem;
			border-radius: 999px;
			border: 1px solid rgba(255, 255, 255, 0.2);
			cursor: pointer;
			font-size: var(--font-sm);
		}

		.exchange-file input {
			display: none;
		}

		.vault-table {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}


		.tile {
			min-height: 0;
			height: 100%;
			max-height: 100%;
		}

		:global(.tile.placeholder-card) {
			overflow: auto;
		}

		:global(.tile .salmon-tin) {
			height: 100%;
		}

		:global(.tile .salmon-tin__body) {
			min-height: 0;
			overflow: auto;
		}

		:global(.tile--r1c3 .tin0-all) {
			height: 100%;
			min-height: 0;
		}

		:global(.tile--r1c3 .tin0-all__list) {
			min-height: 0;
		}

		.vault-stack-tin {
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
			min-height: 0;
			height: 100%;
		}

		.import-tile__inner {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			min-height: 0;
		}

		.import-tile__controls {
			display: grid;
			gap: 0.6rem;
		}

		.import-tile__label {
			display: grid;
			gap: 0.25rem;
			font-size: 0.85rem;
			opacity: 0.9;
		}

		.import-tile__label select,
		.import-tile__label input {
			border-radius: 0.65rem;
			border: 1px solid rgba(255, 255, 255, 0.18);
			background: rgba(255, 255, 255, 0.08);
			color: inherit;
			padding: 0.5rem 0.65rem;
			outline: none;
		}

		.import-tile__btn {
			border-radius: 0.65rem;
			border: 1px solid rgba(255, 255, 255, 0.18);
			background: rgba(255, 255, 255, 0.12);
			color: inherit;
			padding: 0.55rem 0.75rem;
			font-size: 0.9rem;
			cursor: pointer;
		}

		.import-tile__hint {
			font-size: 0.75rem;
			opacity: 0.7;
			margin: 0;
		}

		.import-tile__message {
			font-size: 0.8rem;
			opacity: 0.85;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}

		.import-tile__networth {
			border-top: 1px solid rgba(255, 255, 255, 0.14);
			padding-top: 0.75rem;
			min-height: 0;
		}

		.wallet-label-box {
			align-self: center;
			padding: 0.35rem 1.25rem;
			border: 2px solid salmon;
			border-radius: 999px;
			color: #ffffff;
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.wallet-stack {
			display: flex;
			flex-direction: column;
			gap: 5px;
			flex: 1;
			min-height: 0;
		}

		:global(.wallet-stack .salmon-tin__label) {
			cursor: pointer;
		}

		:global(.wallet-stack .salmon-tin.is-collapsed) {
			padding-bottom: 8px;
			min-height: 7.5rem;
		}

		:global(.wallet-stack .salmon-tin.is-collapsed .salmon-tin__body) {
			display: none;
		}

		:global(.wallet-stack .salmon-tin__summary) {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: var(--space-md);
			padding: 0.35rem 0.5rem 0.5rem;
			min-height: 3.6rem;
		}

		:global(.wallet-stack .tin-summary__label) {
			font-size: var(--font-md2);
			opacity: 0.85;
		}

		:global(.wallet-stack .tin-summary__value) {
			font-size: var(--font-xl2);
			font-weight: 800;
			font-variant-numeric: tabular-nums;
		}

		.wallet-empty {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 120px;
			width: 100%;
			border: 1px dashed rgba(255, 255, 255, 0.35);
			border-radius: 10px;
			color: rgba(247, 242, 235, 0.75);
			font-size: 0.95rem;
		}

		.wallet-summary-tin :global(.salmon-tin__label) {
			left: 50%;
			transform: translateX(-50%);
			color: #ffffff;
			font-size: 20px;
		}

		.defi-summary-tin :global(.salmon-tin__label) {
			left: 50%;
			transform: translateX(-50%);
			color: #ffffff;
			font-size: 20px;
		}

		:global(.defi-summary-tin .defi-stats) {
			display: flex;
			flex-direction: column;
			gap: var(--space-md);
			line-height: var(--lh-md);
		}

		:global(.defi-summary-tin .stat-row) {
			display: grid;
			grid-template-columns: 1fr auto;
			column-gap: var(--space-md);
			align-items: baseline;
		}

		:global(.defi-summary-tin .stat-row .label) {
			font-size: var(--font-lg2);
			opacity: 0.92;
			text-align: left;
			line-height: var(--lh-md);
		}

		:global(.defi-summary-tin .stat-row .value) {
			font-size: var(--font-lg2);
			font-weight: 700;
			justify-self: end;
			text-align: right;
			line-height: var(--lh-md);
		}

		:global(.defi-summary-tin .stat-row.health .label),
		:global(.defi-summary-tin .stat-row.health .value) {
			font-size: var(--font-xl2);
			line-height: var(--lh-tight);
			font-weight: 800;
		}

		:global(.defi-summary-tin .stat-row.net .label),
		:global(.defi-summary-tin .stat-row.net .value) {
			font-size: var(--font-xl2);
			font-weight: 800;
			line-height: var(--lh-tight);
		}

		:global(.defi-summary-tin .stat-row.debt .value) {
			color: #fecaca;
