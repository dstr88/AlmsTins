---
import Layout from '../../layouts/Layout.astro';
import NetWorthHero from '../../components/dashboard/NetWorthHero.astro';
import OrnateTin from '@/components/OrnatedTin.astro';
import DrawerHost from '../../components/bookkeeping/DrawerHost';
import ReconciliationTin from '../../components/bookkeeping/ReconciliationTin';
import { requireTenantSession } from '../../lib/requireTenantSession';
import { buildAnnualBreakdown } from '../../lib/annualBreakdown';
import { getActivePlan } from '../../lib/subscriptions';

const { tenantId } = await requireTenantSession(Astro.request);

// Plan check for Year Summary PDF
const activePlan = await getActivePlan(tenantId);
const canDownloadPdf = activePlan.id === 'unlimited';

// Year selector — default to last year
const currentYear = new Date().getFullYear();
const defaultYear = currentYear - 1;
const yearParam   = Astro.url.searchParams.get('year');
const selectedYear = yearParam ? Number(yearParam) : defaultYear;

const bd = await buildAnnualBreakdown(tenantId, selectedYear);

// ── Formatters ──────────────────────────────────────────────────────────────
const fDate = (iso: string | null) => {
  if (!iso) return '—';
  try {
    return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch { return iso; }
};
const fQty = (v: number) =>
  Number.isFinite(v) ? v.toLocaleString(undefined, { maximumFractionDigits: 6 }) : '—';
const fUsd = (v: number | null) => {
  if (v == null || !Number.isFinite(v)) return '—';
  const sign = v < 0 ? '-' : '';
  return `${sign}$${Math.abs(v).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
};
const fGain = (v: number | null) => {
  if (v == null || !Number.isFinite(v)) return { text: '—', cls: '' };
  const sign = v >= 0 ? '+' : '-';
  return {
    text: `${sign}$${Math.abs(v).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`,
    cls: v >= 0 ? 'gain-pos' : 'gain-neg',
  };
};
const csvBase = (section: string) =>
  `/api/tax/breakdown-csv?year=${selectedYear}&section=${section}`;

const kindLabel = (kind: string) =>
  kind
    .replace(/_/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/Crypto/g, 'Crypto')
    .trim();

// ── Asset classifiers ────────────────────────────────────────────────────────
const STABLECOINS = new Set([
  'USDC','USDT','DAI','BUSD','FRAX','TUSD','USDP','GUSD','LUSD',
  'CRVUSD','USDE','PYUSD','USDS','FDUSD','SUSD','MUSD','ALUSD',
]);
const isAToken    = (s: string) => /^a[A-Z]/.test(s);   // aUSDC, aWETH, aPolUSDC…
const isDebtToken = (s: string) => /^(variableDebt|stableDebt)/i.test(s);
const isDefiAsset = (s: string) => isAToken(s) || isDebtToken(s);
const isStable    = (s: string) => STABLECOINS.has(s.replace(/^a/, '').toUpperCase());

// Scam/dust detector — flags tokens with phishing URLs or claim prompts in name
const SCAM_PATTERNS = [
  /https?:\/\//i, /www\./i, /\.com/i, /\.xyz/i, /\.site/i, /\.io/i,
  /t\.me\//i, /claim/i, /visit/i, /reward/i, /airdrop/i, /official.link/i,
];
const isScamToken = (s: string) => SCAM_PATTERNS.some(p => p.test(s));

// Split holdings into regular wallet vs DeFi protocol positions
const allWalletHoldings = bd.stillHolding.filter(p => !isDefiAsset(p.asset));
const walletHoldings = allWalletHoldings.filter(p => !isScamToken(p.asset));
const dustHoldings   = allWalletHoldings.filter(p => isScamToken(p.asset));
const defiHoldings   = bd.stillHolding.filter(p => isDefiAsset(p.asset));

const walletCostBasis = walletHoldings.reduce((s, p) => s + (p.costUsd ?? 0), 0);
const defiCostBasis   = defiHoldings.reduce((s, p)   => s + (p.costUsd ?? 0), 0);
---

<Layout title="Bookkeeping | Almstins" noindex={true}>
  <section class="bookkeeping-page">
    <div class="hero-bleed">
      <NetWorthHero title="Bookkeeping" subtitle="Annual breakdown" />
    </div>

    <!-- ══ Year Selector ════════════════════════════════════════════════════ -->
    <div class="year-bar">
      <span class="year-bar__label">Calendar Year</span>
      <div class="year-bar__pills">
        {bd.availableYears.map((y) => (
          <a
            href={`/dashboard/bookkeeping?year=${y}`}
            class={`year-pill ${y === selectedYear ? 'year-pill--active' : ''}`}
          >
            {y}
          </a>
        ))}
      </div>
      <div class="year-bar__actions">
        {canDownloadPdf ? (
          <a
            href={`/api/year-summary/report?year=${selectedYear}`}
            download={`almstins-${selectedYear}-year-summary.pdf`}
            class="year-summary-btn"
            title={`Download ${selectedYear} Year Summary PDF`}
          >
            ↓ Year Summary PDF
          </a>
        ) : (
          <a
            href="/dashboard/billing"
            class="year-summary-btn year-summary-btn--locked"
            title="Upgrade to Premium to download Year Summary PDF"
          >
            🔒 Year Summary PDF
            <span class="year-summary-badge">Premium</span>
          </a>
        )}
      </div>
    </div>

    <!-- ══ 2×2 Grid + Full-Width Income ═════════════════════════════════════ -->
    <div class="breakdown-grid">

      <!-- 🔴 1. Needs Attention -->
      <div class="grid-cell">
        <OrnateTin label="⚠ Needs Attention" class="tin-section tin-section--alert">
          <div class="tin-toolbar">
            <span class="tin-toolbar__count">{bd.needsAttention.length} items</span>
            <a href={csvBase('needsAttention')} download class="tin-csv-btn">↓ CSV</a>
          </div>
          <div class="tin-total tin-total--warn">
            Untraced proceeds: <strong>{fUsd(bd.totals.unsettledProceeds)}</strong>
          </div>
          {bd.needsAttention.length === 0 ? (
            <p class="tin-empty">✓ No orphaned sales for {selectedYear}</p>
          ) : (
            <div class="tin-rows">
              {bd.needsAttention.map((item) => {
                // 'other' class = unrecognised transfer pattern → most common scam signal
                const isOther = item.transactionClass === 'other';
                // Round number + unrecognised = strong scam indicator (e.g. exactly 1,000 USDC)
                const isRound = item.amount >= 100 && item.amount === Math.floor(item.amount);
                const scamLikely = isOther && isRound;
                const scamPossible = isOther && !isRound;
                return (
                  <div
                    class={`tin-row tin-row--alert${scamLikely ? ' tin-row--scam' : ''}`}
                    data-source-id={item.sourceId}
                    data-group-id={item.groupId}
                    data-tx-hash={item.txHash ?? ''}
                    data-asset={item.asset}
                    data-amount={String(item.amount)}
                    data-sell-date={item.sellDate}
                    data-proceeds={item.proceedsUsd != null ? String(item.proceedsUsd) : ''}
                    data-tx-class={item.transactionClass}
                    data-source-type={item.sourceType}
                  >
                    <span class="tin-row__asset">{item.asset}</span>
                    {scamLikely && <span class="asset-badge asset-badge--scam">⚠ SCAM?</span>}
                    {scamPossible && <span class="asset-badge asset-badge--verify">VERIFY</span>}
                    <span class="tin-row__qty">{fQty(item.amount)}</span>
                    <span class="tin-row__date">{fDate(item.sellDate)}</span>
                    <span class="tin-row__usd">{fUsd(item.proceedsUsd)}</span>
                    <span class="tin-row__note">{scamLikely ? 'Unrecognised · round amount' : scamPossible ? 'Unrecognised transfer' : 'No purchase found'}</span>
                    <span class="tin-row__cta">Details →</span>
                  </div>
                );
              })}
            </div>
          )}
        </OrnateTin>
      </div>

      <!-- 💼 2. Still in Wallet -->
      <div class="grid-cell">
        <OrnateTin label="💼 Still in Wallet" class="tin-section tin-section--hold">
          <div class="tin-toolbar">
            <span class="tin-toolbar__count">{walletHoldings.length} positions</span>
            <a href={csvBase('stillHolding')} download class="tin-csv-btn">↓ CSV</a>
          </div>
          <div class="tin-total">
            <span class="tin-total__kind">Cost Basis</span>
            <strong>{fUsd(walletCostBasis)}</strong>
            <span class="tin-total__note">what you paid · not market value</span>
          </div>
          {walletHoldings.length === 0 ? (
            <p class="tin-empty">No open positions</p>
          ) : (
            <div class="tin-rows">
              {walletHoldings.map((pos) => (
                <div class={`tin-row${isStable(pos.asset) ? ' tin-row--stable' : ''}`}>
                  <span class="tin-row__asset">{pos.asset}</span>
                  {isStable(pos.asset) && <span class="asset-badge asset-badge--stable">STABLE</span>}
                  <span class="tin-row__qty">{fQty(pos.amount)}</span>
                  <span class="tin-row__date">Since {fDate(pos.acquiredDate)}</span>
                  <span class="tin-row__usd">{fUsd(pos.costUsd)}</span>
                  <span class={`tin-row__term ${pos.daysHeld >= 365 ? 'term-long' : 'term-short'}`}>
                    {pos.daysHeld >= 365 ? 'Long' : 'Short'} · {pos.daysHeld}d
                  </span>
                  <label class="tin-row__confirm">
                    <input type="checkbox" class="confirm-check" data-asset={pos.asset} data-date={pos.acquiredDate} />
                    <span class="confirm-label">Confirmed</span>
                  </label>
                </div>
              ))}
            </div>
          )}

          {bd.nftHoldings.length > 0 && (
            <>
              <div class="nft-divider">
                <span class="nft-divider__line"></span>
                <span class="nft-divider__label">NFT Holdings</span>
                <span class="nft-divider__line"></span>
              </div>
              <p class="nft-note">
                Held NFTs are unrealized — no tax until sold. Cost basis unconfirmed.
              </p>
              <div class="tin-rows">
                {bd.nftHoldings.map((nft) => (
                  <div class="tin-row tin-row--nft">
                    <span class="tin-row__asset nft-name">{nft.name}</span>
                    {nft.symbol && nft.symbol !== nft.name && (
                      <span class="tin-row__kind">{nft.symbol}</span>
                    )}
                    <span class="tin-row__date">{nft.chain}</span>
                    <span class="tin-row__note">#{nft.tokenId.length > 12 ? nft.tokenId.slice(0, 10) + '…' : nft.tokenId}</span>
                    {nft.url && (
                      <a href={nft.url} target="_blank" rel="noopener noreferrer" class="nft-link">
                        View ↗
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </>
          )}
        </OrnateTin>
      </div>

      <!-- 🔷 DeFi Positions — full width, only shown when present -->
      {defiHoldings.length > 0 && (
        <div class="grid-cell grid-cell--full">
          <OrnateTin label="🔷 DeFi Positions" class="tin-section tin-section--defi">
            <div class="tin-toolbar">
              <span class="tin-toolbar__count">{defiHoldings.length} positions</span>
              <span class="tin-toolbar__note">Aave collateral &amp; protocol balances — unrealized, no tax until withdrawn &amp; sold</span>
            </div>
            <div class="tin-total">
              Protocol cost basis: <strong>{fUsd(defiCostBasis)}</strong>
              <span class="tin-total__note">not included in wallet total above</span>
            </div>
            <div class="tin-rows tin-rows--defi">
              {defiHoldings.map((pos) => (
                <div class={`tin-row${isDebtToken(pos.asset) ? ' tin-row--debt' : ' tin-row--atoken'}`}>
                  <span class="tin-row__asset">{pos.asset}</span>
                  {isDebtToken(pos.asset)
                    ? <span class="asset-badge asset-badge--debt">DEBT</span>
                    : <span class="asset-badge asset-badge--atoken">AAVE</span>
                  }
                  <span class="tin-row__qty">{fQty(pos.amount)}</span>
                  <span class="tin-row__date">Since {fDate(pos.acquiredDate)}</span>
                  <span class="tin-row__usd">{fUsd(pos.costUsd)}</span>
                  <span class={`tin-row__term ${pos.daysHeld >= 365 ? 'term-long' : 'term-short'}`}>
                    {pos.daysHeld >= 365 ? 'Long' : 'Short'} · {pos.daysHeld}d
                  </span>
                </div>
              ))}
            </div>
          </OrnateTin>
        </div>
      )}

      <!-- 🟠 3. Short-Term Gains / Losses -->
      <div class="grid-cell">
        <OrnateTin label="🟠 Short-Term G/L" class="tin-section tin-section--short">
          <div class="tin-toolbar">
            <span class="tin-toolbar__count">{bd.shortTerm.length} lots</span>
            <a href={csvBase('shortTerm')} download class="tin-csv-btn">↓ CSV</a>
          </div>
          {(() => {
            const g = fGain(bd.totals.shortTermGain);
            return (
              <div class={`tin-total ${g.cls}`}>
                Net short-term: <strong>{g.text}</strong>
                <span class="tin-total__note">taxed as ordinary income</span>
              </div>
            );
          })()}
          {bd.shortTerm.length === 0 ? (
            <p class="tin-empty">No short-term disposals in {selectedYear}</p>
          ) : (
            <div class="tin-rows">
              {bd.shortTerm.map((lot) => {
                const g = fGain(lot.gainLossUsd);
                return (
                  <div class="tin-row">
                    <span class="tin-row__asset">{lot.asset}</span>
                    <span class="tin-row__qty">{fQty(lot.amount)}</span>
                    <div class="tin-row__dates">
                      <span>{fDate(lot.buyDate)}</span>
                      <span class="tin-row__arrow">→</span>
                      <span>{fDate(lot.sellDate)}</span>
                      <span class="tin-row__days">{lot.daysHeld}d</span>
                    </div>
                    <span class="tin-row__usd">{fUsd(lot.costUsd)}</span>
                    <span class="tin-row__usd">{fUsd(lot.proceedsUsd)}</span>
                    <span class={`tin-row__gain ${g.cls}`}>{g.text}</span>
                  </div>
                );
              })}
            </div>
          )}
        </OrnateTin>
      </div>

      <!-- 🟢 4. Long-Term Gains / Losses -->
      <div class="grid-cell">
        <OrnateTin label="🟢 Long-Term G/L" class="tin-section tin-section--long">
          <div class="tin-toolbar">
            <span class="tin-toolbar__count">{bd.longTerm.length} lots</span>
            <a href={csvBase('longTerm')} download class="tin-csv-btn">↓ CSV</a>
          </div>
          {(() => {
            const g = fGain(bd.totals.longTermGain);
            return (
              <div class={`tin-total ${g.cls}`}>
                Net long-term: <strong>{g.text}</strong>
                <span class="tin-total__note">preferential rate</span>
              </div>
            );
          })()}
          {bd.longTerm.length === 0 ? (
            <p class="tin-empty">No long-term disposals in {selectedYear}</p>
          ) : (
            <div class="tin-rows">
              {bd.longTerm.map((lot) => {
                const g = fGain(lot.gainLossUsd);
                return (
                  <div class="tin-row">
                    <span class="tin-row__asset">{lot.asset}</span>
                    <span class="tin-row__qty">{fQty(lot.amount)}</span>
                    <div class="tin-row__dates">
                      <span>{fDate(lot.buyDate)}</span>
                      <span class="tin-row__arrow">→</span>
                      <span>{fDate(lot.sellDate)}</span>
                      <span class="tin-row__days">{lot.daysHeld}d</span>
                    </div>
                    <span class="tin-row__usd">{fUsd(lot.costUsd)}</span>
                    <span class="tin-row__usd">{fUsd(lot.proceedsUsd)}</span>
                    <span class={`tin-row__gain ${g.cls}`}>{g.text}</span>
                  </div>
                );
              })}
            </div>
          )}
        </OrnateTin>
      </div>

      <!-- 💰 5. Income & Fees — full width -->
      <div class="grid-cell grid-cell--full">
        <OrnateTin label="💰 Income — Interest, Staking & Rewards" class="tin-section tin-section--income">
          <div class="tin-toolbar">
            <span class="tin-toolbar__count">{bd.income.length} items</span>
            <a href={csvBase('income')} download class="tin-csv-btn">↓ CSV</a>
          </div>
          <div class="tin-total">
            Total ordinary income: <strong>{fUsd(bd.totals.totalIncome)}</strong>
          </div>
          {bd.income.length === 0 ? (
            <p class="tin-empty">No income events in {selectedYear}</p>
          ) : (
            <div class="tin-rows tin-rows--income">
              {bd.income.map((item) => (
                <div class="tin-row tin-row--income">
                  <span class="tin-row__asset">{item.asset}</span>
                  <span class="tin-row__qty">{fQty(item.amount)}</span>
                  <span class="tin-row__date">{fDate(item.date)}</span>
                  <span class="tin-row__usd">{fUsd(item.usdValue)}</span>
                  <span class="tin-row__kind">{kindLabel(item.kind)}</span>
                  {item.description && (
                    <span class="tin-row__note">{item.description}</span>
                  )}
                </div>
              ))}
            </div>
          )}
        </OrnateTin>
      </div>

    </div><!-- /breakdown-grid -->

    <!-- ══ NFT Dust / Scam Tokens ═══════════════════════════════════════════ -->
    {dustHoldings.length > 0 && (
      <div class="reconciliation-section">
        <details class="dust-tin">
          <summary class="dust-tin__summary">
            <span class="dust-tin__label">☣ NFT Dust &amp; Scam Tokens</span>
            <span class="dust-tin__count">{dustHoldings.length} tokens</span>
            <span class="dust-tin__caret">▾</span>
          </summary>
          <div class="dust-tin__body">
            <p class="dust-tin__note">These tokens contain phishing URLs or claim prompts in their name. They have no real value and are excluded from your cost basis above.</p>
            <div class="tin-rows">
              {dustHoldings.map((pos) => (
                <div class="tin-row tin-row--dust">
                  <span class="tin-row__asset">{pos.asset}</span>
                  <span class="tin-row__qty">{fQty(pos.amount)}</span>
                  <span class="tin-row__date">Since {fDate(pos.acquiredDate)}</span>
                </div>
              ))}
            </div>
          </div>
        </details>
      </div>
    )}

    <!-- ══ Reconciliation ══════════════════════════════════════════════════ -->
    <div class="reconciliation-section">
      <ReconciliationTin client:load />
    </div>

  </section>

  <!-- Drawer mount point -->
  <div id="drawer-mount">
    <DrawerHost client:load />
  </div>

  <style>
    /* ── Page shell ─────────────────────────────────────────── */
    .bookkeeping-page {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 1rem 0 3rem;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
      box-sizing: border-box;
    }

    .bookkeeping-page > :not(.hero-bleed) {
      padding-left: clamp(1rem, 3vw, 2.5rem);
      padding-right: clamp(1rem, 3vw, 2.5rem);
    }
    .reconciliation-section {
      padding: 0 1.5rem;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .hero-bleed {
      height: 60vh;
      min-height: 420px;
      width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: stretch;
    }
    .hero-bleed :global(.hero) { width: 100%; }

    /* ── Year selector bar ─────────────────────────────────── */
    .year-bar {
      display: flex;
      align-items: center;
      gap: 1rem;
      max-width: calc(100% - 6rem);
      margin: 0 auto;
      flex-wrap: wrap;
    }
    .year-bar__label {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.55;
    }
    .year-bar__pills {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .year-pill {
      display: inline-block;
      padding: 0.35rem 0.9rem;
      border-radius: 20px;
      border: 1px solid rgba(250,128,114,0.4);
      color: rgba(250,128,114,0.85);
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s, color 0.15s;
    }
    .year-pill:hover { background: rgba(250,128,114,0.1); }
    .year-pill--active {
      background: rgba(250,128,114,0.9);
      color: #0b0f1a;
      border-color: transparent;
    }
    .year-bar__actions {
      margin-left: auto;
      display: flex;
      align-items: center;
    }
    .year-summary-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 1rem;
      border-radius: 20px;
      border: 1px solid rgba(250,128,114,0.6);
      color: rgba(250,128,114,0.9);
      background: rgba(250,128,114,0.06);
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
    .year-summary-btn:hover {
      background: rgba(250,128,114,0.15);
      border-color: rgba(250,128,114,0.9);
    }
    .year-summary-btn--locked {
      opacity: 0.55;
      cursor: default;
      border-style: dashed;
    }
    .year-summary-btn--locked:hover {
      background: rgba(250,128,114,0.06);
      border-color: rgba(250,128,114,0.4);
      opacity: 0.7;
    }
    .year-summary-badge {
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
      border-radius: 8px;
      background: rgba(250,128,114,0.2);
      color: rgba(250,128,114,0.9);
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    /* ── 2×2 + full-width grid ─────────────────────────────── */
    .breakdown-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
      gap: 2rem;
      max-width: calc(100% - 6rem);
      margin: 0 auto;
    }

    .grid-cell {
      height: 68vh;
      min-height: 520px;
      max-height: 840px;
      display: flex;
      flex-direction: column;
    }

    .grid-cell--full {
      grid-column: 1 / -1;
      height: 56vh;
      min-height: 400px;
      max-height: 640px;
    }

    /* ── Tin section variants (accent colours) ─────────────── */
    :global(.tin-section) {
      height: 100%;
      min-height: 0;
      overflow: hidden; /* let body scroll, not the tin frame */
    }

    /* Alert: red label pill */
    :global(.tin-section--alert .ornate-tin__label) {
      background: linear-gradient(180deg, #ef4444cc, #ef444490) !important;
      color: #fff !important;
    }
    :global(.tin-section--alert::before) {
      box-shadow:
        0 0 0 2px rgba(239,68,68,0.8) inset,
        0 0 0 8px rgba(239,68,68,0.08) inset,
        0 0 0 1px rgba(255,255,255,0.06) inset !important;
    }
    :global(.tin-section--alert::after) {
      border-color: rgba(239,68,68,0.55) !important;
    }

    /* Hold: blue accent */
    :global(.tin-section--hold .ornate-tin__label) {
      background: linear-gradient(180deg, #3b82f6cc, #3b82f690) !important;
      color: #fff !important;
    }
    :global(.tin-section--hold::before) {
      box-shadow:
        0 0 0 2px rgba(59,130,246,0.8) inset,
        0 0 0 8px rgba(59,130,246,0.08) inset,
        0 0 0 1px rgba(255,255,255,0.06) inset !important;
    }
    :global(.tin-section--hold::after) {
      border-color: rgba(59,130,246,0.55) !important;
    }

    /* Short-term: amber */
    :global(.tin-section--short .ornate-tin__label) {
      background: linear-gradient(180deg, #f59e0bcc, #f59e0b90) !important;
      color: #0b0f1a !important;
    }
    :global(.tin-section--short::before) {
      box-shadow:
        0 0 0 2px rgba(245,158,11,0.8) inset,
        0 0 0 8px rgba(245,158,11,0.08) inset,
        0 0 0 1px rgba(255,255,255,0.06) inset !important;
    }
    :global(.tin-section--short::after) {
      border-color: rgba(245,158,11,0.55) !important;
    }

    /* Long-term: green */
    :global(.tin-section--long .ornate-tin__label) {
      background: linear-gradient(180deg, #22c55ecc, #22c55e90) !important;
      color: #0b0f1a !important;
    }
    :global(.tin-section--long::before) {
      box-shadow:
        0 0 0 2px rgba(34,197,94,0.8) inset,
        0 0 0 8px rgba(34,197,94,0.08) inset,
        0 0 0 1px rgba(255,255,255,0.06) inset !important;
    }
    :global(.tin-section--long::after) {
      border-color: rgba(34,197,94,0.55) !important;
    }

    /* DeFi: teal/cyan */
    :global(.tin-section--defi .ornate-tin__label) {
      background: linear-gradient(180deg, #06b6d4cc, #06b6d490) !important;
      color: #fff !important;
    }
    :global(.tin-section--defi::before) {
      box-shadow:
        0 0 0 2px rgba(6,182,212,0.8) inset,
        0 0 0 8px rgba(6,182,212,0.08) inset,
        0 0 0 1px rgba(255,255,255,0.06) inset !important;
    }
    :global(.tin-section--defi::after) {
      border-color: rgba(6,182,212,0.55) !important;
    }

    /* Income: purple */
    :global(.tin-section--income .ornate-tin__label) {
      background: linear-gradient(180deg, #a855f7cc, #a855f790) !important;
      color: #fff !important;
    }
    :global(.tin-section--income::before) {
      box-shadow:
        0 0 0 2px rgba(168,85,247,0.8) inset,
        0 0 0 8px rgba(168,85,247,0.08) inset,
        0 0 0 1px rgba(255,255,255,0.06) inset !important;
    }
    :global(.tin-section--income::after) {
      border-color: rgba(168,85,247,0.55) !important;
    }

    /* ── Toolbar (count + CSV button) ──────────────────────── */
    .tin-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .tin-toolbar__count {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      opacity: 0.5;
    }
    .tin-toolbar__note {
      font-size: 0.72rem;
      opacity: 0.4;
      font-style: italic;
      margin-left: 0.75rem;
    }
    .tin-csv-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.75rem;
      border-radius: 8px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.14);
      color: rgba(255,255,255,0.75);
      font-size: 0.78rem;
      font-weight: 600;
      text-decoration: none;
      letter-spacing: 0.05em;
      transition: background 0.15s;
    }
    .tin-csv-btn:hover { background: rgba(255,255,255,0.13); }

    /* ── Section total ─────────────────────────────────────── */
    .tin-total {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
      padding: 0.5rem 0.75rem;
      background: rgba(255,255,255,0.04);
      border-radius: 8px;
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
    }
    .tin-total strong { font-size: 1.05rem; }
    .tin-total__kind {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.55;
      margin-right: 0.15rem;
    }
    .tin-total__note {
      font-size: 0.75rem;
      opacity: 0.5;
      margin-left: auto;
      font-style: italic;
    }
    .tin-total--warn { background: rgba(239,68,68,0.08); }

    /* ── Row list ───────────────────────────────────────────── */
    .tin-rows {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      overflow-y: auto;
    }
    .tin-rows--income {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.4rem;
      overflow-y: visible;
    }

    .tin-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.4rem 0.75rem;
      padding: 0.45rem 0.7rem;
      border-radius: 7px;
      background: rgba(255,255,255,0.04);
      font-size: 0.85rem;
      transition: background 0.12s;
    }
    .tin-row:hover { background: rgba(255,255,255,0.08); }

    .tin-row--alert { border-left: 3px solid rgba(239,68,68,0.6); cursor: pointer; }
    .tin-row--alert:hover { background: rgba(239,68,68,0.08); }
    .tin-row__cta { margin-left: auto; font-size: 0.75rem; opacity: 0.45; font-weight: 600; letter-spacing: 0.04em; }
    .tin-row--alert:hover .tin-row__cta { opacity: 0.8; color: #fca5a5; }
    .tin-row--income { border-left: 3px solid rgba(168,85,247,0.45); }

    .tin-row__asset  { font-weight: 800; font-size: 0.95rem; letter-spacing: 0.04em; min-width: 3rem; max-width: 22ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tin-row__qty    { font-variant-numeric: tabular-nums; opacity: 0.75; }
    .tin-row__date   { opacity: 0.55; font-size: 0.78rem; }
    .tin-row__dates  { display: flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; opacity: 0.6; }
    .tin-row__arrow  { opacity: 0.4; }
    .tin-row__days   { opacity: 0.45; font-size: 0.72rem; }
    .tin-row__usd    { font-variant-numeric: tabular-nums; }
    .tin-row__gain   { font-weight: 700; font-size: 0.9rem; margin-left: auto; }
    .tin-row__note   { font-size: 0.75rem; opacity: 0.45; font-style: italic; }
    .tin-row__kind   { font-size: 0.75rem; opacity: 0.55; }
    .tin-row__term   { font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 4px; }

    /* ── DeFi rows grid (multi-column when wide) ────────────── */
    .tin-rows--defi {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 0.4rem;
      overflow-y: visible;
    }

    /* ── Row: aToken (Aave collateral deposit) ──────────────── */
    .tin-row--atoken {
      border-left: 3px solid rgba(6,182,212,0.55);
      background: rgba(6,182,212,0.05);
      color: #e0f7fa;
    }
    .tin-row--atoken:hover { background: rgba(6,182,212,0.1); }
    .tin-row--atoken .tin-row__asset { color: #67e8f9; }

    /* ── Row: Debt token (borrowed, still owed) ─────────────── */
    .tin-row--debt {
      border-left: 3px solid rgba(239,68,68,0.6);
      background: rgba(239,68,68,0.07);
      color: #fecaca;
    }
    .tin-row--debt:hover { background: rgba(239,68,68,0.13); }
    .tin-row--debt .tin-row__asset { color: #f87171; }

    /* ── Row: Stablecoin in regular wallet ──────────────────── */
    .tin-row--stable {
      border-left: 3px solid rgba(255,255,255,0.35);
      background: rgba(255,255,255,0.06);
      color: #f5f5f5;
    }
    .tin-row--stable:hover { background: rgba(255,255,255,0.1); }
    .tin-row--stable .tin-row__asset { color: #ffffff; }

    /* ── Asset type badges ──────────────────────────────────── */
    .asset-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.09em;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      vertical-align: middle;
    }
    .asset-badge--stable {
      background: rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.7);
      border: 1px solid rgba(255,255,255,0.22);
    }
    .asset-badge--atoken {
      background: rgba(6,182,212,0.18);
      color: #67e8f9;
      border: 1px solid rgba(6,182,212,0.35);
    }
    .asset-badge--debt {
      background: rgba(239,68,68,0.18);
      color: #f87171;
      border: 1px solid rgba(239,68,68,0.35);
    }
    .asset-badge--scam {
      background: rgba(251,191,36,0.18);
      color: #fbbf24;
      border: 1px solid rgba(251,191,36,0.45);
      animation: scam-pulse 2s ease-in-out infinite;
    }
    .asset-badge--verify {
      background: rgba(251,191,36,0.08);
      color: rgba(251,191,36,0.7);
      border: 1px solid rgba(251,191,36,0.2);
    }
    .tin-row--scam {
      border-left: 3px solid rgba(251,191,36,0.6) !important;
    }
    @keyframes scam-pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.55; }
    }

    /* ── Colour tokens ──────────────────────────────────────── */
    .gain-pos { color: #4ade80; }
    .gain-neg { color: #f87171; }
    .term-long  { background: rgba(34,197,94,0.12);  color: #4ade80; }
    .term-short { background: rgba(245,158,11,0.12); color: #fbbf24; }

    /* ── Empty state ────────────────────────────────────────── */
    .tin-empty {
      font-size: 0.9rem;
      opacity: 0.5;
      padding: 1rem 0.5rem;
      margin: 0;
      font-style: italic;
    }

    /* ── NFT sub-section ───────────────────────────────────── */
    .nft-divider {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin: 1.25rem 0 0.5rem;
    }
    .nft-divider__line {
      flex: 1;
      height: 1px;
      background: rgba(255,255,255,0.12);
    }
    .nft-divider__label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.45;
      white-space: nowrap;
    }
    .nft-note {
      font-size: 0.75rem;
      opacity: 0.4;
      font-style: italic;
      margin: 0 0 0.5rem;
      padding: 0 0.25rem;
    }
    .tin-row--nft { border-left: 3px solid rgba(139,92,246,0.5); }

    /* ── NFT Dust / Scam tin ─────────────────────────────────── */
    .dust-tin {
      background: rgba(239,68,68,0.06);
      border: 1px solid rgba(239,68,68,0.25);
      border-radius: 12px;
      overflow: hidden;
    }

    .dust-tin__summary {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.85rem 1.25rem;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    .dust-tin__summary::-webkit-details-marker { display: none; }

    .dust-tin__label {
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #fca5a5;
    }

    .dust-tin__count {
      font-size: 0.75rem;
      color: rgba(252,165,165,0.6);
      margin-right: auto;
    }

    .dust-tin__caret {
      font-size: 0.75rem;
      color: rgba(252,165,165,0.6);
      transition: transform 0.2s;
    }

    .dust-tin[open] .dust-tin__caret { transform: rotate(180deg); }

    .dust-tin__body {
      padding: 0 1.25rem 1.25rem;
    }

    .dust-tin__note {
      margin: 0 0 0.75rem;
      font-size: 0.8rem;
      color: rgba(252,165,165,0.7);
      line-height: 1.5;
    }

    .tin-row--dust {
      opacity: 0.6;
      border-left: 3px solid rgba(239,68,68,0.4);
    }

    .tin-row--dust .tin-row__asset {
      color: #fca5a5;
      font-size: 0.82rem !important;
    }
    .nft-name { font-size: 0.85rem !important; font-weight: 600; }
    .nft-link {
      margin-left: auto;
      font-size: 0.75rem;
      color: rgba(139,92,246,0.85);
      text-decoration: none;
    }
    .nft-link:hover { text-decoration: underline; }

    /* ── "Confirmed held" checkbox ──────────────────────────── */
    .tin-row__confirm {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-left: auto;
      cursor: pointer;
    }
    .confirm-check { accent-color: #3b82f6; cursor: pointer; }
    .confirm-label { font-size: 0.72rem; opacity: 0.45; }
    .tin-row__confirm:has(.confirm-check:checked) .confirm-label {
      opacity: 0.8;
      color: #86efac;
    }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 1080px) {
      .breakdown-grid,
      .year-bar {
        max-width: none;
        margin: 0 1.5rem;
      }
    }
    @media (max-width: 760px) {
      .breakdown-grid { grid-template-columns: 1fr; }
      .grid-cell--full { grid-column: 1; }
      .hero-bleed { height: 45vh; min-height: 320px; }
      .grid-cell { height: 50vh; max-height: none; }
      .grid-cell--full { height: 40vh; max-height: none; }
    }
  </style>

  <script>
    // Persist "confirmed held" checkboxes across page loads via localStorage
    const KEY = 'held-confirmed';
    const stored: Record<string, boolean> = JSON.parse(localStorage.getItem(KEY) ?? '{}');

    document.querySelectorAll<HTMLInputElement>('.confirm-check').forEach((cb) => {
      const id = `${cb.dataset.asset}|${cb.dataset.date}`;
      if (stored[id]) cb.checked = true;
      cb.addEventListener('change', () => {
        if (cb.checked) stored[id] = true;
        else delete stored[id];
        localStorage.setItem(KEY, JSON.stringify(stored));
      });
    });
  </script>

  <script>
    // Open TransactionDrawer when a Needs Attention row is clicked
    document.addEventListener('click', (e: MouseEvent) => {
      const row = (e.target as Element).closest<HTMLElement>('.tin-row--alert');
      if (!row) return;

      const detail = {
        asset: row.dataset.asset ?? '',
        amount: parseFloat(row.dataset.amount ?? '0') || 0,
        sellDate: row.dataset.sellDate ?? '',
        proceedsUsd: row.dataset.proceeds ? parseFloat(row.dataset.proceeds) : null,
        sourceId: row.dataset.sourceId ?? '',
        groupId: row.dataset.groupId ?? '',
        txHash: row.dataset.txHash || null,
        transactionClass: row.dataset.txClass ?? '',
        sourceType: row.dataset.sourceType ?? '',
      };

      window.dispatchEvent(new CustomEvent('open-transaction-drawer', { detail }));
    });
  </script>
</Layout>
