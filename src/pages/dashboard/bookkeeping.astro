---
import Layout from '../../layouts/Layout.astro';
import NetWorthHero from '../../components/dashboard/NetWorthHero.astro';
import SalmonTin from '@/components/dashboard/SalmonTin.astro';
import Tin0AllTransactions from '../../components/dashboard/Tin0AllTransactions.astro';
import Tin2Wallet from '../../components/dashboard/Tin2Wallet.astro';
import OnchainWalletTransactions from '../../components/dashboard/OnchainWalletTransactions.astro';
import AaveHealthSummary from '../../components/dashboard/AaveHealthSummary';
import WalletSummary from '../../components/dashboard/WalletSummary';
import { requireTenantSession } from '../../lib/requireTenantSession';

const pageStart = Date.now();
const { tenantId } = await requireTenantSession(Astro.request);
console.log('[bookkeeping] auth ms', Date.now() - pageStart, 'tenant', tenantId);
console.log('[bookkeeping] total ms', Date.now() - pageStart);
---

<Layout title="Bookkeeping">
	<section class="transactions-tax-layout">
  <!-- LEFT COLUMN: All wallet transactions -->
  <div class="transactions-column">
    <Tin0AllTransactions walletId="fa58b" />
    <OnchainWalletTransactions 
      walletId="fa58b" 
      title="fa58b — All Transactions" 
    />
  </div>

  <!-- RIGHT COLUMN: Tax events by year -->
  <div class="tax-events-column">
    <h2 class="column-title">Tax Events (Past Years)</h2>
    
    <div class="year-group">
      <h3>2025</h3>
      <div class="year-divider"></div>
      <!-- Populate dynamically with your tax events list/table -->
      <div class="tax-events-list">
        <!-- Example placeholder events -->
        <div class="tax-event">Capital gain • ETH sale • $12,450.00</div>
        <div class="tax-event">Staking reward • 0.85 ETH • $2,340.00</div>
        <!-- ... more events ... -->
      </div>
      <a href={`/api/tax-csv?year=2025&walletId=fa58b&tenantId=${tenantId}`} 
         class="csv-download-btn" download>
        📥 Download 2025 Tax Events (CSV)
      </a>
    </div>

    <div class="year-group">
      <h3>2024</h3>
      <div class="year-divider"></div>
      <div class="tax-events-list">
        <!-- events for 2024 -->
      </div>
      <a href={`/api/tax-csv?year=2024&walletId=fa58b&tenantId=${tenantId}`} 
         class="csv-download-btn" download>
        📥 Download 2024 Tax Events (CSV)
      </a>
    </div>

    <!-- Repeat for 2023, 2022, etc. -->
    <!-- You can loop this in Astro if you have the data available -->
  </div>
</section>

	<style>
		.transactions-tax-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: start;
  margin-bottom: 2rem;
}

/* Scrollable columns */
.transactions-column,
.tax-events-column {
  max-height: 65vh;                 /* Adjust 60-70vh based on hero height */
  overflow-y: auto;
  padding: 1.25rem;
  border-radius: 12px;
  background: rgba(47, 65, 59, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.15);
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.3) transparent;
}

/* Left column inset */
.transactions-column {
  margin-left: 3rem;                /* as requested */
  padding-left: 1.5rem;             /* extra breathing room inside */
}

/* Professional scrollbar */
.transactions-column::-webkit-scrollbar,
.tax-events-column::-webkit-scrollbar {
  width: 6px;
}
.transactions-column::-webkit-scrollbar-thumb,
.tax-events-column::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.35);
  border-radius: 20px;
}

/* Tax year styling */
.year-group {
  margin-bottom: 2.5rem;
}
.year-group:last-child {
  margin-bottom: 0;
}
.year-group h3 {
  font-size: 1.25rem;
  margin: 0 0 0.75rem;
  color: #f7f2eb;
  font-weight: 600;
}
.year-divider {
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.3), transparent);
  margin-bottom: 1rem;
}
.tax-events-list {
  margin-bottom: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.tax-event {
  padding: 0.6rem 0.9rem;
  background: rgba(255,255,255,0.05);
  border-radius: 6px;
  font-size: 0.95rem;
}
.column-title {
  font-size: 1.4rem;
  margin-bottom: 1.5rem;
  font-weight: 600;
}
.csv-download-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 1.25rem;
  background: #1e3a2f;
  color: #f7f2eb;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 500;
  transition: background 0.2s;
}
.csv-download-btn:hover {
  background: #2a4a3e;
}

/* Responsive: stack on smaller screens */
@media (max-width: 1080px) {
  .transactions-tax-layout {
    grid-template-columns: 1fr;
  }
  .transactions-column {
    margin-left: 0;                 /* remove extra left margin on mobile */
  }
}
@media (max-width: 720px) {
  .transactions-column,
  .tax-events-column {
    max-height: 55vh;
  }
}

	</style>
</Layout>
