---
import Layout from '../../layouts/Layout.astro';
import NetWorthHero from '../../components/dashboard/NetWorthHero.astro';
import OrnateTin from '@/components/OrnatedTin.astro';

import Tin0AllTransactions from '../../components/dashboard/Tin0AllTransactions.astro';
import { requireTenantSession } from '../../lib/requireTenantSession';
import { buildTaxLotsByYear } from '../../lib/bookkeepingTaxLots';

const pageStart = Date.now();
const { tenantId } = await requireTenantSession(Astro.request);
console.log('[bookkeeping] auth ms', Date.now() - pageStart, 'tenant', tenantId);
console.log('[bookkeeping] total ms', Date.now() - pageStart);

const formatDate = (value: string | null) => {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};

const formatAmount = (value: number) =>
  Number.isFinite(value) ? value.toLocaleString(undefined, { maximumFractionDigits: 6 }) : '—';

const formatUsd = (value: number | null | undefined) =>
  Number.isFinite(Number(value))
    ? `$${Number(value).toLocaleString(undefined, { maximumFractionDigits: 2 })}`
    : '—';

const { taxLotsByYear, taxYears } = await buildTaxLotsByYear(tenantId);

// Fetch per-asset cost basis summary from exchange imports
type CostBasisAsset = {
  symbol: string;
  totalAcquired: number;
  totalCostUsd: number;
  totalDisposed: number;
  totalProceedsUsd: number;
  netQtyHeld: number;
  avgCostPerUnit: number;
  totalCostBasis: number;
  realizedGain: number | null;
  buyCount: number;
  sellCount: number;
  firstBuyDate: string | null;
};

let costBasisAssets: CostBasisAsset[] = [];
try {
  const cbRes = await fetch(new URL('/api/tax/cost-basis', Astro.url), {
    headers: { cookie: Astro.request.headers.get('cookie') ?? '' },
  });
  if (cbRes.ok) {
    const cbData = await cbRes.json();
    costBasisAssets = cbData.assets ?? [];
  }
} catch (e) {
  console.warn('[bookkeeping] cost-basis fetch failed', e);
}

const formatQty = (value: number) =>
  Number.isFinite(value) ? value.toLocaleString(undefined, { maximumFractionDigits: 8 }) : '—';

const formatGain = (value: number | null) => {
  if (value === null || !Number.isFinite(value)) return null;
  const sign = value >= 0 ? '+' : '';
  return `${sign}$${Math.abs(value).toLocaleString(undefined, { maximumFractionDigits: 2 })}`;
};

---

<Layout title="Bookkeeping">
  <section class="bookkeeping-page">
    <div class="hero-bleed">
      <NetWorthHero title="Bookkeeping" subtitle="Transactions and tax lots" />
    </div>

    <section class="two-tins">
      <!-- LEFT: All wallet transactions -->
      <div class="tin-col tin-col--tx">
        <OrnateTin label="All Transactions" class="tin-full">
          <Tin0AllTransactions />
        </OrnateTin>
      </div>

      <!-- RIGHT: Tax events by year -->
      <div class="tin-col tin-col--recap">
        <OrnateTin label="Annual Recap" class="tin-full">
          <div class="tax-head">
            <h2 class="column-title">Annual Recap</h2>
          </div>

          {taxYears.length === 0 ? (
            <p class="tax-empty">No tax lots available yet.</p>
          ) : (
            taxYears.map((year) => (
              <div class="year-group">
                <h3 class="year-header">
                  <span class="year-label">{year}</span>
                  <a
                    href={`/api/tax-csv?year=${year}&walletId=fa58b&tenantId=${tenantId}`}
                    class="csv-download-btn csv-download-inline"
                    download
                  >
                    Export CSV
                  </a>
                </h3>

                <div class="year-divider"></div>

                <div class="tax-events-list">
                  {taxLotsByYear[year].map((lot) => (
                    <div class="tax-event">
                      <strong>{lot.asset}</strong> • Buy {formatDate(lot.buyDate)} • Sell{' '}
                      {formatDate(lot.sellDate)} • Qty {formatAmount(lot.amount)}
                      {lot.buyUsd || lot.sellUsd ? (
                        <span class="tax-event__sub">
                          Cost {formatUsd(lot.buyUsd)} • Proceeds {formatUsd(lot.sellUsd)}
                        </span>
                      ) : null}
                    </div>
                  ))}
                </div>
              </div>
            ))
          )}
        </OrnateTin>
      </div>
    </section>

    <!-- COST BASIS SUMMARY -->
    <section class="cost-basis-section">
      <OrnateTin label="Cost Basis Summary" class="cost-basis-tin">
        <div class="cb-header">
          <h2 class="column-title">Cost Basis Summary</h2>
          <p class="cb-note">Weighted-average cost method &bull; Exchange CSV imports only</p>
        </div>

        {costBasisAssets.length === 0 ? (
          <p class="cb-empty">No cost basis data yet. Import exchange CSVs to populate this table.</p>
        ) : (
          <div class="cb-table-wrap">
            <table class="cb-table">
              <thead>
                <tr>
                  <th>Asset</th>
                  <th class="num">Qty Held</th>
                  <th class="num">Avg Cost/Unit</th>
                  <th class="num">Total Cost Basis</th>
                  <th class="num">Total Proceeds</th>
                  <th class="num">Realized Gain/Loss</th>
                  <th class="num">First Purchase</th>
                </tr>
              </thead>
              <tbody>
                {costBasisAssets.map((a) => {
                  const gainStr = formatGain(a.realizedGain);
                  const gainClass = a.realizedGain === null ? '' : a.realizedGain >= 0 ? 'gain-pos' : 'gain-neg';
                  return (
                    <tr>
                      <td class="asset-symbol">{a.symbol}</td>
                      <td class="num">{formatQty(a.netQtyHeld)}</td>
                      <td class="num">{formatUsd(a.avgCostPerUnit)}</td>
                      <td class="num">{formatUsd(a.totalCostBasis)}</td>
                      <td class="num">{a.sellCount > 0 ? formatUsd(a.totalProceedsUsd) : '—'}</td>
                      <td class={`num ${gainClass}`}>{gainStr ?? '—'}</td>
                      <td class="num date-col">{formatDate(a.firstBuyDate)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </OrnateTin>
    </section>
  </section>

  <style>
    .bookkeeping-page {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 1rem 0 2rem;
    }

    .hero-bleed {
      height: 60vh;
      min-height: 420px;
      width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
      padding: 0;
      max-width: none;
      display: flex;
      align-items: stretch;
    }

    .hero-bleed :global(.hero) {
      width: 100%;
    }

    /* === Two equal tins, identical height === */
    .two-tins {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: stretch;
      width: 100%;
      max-width: calc(100% - 6rem);
      margin: 0 auto 2rem;
    }

    .tin-col {
      height: 72vh;
      max-height: 72vh;
      min-width: 0;

      /* Critical: allow the child tin to become the scroll container */
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .two-tins > .tin-col {
      min-height: 0;
    }

    /* Make the tin fill the column */
    .tin-full {
      height: 100%;
      min-height: 0;
    }

    /* LEFT COLUMN: single unified scroll container */
    .tin-col--tx :global(.ornate-tin__body) {
      overflow-y: auto !important;
      overflow-x: hidden !important;
    }

    /* Let Tin0 expand normally inside the scroll container */
    .tin-col--tx :global(.tin0-all),
    .tin-col--tx :global(.tin0-all__inner) {
      height: auto !important;
      min-height: 0 !important;
      overflow: visible !important;
    }

    /* Disable nested scrolling regions */
    .tin-col--tx :global(.tin0-all__lifecycles),
    .tin-col--tx :global(.tin0-all__list) {
      max-height: none !important;
      height: auto !important;
      overflow: visible !important;
    }

    /* === Right tin content styling === */
    .tax-head {
      padding-bottom: 0.75rem;
    }

    .column-title {
      font-size: 1.35rem;
      margin: 0 0 0.75rem;
      font-weight: 650;
    }

    /* Right column: center Annual Recap labels and keep them fixed */
    .tin-col--recap :global(.ornate-tin__label) {
      left: 50% !important;
      transform: translateX(-50%);
      text-align: center;
      z-index: 1;
    }

    .tin-col--recap .tax-head {
      position: sticky;
      top: 0;
      z-index: 1;
      text-align: center;
      background: darkslategray;
      padding-top: 0.35rem;
    }

    .year-group {
      margin-bottom: 2.5rem;
    }
    .year-group:last-child {
      margin-bottom: 0;
    }

    .year-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin: 0 0 0.75rem;
    }

    .year-label {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.15rem;
      font-weight: 650;
    }

    .year-divider {
      height: 1px;
      background: linear-gradient(
        to right,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
      );
      margin-bottom: 1rem;
    }

    .tax-events-list {
      margin-bottom: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .tax-event {
      padding: 0.6rem 0.9rem;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      font-size: 0.95rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .tax-event__sub {
      font-size: 0.85rem;
      opacity: 0.8;
    }

    .tax-empty {
      font-size: 0.95rem;
      opacity: 0.75;
      margin: 0;
    }

    .csv-download-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      background: #1e3a2f;
      color: #f7f2eb;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      transition: background 0.2s;
    }

    .csv-download-btn:hover {
      background: #2a4a3e;
    }

    .csv-download-inline {
      padding: 0.45rem 0.9rem;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* Responsive */
    @media (max-width: 1080px) {
      .two-tins {
        grid-template-columns: 1fr;
        margin: 0 1.5rem 2rem;
      }
    }

    @media (max-width: 720px) {
      .hero-bleed {
        height: 45vh;
        min-height: 320px;
      }
      .tin-col {
        height: 62vh;
        max-height: 62vh;
      }
    }

    /* === Cost Basis Summary section === */
    .cost-basis-section {
      width: 100%;
      max-width: calc(100% - 6rem);
      margin: 0 auto 3rem;
    }

    .cost-basis-tin {
      width: 100%;
    }

    .cb-header {
      display: flex;
      align-items: baseline;
      gap: 1.25rem;
      flex-wrap: wrap;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      margin-bottom: 1rem;
    }

    .cb-note {
      font-size: 0.8rem;
      opacity: 0.55;
      margin: 0;
      letter-spacing: 0.03em;
    }

    .cb-empty {
      font-size: 0.95rem;
      opacity: 0.65;
      margin: 0;
      padding: 1rem 0;
    }

    .cb-table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .cb-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    .cb-table th {
      text-align: left;
      font-weight: 600;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.6;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      white-space: nowrap;
    }

    .cb-table td {
      padding: 0.6rem 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      white-space: nowrap;
    }

    .cb-table tr:last-child td {
      border-bottom: none;
    }

    .cb-table tr:hover td {
      background: rgba(255, 255, 255, 0.03);
    }

    .cb-table .num {
      text-align: right;
    }

    .cb-table .asset-symbol {
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.04em;
    }

    .cb-table .date-col {
      opacity: 0.7;
      font-size: 0.85rem;
    }

    .gain-pos {
      color: #4ade80;
      font-weight: 600;
    }

    .gain-neg {
      color: #f87171;
      font-weight: 600;
    }

    @media (max-width: 1080px) {
      .cost-basis-section {
        margin: 0 1.5rem 2rem;
        max-width: none;
      }
    }
  </style>
</Layout>
