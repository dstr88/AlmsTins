---
import Layout from '../../layouts/Layout.astro';
import NetWorthHero from '../../components/dashboard/NetWorthHero.astro';
import OrnateTin from '@/components/OrnatedTin.astro';

import Tin0AllTransactions from '../../components/dashboard/Tin0AllTransactions.astro';
import Tin2Wallet from '../../components/dashboard/Tin2Wallet.astro';
import OnchainWalletTransactions from '../../components/dashboard/OnchainWalletTransactions.astro';
import AaveHealthSummary from '../../components/dashboard/AaveHealthSummary';
import WalletSummary from '../../components/dashboard/WalletSummary';
import { requireTenantSession } from '../../lib/requireTenantSession';
import { buildTaxLotsByYear } from '../../lib/bookkeepingTaxLots';

---

<Layout title="Bookkeeping">
  <section class="bookkeeping-page">
    <div class="hero-bleed">
      <NetWorthHero title="Bookkeeping" subtitle="Transactions and tax lots" />
    </div>

    <section class="two-tins">
      <!-- LEFT: All wallet transactions -->
      <div class="tin-col">
        <OrnateTin label="All Transactions" class="tin-full">
          <Tin0AllTransactions />
        </OrnateTin>
      </div>

      <!-- RIGHT: Tax events by year -->
      <div class="tin-col">
        <OrnateTin label="Tax Events" class="tin-full">
          <div class="tax-head">
            <h2 class="column-title">Tax Events by Year</h2>
          </div>

          {taxYears.length === 0 ? (
            <p class="tax-empty">No tax lots available yet.</p>
          ) : (
            taxYears.map((year) => (
              <div class="year-group">
                <h3 class="year-header">
                  <span class="year-label">{year}</span>
                  <a
                    href={`/api/tax-csv?year=${year}&walletId=fa58b&tenantId=${tenantId}`}
                    class="csv-download-btn csv-download-inline"
                    download
                  >
                    Export CSV
                  </a>
                </h3>

                <div class="year-divider"></div>

                <div class="tax-events-list">
                  {taxLotsByYear[year].map((lot) => (
                    <div class="tax-event">
                      <strong>{lot.asset}</strong> • Buy {formatDate(lot.buyDate)} • Sell{' '}
                      {formatDate(lot.sellDate)} • Qty {formatAmount(lot.amount)}
                      {lot.buyUsd || lot.sellUsd ? (
                        <span class="tax-event__sub">
                          Cost {formatUsd(lot.buyUsd)} • Proceeds {formatUsd(lot.sellUsd)}
                        </span>
                      ) : null}
                    </div>
                  ))}
                </div>
              </div>
            ))
          )}
        </OrnateTin>
      </div>
    </section>
  </section>

  <style>
    .bookkeeping-page {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 1rem 0 2rem;
    }

    .hero-bleed {
      height: 60vh;
      min-height: 420px;
      width: 100vw;
      margin-left: 50%;
      transform: translateX(-50%);
      padding: 0;
      max-width: none;
      display: flex;
      align-items: stretch;
    }

    .hero-bleed :global(.hero) {
      width: 100%;
    }

    /* === Two equal tins, identical height === */
    .two-tins {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: stretch;
      width: 100%;
      max-width: calc(100% - 6rem);
      margin: 0 auto 2rem;
    }

    .tin-col {
      height: 72vh;
      max-height: 72vh;
      min-width: 0;

      /* Critical: allow the child tin to become the scroll container */
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    /* Make the tin fill the column */
    .tin-full {
      height: 100%;
      min-height: 0;
    }

    /* === Left tin: ensure your Tin0AllTransactions can scroll internally ===
       The OrnateTin scrolls its body; don't block it with "overflow: hidden" wrappers. */
    .tin-col :global(.tin0-all) {
      min-height: 0;
      height: 100%;
      border: none;
      background: transparent;
      padding: 0.5rem;
      box-shadow: none;
    }

    /* If tin0-all has its own list area, let it size naturally inside the scroll container */
    .tin-col :global(.tin0-all__list) {
      min-height: 0;
      max-height: none;
    }

    /* === Right tin content styling === */
    .tax-head {
      padding-bottom: 0.75rem;
    }

    .column-title {
      font-size: 1.35rem;
      margin: 0 0 0.75rem;
      font-weight: 650;
    }

    .year-group {
      margin-bottom: 2.5rem;
    }
    .year-group:last-child {
      margin-bottom: 0;
    }

    .year-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin: 0 0 0.75rem;
    }

    .year-label {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.15rem;
      font-weight: 650;
    }

    .year-divider {
      height: 1px;
      background: linear-gradient(
        to right,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
      );
      margin-bottom: 1rem;
    }

    .tax-events-list {
      margin-bottom: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .tax-event {
      padding: 0.6rem 0.9rem;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      font-size: 0.95rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .tax-event__sub {
      font-size: 0.85rem;
      opacity: 0.8;
    }

    .tax-empty {
      font-size: 0.95rem;
      opacity: 0.75;
      margin: 0;
    }

    .csv-download-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      background: #1e3a2f;
      color: #f7f2eb;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      transition: background 0.2s;
    }

    .csv-download-btn:hover {
      background: #2a4a3e;
    }

    .csv-download-inline {
      padding: 0.45rem 0.9rem;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* Responsive */
    @media (max-width: 1080px) {
      .two-tins {
        grid-template-columns: 1fr;
        margin: 0 1.5rem 2rem;
      }
    }

    @media (max-width: 720px) {
      .hero-bleed {
        height: 45vh;
        min-height: 320px;
      }
      .tin-col {
        height: 62vh;
        max-height: 62vh;
      }
    }
  </style>
</Layout>
