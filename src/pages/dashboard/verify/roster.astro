---
import Layout from '../../../layouts/Layout.astro';
import RosterEditor from '../../../components/verify/RosterEditor';
import { requireTenantSession } from '@/lib/requireTenantSession';
import { getLang } from '@/lib/i18n/locale';
import { getVerifyRoster } from '@/i18n/dashboard/verifyRoster';

const session = await requireTenantSession(Astro.request);
if (!session) return Astro.redirect('/verify');

const lang = getLang(Astro.request);
const t = getVerifyRoster(lang);
---

<Layout title={t.pageTitle} noindex={true} logoutRedirect="/verify">
  <div class="dash-page">
    <header class="rp-topbar">
      <span class="rp-topbar__brand">{t.brandLabel}</span>
      <a class="rp-topbar__back" href="/dashboard/verify">{t.backLink}</a>
    </header>

    <div class="rp-page">
      <section class="rp-hero">
        <p class="rp-hero__kicker">{t.heroKicker}</p>
        <h1 class="rp-hero__title">{t.heroTitle}</h1>
      </section>
    </div>

    <div class="rp-tiles">
      <RosterEditor client:load t={t} />

      <section class="rp-how rp-tile">
        <h2 class="rp-how__title">{t.howItWorksTitle}</h2>
        <ul class="rp-how__list">
          {t.howItWorksItems.map((item, i) => (
            <li class="rp-how__item">
              <span class="rp-how__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="rp-how__item-title">{item.title}</p>
                <p class="rp-how__item-desc">{item.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>

<style>
  .rp-topbar {
    display: flex; align-items: center; justify-content: space-between;
    height: 56px; max-width: 36rem; margin: 0 auto; padding: 0 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .rp-topbar__brand {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--text-muted);
  }
  .rp-topbar__back {
    font-size: 0.82rem; font-weight: 600; color: var(--text-muted); text-decoration: none;
    transition: color 0.15s;
  }
  .rp-topbar__back:hover { color: var(--accent); }

  .rp-page { max-width: 36rem; margin: 0 auto; padding: 3.5rem 1.25rem 0; }

  .rp-hero { text-align: center; }
  .rp-hero__kicker {
    margin: 0; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent);
  }
  .rp-hero__title {
    margin: 0.6rem 0 0; font-weight: 800; letter-spacing: -0.01em; line-height: 1.25;
    font-size: clamp(1.6rem, 2vw + 1.2rem, 2.1rem); color: var(--text-primary);
  }

  /* Two tiles: one column (stacked) up to 800px, side by side above it — same
     breakpoint the /verify landing page's own tile grid switches at. */
  .rp-tiles {
    max-width: 52rem; margin: 0 auto; padding: 3rem 1.25rem 4rem;
    display: grid; grid-template-columns: 1fr; align-items: start; gap: 1.5rem;
  }
  @media (min-width: 800px) {
    .rp-tiles { grid-template-columns: 1fr 1fr; }
  }

  .rp-tile {
    background: var(--surface-card); border: 1px solid var(--border-subtle);
    border-radius: 16px; padding: 1.5rem;
  }
  .rp-how__title {
    margin: 0 0 1.25rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--text-muted);
    padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle);
  }
  .rp-how__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .rp-how__item { display: flex; gap: 0.9rem; align-items: flex-start; }
  .rp-how__num {
    flex: 0 0 auto; width: 1.9rem; height: 1.9rem; border-radius: 50%;
    border: 1px solid var(--border-bright); background: var(--surface-card);
    color: var(--accent); font-size: 0.72rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .rp-how__item-title { margin: 0; font-size: 0.88rem; font-weight: 700; color: var(--text-primary); }
  .rp-how__item-desc { margin: 0.3rem 0 0; font-size: 0.8rem; line-height: 1.6; color: var(--text-muted); }
</style>
