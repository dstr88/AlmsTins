---
import Layout from '../../../layouts/Layout.astro';
import { isDemoRequest } from '../../../lib/demo';
import { requireTenantSession } from '../../../lib/requireTenantSession';
import { buildAnnualBreakdown } from '../../../lib/annualBreakdown';
import { db } from '../../../lib/db';
import { getTickersUSD } from '../../../lib/coinpaprikaProvider';
import './memory-lane.css';

const isDemo      = isDemoRequest(Astro.request);
const defaultYear = new Date().getFullYear() - 1;
const yearParam   = Astro.url.searchParams.get('year');
const year        = yearParam ? Number(yearParam) : defaultYear;

// ── Auth ───────────────────────────────────────────────────────────────────────
const session = await requireTenantSession(Astro.request).catch(() => null);
if (!session) return Astro.redirect('/login', 302);
const { tenantId } = session;

let fetchError: string | null = null;
let byAssetGains: any[]                 = [];
let lotDetails:   Record<string, any[]> = {};
let harvestLosses: any[]                = [];
let availableYears: number[]            = [defaultYear];

try {
	// ── Available years ──────────────────────────────────────────────────────
	const yearsRes = await db.execute({
		sql: `SELECT DISTINCT strftime('%Y', timestamp_utc) AS y
		      FROM asset_lifecycle_events
		      WHERE tenant_id = ?
		      ORDER BY y DESC`,
		args: [tenantId],
	});
	availableYears = yearsRes.rows
		.map((r: any) => Number(r.y))
		.filter((y: number) => y >= 2009 && y <= 2100);

	// ── FIFO breakdown ────────────────────────────────────────────────────────
	const bd = await buildAnnualBreakdown(tenantId, year, 'fifo', undefined, 'auto');

	// ── Per-asset gains (step 6) ──────────────────────────────────────────────
	type AssetRow = { asset: string; stGain: number; stLots: number; ltGain: number; ltLots: number; netGain: number };
	const assetMap = new Map<string, AssetRow>();
	const getRow = (asset: string): AssetRow => {
		if (!assetMap.has(asset)) assetMap.set(asset, { asset, stGain: 0, stLots: 0, ltGain: 0, ltLots: 0, netGain: 0 });
		return assetMap.get(asset)!;
	};
	for (const lot of bd.shortTerm) { const r = getRow(lot.asset); r.stGain += lot.gainLossUsd ?? 0; r.stLots++; }
	for (const lot of bd.longTerm)  { const r = getRow(lot.asset); r.ltGain += lot.gainLossUsd ?? 0; r.ltLots++; }
	byAssetGains = Array.from(assetMap.values())
		.map((r) => ({ ...r, netGain: r.stGain + r.ltGain }))
		.sort((a, b) => Math.abs(b.netGain) - Math.abs(a.netGain));

	// ── Per-lot detail (step 6b) ──────────────────────────────────────────────
	for (const lot of bd.shortTerm) (lotDetails[lot.asset] ??= []).push({ ...lot, term: 'short' });
	for (const lot of bd.longTerm)  (lotDetails[lot.asset] ??= []).push({ ...lot, term: 'long'  });
	for (const lots of Object.values(lotDetails)) lots.sort((a: any, b: any) => a.sellDate.localeCompare(b.sellDate));

	// ── Tax-loss harvesting (step 7) ──────────────────────────────────────────
	type HarvestRow = {
		asset: string; totalQty: number; totalCost: number;
		currentPrice: number | null; currentValue: number | null; unrealizedGainLoss: number | null;
		shortTermQty: number; longTermQty: number; soonestLotDaysToLT: number | null;
	};
	const harvestMap = new Map<string, HarvestRow>();
	for (const lot of bd.stillHolding) {
		if (!harvestMap.has(lot.asset)) {
			harvestMap.set(lot.asset, {
				asset: lot.asset, totalQty: 0, totalCost: 0,
				currentPrice: null, currentValue: null, unrealizedGainLoss: null,
				shortTermQty: 0, longTermQty: 0, soonestLotDaysToLT: null,
			});
		}
		const row = harvestMap.get(lot.asset)!;
		row.totalQty  += lot.amount;
		row.totalCost += lot.costUsd ?? 0;
		if (lot.daysHeld >= 365) {
			row.longTermQty += lot.amount;
		} else {
			row.shortTermQty += lot.amount;
			const daysLeft = 365 - lot.daysHeld;
			if (row.soonestLotDaysToLT === null || daysLeft < row.soonestLotDaysToLT) row.soonestLotDaysToLT = daysLeft;
		}
	}
	try {
		const heldAssets = Array.from(harvestMap.keys());
		if (heldAssets.length > 0) {
			const tickers = await getTickersUSD() as Array<{ symbol?: string; quotes?: { USD?: { price?: number } } }>;
			const priceMap = new Map<string, number>();
			for (const t of tickers) {
				const sym = String(t.symbol ?? '').toUpperCase();
				const price = t.quotes?.USD?.price;
				if (sym && typeof price === 'number' && price > 0) priceMap.set(sym, price);
			}
			for (const row of harvestMap.values()) {
				const price = priceMap.get(row.asset) ?? null;
				row.currentPrice = price;
				if (price !== null) { row.currentValue = price * row.totalQty; row.unrealizedGainLoss = row.currentValue - row.totalCost; }
			}
		}
		harvestLosses = Array.from(harvestMap.values())
			.sort((a, b) => {
				const aGl = a.unrealizedGainLoss ?? Infinity;
				const bGl = b.unrealizedGainLoss ?? Infinity;
				return aGl - bGl;
			});
	} catch (e) {
		console.warn('[memory-lane] harvest price fetch failed', e);
	}
} catch (err: any) {
	fetchError = String(err?.message ?? err);
	console.error('[memory-lane] data load failed:', err);
}

const data = { ok: !fetchError };

// ── Coin classification ────────────────────────────────────────────────────────
type CoinType = 'L1' | 'DeFi' | 'Wrapped' | 'Stable' | 'Other';
function classifyCoin(symbol: string): CoinType {
	const s = symbol.toUpperCase().split('.')[0];
	const L1s     = new Set(['BTC','ETH','SOL','AVAX','SUI','LTC','MATIC','BNB','ADA','DOT','ATOM','NEAR','FTM','ALGO','RSK','RBTC','ONE','HBAR','APT']);
	const wrapped = new Set(['WBTC','WETH','WAVAX','WRBTC','WMATIC','WBNB','WSOL','SAVAX']);
	const stables = new Set(['USDC','USDT','DAI','BUSD','XUSD','DLLR','ZUSD','RUSDT','TUSD','FRAX','LUSD','USDD','GUSD','USDP']);
	const defi    = new Set(['AAVE','UNI','COMP','SOV','MOC','FISH','BPRO','RIF','CRV','MKR','SNX','YFI','SUSHI','PYTH','GMX','GNS','LINK','GRT']);
	if (wrapped.has(s)) return 'Wrapped';
	if (L1s.has(s))     return 'L1';
	if (stables.has(s)) return 'Stable';
	if (defi.has(s))    return 'DeFi';
	return 'Other';
}

// ── Grade from gain % ──────────────────────────────────────────────────────────
function getGrade(gainPct: number | null): { grade: string; cls: string } {
	if (gainPct === null) return { grade: '?',  cls: 'grade-unknown'    };
	if (gainPct >  100)   return { grade: 'A+', cls: 'grade-aplus'      };
	if (gainPct >   50)   return { grade: 'A',  cls: 'grade-a'          };
	if (gainPct >   20)   return { grade: 'B',  cls: 'grade-b'          };
	if (gainPct >    0)   return { grade: 'C+', cls: 'grade-c'          };
	if (gainPct >  -20)   return { grade: 'D',  cls: 'grade-d'          };
	return                       { grade: 'F',  cls: 'grade-f'          };
}

// ── Rarity tier ────────────────────────────────────────────────────────────────
function getRarity(plAbs: number, isLongTerm: boolean, isGraduatedWin: boolean): string {
	if (plAbs > 100000 || isGraduatedWin) return 'legendary';
	if (plAbs > 10000)                    return 'epic';
	if (isLongTerm || plAbs > 1000)       return 'rare';
	return 'common';
}

// ── Per-asset lot stats ────────────────────────────────────────────────────────
function getLotStats(asset: string) {
	const lots = lotDetails[asset] ?? [];
	let cost = 0, proceeds = 0, lastSell = '', firstBuy = '';
	for (const lot of lots) {
		cost     += lot.costUsd     ?? 0;
		proceeds += lot.proceedsUsd ?? 0;
		if (!lastSell || lot.sellDate > lastSell) lastSell = lot.sellDate;
		if (!firstBuy  || lot.buyDate  < firstBuy) firstBuy = lot.buyDate;
	}
	const gainPct = cost > 0 ? ((proceeds - cost) / cost) * 100 : null;
	return { cost, proceeds, lastSell, firstBuy, gainPct, lotCount: lots.length };
}

// ── Graduated vs Active Roster ─────────────────────────────────────────────────
const heldSet      = new Set(harvestLosses.map((h: any) => h.asset));
const graduated    = byAssetGains.filter((a: any) => !heldSet.has(a.asset));
const enrolled     = harvestLosses;
const gainsByAsset = new Map(byAssetGains.map((a: any) => [a.asset, a]));

// ── Group by coin type ─────────────────────────────────────────────────────────
function groupByType<T>(arr: T[], key: (item: T) => string): Record<CoinType, T[]> {
	const out: Record<string, T[]> = { L1: [], DeFi: [], Wrapped: [], Stable: [], Other: [] };
	for (const item of arr) {
		out[classifyCoin(key(item))].push(item);
	}
	return out as Record<CoinType, T[]>;
}
const gradGroups   = groupByType(graduated, (a: any) => a.asset);
const enrollGroups = groupByType(enrolled,  (h: any) => h.asset);

const TYPE_ORDER: CoinType[] = ['L1', 'DeFi', 'Wrapped', 'Stable', 'Other'];
const TYPE_META: Record<CoinType, { label: string; icon: string }> = {
	L1:      { label: 'Heavyweights', icon: '🛡️' },
	DeFi:    { label: 'Wildcards',    icon: '⚡' },
	Wrapped: { label: 'Wrapped',      icon: '🎁' },
	Stable:  { label: 'Stablecoins', icon: '🏛️' },
	Other:   { label: 'Wildcards',   icon: '🎲' },
};

// ── Totals ─────────────────────────────────────────────────────────────────────
const totalGradGain = graduated.reduce((s: number, a: any) => s + a.netGain, 0);

// ── Formatters ─────────────────────────────────────────────────────────────────
function fmt(n: number) {
	return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
}
function fmtDate(d: string) {
	if (!d) return '—';
	try {
		const iso = d.length > 10 && d.includes('T') ? d : d.slice(0, 10) + 'T12:00:00Z';
		return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
	}
	catch { return d.slice(0, 10); }
}
function fmtQty(n: number) {
	return n.toLocaleString('en-US', { maximumFractionDigits: 8 });
}
function logoUrl(symbol: string) {
	return `https://cdn.jsdelivr.net/gh/spothq/cryptocurrency-icons@master/svg/color/${symbol.toLowerCase().split('.')[0]}.svg`;
}
function timelineId(asset: string) {
	return `tl-${asset.replace(/[^a-z0-9]/gi, '_')}`;
}
---

<Layout title={`History ${year} | almsTins`} noindex={true}>
<div class="memory-lane">

	<!-- ── Back link ─────────────────────────────────────────────────────── -->
	<a href="/dashboard/vault" class="memory-lane__back">← Dashboard</a>

	{fetchError && !isDemo && (
		<div class="memory-lane__error">
			<strong>⚠️ Could not load History</strong>
			<p>{fetchError}</p>
			<a href={`?year=${year}`}>Try again</a>
		</div>
	)}

	{/* ── Demo sticky note ────────────────────────────────────────────── */}
	{isDemo && (
		<div style="
			background: rgba(45,212,168,0.08);
			border: 1px solid rgba(45,212,168,0.22);
			border-left: 4px solid var(--accent);
			border-radius: 0 8px 8px 0;
			padding: 1rem 1.4rem;
			margin-bottom: 1.5rem;
			display: flex;
			gap: 0.75rem;
			align-items: flex-start;
		">
			<span style="font-size:1.15rem; line-height:1.4;">📌</span>
			<p style="margin:0; font-size:0.85rem; color:var(--text-secondary); line-height:1.6;">
				<strong style="color:var(--accent);">A walk down memory lane.</strong>
				Lest you forget those coins you paid for your education with — the meme coins bought at the top,
				the launches that didn't launch, the pumps you held all the way back down.
				Every card below is real history. Grade F never looked so educational.
			</p>
		</div>
	)}


	<!-- ── Hero ──────────────────────────────────────────────────────────── -->
	<header class="memory-lane__hero">
		<div class="memory-lane__hero-cap">🃏</div>
		<h1 class="memory-lane__hero-title">History</h1>
		<p class="memory-lane__hero-sub">Every asset you've held — and the full transaction history behind each one.</p>

		<p class="memory-lane__season-label">Select Season</p>
		<div class="memory-lane__season-chips">
			{availableYears.map((y) => (
				<a href={`?year=${y}`} class={`season-chip${y === year ? ' season-chip--active' : ''}`}>{y}</a>
			))}
		</div>
	</header>

	<!-- ── Player stats panel ────────────────────────────────────────────── -->
	{(graduated.length > 0 || enrolled.length > 0) && (
		<div class="player-stats">
			<div class="player-stats__item">
				<span class="player-stats__num">{graduated.length}</span>
				<span class="player-stats__label">Retired</span>
			</div>
			<div class="player-stats__item">
				<span class={`player-stats__num ${totalGradGain >= 0 ? 'player-stats__num--gain' : 'player-stats__num--loss'}`}>
					{fmt(totalGradGain)}
				</span>
				<span class="player-stats__label">Score</span>
			</div>
			<div class="player-stats__item">
				<span class="player-stats__num player-stats__num--active">{enrolled.length}</span>
				<span class="player-stats__label">In Play</span>
			</div>
		</div>
	)}

	<!-- ══════════════════════════════════════════════════════════════════════
	     HALL OF FAME — retired cards
	══════════════════════════════════════════════════════════════════════ -->
	{graduated.length > 0 && (
		<section class="memory-lane__section">
			<div class="section-header section-header--hall-of-fame">
				<span class="section-header__icon">🏆</span>
				<div>
					<h2 class="section-header__title">Hall of Fame</h2>
					<p class="section-header__subtitle">Cards retired from the roster</p>
				</div>
				<span class="section-header__count">{graduated.length} card{graduated.length !== 1 ? 's' : ''}</span>
			</div>

			{TYPE_ORDER.map((type) => {
				const group = gradGroups[type];
				if (!group?.length) return null;
				const meta = TYPE_META[type];
				return (
					<div class="type-group">
						<div class="type-group__label">
							<span>{meta.icon}</span>
							<span>{meta.label}</span>
						</div>
						<div class="card-grid">
							{group.map((asset: any) => {
								const stats  = getLotStats(asset.asset);
								const grade  = getGrade(stats.gainPct);
								const lots   = lotDetails[asset.asset] ?? [];
								const isWin  = asset.netGain >= 0;
								const rarity = getRarity(Math.abs(asset.netGain), asset.ltLots > 0, isWin);
								return (
									<div class={`token-card token-card--retired ${isWin ? 'token-card--win' : 'token-card--loss'}`}
									     data-rarity={rarity}
									     data-asset={asset.asset}>
										<div class="token-card__inner">

											<!-- Header: logo · ticker · grade -->
											<div class="token-card__header">
												<div class="token-card__logo-wrap">
													<img class="token-card__coin-logo"
													     src={logoUrl(asset.asset)}
													     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
													     alt={asset.asset} />
													<div class="token-card__coin-fallback" style="display:none">{asset.asset.slice(0, 3)}</div>
												</div>
												<div class="token-card__identity">
													<span class="token-card__ticker">{asset.asset}</span>
													{rarity !== 'common' && (
														<span class={`token-card__rarity-badge token-card__rarity-badge--${rarity}`}>
															{rarity}
														</span>
													)}
												</div>
												<div class={`grade ${grade.cls}`} title={`Final grade: ${grade.grade}`}>
													{grade.grade}
												</div>
											</div>

											<!-- Status chip -->
											<span class={`token-card__status-chip token-card__status-chip--${isWin ? 'win' : 'loss'}`}>
												🏆 Retired
											</span>

											<!-- P&L -->
											<div class="token-card__pnl">
												<span class={`token-card__pnl-num token-card__pnl-num--${isWin ? 'gain' : 'loss'}`}>
													{isWin ? '+' : ''}{fmt(asset.netGain)}
												</span>
												{stats.gainPct !== null && (
													<span class={`token-card__pnl-pct token-card__pnl-pct--${isWin ? 'gain' : 'loss'}`}>
														{isWin ? '+' : ''}{stats.gainPct.toFixed(1)}%
													</span>
												)}
											</div>

											<!-- KDA stat strip -->
											<div class="token-card__stats">
												{lots.length > 0 && (
													<div class="token-card__stats-item">
														<span class="token-card__stats-key">Lots</span>
														<span class="token-card__stats-val">{lots.length}</span>
													</div>
												)}
												{asset.stLots > 0 && (
													<div class="token-card__stats-item">
														<span class="token-card__stats-key">Short-Term</span>
														<span class="token-card__stats-val st-tag">{asset.stLots}</span>
													</div>
												)}
												{asset.ltLots > 0 && (
													<div class="token-card__stats-item">
														<span class="token-card__stats-key">Long-Term</span>
														<span class="token-card__stats-val lt-tag">{asset.ltLots}</span>
													</div>
												)}
												{stats.lastSell && (
													<div class="token-card__stats-item">
														<span class="token-card__stats-key">Closed</span>
														<span class="token-card__stats-val">{fmtDate(stats.lastSell)}</span>
													</div>
												)}
											</div>

											<!-- CTA button -->
											{lots.length > 0 && (
												<button class="token-card__cta" data-asset={asset.asset}>
													View Transcript <span class="token-card__cta-chevron">▾</span>
												</button>
											)}
										</div>

										<!-- Expanded timeline -->
										{lots.length > 0 && (
											<div class="token-card__timeline" id={timelineId(asset.asset)} hidden>
												<div class="timeline__header">
													{asset.asset} · Full Trading History · {lots.length} disposal{lots.length !== 1 ? 's' : ''}
												</div>
												<div class="timeline__track">
													{lots.map((lot: any) => {
														const gain = lot.gainLossUsd ?? 0;
														const isLotWin = gain >= 0;
														return (
															<div class="tl-pair">
																<!-- BUY node -->
																<div class="tl-node">
																	<div class="tl-dot tl-dot--buy"></div>
																	<div class="tl-content">
																		<span class="tl-action buy">BUY</span>
																		<span class="tl-date">{fmtDate(lot.buyDate)}</span>
																		<span class="tl-qty">{fmtQty(lot.amount)} {asset.asset}</span>
																		<span class="tl-usd">{lot.costUsd != null ? fmt(lot.costUsd) : '—'}</span>
																	</div>
																</div>
																<!-- Connector -->
																<div class="tl-connector">
																	<div class="tl-line"></div>
																	<span class="tl-held">
																		{lot.daysHeld}d held ·
																		<span class={lot.term === 'long' ? 'lt-badge' : 'st-badge'}>
																			{lot.term === 'long' ? 'Long-term' : 'Short-term'}
																		</span>
																	</span>
																</div>
																<!-- SELL node -->
																<div class="tl-node">
																	<div class={`tl-dot tl-dot--sell ${isLotWin ? 'win' : 'loss'}`}></div>
																	<div class="tl-content">
																		<span class="tl-action sell">SELL</span>
																		<span class="tl-date">{fmtDate(lot.sellDate)}</span>
																		<span class="tl-qty">{fmtQty(lot.amount)} {asset.asset}</span>
																		<span class="tl-usd">{lot.proceedsUsd != null ? fmt(lot.proceedsUsd) : '—'}</span>
																		{lot.gainLossUsd != null && (
																			<span class={`tl-gain ${isLotWin ? 'positive' : 'negative'}`}>
																				{isLotWin ? '+' : ''}{fmt(lot.gainLossUsd)}
																			</span>
																		)}
																	</div>
																</div>
															</div>
														);
													})}
												</div>
											</div>
										)}
									</div>
								);
							})}
						</div>
					</div>
				);
			})}
		</section>
	)}

	<!-- ══════════════════════════════════════════════════════════════════════
	     ACTIVE ROSTER — cards in play
	══════════════════════════════════════════════════════════════════════ -->
	{enrolled.length > 0 && (
		<section class="memory-lane__section">
			<div class="section-header section-header--active-roster">
				<span class="section-header__icon">⚔️</span>
				<div>
					<h2 class="section-header__title">Active Roster</h2>
					<p class="section-header__subtitle">Cards in play — match still live</p>
				</div>
				<span class="section-header__count">{enrolled.length} card{enrolled.length !== 1 ? 's' : ''}</span>
			</div>

			{TYPE_ORDER.map((type) => {
				const group = enrollGroups[type];
				if (!group?.length) return null;
				const meta = TYPE_META[type];
				return (
					<div class="type-group">
						<div class="type-group__label">
							<span>{meta.icon}</span>
							<span>{meta.label}</span>
						</div>
						<div class="card-grid">
							{group.map((h: any) => {
								const soldGains = gainsByAsset.get(h.asset);
								const lots      = lotDetails[h.asset] ?? [];
								const isUp      = (h.unrealizedGainLoss ?? 0) >= 0;
								const rarity    = getRarity(Math.abs(h.unrealizedGainLoss ?? 0), h.longTermQty > 0, false);
								return (
									<div class="token-card token-card--active"
									     data-rarity={rarity}
									     data-asset={h.asset}>
										<div class="token-card__inner">

											<!-- Header: logo · ticker · grade -->
											<div class="token-card__header">
												<div class="token-card__logo-wrap">
													<img class="token-card__coin-logo"
													     src={logoUrl(h.asset)}
													     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
													     alt={h.asset} />
													<div class="token-card__coin-fallback" style="display:none">{h.asset.slice(0, 3)}</div>
												</div>
												<div class="token-card__identity">
													<span class="token-card__ticker">{h.asset}</span>
													{rarity !== 'common' && (
														<span class={`token-card__rarity-badge token-card__rarity-badge--${rarity}`}>
															{rarity}
														</span>
													)}
												</div>
												<div class="grade grade-incomplete" title="Grade in progress">IP</div>
											</div>

											<!-- Status chip -->
											<span class="token-card__status-chip token-card__status-chip--active">
												⚔️ In Play
											</span>

											<!-- P&L (unrealized) -->
											<div class="token-card__pnl">
												{h.unrealizedGainLoss != null ? (
													<span class={`token-card__pnl-num token-card__pnl-num--${isUp ? 'gain' : 'loss'}`}>
														{isUp ? '+' : ''}{fmt(h.unrealizedGainLoss)}
													</span>
												) : (
													<span class="token-card__pnl-num">Unpriced</span>
												)}
												<span class="token-card__pnl-label">unrealized</span>
											</div>

											<!-- KDA stat strip -->
											<div class="token-card__stats">
												<div class="token-card__stats-item">
													<span class="token-card__stats-key">Held</span>
													<span class="token-card__stats-val">{fmtQty(h.totalQty)}</span>
												</div>
												{h.currentPrice != null && (
													<div class="token-card__stats-item">
														<span class="token-card__stats-key">Price</span>
														<span class="token-card__stats-val">${h.currentPrice.toLocaleString('en-US', { maximumFractionDigits: 2 })}</span>
													</div>
												)}
												{h.shortTermQty > 0 && (
													<div class="token-card__stats-item">
														<span class="token-card__stats-key">ST Qty</span>
														<span class="token-card__stats-val st-tag">{fmtQty(h.shortTermQty)}</span>
													</div>
												)}
												{h.longTermQty > 0 && (
													<div class="token-card__stats-item">
														<span class="token-card__stats-key">LT Qty</span>
														<span class="token-card__stats-val lt-tag">{fmtQty(h.longTermQty)}</span>
													</div>
												)}
											</div>

											<!-- Also sold note -->
											{soldGains && (
												<div class="token-card__sold-note">
													Also sold {soldGains.stLots + soldGains.ltLots} lot(s) this year &middot; {fmt(soldGains.netGain)} realized
												</div>
											)}

											<!-- CTA button -->
											{lots.length > 0 && (
												<button class="token-card__cta token-card__cta--enrolled" data-asset={h.asset}>
													View Sold Lots <span class="token-card__cta-chevron">▾</span>
												</button>
											)}
										</div>

										<!-- Expanded timeline -->
										{lots.length > 0 && (
											<div class="token-card__timeline token-card__timeline--active" id={timelineId(h.asset)} hidden>
												<div class="timeline__header">
													{h.asset} · Sold Lots This Year · {lots.length} disposal{lots.length !== 1 ? 's' : ''}
												</div>
												<div class="timeline__track">
													{lots.map((lot: any) => {
														const gain = lot.gainLossUsd ?? 0;
														const isLotWin = gain >= 0;
														return (
															<div class="tl-pair">
																<div class="tl-node">
																	<div class="tl-dot tl-dot--buy"></div>
																	<div class="tl-content">
																		<span class="tl-action buy">BUY</span>
																		<span class="tl-date">{fmtDate(lot.buyDate)}</span>
																		<span class="tl-qty">{fmtQty(lot.amount)} {h.asset}</span>
																		<span class="tl-usd">{lot.costUsd != null ? fmt(lot.costUsd) : '—'}</span>
																	</div>
																</div>
																<div class="tl-connector">
																	<div class="tl-line"></div>
																	<span class="tl-held">
																		{lot.daysHeld}d ·
																		<span class={lot.term === 'long' ? 'lt-badge' : 'st-badge'}>
																			{lot.term === 'long' ? 'Long-term' : 'Short-term'}
																		</span>
																	</span>
																</div>
																<div class="tl-node">
																	<div class={`tl-dot tl-dot--sell ${isLotWin ? 'win' : 'loss'}`}></div>
																	<div class="tl-content">
																		<span class="tl-action sell">SELL</span>
																		<span class="tl-date">{fmtDate(lot.sellDate)}</span>
																		<span class="tl-qty">{fmtQty(lot.amount)} {h.asset}</span>
																		<span class="tl-usd">{lot.proceedsUsd != null ? fmt(lot.proceedsUsd) : '—'}</span>
																		{lot.gainLossUsd != null && (
																			<span class={`tl-gain ${isLotWin ? 'positive' : 'negative'}`}>
																				{isLotWin ? '+' : ''}{fmt(lot.gainLossUsd)}
																			</span>
																		)}
																	</div>
																</div>
															</div>
														);
													})}
												</div>
											</div>
										)}
									</div>
								);
							})}
						</div>
					</div>
				);
			})}
		</section>
	)}

	<!-- ── Empty state ────────────────────────────────────────────────────── -->
	{graduated.length === 0 && enrolled.length === 0 && (
		<div class="memory-lane__empty">
			<div class="memory-lane__empty-icon">📭</div>
			<p class="memory-lane__empty-title">No cards found for {year}</p>
			<p class="memory-lane__empty-sub">Select a different season above, or make sure your transactions are synced.</p>
		</div>
	)}

</div>
</Layout>

<script>
// ── Staggered card entrance ───────────────────────────────────────────────────
document.querySelectorAll<HTMLElement>('.token-card:not(.token-card--wire)').forEach((card, i) => {
	card.style.animationDelay = `${i * 0.05}s`;
});

// ── Timeline toggle ───────────────────────────────────────────────────────────
function toggleTimeline(asset: string) {
	const id       = 'tl-' + asset.replace(/[^a-z0-9]/gi, '_');
	const timeline = document.getElementById(id);
	if (!timeline) return;
	const isOpen = !timeline.hidden;
	timeline.hidden = isOpen;
	document.querySelectorAll<HTMLButtonElement>(`[data-asset="${CSS.escape(asset)}"].token-card__cta`)
		.forEach(btn => btn.classList.toggle('open', !isOpen));
}

// CTA button clicks
document.querySelectorAll<HTMLButtonElement>('.token-card__cta').forEach(btn => {
	btn.addEventListener('click', (e) => {
		e.stopPropagation();
		toggleTimeline(btn.dataset.asset!);
	});
});

// Card click (anywhere) also toggles
document.querySelectorAll<HTMLElement>('.token-card').forEach(card => {
	card.addEventListener('click', () => {
		const asset = card.dataset.asset;
		if (asset) toggleTimeline(asset);
	});
});

// ── Season chip bounce ────────────────────────────────────────────────────────
document.querySelectorAll<HTMLAnchorElement>('.season-chip').forEach(chip => {
	chip.addEventListener('click', () => {
		chip.classList.add('season-chip--bounce');
		chip.addEventListener('animationend', () => chip.classList.remove('season-chip--bounce'), { once: true });
	});
});
</script>
