---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo.jpeg';

const bye = Astro.url.searchParams.get('bye') === '1';
---

<Layout>
	<div class="landing">
		<img class="logo" src={logo.src} width="56" height="56" alt="Almstins logo" />
		{bye && (
			<div class="bye-toast">
				Thanks for your visit — come back soon! 👋
			</div>
		)}
		<a class="login-button" href="/login">Login</a>
	</div>
</Layout>

<style>
	.landing {
		position: relative;
		width: 100%;
	}

	.logo {
		position: fixed;
		top: 1.5rem;
		left: 1.5rem;
		width: 56px;
		height: 56px;
		object-fit: cover;
		border-radius: 12px;
		z-index: 5;
	}

	.login-button {
		position: fixed;
		top: 10rem;
		right: 5rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.4rem;
		border-radius: 999px;
		background: linear-gradient(135deg, #5767ff, #934dff);
		color: #fff;
		text-decoration: none;
		font-weight: 600;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			filter 0.2s ease;
		z-index: 5;
	}

	.login-button:hover {
		transform: translateY(-2px) scale(1.02);
		filter: brightness(1.12);
		box-shadow: 0 12px 24px rgba(88, 95, 255, 0.35);
	}

	.login-button:focus-visible {
		outline: 2px solid rgba(147, 77, 255, 0.6);
		outline-offset: 4px;
	}

	.bye-toast {
		position: fixed;
		top: 2rem;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		backdrop-filter: blur(12px);
		color: #f0f4ff;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 500;
		z-index: 10;
		animation: fadeOut 4s ease forwards;
	}

	@keyframes fadeOut {
		0%   { opacity: 1; transform: translateX(-50%) translateY(0); }
		70%  { opacity: 1; transform: translateX(-50%) translateY(0); }
		100% { opacity: 0; transform: translateX(-50%) translateY(-8px); }
	}

</style>
