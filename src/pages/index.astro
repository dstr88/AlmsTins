---
import Layout from '../layouts/Layout.astro';
import WalletChecker from '../components/WalletChecker';
import logo from '../assets/logo.jpeg';

const bye = Astro.url.searchParams.get('bye') === '1';
---

<Layout
	title="Almstins — Crypto Portfolio Tracker & Tax Tool"
	description="Track wallets, DeFi positions, and exchange accounts in one place. Calculate capital gains, export Form 8949, and know your real net worth."
	canonical="https://almstins.com"
>
	<div class="landing">
		<img class="logo" src={logo.src} width="56" height="56" alt="Almstins logo" />
		<h1 class="sr-only">Almstins — Crypto Portfolio Tracker</h1>
		{bye && (
			<div class="bye-toast">
				Thanks for your visit — come back soon! 👋
			</div>
		)}
		<a class="login-button" href="/login">Login</a>

		<!-- Wallet scam checker -->
		<div class="checker-wrap">
			<div class="checker-header">
				<h2 class="checker-title">🔍 Wallet Scam Checker</h2>
				<p class="checker-sub">
					Been offered a "too good to be true" crypto deal? Paste the wallet address
					here before you send anything.
				</p>
			</div>
			<WalletChecker client:load />
		</div>
	</div>
</Layout>

<style>
	.landing {
		position: relative;
		width: 100%;
	}

	.logo {
		position: fixed;
		top: 1.5rem;
		left: 1.5rem;
		width: 56px;
		height: 56px;
		object-fit: cover;
		border-radius: 12px;
		z-index: 5;
	}

	.login-button {
		position: fixed;
		top: 10rem;
		right: 5rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.4rem;
		border-radius: 999px;
		background: linear-gradient(135deg, #5767ff, #934dff);
		color: #fff;
		text-decoration: none;
		font-weight: 600;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			filter 0.2s ease;
		z-index: 5;
	}

	.login-button:hover {
		transform: translateY(-2px) scale(1.02);
		filter: brightness(1.12);
		box-shadow: 0 12px 24px rgba(88, 95, 255, 0.35);
	}

	.login-button:focus-visible {
		outline: 2px solid rgba(147, 77, 255, 0.6);
		outline-offset: 4px;
	}

	/* sr-only utility */
	.sr-only {
		position: absolute;
		width: 1px; height: 1px;
		padding: 0; margin: -1px;
		overflow: hidden; clip: rect(0,0,0,0);
		white-space: nowrap; border: 0;
	}

	/* Wallet checker section */
	.checker-wrap {
		position: relative;
		z-index: 5;
		margin: 14rem auto 4rem;
		width: min(680px, 92vw);
	}

	.checker-header {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.checker-title {
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		font-weight: 700;
		color: #f5f8ff;
		margin: 0 0 0.5rem;
	}

	.checker-sub {
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.45);
		margin: 0;
		line-height: 1.6;
		max-width: 520px;
		margin: 0 auto;
	}

	.bye-toast {
		position: fixed;
		top: 2rem;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		backdrop-filter: blur(12px);
		color: #f0f4ff;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 500;
		z-index: 10;
		animation: fadeOut 4s ease forwards;
	}

	@keyframes fadeOut {
		0%   { opacity: 1; transform: translateX(-50%) translateY(0); }
		70%  { opacity: 1; transform: translateX(-50%) translateY(0); }
		100% { opacity: 0; transform: translateX(-50%) translateY(-8px); }
	}

</style>
