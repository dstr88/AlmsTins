    align-items: center;
    gap: 1.25rem;
    background: linear-gradient(135deg, rgba(87, 103, 255, 0.12), rgba(147, 77, 255, 0.1));
    border: 1px solid rgba(87, 103, 255, 0.28);
    border-radius: 16px;
    padding: 1.4rem 1.6rem;
    margin-bottom: 4rem;
    flex-wrap: wrap;
  }

  .cta-banner__icon {
    font-size: 2rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .cta-banner__body {
    flex: 1;
    min-width: 200px;
  }

  .cta-banner__headline {
    margin: 0 0 0.3rem;
    font-size: 1rem;
    font-weight: 700;
    color: #f5f8ff;
  }

  .cta-banner__sub {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
  }

  .cta-banner__btn {
    flex-shrink: 0;
    display: inline-block;
    padding: 0.65rem 1.3rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #5767ff, #934dff);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  .cta-banner__btn:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  /* Cuadrícula de "qué verificamos" */
  .signals {
    margin-bottom: 4rem;
  }

  .signals__title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .signals__sub {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin: 0 0 0.85rem;
  }

  .signals__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .signal-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
  }

  .signal-card__icon {
    font-size: 1.3rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .signal-card__label {
    font-size: 0.875rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 0.4rem;
  }

  .signal-card__body {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.65;
    margin: 0;
  }

  /* Preguntas frecuentes */
  .faq {
    margin-bottom: 3rem;
  }

  .faq__title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .faq__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    padding: 0.25rem 0;
  }

  .faq__item[open] {
    padding-bottom: 0.75rem;
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::marker { display: none; }

  .faq__chevron {
    font-size: 1.3rem;
    opacity: 0.4;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(90deg);
  }

  .faq__a {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.75;
    margin: 0 0 0 0.25rem;
    padding-right: 2rem;
  }

  /* Aviso legal */
  .disclaimer {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.25);
    line-height: 1.7;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 2rem;
  }

  .disclaimer__link {
    color: rgba(165, 180, 252, 0.5);
    text-decoration: none;
    display: inline-block;
    margin-top: 0.4rem;
    transition: color 0.15s ease;
  }

  .disclaimer__link:hover {
    color: #a5b4fc;
  }

  /* ── Pestañas del verificador ── */
  .checker-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 0;
  }

  .checker-tab {
    padding: 0.65rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255,255,255,0.45);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    margin-bottom: -1px;
  }

  .checker-tab:hover { color: rgba(255,255,255,0.75); }

  .checker-tab.active {
    color: #a5b4fc;
    border-bottom-color: #a5b4fc;
  }

  /* ── Panel dApp ── */
  .dapp-panel {
    margin-bottom: 2.5rem;
  }

  .dapp-input-row {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .dapp-input-row input {
    flex: 1;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.06);
    color: #f5f8ff;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }

  .dapp-input-row input:focus { border-color: rgba(165,180,252,0.6); }
  .dapp-input-row input::placeholder { color: rgba(255,255,255,0.3); }

  .dapp-input-row button {
    padding: 0.8rem 1.4rem;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #5767ff, #934dff);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: filter 0.15s, transform 0.15s;
  }

  .dapp-input-row button:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .dapp-input-row button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  /* Ensure [hidden] attribute wins over any display property */
  [hidden] { display: none !important; }

  /* ── Cola de verificación progresiva ── */
  .check-queue {
    display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem;
  }
  .check-item {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.6rem 1rem; border-radius: 10px;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);
    font-size: 0.875rem; transition: background 0.3s ease, border-color 0.3s ease;
    overflow: hidden; max-height: 60px;
  }
  .ci-icon   { font-size: 1rem; flex-shrink: 0; width: 1.25rem; text-align: center; line-height: 1; }
  .ci-label  { flex: 1; color: rgba(255,255,255,0.75); }
  .ci-status { font-size: 0.8rem; color: rgba(255,255,255,0.35); white-space: nowrap; }
  .check-item[data-state="pending"] .ci-icon::before {
    content: ''; display: inline-block; width: 11px; height: 11px;
    border: 2px solid rgba(165,180,252,0.25); border-top-color: #a5b4fc;
    border-radius: 50%; animation: spin 0.7s linear infinite; vertical-align: middle;
  }
  .check-item[data-state="clean"]     { background: rgba(52,211,153,0.08); border-color: rgba(52,211,153,0.2); }
  .check-item[data-state="clean"]     .ci-status { color: #34d399; }
  .check-item[data-state="flagged"]   { background: rgba(255,59,59,0.08); border-color: rgba(255,59,59,0.3); }
  .check-item[data-state="flagged"]   .ci-status { color: #ff6b6b; font-weight: 600; }
  .check-item[data-state="vt-pending"]{ background: rgba(245,158,11,0.07); border-color: rgba(245,158,11,0.25); }
  .check-item[data-state="vt-pending"].ci-status { color: #f59e0b; }
  .check-item[data-state="unscanned"] { background: rgba(255,193,7,0.04); border-color: rgba(255,193,7,0.18); }
  .check-item[data-state="unscanned"] .ci-status { color: rgba(255,193,7,0.65); }
  @keyframes ci-flash {
    0%   { background: rgba(52,211,153,0.38); border-color: rgba(52,211,153,0.55); }
    100% { background: rgba(52,211,153,0.08); border-color: rgba(52,211,153,0.20); }
  }
  .ci-flash { animation: ci-flash 0.65s ease-out forwards; }
  @keyframes ci-fade {
    0%   { opacity: 1; max-height: 60px; padding-top: 0.6rem; padding-bottom: 0.6rem; }
    50%  { opacity: 0; max-height: 60px; }
    100% { opacity: 0; max-height: 0;    padding-top: 0;      padding-bottom: 0; margin-bottom: -0.35rem; }
  }
  .ci-done { animation: ci-fade 0.55s ease-out 0.85s forwards; pointer-events: none; }

  .spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(165,180,252,0.25);
    border-top-color: #a5b4fc;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Error ── */
  .dapp-error {
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: rgba(255,107,107,0.08);
    border: 1px solid rgba(255,107,107,0.3);
    color: #ff9b9b;
    font-size: 0.9rem;
  }

  /* ── Banner de veredicto ── */
  .verdict-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    border-radius: 16px;
    margin-bottom: 1rem;
  }

  .verdict-banner.red    { background: rgba(255,59,59,0.12);  border: 1px solid rgba(255,59,59,0.35); }
  .verdict-banner.yellow { background: rgba(255,193,7,0.1);   border: 1px solid rgba(255,193,7,0.3);  }
  .verdict-banner.green  { background: rgba(52,211,153,0.1);  border: 1px solid rgba(52,211,153,0.3); }

  .verdict-icon { font-size: 2.2rem; line-height: 1; }

  .verdict-label {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .verdict-banner.red    .verdict-label { color: #ff6b6b; }
  .verdict-banner.yellow .verdict-label { color: #ffc107; }
  .verdict-banner.green  .verdict-label { color: #34d399; }

  .verdict-url {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
    word-break: break-all;
  }

  /* ── Lista de fuentes ── */
  .source-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .source-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    font-size: 0.875rem;
  }

  .source-item.flagged { border-color: rgba(255,59,59,0.35);   background: rgba(255,59,59,0.07);  }
  .source-item.clean   { border-color: rgba(52,211,153,0.2);   }
  .source-item.yellow  { border-color: rgba(255,193,7,0.25);   background: rgba(255,193,7,0.05);  }

  .source-badge {
    font-size: 1rem;
    flex-shrink: 0;
    line-height: 1.4;
  }

  .source-name {
    font-weight: 700;
    color: rgba(255,255,255,0.85);
    margin: 0 0 0.15rem;
  }

  .source-detail {
    margin: 0;
    color: rgba(255,255,255,0.45);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .source-verdict-dot {
    margin-left: auto;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    align-self: center;
  }

  .dot-red    { background: #ff4d4d; box-shadow: 0 0 8px rgba(255,77,77,0.6); }
  .dot-green  { background: #34d399; box-shadow: 0 0 8px rgba(52,211,153,0.4); }
  .dot-yellow { background: #ffc107; box-shadow: 0 0 8px rgba(255,193,7,0.4); }
  .dot-gray   { background: rgba(255,255,255,0.2); }

  /* ── Consejo de seguridad ── */
  .safety-tip {
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.55);
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .signals__grid      { grid-template-columns: 1fr; }
    .hero__title        { -webkit-text-fill-color: #f5f8ff; }
    .cta-banner         { flex-direction: column; text-align: center; }
    .cta-banner__icon   { align-self: center; }
    .cta-banner__btn    { align-self: stretch; text-align: center; }
    .dapp-input-row     { flex-direction: column; }
  }
</style>

<script>
  // ── Modales de amenaza ─────────────────────────────────────────────────────────
  function openModal(id: string) {
    const modal = document.getElementById(id);
    if (!modal) return;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    const closeBtn = modal.querySelector<HTMLButtonElement>('.threat-modal__close');
    closeBtn?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  // Mitad superior de cada tarjeta → abrir modal
  document.querySelectorAll<HTMLButtonElement>('.threat-card__top').forEach((btn) => {
    btn.addEventListener('click', () => {
      const modalId = btn.dataset.modal;
      if (modalId) openModal(modalId);
    });
  });

  // Botones de verificación de la mitad inferior
  document.querySelectorAll<HTMLButtonElement>('.threat-card__check-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const type  = btn.dataset.checker;
      const input = btn.closest('.threat-card__checker')
                       ?.querySelector<HTMLInputElement>('.threat-card__input');
      const value = input?.value.trim() ?? '';
      if (!value) { input?.focus(); return; }

      if (type === 'dapp') {
        // Cambiar a pestaña dApp, pre-rellenar y ejecutar verificación
        const dappTab   = document.getElementById('tab-btn-dapp') as HTMLButtonElement | null;
        const walletTab = document.getElementById('tab-btn-wallet') as HTMLButtonElement | null;
        const dappPanel   = document.getElementById('panel-dapp')   as HTMLElement | null;
        const walletPanel = document.getElementById('panel-wallet') as HTMLElement | null;
        const urlInput  = document.getElementById('dapp-url-input') as HTMLInputElement | null;
        const checkBtn  = document.getElementById('dapp-check-btn') as HTMLButtonElement | null;
        if (dappTab && walletTab && dappPanel && walletPanel && urlInput && checkBtn) {
          walletTab.classList.remove('active'); walletTab.setAttribute('aria-selected', 'false');
          dappTab.classList.add('active');      dappTab.setAttribute('aria-selected', 'true');
          walletPanel.hidden = true;
          dappPanel.hidden   = false;
          urlInput.value = value;
          dappPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          setTimeout(() => checkBtn.click(), 350);
        }
      } else if (type === 'wallet') {
        // Cambiar a pestaña de billetera y navegar a ?address= para que React pre-rellene
        const url = new URL(window.location.href);
        url.searchParams.set('address', value);
        url.hash = 'panel-wallet';
        window.location.href = url.toString();
      } else if (type === 'approval') {
        // Abrir revoke.cash con la dirección
        const addr = encodeURIComponent(value);
        window.open(`https://revoke.cash/address/${addr}`, '_blank', 'noopener,noreferrer');
      }
    });
  });

  // Evitar que los clics en el input se propaguen a la parte superior de la tarjeta
  document.querySelectorAll<HTMLInputElement>('.threat-card__input').forEach((inp) => {
    inp.addEventListener('click', (e) => e.stopPropagation());
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        (inp.closest('.threat-card__checker')
             ?.querySelector<HTMLButtonElement>('.threat-card__check-btn'))?.click();
      }
    });
  });

  document.querySelectorAll<HTMLElement>('.threat-modal').forEach((modal) => {
    // Botón de cerrar
    modal.querySelector('.threat-modal__close')?.addEventListener('click', () => closeModal(modal));
    // Clic en el fondo para cerrar
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(modal);
    });
  });

  // La tecla Escape cierra cualquier modal abierto
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll<HTMLElement>('.threat-modal.open').forEach(closeModal);
    }
  });

  // ── Cambio de pestañas ────────────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('.checker-tab');
  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabs.forEach((t) => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const target = btn.dataset.tab!;
      (document.getElementById('panel-wallet') as HTMLElement).hidden = target !== 'wallet';
      (document.getElementById('panel-dapp')   as HTMLElement).hidden = target !== 'dapp';
    });
  });

  // ── Verificador de dApp ───────────────────────────────────────────────────────
  const input   = document.getElementById('dapp-url-input')   as HTMLInputElement;
  const btn     = document.getElementById('dapp-check-btn')   as HTMLButtonElement;
  const result  = document.getElementById('dapp-result')      as HTMLElement;
  const errBox  = document.getElementById('dapp-error')       as HTMLElement;

  function verdictDot(v: string): string {
    if (v === 'flagged')   return 'dot-red';
    if (v === 'clean' || v === 'whitelisted') return 'dot-green';
    if (v === 'unscanned') return 'dot-yellow';
    return 'dot-gray';
  }

  function sourceClass(v: string): string {
    if (v === 'flagged')   return 'flagged';
    if (v === 'unscanned') return 'yellow';
    return 'clean';
  }

  // ── Cola de verificación progresiva ──────────────────────────────────────────

  const SOURCE_TO_ID: Record<string, string> = {
    'MetaMask Blocklist':    'ci-metamask',
    'ScamSniffer':           'ci-scamsniffer',
    'OpenPhish':             'ci-openphish',
    'GoPlus Security':       'ci-goplus',
    'URLScan.io':            'ci-urlscan',
    'Google Safe Browsing':  'ci-gsb',
    'VirusTotal':            'ci-virustotal',
  };

  function resolveCheckItem(s: { name: string; verdict: string }): void {
    const elemId = SOURCE_TO_ID[s.name];
    if (!elemId) return;
    const elem = document.getElementById(elemId);
    if (!elem) return;
    const iconEl   = elem.querySelector('.ci-icon')   as HTMLElement;
    const statusEl = elem.querySelector('.ci-status') as HTMLElement;
    const { verdict, name } = s as any;

    if (verdict === 'flagged') {
      iconEl.textContent = '🚨'; statusEl.textContent = 'Signalé'; elem.dataset.state = 'flagged'; return;
    }
    if (verdict === 'unscanned' && name === 'VirusTotal') {
      iconEl.textContent = '⏳'; statusEl.textContent = 'En attente…'; elem.dataset.state = 'vt-pending'; return;
    }
    if (verdict === 'whitelisted') {
      iconEl.textContent = '✅'; statusEl.textContent = 'Introuvable ✓'; elem.dataset.state = 'clean';
    } else if (verdict === 'clean') {
      iconEl.textContent = '✅'; statusEl.textContent = 'Introuvable ✓'; elem.dataset.state = 'clean';
    } else if (verdict === 'unscanned') {
      iconEl.textContent = '⚠️'; statusEl.textContent = 'Aucune donnée'; elem.dataset.state = 'unscanned';
    } else {
      elem.style.display = 'none'; return;
    }
    elem.classList.add('ci-flash'); elem.classList.add('ci-done');
  }

  function resetQueue(): void {
    Object.values(SOURCE_TO_ID).forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.display = ''; el.dataset.state = 'pending'; el.className = 'check-item';
      (el.querySelector('.ci-icon')   as HTMLElement).textContent = '';
      (el.querySelector('.ci-status') as HTMLElement).textContent = 'Vérification…';
    });
  }

  async function runCheck() {
    const raw = input.value.trim();
    if (!raw) { input.focus(); return; }

    btn.disabled  = true;
    result.hidden = true;
    errBox.hidden = true;

    const queue = document.getElementById('check-queue') as HTMLElement;
    resetQueue();
    queue.hidden = false;

    const qs = new URLSearchParams({ url: raw });

    const fastFetch = fetch(`/api/dapp-check?${qs}&phase=fast`)
      .then((r) => r.json() as Promise<any>).catch(() => null);

    const slowFetch = fetch(`/api/dapp-check?${qs}`).then((r) => r.json());

    fastFetch.then((data) => {
      if (data?.sources) (data.sources as any[]).forEach(resolveCheckItem);
    });

    let data: any;
    try {
      data = await slowFetch;
    } catch (e) {
      queue.hidden = true;
      errBox.textContent = `Échec de la vérification : ${e instanceof Error ? e.message : 'Erreur inconnue'}. Réessayez.`;
      errBox.hidden = false;
      btn.disabled  = false;
      return;
    }

    if (!data || data.error) {
      queue.hidden = true;
      errBox.textContent = data?.message ?? 'Échec de la vérification. Réessayez.';
      errBox.hidden = false;
      btn.disabled  = false;
      return;
    }

    (data.sources as any[]).forEach(resolveCheckItem);

    setTimeout(() => {
      queue.hidden = true;

      const banner = document.getElementById('verdict-banner')!;
      banner.className = `verdict-banner ${data.verdict}`;
      document.getElementById('verdict-icon')!.textContent  =
        data.verdict === 'red' ? '🚨' : data.verdict === 'yellow' ? '⚠️' : '✅';
      document.getElementById('verdict-label')!.textContent =
        data.verdict === 'red'    ? 'DANGER — Ne connectez pas votre portefeuille' :
        data.verdict === 'yellow' ? 'PRUDENCE — Impossible de confirmer que ce site est sûr' :
                                    'INTROUVABLE — Aucun signalement dans aucune base de données';
      document.getElementById('verdict-url')!.textContent = data.domain;

      const VERDICT_RANK: Record<string, number> = { flagged: 0, error: 1, unscanned: 1, clean: 2, whitelisted: 2, skipped: 3 };
      const sorted = ([...data.sources] as any[]).sort(
        (a, b) => (VERDICT_RANK[a.verdict] ?? 2) - (VERDICT_RANK[b.verdict] ?? 2),
      );
      document.getElementById('source-list')!.innerHTML = sorted.map((s: any) => `
        <li class="source-item ${sourceClass(s.verdict)}">
          <span class="source-badge">${s.icon}</span>
          <div>
            <p class="source-name">${s.name}</p>
            <p class="source-detail">${s.detail}</p>
          </div>
          <span class="source-verdict-dot ${verdictDot(s.verdict)}"></span>
        </li>`).join('');

      document.getElementById('safety-tip')!.textContent =
        data.verdict === 'red'
          ? '🛑 Une ou plusieurs bases de données de sécurité ont signalé ce site. NE connectez PAS votre portefeuille et ne signez aucune transaction tant que vous n\'êtes pas certain.'
          : data.verdict === 'yellow'
          ? '⚠️ Ce site a un historique d\'analyse limité. Ne connectez votre portefeuille qu\'à des sites que vous avez trouvés vous-même.'
          : '✅ Aucune menace détectée. Vérifiez toujours l\'URL dans votre navigateur avant de signer une transaction.';

      result.hidden = false;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'dapp_check_submitted', {
          event_category: 'interactive_tool',
          event_label: data.verdict ?? 'unknown',
        });
      }
      btn.disabled = false;
    }, 1_400);
  }

  btn.addEventListener('click', runCheck);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') runCheck(); });
</script>
