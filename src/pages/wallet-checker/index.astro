  .faq__title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .faq__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    padding: 0.25rem 0;
  }

  .faq__item[open] {
    padding-bottom: 0.75rem;
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::marker { display: none; }

  .faq__chevron {
    font-size: 1.3rem;
    opacity: 0.4;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(90deg);
  }

  .faq__a {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.75;
    margin: 0 0 0 0.25rem;
    padding-right: 2rem;
  }

  /* Disclaimer */
  .disclaimer {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.25);
    line-height: 1.7;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 2rem;
  }

  .disclaimer__link {
    color: rgba(165, 180, 252, 0.5);
    text-decoration: none;
    display: inline-block;
    margin-top: 0.4rem;
    transition: color 0.15s ease;
  }

  .disclaimer__link:hover {
    color: #a5b4fc;
  }

  /* ── Checker tabs ── */
  .checker-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 0;
  }

  .checker-tab {
    padding: 0.65rem 1.2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255,255,255,0.45);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    margin-bottom: -1px;
  }

  .checker-tab:hover { color: rgba(255,255,255,0.75); }

  .checker-tab.active {
    color: #a5b4fc;
    border-bottom-color: #a5b4fc;
  }

  /* ── dApp panel ── */
  .dapp-panel {
    margin-bottom: 2.5rem;
  }

  .dapp-input-row {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .dapp-input-row input {
    flex: 1;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.06);
    color: #f5f8ff;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }

  .dapp-input-row input:focus { border-color: rgba(165,180,252,0.6); }
  .dapp-input-row input::placeholder { color: rgba(255,255,255,0.3); }

  .dapp-input-row button {
    padding: 0.8rem 1.4rem;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #5767ff, #934dff);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: filter 0.15s, transform 0.15s;
  }

  .dapp-input-row button:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .dapp-input-row button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  /* ── Loading ── */
  .dapp-loading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.5);
  }

  .spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(165,180,252,0.25);
    border-top-color: #a5b4fc;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Error ── */
  .dapp-error {
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: rgba(255,107,107,0.08);
    border: 1px solid rgba(255,107,107,0.3);
    color: #ff9b9b;
    font-size: 0.9rem;
  }

  /* ── Verdict banner ── */
  .verdict-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    border-radius: 16px;
    margin-bottom: 1rem;
  }

  .verdict-banner.red    { background: rgba(255,59,59,0.12);  border: 1px solid rgba(255,59,59,0.35); }
  .verdict-banner.yellow { background: rgba(255,193,7,0.1);   border: 1px solid rgba(255,193,7,0.3);  }
  .verdict-banner.green  { background: rgba(52,211,153,0.1);  border: 1px solid rgba(52,211,153,0.3); }

  .verdict-icon { font-size: 2.2rem; line-height: 1; }

  .verdict-label {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .verdict-banner.red    .verdict-label { color: #ff6b6b; }
  .verdict-banner.yellow .verdict-label { color: #ffc107; }
  .verdict-banner.green  .verdict-label { color: #34d399; }

  .verdict-url {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
    word-break: break-all;
  }

  /* ── Source list ── */
  .source-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .source-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    font-size: 0.875rem;
  }

  .source-item.flagged { border-color: rgba(255,59,59,0.35);   background: rgba(255,59,59,0.07);  }
  .source-item.clean   { border-color: rgba(52,211,153,0.2);   }
  .source-item.yellow  { border-color: rgba(255,193,7,0.25);   background: rgba(255,193,7,0.05);  }

  .source-badge {
    font-size: 1rem;
    flex-shrink: 0;
    line-height: 1.4;
  }

  .source-name {
    font-weight: 700;
    color: rgba(255,255,255,0.85);
    margin: 0 0 0.15rem;
  }

  .source-detail {
    margin: 0;
    color: rgba(255,255,255,0.45);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .source-verdict-dot {
    margin-left: auto;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    align-self: center;
  }

  .dot-red    { background: #ff4d4d; box-shadow: 0 0 8px rgba(255,77,77,0.6); }
  .dot-green  { background: #34d399; box-shadow: 0 0 8px rgba(52,211,153,0.4); }
  .dot-yellow { background: #ffc107; box-shadow: 0 0 8px rgba(255,193,7,0.4); }
  .dot-gray   { background: rgba(255,255,255,0.2); }

  /* ── Safety tip ── */
  .safety-tip {
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.55);
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .signals__grid      { grid-template-columns: 1fr; }
    .hero__title        { -webkit-text-fill-color: #f5f8ff; }
    .cta-banner         { flex-direction: column; text-align: center; }
    .cta-banner__icon   { align-self: center; }
    .cta-banner__btn    { align-self: stretch; text-align: center; }
    .dapp-input-row     { flex-direction: column; }
  }
</style>

<script>
  // ── Threat modals ─────────────────────────────────────────────────────────────
  function openModal(id: string) {
    const modal = document.getElementById(id);
    if (!modal) return;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    const closeBtn = modal.querySelector<HTMLButtonElement>('.threat-modal__close');
    closeBtn?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  // Top half of each card → open modal
  document.querySelectorAll<HTMLButtonElement>('.threat-card__top').forEach((btn) => {
    btn.addEventListener('click', () => {
      const modalId = btn.dataset.modal;
      if (modalId) openModal(modalId);
    });
  });

  // Bottom half check buttons
  document.querySelectorAll<HTMLButtonElement>('.threat-card__check-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const type  = btn.dataset.checker;
      const input = btn.closest('.threat-card__checker')
                       ?.querySelector<HTMLInputElement>('.threat-card__input');
      const value = input?.value.trim() ?? '';
      if (!value) { input?.focus(); return; }

      if (type === 'dapp') {
        // Switch to dApp tab, pre-fill, and run check
        const dappTab   = document.getElementById('tab-btn-dapp') as HTMLButtonElement | null;
        const walletTab = document.getElementById('tab-btn-wallet') as HTMLButtonElement | null;
        const dappPanel   = document.getElementById('panel-dapp')   as HTMLElement | null;
        const walletPanel = document.getElementById('panel-wallet') as HTMLElement | null;
        const urlInput  = document.getElementById('dapp-url-input') as HTMLInputElement | null;
        const checkBtn  = document.getElementById('dapp-check-btn') as HTMLButtonElement | null;
        if (dappTab && walletTab && dappPanel && walletPanel && urlInput && checkBtn) {
          walletTab.classList.remove('active'); walletTab.setAttribute('aria-selected', 'false');
          dappTab.classList.add('active');      dappTab.setAttribute('aria-selected', 'true');
          walletPanel.hidden = true;
          dappPanel.hidden   = false;
          urlInput.value = value;
          dappPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          setTimeout(() => checkBtn.click(), 350);
        }
      } else if (type === 'wallet') {
        // Switch to wallet tab and navigate to ?address= so React pre-fills
        const url = new URL(window.location.href);
        url.searchParams.set('address', value);
        url.hash = 'panel-wallet';
        window.location.href = url.toString();
      } else if (type === 'approval') {
        // Open revoke.cash with the address
        const addr = encodeURIComponent(value);
        window.open(`https://revoke.cash/address/${addr}`, '_blank', 'noopener,noreferrer');
      }
    });
  });

  // Prevent input clicks from bubbling to card top
  document.querySelectorAll<HTMLInputElement>('.threat-card__input').forEach((inp) => {
    inp.addEventListener('click', (e) => e.stopPropagation());
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        (inp.closest('.threat-card__checker')
             ?.querySelector<HTMLButtonElement>('.threat-card__check-btn'))?.click();
      }
    });
  });

  document.querySelectorAll<HTMLElement>('.threat-modal').forEach((modal) => {
    // Close button
    modal.querySelector('.threat-modal__close')?.addEventListener('click', () => closeModal(modal));
    // Click backdrop to close
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(modal);
    });
  });

  // Escape key closes any open modal
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll<HTMLElement>('.threat-modal.open').forEach(closeModal);
    }
  });

  // ── Tab switching ─────────────────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('.checker-tab');
  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabs.forEach((t) => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const target = btn.dataset.tab!;
      (document.getElementById('panel-wallet') as HTMLElement).hidden = target !== 'wallet';
      (document.getElementById('panel-dapp')   as HTMLElement).hidden = target !== 'dapp';
    });
  });

  // ── dApp checker ──────────────────────────────────────────────────────────────
  const input   = document.getElementById('dapp-url-input')   as HTMLInputElement;
  const btn     = document.getElementById('dapp-check-btn')   as HTMLButtonElement;
  const result  = document.getElementById('dapp-result')      as HTMLElement;
  const loading = document.getElementById('dapp-loading')     as HTMLElement;
  const errBox  = document.getElementById('dapp-error')       as HTMLElement;

  function setLoading(on: boolean) {
    btn.disabled   = on;
    loading.hidden = !on;
    result.hidden  = true;
    errBox.hidden  = true;
  }

  function verdictDot(v: string): string {
    if (v === 'flagged')   return 'dot-red';
    if (v === 'clean' || v === 'whitelisted') return 'dot-green';
    if (v === 'unscanned') return 'dot-yellow';
    return 'dot-gray';
  }

  function sourceClass(v: string): string {
    if (v === 'flagged')   return 'flagged';
    if (v === 'unscanned') return 'yellow';
    return 'clean';
  }

  function verdictEmoji(v: string): string {
    if (v === 'flagged') return '🚫';
    if (v === 'clean' || v === 'whitelisted') return '✅';
    return '⚠️';
  }

  async function runCheck() {
    const raw = input.value.trim();
    if (!raw) { input.focus(); return; }

    setLoading(true);
    try {
      const qs  = new URLSearchParams({ url: raw });
      const res = await fetch(`/api/dapp-check?${qs}`);
      const data = await res.json();

      if (!res.ok || data.error) throw new Error(data.message ?? `HTTP ${res.status}`);

      // Verdict banner
      const banner = document.getElementById('verdict-banner')!;
      banner.className = `verdict-banner ${data.verdict}`;
      document.getElementById('verdict-icon')!.textContent  =
        data.verdict === 'red' ? '🚨' : data.verdict === 'yellow' ? '⚠️' : '✅';
      document.getElementById('verdict-label')!.textContent =
        data.verdict === 'red'    ? 'DANGER — Do not connect your wallet' :
        data.verdict === 'yellow' ? 'CAUTION — Proceed carefully' :
                                    'LOOKS SAFE — No threats detected';
      document.getElementById('verdict-url')!.textContent = data.domain;

      // Source list
      const list = document.getElementById('source-list')!;
      list.innerHTML = (data.sources as any[]).map((s) => `
        <li class="source-item ${sourceClass(s.verdict)}">
          <span class="source-badge">${s.icon}</span>
          <div>
            <p class="source-name">${s.name}</p>
            <p class="source-detail">${s.detail}</p>
          </div>
          <span class="source-verdict-dot ${verdictDot(s.verdict)}"></span>
        </li>`).join('');

      // Safety tip
      const tip = document.getElementById('safety-tip')!;
      tip.textContent =
        data.verdict === 'red'
          ? '🛑 One or more security databases have reported this site. We are not making that determination ourselves — always verify independently. Do NOT connect your wallet or sign any transactions until you are certain.'
          : data.verdict === 'yellow'
          ? '⚠️ This site has limited scan history. Only connect your wallet to sites you found yourself — never through a link in a DM or email.'
          : '✅ No threats detected across all sources. Always double-check the URL in your browser bar before signing any transaction — even safe-looking sites can be typosquatted.';

      result.hidden = false;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'dapp_check_submitted', {
          event_category: 'interactive_tool',
          event_label: data.verdict ?? 'unknown',
        });
      }
    } catch (e) {
      errBox.textContent = `Check failed: ${e instanceof Error ? e.message : 'Unknown error'}. Try again.`;
      errBox.hidden = false;
    } finally {
      setLoading(false);
    }
  }

  btn.addEventListener('click', runCheck);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') runCheck(); });
</script>
