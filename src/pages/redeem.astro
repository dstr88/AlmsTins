---
/**
 * /redeem
 *
 * Promo code redemption page.
 * User must be logged in. No credit card required.
 */
import Layout from '@/layouts/Layout.astro';
import { requireTenantSession } from '@/lib/requireTenantSession';

const sess = await requireTenantSession(Astro.request).catch(() => null);
if (!sess) return Astro.redirect('/login?next=/redeem', 302);

const prefill = Astro.url.searchParams.get('code') ?? '';
---

<Layout title="Redeem Promo Code">
  <main class="redeem-page">
    <div class="card">
      <div class="card__icon">🎁</div>
      <h1 class="card__title">Redeem a Promo Code</h1>
      <p class="card__sub">
        Enter your code below to unlock your plan upgrade instantly.
        No credit card required.
      </p>

      <form class="redeem-form" id="redeem-form">
        <input
          id="code-input"
          class="code-input"
          type="text"
          name="code"
          placeholder="e.g. LAUNCH2026"
          value={prefill}
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          maxlength="32"
          required
        />
        <button class="submit-btn" type="submit" id="submit-btn">
          Apply Code
        </button>
      </form>

      <div id="result" class="result" aria-live="polite"></div>
    </div>
  </main>
</Layout>

<script>
const form     = document.getElementById('redeem-form') as HTMLFormElement;
const input    = document.getElementById('code-input')  as HTMLInputElement;
const btn      = document.getElementById('submit-btn')  as HTMLButtonElement;
const resultEl = document.getElementById('result')      as HTMLDivElement;

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const code = input.value.trim().toUpperCase();
  if (!code) return;

  btn.disabled = true;
  btn.textContent = 'Applying…';
  resultEl.className = 'result';
  resultEl.textContent = '';

  try {
    const res  = await fetch('/api/promo/redeem', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const data = await res.json();

    if (res.ok && data.ok) {
      const neverExpires = data.expiresAt === '9999-12-31T23:59:59Z';
      const expiryText = neverExpires
        ? 'Your access never expires.'
        : `Your access runs through <strong>${new Date(data.expiresAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</strong>.`;
      resultEl.className = 'result result--success';
      resultEl.innerHTML = `
        <span class="result__icon">🎉</span>
        <span>
          <strong>${data.plan} plan unlocked!</strong><br>
          ${expiryText}
          <a href="/dashboard" class="result__link">Go to dashboard →</a>
        </span>
      `;
      input.value = '';
    } else {
      resultEl.className = 'result result--error';
      resultEl.innerHTML = `<span class="result__icon">⚠️</span><span>${data.error ?? 'Something went wrong. Please try again.'}</span>`;
    }
  } catch {
    resultEl.className = 'result result--error';
    resultEl.textContent = 'Network error. Please check your connection and try again.';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Apply Code';
  }
});

// Auto-uppercase as the user types
input.addEventListener('input', () => {
  const pos = input.selectionStart ?? 0;
  input.value = input.value.toUpperCase();
  input.setSelectionRange(pos, pos);
});
</script>

<style>
  .redeem-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    max-width: 440px;
    width: 100%;
    text-align: center;
  }

  .card__icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .card__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #e2e8ff;
    margin-bottom: .5rem;
  }

  .card__sub {
    font-size: .9rem;
    color: rgba(255,255,255,.45);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .redeem-form {
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .code-input {
    width: 100%;
    padding: .75rem 1rem;
    border-radius: 10px;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.15);
    color: #fff;
    font-size: 1.1rem;
    font-family: 'Courier New', monospace;
    font-weight: 700;
    letter-spacing: .1em;
    text-align: center;
    text-transform: uppercase;
    transition: border-color .15s;
  }

  .code-input:focus {
    outline: none;
    border-color: rgba(99,102,241,.6);
  }

  .code-input::placeholder {
    color: rgba(255,255,255,.2);
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }

  .submit-btn {
    padding: .75rem 1rem;
    border-radius: 10px;
    background: #6366f1;
    border: none;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s, opacity .15s;
  }

  .submit-btn:hover:not(:disabled) { background: #4f46e5; }
  .submit-btn:disabled { opacity: .5; cursor: default; }

  /* Result states */
  .result {
    display: none;
    margin-top: 1.25rem;
    padding: .9rem 1rem;
    border-radius: 10px;
    font-size: .9rem;
    text-align: left;
    display: flex;
    align-items: flex-start;
    gap: .6rem;
    line-height: 1.5;
  }

  .result:empty { display: none; }

  .result--success {
    background: rgba(16,185,129,.1);
    border: 1px solid rgba(16,185,129,.25);
    color: #6ee7b7;
  }

  .result--error {
    background: rgba(239,68,68,.1);
    border: 1px solid rgba(239,68,68,.25);
    color: #fca5a5;
  }

  .result__icon { font-size: 1.1rem; flex-shrink: 0; margin-top: .1rem; }

  .result__link {
    display: inline-block;
    margin-top: .4rem;
    color: #a5b4fc;
    text-decoration: none;
    font-weight: 600;
  }

  .result__link:hover { text-decoration: underline; }
</style>
