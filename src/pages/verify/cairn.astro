---
// Almstins Verify — PPPcairn milestone desk (Phase 0 + 1).
//
// A project is a financed piece of infrastructure; its milestones are the stages money is
// released against. Phase 1 adds the point of the whole thing: a single-use link asks an
// independent inspector to attest a milestone, and the signed, Bitcoin-stamped answer
// flips its status and lands on the dated trail below. Nothing here moves money.
//
// Signed-in only, like the receivables desk. No tenant_id or identity is ever rendered.
import '@/styles/tokens.css';
import { requireTenantSession } from '@/lib/requireTenantSession';
import { getAuthSession } from '@/lib/authSession';

export const prerender = false;

const sess = await requireTenantSession(Astro.request);
if (!sess) return Astro.redirect('/verify/login?next=/verify/cairn', 302);

const authSession = await getAuthSession(Astro.request);
const email = authSession?.user?.email ?? null;
const signOutHref = `/api/auth/signout?callbackUrl=${encodeURIComponent('/verify/login?next=/verify/cairn')}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Milestone Desk — Almstins Verify</title>
  <meta name="description" content="Record a financed project and its milestones, signed and timestamped." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon-verify.png" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--surface-bg); color: var(--text-primary); min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6; padding: 2rem 1.1rem 4rem;
    }
    .wrap { max-width: 60rem; margin: 0 auto; display: flex; flex-direction: column; gap: 1.25rem; }
    .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
    h1 { font-size: clamp(1.6rem, 4vw, 2.05rem); line-height: 1.2; font-weight: 700; margin-top: .3rem; }
    .blurb { color: var(--text-secondary); font-size: 1rem; max-width: 42rem; margin-top: .35rem; }

    .card { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 1.4rem 1.5rem; }
    .card.accent { border-color: var(--accent-glow); box-shadow: inset 0 0 0 1px var(--accent-glow); }
    .card h2 { font-size: 1.15rem; font-weight: 700; }
    .card .hint { font-size: .92rem; color: var(--text-muted); margin: .25rem 0 1rem; }

    .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .8rem; }
    .fld { display: flex; flex-direction: column; gap: .34rem; font-size: 1.02rem; }
    .fld .req { font-size: .7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-muted); }
    .fld input, .fld select, .fld textarea {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 9px;
      color: var(--text-primary); padding: .6rem .75rem; font-size: 1.02rem; font-family: inherit;
    }
    .fld textarea { min-height: 3.2rem; resize: vertical; }
    .fld input:focus, .fld select:focus, .fld textarea:focus { outline: none; border-color: var(--accent); }
    .row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }

    /* Tranche entry: money on top (currency symbol), percent below. One number each,
       big enough to read across a desk. */
    .amt-wrap { display: flex; align-items: center; gap: .5rem; background: var(--surface-card-2);
      border: 1px solid var(--border-subtle); border-radius: 9px; padding: 0 .8rem; }
    .amt-wrap:focus-within { border-color: var(--accent); }
    .amt-wrap input { flex: 1; min-width: 0; background: transparent; border: none; outline: none;
      color: var(--text-primary); padding: .65rem 0; font-size: 1.2rem; font-family: inherit;
      font-variant-numeric: tabular-nums; }
    .amt-sym { font-size: 1.1rem; font-weight: 700; color: var(--text-muted); flex: 0 0 auto; }
    .grow { flex: 1 1 12rem; }

    button {
      border-radius: 10px; padding: .72rem 1.1rem; font-size: .98rem; font-weight: 700;
      cursor: pointer; font-family: inherit; border: 1px solid transparent; background: var(--accent); color: var(--surface-bg);
    }
    button:hover:not(:disabled) { filter: brightness(1.08); }
    button:disabled { opacity: .45; cursor: not-allowed; }
    button.ghost { background: transparent; border-color: var(--border-bright); color: var(--text-secondary); }
    button.small { padding: .45rem .8rem; font-size: .85rem; }

    .modes { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-bottom: 1.1rem; }
    .mode { display: flex; gap: .4rem; align-items: center; font-size: .95rem; cursor: pointer; }
    .mode--test input { accent-color: var(--warning); }
    .modes__d { font-size: .86rem; color: var(--text-muted); }
    .card.is-test { border-color: var(--warning-border); box-shadow: inset 0 0 0 1px var(--warning-border); background: var(--warning-bg); }

    .note { border-radius: 10px; padding: .7rem .85rem; font-size: .92rem; margin-top: .8rem; display: none; }
    .note.show { display: block; }
    .note-gain { background: var(--gain-bg); border: 1px solid var(--gain-border); }
    .note-loss { background: var(--loss-bg); border: 1px solid var(--loss-border); }

    .plist { display: flex; flex-direction: column; gap: .55rem; }
    .prow { display: flex; justify-content: space-between; gap: 1rem; align-items: center;
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 11px; padding: .75rem .9rem; cursor: pointer; }
    .prow:hover { border-color: var(--accent-glow); }
    .prow__name { font-weight: 700; }
    .prow__meta { font-size: .82rem; color: var(--text-muted); }
    .pill { font-size: .68rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
      color: var(--warning); border: 1px solid var(--warning-border); background: var(--warning-bg); border-radius: 99px; padding: .1rem .5rem; }

    /* Milestone table: a framed ledger, not a bare grid. Rounded frame, tinted
       header, hover on rows, status as pills, money right-aligned. (Lovable restyle.) */
    .ms-table-wrap { margin-top: .5rem; border: 1px solid var(--border-subtle); border-radius: 12px;
      overflow-x: auto; background: var(--surface-card-2); }
    table { width: 100%; border-collapse: collapse; min-width: 34rem; }
    th, td { text-align: left; padding: .7rem .9rem; border-bottom: 1px solid var(--border-subtle); font-size: .92rem; }
    thead th { background: var(--surface-card); font-size: .66rem; letter-spacing: .09em; text-transform: uppercase;
      color: var(--text-muted); font-weight: 700; border-bottom: 1px solid var(--border-bright); white-space: nowrap; }
    tbody tr { transition: background .12s ease; }
    tbody tr:hover { background: var(--surface-hover); }
    tbody tr:last-child td { border-bottom: none; }
    th.col-num, td.num { text-align: right; font-variant-numeric: tabular-nums; }
    th.col-seq, td.seq { width: 2.2rem; text-align: center; color: var(--text-muted); font-variant-numeric: tabular-nums; }
    th.col-act, td.act { text-align: right; white-space: nowrap; }
    td .muted { margin-top: .15rem; font-size: .8rem; }
    .st { display: inline-block; font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
      color: var(--text-secondary); border: 1px solid var(--border-bright); background: var(--surface-card);
      border-radius: 99px; padding: .14rem .6rem; white-space: nowrap; }
    .st--attested { color: var(--gain); border-color: var(--gain-border); background: var(--gain-bg); }
    .st--disputed { color: var(--loss); border-color: var(--loss-border); background: var(--loss-bg); }

    .trail { display: flex; flex-direction: column; gap: .5rem; margin-top: .5rem; }
    .tr-item { border-left: 3px solid var(--accent-glow); background: var(--surface-card-2); border-radius: 8px; padding: .6rem .8rem; font-size: .88rem; }
    .tr-item--disputed { border-left-color: var(--loss-border); }
    .tr-item .when { font-size: .72rem; color: var(--text-muted); margin-top: .15rem; }
    .tr-item .found { margin-top: .5rem; padding: .5rem .65rem; border: 1px solid var(--border-subtle); border-radius: 7px;
      background: var(--surface-card); font-size: .85rem; color: var(--text-secondary); white-space: pre-wrap; }
    .tr-item .found b { display: block; font-size: .64rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: .2rem; }

    .reqrow { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem .9rem; align-items: center;
      border: 1px solid var(--border-subtle); border-radius: 9px; padding: .55rem .75rem; font-size: .88rem; }
    .reqrow .muted { font-size: .8rem; }
    .linkbox { margin-top: .7rem; background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 9px;
      padding: .6rem .75rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .74rem; word-break: break-all;
      user-select: all; }
    .sep { height: 1px; background: var(--accent-soft); border: 0; margin: 1.1rem 0; }

    /* The tranche arithmetic, done for you: total vs allocated vs still to place. */
    .alloc { margin: .2rem 0 .9rem; }
    .alloc__bar { height: 9px; border-radius: 99px; background: var(--surface-card-2); border: 1px solid var(--border-subtle); overflow: hidden; }
    .alloc__used { display: block; height: 100%; background: var(--accent); border-radius: 99px; transition: width .25s ease; }
    .alloc__used.over { background: var(--loss); }
    .alloc__keys { display: flex; flex-wrap: wrap; gap: .3rem 1.3rem; margin-top: .45rem; font-size: .82rem; color: var(--text-muted); }
    .alloc__keys b { color: var(--text-primary); font-variant-numeric: tabular-nums; }
    .alloc__keys .used b { color: var(--accent); }
    .alloc__keys .free b { color: var(--text-secondary); }
    .alloc__keys .free.over, .alloc__keys .free.over b { color: var(--loss); }
    .muted { color: var(--text-muted); font-size: .9rem; }
    .foot { font-size: .8rem; color: var(--text-muted); border-top: 1px solid var(--border-subtle); padding-top: 1.1rem; }
    .foot a { color: var(--accent); }
    .acct { display: flex; flex-direction: column; align-items: flex-end; gap: .2rem; flex: 0 0 auto; }
    .acct__email { font-size: .82rem; color: var(--text-muted); max-width: 14rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .acct__out { font-size: .82rem; color: var(--accent); text-decoration: none; }
    .acct__out:hover { text-decoration: underline; }
    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="top">
      <div>
        <div class="eyebrow">Almstins Verify · PPPcairn</div>
        <h1>Milestone desk</h1>
        <p class="blurb">
          Draft a financed project and the milestones its money releases against. Edit freely,
          leave, come back. When all of it is true, sign and seal the schedule in one act; then
          ask independent inspectors to attest each stage by single-use link, signed and stamped
          to Bitcoin: the dated trail a tranche can safely release against.
        </p>
      </div>
      <div class="acct">
        <span class="acct__email">{email ?? 'Account'}</span>
        <a class="acct__out" href={signOutHref}>Sign out</a>
      </div>
    </div>

    <div class="card accent" id="new-card">
      <div class="modes" id="modes">
        <label class="mode"><input type="radio" name="cairnmode" value="real" checked /><span>Real world</span></label>
        <label class="mode mode--test"><input type="radio" name="cairnmode" value="test" /><span>Test</span></label>
        <span class="modes__d" id="mode-note">A real project. Everything recorded counts.</span>
      </div>

      <h2>New project</h2>
      <p class="hint">The financed work, and what it is worth in total. Milestones come after you record it.</p>
      <div class="grid2">
        <label class="fld">Project name <span class="req">required</span>
          <input id="p-name" placeholder="Lagos-Ibadan section 3 road" autocomplete="off" />
        </label>
        <label class="fld">Contractor / borrower <span class="req">required</span>
          <input id="p-cparty" placeholder="Who you are financing" autocomplete="off" />
        </label>
        <label class="fld">Total value <span class="req">required</span>
          <input id="p-total" type="number" step="0.01" min="0" placeholder="500000000" />
        </label>
        <label class="fld">Currency
          <select id="p-ccy">
            <option value="NGN">NGN</option><option value="USD">USD</option>
            <option value="GBP">GBP</option><option value="EUR">EUR</option>
            <option value="GHS">GHS</option><option value="KES">KES</option>
            <option value="ZAR">ZAR</option>
          </select>
        </label>
      </div>
      <label class="fld" style="margin-top:.8rem">Description (optional)
        <textarea id="p-desc" placeholder="What is being built, and the shape of the facility."></textarea>
      </label>
      <div class="row" style="margin-top:1rem">
        <button id="p-go">Record the project</button>
      </div>
      <div id="p-out" class="note"></div>
    </div>

    <div class="card" id="ms-card" hidden>
      <h2 id="ms-title">Milestones</h2>
      <p class="hint" id="ms-sub">The stages money releases against, in order.</p>

      <div id="alloc" class="alloc" hidden>
        <div class="alloc__bar"><span class="alloc__used" id="alloc-used"></span></div>
        <div class="alloc__keys">
          <span><b id="alloc-total"></b> total</span>
          <span class="used"><b id="alloc-in"></b> in milestones</span>
          <span class="free" id="alloc-rest-wrap"><b id="alloc-rest"></b> <span id="alloc-rest-word">unallocated</span></span>
        </div>
      </div>

      <div id="ms-list"></div>

      <div id="seal-wrap" hidden style="margin-top:1rem; border:1px solid var(--accent-glow); border-radius:11px; padding:1rem 1.1rem">
        <h2 style="font-size:1rem">When all of it is true, sign it</h2>
        <p class="hint">
          Look the schedule over. While it is a draft you can edit and remove freely. Sealing signs
          every milestone and the schedule as one object, stamps it to Bitcoin, and locks it. Only a
          sealed schedule can take inspectors: their answer must bind to a milestone that can no
          longer change.
        </p>
        <div class="row">
          <button id="seal-go">Sign &amp; seal the schedule</button>
        </div>
        <div id="seal-out" class="note"></div>
      </div>

      <div id="ask-card" hidden style="margin-top:1rem; border:1px solid var(--accent-glow); border-radius:11px; padding:1rem 1.1rem">
        <h2 style="font-size:1rem">Ask an inspector: <span id="ask-title"></span></h2>
        <p class="hint">One single-use link, one milestone, one answer. Their reply is signed and stamped in their name.</p>
        <div class="row">
          <input id="ask-email" class="grow" type="email" placeholder="engineer@firm.com" autocomplete="off" />
          <input id="ask-label" placeholder="Who this is (optional)" style="flex:0 1 14rem" autocomplete="off" />
          <button id="ask-send" class="small">Create &amp; email</button>
          <button id="ask-link" class="small ghost">Create link only</button>
        </div>
        <div class="row" style="margin-top:.7rem">
          <input id="ask-file" type="file" accept="application/pdf,image/png,image/jpeg,image/gif,image/webp" class="grow" style="font-size:.85rem" />
          <button id="ask-attach" class="small ghost">Attach your report form</button>
        </div>
        <p class="hint" style="margin:.35rem 0 0">
          Optional: attach the form you want the inspector to fill in, print, and sign. They see it
          on their phone; their signed copy comes back below and both fingerprints seal into the answer.
        </p>
        <div id="ask-out" class="note"></div>
        <div id="ask-linkbox" class="linkbox" hidden></div>
      </div>

      <div id="trail-wrap" hidden style="margin-top:1.1rem">
        <h2 style="font-size:1rem">The trail</h2>
        <p class="hint">Every answer that has come back, signed and dated. This is what a tranche releases against.</p>
        <div id="trail" class="trail"></div>
      </div>

      <div id="docs-wrap" hidden style="margin-top:1.1rem">
        <h2 style="font-size:1rem">The paperwork</h2>
        <p class="hint">Forms you attached, and what inspectors sent back. Fingerprints seal into each answer.</p>
        <div id="docs-list" style="display:flex;flex-direction:column;gap:.5rem"></div>
      </div>

      <div id="req-wrap" hidden style="margin-top:1.1rem">
        <h2 style="font-size:1rem">Outstanding requests</h2>
        <p class="hint">Links minted and not yet answered.</p>
        <div id="req-list" style="display:flex;flex-direction:column;gap:.5rem"></div>
      </div>

      <hr class="sep" />
      <div class="grid2">
        <label class="fld">Milestone <span class="req">required</span>
          <input id="m-title" class="grow" placeholder="Foundation poured" autocomplete="off" />
        </label>
        <div class="fld">
          <span>Tranche amount <span class="req">either box works</span></span>
          <div class="amt-wrap"><span class="amt-sym" id="m-sym">$</span><input id="m-amt" type="number" step="0.01" min="0" placeholder="5000000" /></div>
          <div class="amt-wrap"><input id="m-pct" type="number" step="0.1" min="0" max="100" placeholder="10" /><span class="amt-sym">%</span></div>
        </div>
        <label class="fld">Target date (optional)
          <input id="m-date" type="date" />
        </label>
      </div>
      <label class="fld" style="margin-top:.8rem">What this stage means (optional)
        <textarea id="m-desc" placeholder="What has to be true for this milestone to count as reached."></textarea>
      </label>
      <div class="row" style="margin-top:1rem">
        <button id="m-go">Add milestone</button>
        <button id="m-cancel" class="ghost" hidden>Cancel edit</button>
      </div>
      <div id="m-out" class="note"></div>
    </div>

    <div class="card">
      <h2>Your projects</h2>
      <p class="hint">Everything you have recorded. Click one to work on its milestones.</p>
      <div id="proj-list" class="plist"><p class="muted">Loading…</p></div>
    </div>

    <p class="foot">
      Almstins records and proves. It never holds money, never moves it, and never says who anyone is.
      Full workbench for receivables at <a href="/verify/desk">/verify/desk</a>.
    </p>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const val = (id: string) => ($(id)?.value ?? '').trim();
    function esc(s: unknown) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
      )[c]!);
    }
    function show(el: HTMLElement, html: string, cls = 'note-gain') {
      el.className = `note show ${cls}`; el.innerHTML = html;
    }
    function hide(el: HTMLElement) { el.className = 'note'; el.innerHTML = ''; }
    const money = (n: number, ccy: string) =>
      `${ccy} ${Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;

    let currentProject: string | null = null;
    let currentTotal = 0;
    let currentCcy = 'NGN';

    // Percent <-> amount, both directions. He thinks "the first nine weeks is worth 10%";
    // the record stores money, because money is what the signature and the lender release.
    function wirePct() {
      const amt = $('m-amt'), pct = $('m-pct');
      pct?.addEventListener('input', () => {
        if (!(currentTotal > 0)) return;
        const p = Number(pct.value);
        if (Number.isFinite(p) && p >= 0) amt.value = String(Math.round(currentTotal * p) / 100);
      });
      amt?.addEventListener('input', () => {
        if (!(currentTotal > 0)) { if (pct) pct.value = ''; return; }
        const a = Number(amt.value);
        if (pct) pct.value = Number.isFinite(a) && a >= 0 ? String(Math.round((a / currentTotal) * 1000) / 10) : '';
      });
    }
    const pctOf = (n: number) => currentTotal > 0 ? `${Math.round((n / currentTotal) * 1000) / 10}%` : '';

    const CCY_SYMBOL: Record<string, string> = {
      NGN: '₦', USD: '$', GBP: '£', EUR: '€', GHS: 'GH₵', KES: 'KSh', ZAR: 'R',
    };
    const ccySymbol = (c: string) => CCY_SYMBOL[c] ?? c;

    // Practice mode. The new-project card turns amber so a rehearsal can't be mistaken for real,
    // and the flag travels with the record into its signed manifest.
    function syncMode() {
      const test = (document.querySelector('input[name=cairnmode]:checked') as HTMLInputElement)?.value === 'test';
      document.getElementById('new-card')?.classList.toggle('is-test', test);
      document.getElementById('mode-note')!.textContent = test
        ? 'A practice run. Marked TEST on this desk and inside the signed record.'
        : 'A real project. Everything recorded counts.';
    }
    document.querySelectorAll('input[name=cairnmode]').forEach((r) => r.addEventListener('change', syncMode));
    syncMode();

    async function createProject() {
      const out = $('p-out') as unknown as HTMLElement;
      const name = val('p-name'), counterparty = val('p-cparty');
      const totalValue = Number(val('p-total'));
      if (!name || !counterparty) { show(out, 'A project name and contractor are both needed.', 'note-loss'); return; }
      if (!totalValue || totalValue <= 0) { show(out, 'Enter the total value of the project.', 'note-loss'); return; }
      show(out, 'Signing and recording…');
      try {
        const r = await fetch('/api/verify/cairn/projects', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name, counterparty, totalValue, currency: val('p-ccy') || 'NGN',
            description: val('p-desc') || null,
            isTest: (document.querySelector('input[name=cairnmode]:checked') as HTMLInputElement)?.value === 'test',
          }),
        });
        const j = await r.json();
        if (!j.ok) { show(out, esc(j.message || 'Could not record that.'), 'note-loss'); return; }
        show(out, '<b>Recorded as a draft.</b> Add the milestones, edit until it is all true, then sign and seal.', 'note-gain');
        ['p-name','p-cparty','p-total','p-desc'].forEach((id) => { const el = $(id) as HTMLInputElement; if (el) el.value = ''; });
        openProject(j.id);
        loadProjects();
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    async function openProject(id: string, scroll = true) {
      currentProject = id;
      try {
        const j = await (await fetch('/api/verify/cairn/projects?id=' + encodeURIComponent(id))).json();
        if (!j.ok) return;
        const card = document.getElementById('ms-card')!;
        card.hidden = false;
        // The whole workspace wears the test color while a test project is open — the
        // create-card toggle already marks what you record; this marks where you ARE.
        const isTest = j.project.isTest === true;
        const sealed = j.project.sealedAt != null;
        currentTotal = Number(j.project.totalValue || 0);
        currentCcy = j.project.currency;
        const sym = document.getElementById('m-sym');
        if (sym) sym.textContent = ccySymbol(currentCcy);
        card.classList.toggle('is-test', isTest);
        document.getElementById('ms-title')!.innerHTML =
          `Milestones — ${esc(j.project.name)}${isTest ? ' <span class="pill">test</span>' : ''}${sealed ? ' <span class="pill" style="color:var(--gain);border-color:var(--gain-border);background:var(--gain-bg)">sealed</span>' : ' <span class="pill" style="color:var(--text-muted);border-color:var(--border-bright);background:transparent">draft</span>'}`;
        document.getElementById('ms-sub')!.textContent =
          `${j.project.counterparty} · ${money(j.project.totalValue, j.project.currency)} total` +
          `${sealed ? ` · signed and sealed ${String(j.project.sealedAt).slice(0, 10)}` : ' · a draft, edit freely'}` +
          `${isTest ? ' · practice project, nothing here counts' : ''}`;
        renderMilestones(j.milestones || [], j.project.currency, sealed);
        (document.getElementById('seal-wrap') as HTMLElement).hidden = sealed || !(j.milestones || []).length;
        // The add-milestone form only makes sense while drafting.
        const canDraft = !sealed;
        ['m-title','m-amt','m-pct','m-date','m-desc'].forEach((id) => { const el = $(id) as HTMLInputElement; if (el) el.disabled = !canDraft; });
        (document.getElementById('m-go') as HTMLButtonElement).disabled = !canDraft;
        if (sealed && editingId) cancelEdit();
        renderAlloc(j.project, j.milestones || []);
        renderTrail(j.attestations || []);
        renderDocs(j.documents || [], j.milestones || []);
        loadRequests(id);
        if (scroll) {
          card.scrollIntoView({ behavior: 'smooth', block: 'start' });
          ($('m-title') as HTMLInputElement)?.focus();
        }
      } catch { /* non-fatal */ }
    }

    let msRows: any[] = [];
    let editingId: string | null = null;

    function renderMilestones(rows: any[], ccy: string, sealed: boolean) {
      msRows = rows;
      const box = document.getElementById('ms-list')!;
      if (!rows.length) { box.innerHTML = '<p class="muted">No milestones yet. Add the first below.</p>'; return; }
      box.innerHTML = '<div class="ms-table-wrap"><table><thead><tr><th class="col-seq">#</th><th>Milestone</th><th class="col-num">Tranche</th><th>Target</th><th>Status</th><th class="col-act"></th></tr></thead><tbody>' +
        rows.map((m) => `<tr>
          <td class="seq">${esc(m.seq)}</td>
          <td>${esc(m.title)}${m.description ? `<div class="muted">${esc(m.description)}</div>` : ''}</td>
          <td class="num">${esc(money(m.trancheAmount, ccy))}${pctOf(Number(m.trancheAmount) || 0) ? `<div class="muted">${esc(pctOf(Number(m.trancheAmount) || 0))}</div>` : ''}</td>
          <td>${esc(m.targetDate || '—')}</td>
          <td><span class="st${m.status === 'attested' ? ' st--attested' : m.status === 'disputed' ? ' st--disputed' : ''}">${sealed ? esc(m.status) : 'draft'}</span></td>
          <td class="act"><div class="row" style="gap:.35rem;justify-content:flex-end">
            ${sealed && m.status !== 'attested' ? `<button class="small ghost" type="button" data-ask="${esc(m.id)}" data-mtitle="${esc(m.seq)}. ${esc(m.title)}">Ask an inspector</button>` : ''}
            ${!sealed ? `<button class="small ghost" type="button" data-edit="${esc(m.id)}">Edit</button><button class="small ghost" type="button" data-del="${esc(m.id)}" title="Remove this draft milestone">&#10005;</button>` : ''}
          </div></td>
        </tr>`).join('') + '</tbody></table></div>';
      box.querySelectorAll('[data-ask]').forEach((el) =>
        el.addEventListener('click', () => openAsk(
          (el as HTMLElement).dataset.ask as string,
          (el as HTMLElement).dataset.mtitle as string,
        )));
      box.querySelectorAll('[data-edit]').forEach((el) =>
        el.addEventListener('click', () => startEdit((el as HTMLElement).dataset.edit as string)));
      box.querySelectorAll('[data-del]').forEach((el) =>
        el.addEventListener('click', () => removeMilestone((el as HTMLElement).dataset.del as string)));
    }

    // Edit = replace-the-draft: the form becomes the editor, and saving re-signs the
    // milestone into the same seat. Server enforces drafts-only (pending, unattested).
    function startEdit(id: string) {
      const m = msRows.find((r) => r.id === id);
      if (!m) return;
      editingId = id;
      ($('m-title') as HTMLInputElement).value = m.title || '';
      ($('m-amt') as HTMLInputElement).value = m.trancheAmount ? String(m.trancheAmount) : '';
      ($('m-amt') as HTMLInputElement).dispatchEvent(new Event('input'));
      ($('m-date') as HTMLInputElement).value = m.targetDate || '';
      ($('m-desc') as HTMLInputElement).value = m.description || '';
      const go = document.getElementById('m-go')!;
      go.textContent = `Save changes to milestone ${m.seq}`;
      (document.getElementById('m-cancel') as HTMLButtonElement).hidden = false;
      go.scrollIntoView({ behavior: 'smooth', block: 'center' });
      ($('m-title') as HTMLInputElement).focus();
    }

    function cancelEdit() {
      editingId = null;
      ['m-title','m-amt','m-pct','m-date','m-desc'].forEach((id) => { const el = $(id) as HTMLInputElement; if (el) el.value = ''; });
      document.getElementById('m-go')!.textContent = 'Add milestone';
      (document.getElementById('m-cancel') as HTMLButtonElement).hidden = true;
    }

    // The deliberate act. One confirm, because it cannot be undone.
    async function sealSchedule() {
      const out = document.getElementById('seal-out')!;
      if (!currentProject) return;
      if (!confirm('Sign and seal this schedule? After this, milestones cannot be edited or removed, and inspectors can be invited.')) return;
      show(out as HTMLElement, 'Signing every milestone and sealing the schedule…');
      try {
        const r = await fetch('/api/verify/cairn/seal', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ projectId: currentProject }),
        });
        const j = await r.json();
        if (!j.ok) { show(out as HTMLElement, esc(j.message || 'Could not seal the schedule.'), 'note-loss'); return; }
        show(out as HTMLElement, `<b>Sealed.</b> ${esc(j.milestones)} milestones signed as one schedule${j.anchored ? ', stamped to Bitcoin' : ''}. You can now ask inspectors.`, 'note-gain');
        openProject(currentProject, false);
        loadProjects();
      } catch { show(out as HTMLElement, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    async function removeMilestone(id: string) {
      const m = msRows.find((r) => r.id === id);
      if (!m) return;
      if (!confirm(`Remove milestone ${m.seq}, "${m.title}"? Open inspector links on it will stop working.`)) return;
      try {
        const r = await fetch('/api/verify/cairn/milestone', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'remove', milestoneId: id }),
        });
        const j = await r.json();
        if (!j.ok) {
          const out = $('m-out') as unknown as HTMLElement;
          show(out, j.error === 'locked' ? 'This schedule is signed and sealed; its milestones no longer change.' : 'Could not remove that.', 'note-loss');
          return;
        }
        if (editingId === id) cancelEdit();
        if (currentProject) openProject(currentProject, false);
        loadProjects();
      } catch { /* non-fatal */ }
    }

    // The tranche arithmetic: total value vs what the milestones already carry. Turns red
    // instead of silently letting a schedule promise more money than the project has.
    function renderAlloc(project: any, milestones: any[]) {
      const box = document.getElementById('alloc')!;
      const total = Number(project.totalValue || 0);
      if (!(total > 0)) { box.hidden = true; return; }
      box.hidden = false;
      const inMs = milestones.reduce((s, m) => s + (Number(m.trancheAmount) || 0), 0);
      const rest = total - inMs;
      const over = rest < 0;
      const ccy = project.currency;
      const pct = Math.max(0, Math.min(100, (inMs / total) * 100));
      const used = document.getElementById('alloc-used')!;
      used.style.width = pct + '%';
      used.classList.toggle('over', over);
      document.getElementById('alloc-total')!.textContent = money(total, ccy);
      document.getElementById('alloc-in')!.textContent =
        `${money(inMs, ccy)} (${Math.round((inMs / total) * 1000) / 10}%)`;
      document.getElementById('alloc-rest')!.textContent = money(Math.abs(rest), ccy);
      document.getElementById('alloc-rest-word')!.textContent = over ? 'over the total' : 'unallocated';
      document.getElementById('alloc-rest-wrap')!.classList.toggle('over', over);
    }

    // ── Phase 1: the inspector flow ────────────────────────────────────────
    let askMilestone: string | null = null;

    function openAsk(milestoneId: string, title: string) {
      askMilestone = milestoneId;
      const card = document.getElementById('ask-card')!;
      card.hidden = false;
      document.getElementById('ask-title')!.textContent = title;
      (document.getElementById('ask-linkbox') as HTMLElement).hidden = true;
      hide($('ask-out') as unknown as HTMLElement);
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      ($('ask-email') as HTMLInputElement)?.focus();
    }

    // Mint the token; optionally hand it straight to the email machinery. "Link only" is
    // for the WhatsApp-and-voice world where email is the wrong channel.
    async function mintInvite(sendIt: boolean) {
      const out = $('ask-out') as unknown as HTMLElement;
      if (!currentProject || !askMilestone) { show(out, 'Pick a milestone first.', 'note-loss'); return; }
      const email = val('ask-email');
      if (sendIt && !email) { show(out, 'An email address is needed to send it. Or create the link only.', 'note-loss'); return; }
      show(out, 'Creating the link…');
      try {
        const r = await fetch('/api/verify/cairn/invite', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            projectId: currentProject, milestoneId: askMilestone,
            email: email || null, label: val('ask-label') || null,
          }),
        });
        const j = await r.json();
        if (!j.ok) {
          show(out, j.error === 'draft'
            ? 'This schedule is still a draft. Sign and seal it first; an inspector can only attest a milestone that can no longer change.'
            : esc(j.message || 'Could not create the link.'), 'note-loss');
          return;
        }
        const link = `${location.origin}/verify/cairn-attest?token=${encodeURIComponent(j.token)}`;
        if (sendIt) {
          const s = await fetch('/api/verify/cairn/send', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: j.token }),
          });
          const sj = await s.json();
          if (sj.ok) show(out, `<b>Sent to ${esc(sj.sentTo)}.</b> The link works once and expires ${esc(j.expiresAt.slice(0, 10))}.`, 'note-gain');
          else show(out, `The link was created but the email failed${sj.detail ? ` (${esc(sj.detail)})` : ''}. Copy it below and send it yourself.`, 'note-loss');
        } else {
          show(out, `<b>Link created.</b> It works once and expires ${esc(j.expiresAt.slice(0, 10))}. Send it however you like:`, 'note-gain');
        }
        const box = document.getElementById('ask-linkbox') as HTMLElement;
        box.textContent = link;
        box.hidden = false;
        loadRequests(currentProject);
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    function renderTrail(rows: any[]) {
      const wrap = document.getElementById('trail-wrap')!;
      const box = document.getElementById('trail')!;
      if (!rows.length) { wrap.hidden = true; return; }
      wrap.hidden = false;
      box.innerHTML = rows.map((a: any) => `
        <div class="tr-item${String(a.statement).startsWith('DISPUTED') ? ' tr-item--disputed' : ''}">
          <div>${esc(a.statement)}</div>
          ${a.findings ? `<div class="found"><b>What the inspector found</b>${esc(a.findings)}</div>` : ''}
          <div class="when">${esc(a.attestedAt)}${a.anchored ? ' · stamped to Bitcoin' : ''} · signed</div>
        </div>`).join('');
    }

    // The lender attaches the report form the inspector is asked to use.
    async function attachForm() {
      const out = $('ask-out') as unknown as HTMLElement;
      if (!currentProject || !askMilestone) { show(out, 'Pick a milestone first.', 'note-loss'); return; }
      const input = $('ask-file') as HTMLInputElement;
      const f = input?.files?.[0];
      if (!f) { show(out, 'Choose the form file first (PDF or image).', 'note-loss'); return; }
      show(out, 'Attaching…');
      try {
        const fd = new FormData();
        fd.append('milestoneId', askMilestone);
        fd.append('file', f);
        const r = await fetch('/api/verify/cairn/document', { method: 'POST', body: fd });
        const j = await r.json();
        if (!j.ok) {
          show(out, j.error === 'too_large' ? 'That file is over 5 MB.'
            : j.error === 'unsupported_type' ? 'PDF or image formats only.'
            : esc(j.message || 'Could not attach that.'), 'note-loss');
          return;
        }
        input.value = '';
        show(out, `<b>${esc(j.doc.filename)} attached.</b> The inspector's link now carries it.`, 'note-gain');
        if (currentProject) openProject(currentProject, false);
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    function renderDocs(docs: any[], milestones: any[]) {
      const wrap = document.getElementById('docs-wrap')!;
      const box = document.getElementById('docs-list')!;
      const live = docs.filter((d: any) => !d.purgedAt);
      if (!live.length) { wrap.hidden = true; return; }
      wrap.hidden = false;
      const bySeq = (id: string) => milestones.find((m) => m.id === id)?.seq ?? '?';
      box.innerHTML = live.map((d: any) => `
        <div class="reqrow">
          <div>
            <a class="doc" href="/api/verify/cairn/document?id=${esc(d.id)}" target="_blank" rel="noopener" style="text-decoration:none">
              <b style="color:var(--accent)">${esc(d.filename)}</b>
            </a>
            <div class="muted">milestone ${esc(bySeq(d.milestoneId))} · ${
              d.kind === 'photo' ? 'site photo from the inspector'
              : d.kind === 'signature' ? "inspector's signature"
              : d.kind === 'report' ? 'completed form from the inspector'
              : 'your form'} · ${Math.round((d.fileSize || 0) / 1024)} KB · ${esc(String(d.sha256).slice(0, 16))}…</div>
          </div>
        </div>`).join('');
    }

    async function loadRequests(projectId: string) {
      const wrap = document.getElementById('req-wrap')!;
      const box = document.getElementById('req-list')!;
      try {
        const j = await (await fetch('/api/verify/cairn/invite?projectId=' + encodeURIComponent(projectId))).json();
        const open = (j.requests ?? []).filter((r: any) => r.state === 'open');
        if (!j.ok || !open.length) { wrap.hidden = true; return; }
        wrap.hidden = false;
        box.innerHTML = open.map((r: any) => `
          <div class="reqrow">
            <div>
              <b>${esc(r.seq)}. ${esc(r.milestoneTitle)}</b>
              <div class="muted">${r.email ? `sent to ${esc(r.email)}` : 'link only'}${r.label ? ` · ${esc(r.label)}` : ''} · expires ${esc(r.expiresAt.slice(0, 10))}</div>
            </div>
            <div class="row">
              <button class="small ghost" type="button" data-copy="${esc(r.token)}">Copy link</button>
              <button class="small ghost" type="button" data-revoke="${esc(r.token)}">Revoke</button>
            </div>
          </div>`).join('');
        box.querySelectorAll('[data-copy]').forEach((el) =>
          el.addEventListener('click', async () => {
            const t = (el as HTMLElement).dataset.copy as string;
            try {
              await navigator.clipboard.writeText(`${location.origin}/verify/cairn-attest?token=${encodeURIComponent(t)}`);
              (el as HTMLButtonElement).textContent = 'Copied';
              setTimeout(() => ((el as HTMLButtonElement).textContent = 'Copy link'), 1500);
            } catch { /* clipboard unavailable */ }
          }));
        box.querySelectorAll('[data-revoke]').forEach((el) =>
          el.addEventListener('click', async () => {
            await fetch('/api/verify/cairn/invite', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'revoke', token: (el as HTMLElement).dataset.revoke }),
            });
            loadRequests(projectId);
          }));
      } catch { wrap.hidden = true; }
    }

    async function addMilestone() {
      const out = $('m-out') as unknown as HTMLElement;
      if (!currentProject) { show(out, 'Record a project first.', 'note-loss'); return; }
      const title = val('m-title');
      const trancheAmount = Number(val('m-amt'));
      if (!title) { show(out, 'A milestone needs a title.', 'note-loss'); return; }
      if (!(trancheAmount >= 0)) { show(out, 'Enter the tranche amount (zero or more).', 'note-loss'); return; }
      show(out, 'Signing…');
      try {
        const r = await fetch('/api/verify/cairn/milestone', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            projectId: currentProject, title,
            trancheAmount, targetDate: val('m-date') || null, description: val('m-desc') || null,
            editMilestoneId: editingId || undefined,
          }),
        });
        const j = await r.json();
        if (!j.ok) {
          show(out, j.error === 'locked'
            ? 'This schedule is signed and sealed; its milestones no longer change.'
            : esc(j.message || 'Could not add that.'), 'note-loss');
          return;
        }
        hide(out);
        cancelEdit();
        openProject(currentProject, false);
        loadProjects();
        ($('m-title') as HTMLInputElement)?.focus();
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    async function loadProjects() {
      const box = document.getElementById('proj-list')!;
      try {
        const j = await (await fetch('/api/verify/cairn/projects')).json();
        const rows = j.projects ?? [];
        if (!j.ok || !rows.length) { box.innerHTML = '<p class="muted">Nothing recorded yet.</p>'; return; }
        box.innerHTML = rows.map((p: any) => `
          <div class="prow" data-open="${esc(p.id)}">
            <div>
              <div class="prow__name">${esc(p.name)} ${p.isTest ? '<span class="pill">test</span>' : ''}</div>
              <div class="prow__meta">${esc(p.counterparty)} · ${esc(money(p.totalValue, p.currency))} · ${esc(p.milestoneCount)} milestone${p.milestoneCount === 1 ? '' : 's'}</div>
            </div>
            <button class="small ghost" type="button">Open</button>
          </div>`).join('');
        box.querySelectorAll('[data-open]').forEach((el) =>
          el.addEventListener('click', () => openProject((el as HTMLElement).dataset.open as string)));
      } catch { box.innerHTML = '<p class="muted">Could not load your projects.</p>'; }
    }

    document.getElementById('p-go')?.addEventListener('click', createProject);
    document.getElementById('m-go')?.addEventListener('click', addMilestone);
    document.getElementById('m-cancel')?.addEventListener('click', cancelEdit);
    document.getElementById('seal-go')?.addEventListener('click', sealSchedule);
    document.getElementById('ask-send')?.addEventListener('click', () => mintInvite(true));
    document.getElementById('ask-link')?.addEventListener('click', () => mintInvite(false));
    document.getElementById('ask-attach')?.addEventListener('click', attachForm);
    wirePct();
    loadProjects();
  </script>
</body>
</html>
