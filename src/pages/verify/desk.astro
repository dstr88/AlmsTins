---
// Almstins Verify — Financing Desk (financier-facing view).
//
// A role-scoped console over the same endpoints as /verify/registry. Where the registry
// page is a workbench showing every tool at once, this presents one job: decide whether
// to advance against a receivable, and record the claim if you do.
//
// The headline figure is the unencumbered headroom, because that is the number the
// financing decision turns on. The debtor's acknowledgment is surfaced as its own
// evidence row: it is the keystone a lender leans on, so its absence should be loud.
//
// Read-only against everything except this tenant's own claims. No tenant_id or identity
// is ever rendered — only self-chosen financier labels. Signed-in only: unauthenticated
// visitors are redirected to /login and returned here.
import '@/styles/tokens.css';
import { requireTenantSession } from '@/lib/requireTenantSession';
import { getAuthSession } from '@/lib/authSession';
import AccountMenu from '@/components/verify/AccountMenu.astro';

export const prerender = false;

// Both role desks require a signed-in account. The no-account public check still lives
// at /verify/registry; these are the working desks for named parties, so they sign in.
const sess = await requireTenantSession(Astro.request);
if (!sess) return Astro.redirect('/verify/login?next=/verify/desk', 302);

const authSession = await getAuthSession(Astro.request);
const email = authSession?.user?.email ?? null;

const prefillId = Astro.url.searchParams.get('id') ?? '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Financing Desk — Almstins Verify</title>
  <meta name="description" content="Check what is already claimed against a receivable before you advance against it." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon-verify.png" />
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--surface-bg); color: var(--text-primary); min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6; padding: 2rem 1.1rem 5rem;
    }
    .wrap { max-width: 60rem; margin: 0 auto; display: flex; flex-direction: column; gap: 1.15rem; }

    header { display: flex; flex-direction: column; gap: .35rem; margin-bottom: .35rem; }
    .head-top { display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
    .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
    h1 { font-size: clamp(1.6rem, 3.6vw, 2.1rem); line-height: 1.15; font-weight: 700; }
    .lede { color: var(--text-secondary); font-size: .95rem; max-width: 40rem; }

    .card { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 14px; padding: 1.15rem 1.3rem; }
    .card h2 { font-size: 1.02rem; font-weight: 700; margin-bottom: .25rem; }
    .card .hint { font-size: .82rem; color: var(--text-muted); margin-bottom: .9rem; }

    .row { display: flex; gap: .6rem; flex-wrap: wrap; }
    input, select {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 9px;
      color: var(--text-primary); padding: .6rem .75rem; font-size: .9rem; font-family: inherit; min-width: 0;
    }
    input:focus, select:focus { outline: none; border-color: var(--accent); }
    input::placeholder { color: var(--text-muted); }
    .grow { flex: 1 1 16rem; }
    button {
      background: var(--accent); color: var(--surface-bg); border: none; border-radius: 9px;
      padding: .6rem 1.05rem; font-size: .88rem; font-weight: 700; cursor: pointer; font-family: inherit;
    }
    button:hover { filter: brightness(1.08); }
    button:disabled { opacity: .5; cursor: not-allowed; }
    button.ghost { background: transparent; border: 1px solid var(--border-bright); color: var(--text-secondary); font-weight: 600; }
    button.ghost:hover { background: var(--surface-hover); filter: none; }
    button.small { padding: .34rem .7rem; font-size: .78rem; }

    /* ── Decision banner: the number the call turns on ── */
    .verdict { border-radius: 13px; padding: 1.1rem 1.25rem; border: 1px solid; display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between; }
    .verdict.clear { background: var(--gain-bg); border-color: var(--gain-border); }
    .verdict.partial { background: var(--warn-bg, var(--accent-soft)); border-color: var(--warn-border, var(--accent-glow)); }
    .verdict.blocked { background: var(--loss-bg); border-color: var(--loss-border); }
    .verdict__label { font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .85; }
    .verdict.clear .verdict__label { color: var(--gain); }
    .verdict.partial .verdict__label { color: var(--warning, var(--accent)); }
    .verdict.blocked .verdict__label { color: var(--loss); }
    .verdict__num { font-size: clamp(1.5rem, 4vw, 2.05rem); font-weight: 800; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .verdict__sub { font-size: .84rem; color: var(--text-secondary); }

    .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .85rem 1.1rem; margin-top: 1rem; }
    .fact__k { font-size: .68rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--text-muted); }
    .fact__v { font-size: .95rem; font-weight: 600; font-variant-numeric: tabular-nums; word-break: break-word; }

    /* Evidence rows — the debtor ack is the keystone, so absence is loud */
    .evidence { margin-top: 1.05rem; display: flex; flex-direction: column; gap: .5rem; }
    .ev { display: flex; gap: .7rem; align-items: flex-start; padding: .65rem .8rem; border-radius: 10px; border: 1px solid var(--border-subtle); background: var(--surface-card-2); }
    .ev.good { border-color: var(--gain-border); background: var(--gain-bg); }
    .ev.missing { border-color: var(--loss-border); background: var(--loss-bg); }
    .ev__icon { flex: 0 0 auto; font-size: .95rem; line-height: 1.5; }
    .ev__t { font-size: .88rem; font-weight: 700; }
    .ev__d { font-size: .8rem; color: var(--text-secondary); }

    table { width: 100%; border-collapse: collapse; font-size: .86rem; margin-top: .3rem; }
    th { text-align: right; font-size: .66rem; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); font-weight: 700; padding: .3rem .55rem; border-bottom: 1px solid var(--border-subtle); white-space: nowrap; }
    th:first-child { text-align: left; }
    td { padding: .5rem .55rem; border-bottom: 1px solid var(--border-subtle); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    td:first-child { text-align: left; white-space: normal; }
    tr.discharged td { opacity: .5; }
    .tag { font-size: .66rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .1rem .45rem; border-radius: 99px; border: 1px solid; }
    .tag.active { color: var(--accent); border-color: var(--accent-glow); background: var(--accent-soft); }
    .tag.off { color: var(--text-muted); border-color: var(--border-subtle); background: var(--surface-card); }

    .note { border-radius: 10px; padding: .7rem .85rem; font-size: .86rem; margin-top: .8rem; display: none; }
    .note.show { display: block; }
    .note-gain { background: var(--gain-bg); border: 1px solid var(--gain-border); color: var(--text-primary); }
    .note-loss { background: var(--loss-bg); border: 1px solid var(--loss-border); color: var(--text-primary); }
    .note-info { background: var(--accent-soft); border: 1px solid var(--accent-glow); color: var(--text-primary); }
    .muted { color: var(--text-muted); font-size: .8rem; }
    .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: .7rem; }
    .fld {
      display: flex; flex-direction: column; gap: .28rem;
      font-size: .68rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--text-muted);
    }
    .fld input, .fld select {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 8px;
      color: var(--text-primary); padding: .5rem .6rem; font-size: .9rem; font-family: inherit;
      font-weight: 400; letter-spacing: normal; text-transform: none; width: 100%;
    }
    .fld input:focus, .fld select:focus { outline: none; border-color: var(--accent); }
    .req { color: var(--accent); font-size: .58rem; letter-spacing: .06em; }
    .xrow { display: flex; gap: .5rem; align-items: center; margin-bottom: .5rem; }
    .xrow input { flex: 1 1 0; min-width: 0; }
    .xrow button {
      background: transparent; border: 1px solid var(--border-subtle); color: var(--text-muted);
      border-radius: 8px; padding: .4rem .6rem; font-size: .85rem; line-height: 1; cursor: pointer;
    }
    .ok { color: var(--gain); font-weight: 600; }
    input[type=file] {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 9px;
      color: var(--text-secondary); padding: .5rem .6rem; font-size: .85rem; font-family: inherit;
    }
    input[type=file]::file-selector-button {
      background: transparent; border: 1px solid var(--border-bright); border-radius: 7px;
      color: var(--text-secondary); padding: .3rem .6rem; margin-right: .6rem;
      font-family: inherit; font-size: .8rem; font-weight: 600; cursor: pointer;
    }
    .foot { margin-top: 1.4rem; font-size: .77rem; color: var(--text-muted); border-top: 1px solid var(--border-subtle); padding-top: 1rem; }
    .foot a { color: var(--accent); }
    #panel { display: none; }
    #panel.show { display: block; }
  </style>
</head>
<body>
  <div class="wrap">

    <header>
      <div class="head-top">
        <div>
          <div class="eyebrow">Almstins Verify</div>
          <h1>Financing Desk</h1>
        </div>
        <AccountMenu tenantId={sess.tenantId} email={email} current="desk" />
      </div>
      <p class="lede">Record a client's deal, attach the paperwork, and see everything already standing against it before you advance.</p>
    </header>

    <div class="card">
      <h2>Your clients</h2>
      <p class="hint">Invite a client onto the registry. Accepting creates their own account and records them as your client. Nothing of theirs lives in your account.</p>
      <div class="row">
        <input id="inv-label" class="grow" placeholder="Your firm's name (shown to them)" autocomplete="organization" />
        <button id="inv-go">Create invitation</button>
      </div>
      <div id="inv-out" class="note"></div>
      <div id="inv-list" style="margin-top:.9rem"></div>
    </div>

    <div class="card">
      <h2>New deal</h2>
      <p class="hint">
        Your client is sitting across the desk with his paperwork. Record what he is owed, then attach
        the papers and ask the debtor to confirm. Only the first four are required; fill in whatever
        the contract in front of you actually says.
      </p>

      <div class="grid2">
        <label class="fld">Client <span class="req">required</span>
          <input id="n-sup" placeholder="Who you are financing" autocomplete="off" />
        </label>
        <label class="fld">Debtor <span class="req">required</span>
          <input id="n-buy" placeholder="Who owes him the money" autocomplete="off" />
        </label>
        <label class="fld">Invoice number <span class="req">required</span>
          <input id="n-inv" placeholder="INV-2093" autocomplete="off" />
        </label>
        <label class="fld">Face value <span class="req">required</span>
          <input id="n-face" type="number" step="0.01" min="0" placeholder="50000000" />
        </label>
        <label class="fld">Currency
          <select id="n-ccy">
            <option value="NGN">NGN</option><option value="USD">USD</option>
            <option value="GBP">GBP</option><option value="EUR">EUR</option>
            <option value="GHS">GHS</option><option value="KES">KES</option>
            <option value="ZAR">ZAR</option>
          </select>
        </label>
        <label class="fld">Debtor's own reference
          <input id="n-ref" placeholder="Their PO or contract no." autocomplete="off" />
        </label>
        <label class="fld">Invoice date<input id="n-idate" type="date" /></label>
        <label class="fld">Delivery date<input id="n-ddate" type="date" /></label>
        <label class="fld">Due date<input id="n-due" type="date" /></label>
        <label class="fld">Terms
          <select id="n-terms">
            <option value="">not stated</option>
            <option>Net 30</option><option>Net 45</option><option>Net 60</option>
            <option>Net 90</option><option>Due on receipt</option>
          </select>
        </label>
      </div>

      <label class="fld" style="margin-top:.7rem">Goods or services
        <input id="n-goods" placeholder="What was supplied" autocomplete="off" />
      </label>
      <label class="fld" style="margin-top:.7rem">Payment instructions
        <input id="n-pay" placeholder="Where the debtor is to pay" autocomplete="off" />
      </label>

      <div id="n-extra" style="margin-top:.9rem"></div>
      <div class="row" style="margin-top:.6rem">
        <button class="small ghost" id="n-add" type="button">+ Add a field</button>
      </div>

      <div class="row" style="margin-top:.9rem">
        <button id="n-go">Sign, record &amp; timestamp</button>
      </div>
      <div id="n-out" class="note"></div>
    </div>

    <div class="card">
      <h2>Check a receivable</h2>
      <p class="hint">Nothing here reveals who holds the record, only what stands against it.</p>
      <div class="row">
        <input id="q-id" class="grow" placeholder="Receivable ID" value={prefillId} spellcheck="false" autocomplete="off" />
        <button id="q-go">Check</button>
      </div>
      <div id="q-out" class="note"></div>
    </div>

    <div id="panel">
      <div id="verdict"></div>

      <div class="card" style="margin-top:1.15rem">
        <h2>The record</h2>
        <p class="hint">What the parties have put their name to.</p>
        <div id="facts" class="facts"></div>
        <div id="evidence" class="evidence"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>Claims standing against it</h2>
        <p class="hint">Every advance registered by any financier holding this ID.</p>
        <div id="claims"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>The paperwork</h2>
        <p class="hint">
          The promissory note or contract your client brought in. PDF or photo, 5 MB each, as many as you need.
          It is shown to whoever you ask to confirm, then removed once they have all replied. The fingerprint stays.
        </p>
        <div class="row">
          <input id="d-file" type="file" accept="application/pdf,image/png,image/jpeg,image/gif,image/webp" class="grow" />
          <button id="d-go">Attach</button>
        </div>
        <div id="d-list"></div>
        <div id="d-out" class="note"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>Ask the debtor to confirm</h2>
        <p class="hint">
          Each request is its own single-use link. Ask more than one person if the amount warrants it:
          one reply from an address your client supplied proves less than two that agree, and two that
          disagree is the most useful answer you can get. They need no account.
        </p>
        <div class="row">
          <input id="k-email" class="grow" type="email" placeholder="accounts@feed-n-seed.com" autocomplete="off" />
          <input id="k-label" placeholder="Who this is (optional)" style="flex:0 1 14rem" autocomplete="off" />
          <button id="k-go">Create link</button>
        </div>
        <div id="k-list"></div>
        <div id="k-out" class="note"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>Register your claim</h2>
        <p class="hint">Signed and timestamped to Bitcoin. A claim over the remaining headroom is refused.</p>
        <div class="row">
          <input id="c-fin" class="grow" placeholder="Your firm" autocomplete="off" />
          <input id="c-amt" type="number" step="0.01" min="0" placeholder="Amount advanced" style="flex:0 1 12rem" />
          <input id="c-date" type="date" style="flex:0 1 11rem" />
        </div>
        <div class="row" style="margin-top:.6rem">
          <button id="c-go">Sign, register &amp; timestamp</button>
        </div>
        <div id="c-out" class="note"></div>
      </div>
    </div>

    <p class="foot">
      This desk records and proves. It does not confirm that goods shipped or money moved, and it never says who anyone is.
      New here? Read the <a href="/verify/guide">user's guide</a>. Full workbench at <a href="/verify/registry">/verify/registry</a>.
    </p>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const val = (id: string) => ($(id)?.value ?? '').trim();
    function esc(s: unknown) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
      )[c]!);
    }
    function money(n: number, ccy: string) {
      const v = Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${ccy} ${v}`;
    }
    function show(el: HTMLElement, html: string, cls = 'note-info') {
      el.className = `note show ${cls}`; el.innerHTML = html;
    }
    function hide(el: HTMLElement) { el.className = 'note'; el.innerHTML = ''; }

    let current: any = null;

    async function check(id?: string) {
      const rid = (id ?? val('q-id')).trim();
      const out = $('q-out') as unknown as HTMLElement;
      const panel = document.getElementById('panel')!;
      if (!rid) { show(out, 'Paste a receivable ID first.', 'note-loss'); return; }
      show(out, 'Checking…');
      try {
        const r = await fetch('/api/verify/receivables/lookup?id=' + encodeURIComponent(rid));
        const j = await r.json();
        if (!j.ok || !j.found) {
          hide(out); show(out, 'No receivable found for that ID. Check it with whoever sent it.', 'note-loss');
          panel.classList.remove('show'); current = null; return;
        }
        hide(out);
        current = j.receivable;
        render(current);
        panel.classList.add('show');
        loadDocs();
        loadConfirms();
      } catch (e) {
        show(out, 'Could not reach the registry. Try again.', 'note-loss');
      }
    }

    function render(r: any) {
      const ccy = r.currency || 'NGN';
      const avail = Number(r.available || 0);
      const claimed = Number(r.claimed || 0);

      // ── Decision banner ──
      let cls = 'clear', label = 'Unfinanced', sub = 'Nothing is claimed against this receivable.';
      if (r.settled) { cls = 'blocked'; label = 'Settled'; sub = 'This receivable is closed.'; }
      else if (r.status === 'over_financed') { cls = 'blocked'; label = 'Over-financed'; sub = 'Claims exceed the face value. Do not advance.'; }
      else if (avail <= 0) { cls = 'blocked'; label = 'Fully financed'; sub = 'No headroom remains. A further advance would be a duplicate.'; }
      else if (claimed > 0) { cls = 'partial'; label = 'Partially financed'; sub = `${money(claimed, ccy)} is already claimed by another financier.`; }
      document.getElementById('verdict')!.innerHTML = `
        <div class="verdict ${cls}">
          <div>
            <div class="verdict__label">${esc(label)} &middot; unencumbered headroom</div>
            <div class="verdict__num">${esc(money(Math.max(0, avail), ccy))}</div>
            <div class="verdict__sub">${esc(sub)}</div>
          </div>
          <div style="text-align:right">
            <div class="verdict__label">Face value</div>
            <div class="verdict__num" style="font-size:1.15rem">${esc(money(r.face, ccy))}</div>
          </div>
        </div>`;

      // ── Facts ──
      const f = (k: string, v: string) => `<div><div class="fact__k">${esc(k)}</div><div class="fact__v">${esc(v)}</div></div>`;
      const det = r.details || {};
      document.getElementById('facts')!.innerHTML =
        f('Client', r.supplier) + f('Debtor', r.buyer) + f('Invoice', r.invoiceNo) +
        (det.buyerRef ? f("Debtor's ref", det.buyerRef) : '') +
        (det.invoiceDate ? f('Invoiced', det.invoiceDate) : '') +
        (det.deliveryDate ? f('Delivered', det.deliveryDate) : '') +
        f('Terms', r.terms || 'not stated') + f('Due', r.dueDate || 'not stated') +
        f('Recorded', String(r.createdAt || '').slice(0, 10)) +
        (det.goods ? f('Goods or services', det.goods) : '') +
        (det.paymentInstructions ? f('Payment instructions', det.paymentInstructions) : '') +
        (Array.isArray(det.extra) ? det.extra.map((e: any) => f(e.label, e.value)).join('') : '');

      // ── Evidence: the debtor's acknowledgment is the keystone ──
      const buyerAck = (r.attestations || []).find((a: any) => a.role === 'buyer') || null;
      const acked = !!buyerAck || !!r.acknowledgedAt;
      const ackWhen = buyerAck?.date || r.acknowledgedAt || '';
      const ev: string[] = [];
      ev.push(acked
        ? `<div class="ev good"><div class="ev__icon">&#10003;</div><div><div class="ev__t">Debtor acknowledged the debt</div><div class="ev__d">${esc(buyerAck ? buyerAck.label : r.buyer)} confirmed this obligation${ackWhen ? ' on ' + esc(String(ackWhen).slice(0, 10)) : ''}. This is the evidence that does not come from the client.</div></div></div>`
        : `<div class="ev missing"><div class="ev__icon">!</div><div><div class="ev__t">No debtor acknowledgment</div><div class="ev__d">Nobody on the paying side has confirmed this debt. You are relying on the client's paperwork alone.</div></div></div>`);
      // A dispute is filed under the 'other' role so it can never sit in the buyer slot.
      // It still has to be the loudest thing on the page.
      const disputes = (r.attestations || []).filter((a: any) => String(a.statement || '').startsWith('DISPUTED'));
      disputes.forEach((d: any) => {
        ev.push(`<div class="ev missing"><div class="ev__icon">!</div><div><div class="ev__t">Disputed by ${esc(d.label)}</div><div class="ev__d">${esc(d.statement)}</div></div></div>`);
      });

      ev.push(r.anchored
        ? `<div class="ev good"><div class="ev__icon">&#9939;</div><div><div class="ev__t">Timestamped to Bitcoin</div><div class="ev__d">${r.anchoredAt ? 'Confirmed in a block on ' + esc(String(r.anchoredAt).slice(0, 10)) + '. The record\'s date cannot be forged or backdated.' : 'Submitted, pending a block. Once confirmed the date cannot be moved.'}</div></div></div>`
        : `<div class="ev"><div class="ev__icon">&middot;</div><div><div class="ev__t">Not yet timestamped</div><div class="ev__d">The record is signed but its date is not yet anchored publicly.</div></div></div>`);
      document.getElementById('evidence')!.innerHTML = ev.join('');

      // ── Claims ──
      const claims = r.claims || [];
      document.getElementById('claims')!.innerHTML = claims.length === 0
        ? `<p class="muted">No claims registered. The full face value is unencumbered.</p>`
        : `<table><thead><tr><th>Financier</th><th>Amount</th><th>Registered</th><th>Receipt</th><th>Status</th><th></th></tr></thead><tbody>` +
          claims.map((c: any) => {
            // "Claimed" has never meant "funded". Until the client counter-signs, this
            // row is one firm's word, and the desk says so rather than implying otherwise.
            const receipt = c.affirmed
              ? `<span class="ok">confirmed by ${esc(c.affirmedBy || 'the client')}</span>`
              : `<span class="muted">not confirmed</span>`;
            const ask = c.affirmed || c.status === 'discharged'
              ? ''
              : `<button class="small ghost" data-ask="${esc(c.id)}">Ask client</button>`;
            return `
            <tr class="${c.status === 'discharged' ? 'discharged' : ''}">
              <td>${esc(c.financier)}${c.anchored ? ' <span class="muted">&#9939;</span>' : ''}</td>
              <td>${esc(money(c.amount, c.currency || ccy))}</td>
              <td>${esc(String(c.registeredAt || '').slice(0, 10))}</td>
              <td>${receipt}</td>
              <td><span class="tag ${c.status === 'discharged' ? 'off' : 'active'}">${esc(c.status === 'discharged' ? 'discharged' : 'active')}</span></td>
              <td>${ask}${c.status === 'discharged' ? '' : ` <button class="small ghost" data-discharge="${esc(c.id)}">Mark repaid</button>`}</td>
            </tr>`;
          }).join('') + `</tbody></table>`;

      document.getElementById('claims')!.querySelectorAll('[data-discharge]').forEach((b) => {
        b.addEventListener('click', () => discharge((b as HTMLElement).dataset.discharge as string));
      });
      document.getElementById('claims')!.querySelectorAll('[data-ask]').forEach((b) => {
        b.addEventListener('click', () => askClient((b as HTMLElement).dataset.ask as string));
      });

      // Prefill the claim amount with the remaining headroom
      const amt = $('c-amt'); if (amt && !amt.value && avail > 0) amt.value = String(avail);
      const d = $('c-date'); if (d && !d.value) d.value = new Date().toISOString().slice(0, 10);
    }

    async function registerClaim() {
      const out = $('c-out') as unknown as HTMLElement;
      if (!current) { show(out, 'Check a receivable first.', 'note-loss'); return; }
      const financier = val('c-fin'), amount = Number(val('c-amt'));
      if (!financier) { show(out, 'Enter your firm name.', 'note-loss'); return; }
      if (!amount || amount <= 0) { show(out, 'Enter the amount you are advancing.', 'note-loss'); return; }
      show(out, 'Signing and registering…');
      try {
        const r = await fetch('/api/verify/receivables/claim', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ receivableId: current.id, financier, amount, date: val('c-date') || undefined }),
        });
        const j = await r.json();
        if (r.status === 401) { show(out, 'Your session ended. <a href="/verify/login?next=/verify/desk" style="color:var(--accent)">Sign in again</a> to register the claim.', 'note-loss'); return; }
        if (!j.ok) {
          if (j.error === 'exceeds_available') {
            show(out, `<b>Refused. This would be a duplicate.</b><br>Only ${esc(money(Number(j.available || 0), current.currency || 'NGN'))} is unencumbered, and you tried to claim ${esc(money(amount, current.currency || 'NGN'))}. The write was rejected before any money moved.`, 'note-loss');
          } else {
            show(out, 'Could not register that claim: ' + esc(j.error || 'unknown error'), 'note-loss');
          }
          await check(current.id);
          return;
        }
        show(out, `<b>Claim registered and signed.</b> Now ${esc(money(Number(j.claimed || 0), current.currency || 'NGN'))} claimed, ${esc(money(Math.max(0, Number(j.available || 0)), current.currency || 'NGN'))} unencumbered.<br><span id="k-anchor">&#9203; Timestamping to Bitcoin…</span>`, 'note-gain');
        try {
          const a = await (await fetch('/api/verify/receivables/anchor', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ kind: 'claim', id: j.claimId }),
          })).json();
          const el = document.getElementById('k-anchor');
          if (el) el.textContent = a && a.ok
            ? '⏳ Timestamp submitted to Bitcoin, pending a block (~1-2h). Its date can no longer be forged or backdated.'
            : 'Signed. The Bitcoin timestamp did not submit; you can anchor it from the workbench.';
        } catch { /* non-fatal */ }
        await check(current.id);
      } catch (e) {
        show(out, 'Could not reach the registry. Try again.', 'note-loss');
      }
    }

    // Releasing a claim once the debtor has paid frees the headroom again, so no phantom
    // lien outlives the payment. Only the financier who registered it can discharge it —
    // the API enforces that, since the public record never says whose claim is whose.
    async function discharge(claimId: string) {
      const out = $('c-out') as unknown as HTMLElement;
      if (!confirm('Mark this claim repaid? That releases it and frees the headroom.')) return;
      show(out, 'Releasing…');
      try {
        const r = await fetch('/api/verify/receivables/discharge', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ claimId }),
        });
        const j = await r.json();
        if (r.status === 401) { show(out, 'Your session ended. <a href="/verify/login?next=/verify/desk" style="color:var(--accent)">Sign in again</a>.', 'note-loss'); return; }
        if (!j.ok) {
          show(out, j.error === 'not_found'
            ? 'That claim was registered by another financier, so only they can release it.'
            : 'Could not release that claim: ' + esc(j.error || 'unknown error'), 'note-loss');
          return;
        }
        show(out, `<b>Claim released.</b> ${esc(money(Math.max(0, Number(j.available || 0)), current?.currency || 'NGN'))} is unencumbered again.`, 'note-gain');
        if (current) await check(current.id);
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    // ── Invitations ────────────────────────────────────────────────────────
    // The link is the capability: single use, seven days, and spent on acceptance.
    async function loadInvites() {
      const box = document.getElementById('inv-list')!;
      try {
        const r = await fetch('/api/verify/receivables/invite');
        if (r.status === 401) { box.innerHTML = ''; return; }
        const j = await r.json();
        const list = j.invites ?? [];
        if (!list.length) { box.innerHTML = '<p class="muted">No invitations sent yet.</p>'; return; }
        box.innerHTML = `<table><thead><tr><th>Invited</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>` +
          list.map((v: any) => {
            const status = v.revokedAt ? 'withdrawn'
              : v.acceptedAt ? 'accepted'
              : (v.expiresAt < new Date().toISOString().replace('T', ' ').slice(0, 19) ? 'expired' : 'waiting');
            const link = `${location.origin}/verify/invite?token=${encodeURIComponent(v.token)}`;
            return `<tr>
              <td>${esc(v.label || '—')}<br><span class="muted">${esc(String(v.createdAt).slice(0, 10))}</span></td>
              <td>${esc(v.role)}</td>
              <td><span class="tag ${status === 'accepted' ? 'active' : 'off'}">${esc(status)}</span></td>
              <td>${status === 'waiting'
                ? `<button class="small ghost" data-copy="${esc(link)}">Copy link</button>
                   <button class="small ghost" data-revoke="${esc(v.token)}">Withdraw</button>`
                : ''}</td>
            </tr>`;
          }).join('') + `</tbody></table>`;

        box.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', async (e) => {
          const el = e.currentTarget as HTMLElement;
          try {
            await navigator.clipboard.writeText(el.dataset.copy as string);
            const t = el.textContent; el.textContent = 'Copied';
            setTimeout(() => { el.textContent = t; }, 1400);
          } catch { /* clipboard unavailable */ }
        }));
        box.querySelectorAll('[data-revoke]').forEach((b) => b.addEventListener('click', async (e) => {
          const el = e.currentTarget as HTMLElement;
          if (!confirm('Withdraw this invitation? The link stops working.')) return;
          await fetch('/api/verify/receivables/invite', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'revoke', token: el.dataset.revoke }),
          });
          loadInvites();
        }));
      } catch { box.innerHTML = ''; }
    }

    async function createInvite() {
      const out = $('inv-out') as unknown as HTMLElement;
      const label = val('inv-label');
      show(out, 'Creating…');
      try {
        const r = await fetch('/api/verify/receivables/invite', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: 'borrower', label: label || null }),
        });
        const j = await r.json();
        if (r.status === 401) { show(out, 'Your session ended. <a href="/verify/login?next=/verify/desk" style="color:var(--accent)">Sign in again</a>.', 'note-loss'); return; }
        if (!j.ok) { show(out, 'Could not create that invitation: ' + esc(j.error || 'unknown error'), 'note-loss'); return; }
        const link = `${location.origin}/verify/invite?token=${encodeURIComponent(j.token)}`;
        show(out, `<b>Invitation ready.</b> Send this to your client. It works once and expires in seven days.<br><code style="word-break:break-all;font-size:.78rem">${esc(link)}</code>`, 'note-gain');
        loadInvites();
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    document.getElementById('inv-go')?.addEventListener('click', createInvite);
    loadInvites();

    // ── Intake: record a new deal ───────────────────────────────────────────
    //
    // The banker-led flow: the client is across the desk with his paperwork, so the record
    // is created here rather than on a page written in the client's voice. On success it
    // loads straight into the panel below, so attaching papers and asking the debtor are
    // the next two clicks and nobody has to re-paste an ID.
    function addExtraRow(label = '', value = '') {
      const box = document.getElementById('n-extra')!;
      const row = document.createElement('div');
      row.className = 'xrow';
      const l = document.createElement('input'); l.placeholder = 'Field name'; l.value = label;
      const v = document.createElement('input'); v.placeholder = 'Value'; v.value = value;
      const x = document.createElement('button'); x.type = 'button'; x.textContent = '\u2715';
      x.setAttribute('aria-label', 'Remove this field');
      x.addEventListener('click', () => row.remove());
      row.append(l, v, x);
      box.appendChild(row);
      l.focus();
    }

    function readExtras(): Array<{ label: string; value: string }> {
      return Array.from(document.querySelectorAll('#n-extra .xrow')).map((r) => {
        const [l, v] = Array.from(r.querySelectorAll('input')) as HTMLInputElement[];
        return { label: (l?.value ?? '').trim(), value: (v?.value ?? '').trim() };
      }).filter((e) => e.label && e.value);
    }

    async function createDeal() {
      const out = $('n-out') as unknown as HTMLElement;
      const supplier = val('n-sup'), buyer = val('n-buy'), invoiceNo = val('n-inv');
      const face = Number(val('n-face'));
      if (!supplier || !buyer || !invoiceNo) {
        show(out, 'Client, debtor and invoice number are all needed.', 'note-loss'); return;
      }
      if (!face || face <= 0) { show(out, 'Enter the face value of the invoice.', 'note-loss'); return; }

      show(out, 'Signing and recording…');
      try {
        const r = await fetch('/api/verify/receivables', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            supplier, buyer, invoiceNo, face,
            currency: val('n-ccy') || 'NGN',
            terms: val('n-terms') || null,
            dueDate: val('n-due') || null,
            details: {
              invoiceDate: val('n-idate') || null,
              deliveryDate: val('n-ddate') || null,
              buyerRef: val('n-ref') || null,
              goods: val('n-goods') || null,
              paymentInstructions: val('n-pay') || null,
              extra: readExtras(),
            },
          }),
        });
        const j = await r.json();
        if (!j.ok) { show(out, esc(j.message || 'Could not record that.'), 'note-loss'); return; }

        show(out, `<b>Recorded and signed.</b> Receivable ID <code>${esc(j.id)}</code><br><span id="n-anchor">&#9203; Timestamping to Bitcoin…</span>`, 'note-gain');
        try {
          const a = await (await fetch('/api/verify/receivables/anchor', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ kind: 'receivable', id: j.id }),
          })).json();
          const el = document.getElementById('n-anchor');
          if (el) el.textContent = a && a.ok
            ? '⏳ Timestamp submitted to Bitcoin, pending a block (~1-2h). Its date can no longer be forged or backdated.'
            : 'Signed. The Bitcoin timestamp did not submit; you can anchor it from the workbench.';
        } catch { /* non-fatal */ }

        // Straight into the panel: attach the papers, then ask the debtor.
        ($('q-id') as HTMLInputElement).value = j.id;
        await check(j.id);
        document.getElementById('panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    document.getElementById('n-add')?.addEventListener('click', () => addExtraRow());
    document.getElementById('n-go')?.addEventListener('click', createDeal);

    // ── Documents ───────────────────────────────────────────────────────────
    async function loadDocs() {
      const box = document.getElementById('d-list')!;
      if (!current?.id) { box.innerHTML = ''; return; }
      try {
        const r = await fetch('/api/verify/receivables/document?receivableId=' + encodeURIComponent(current.id));
        const j = await r.json();
        const docs = j.documents ?? [];
        if (!j.ok || !docs.length) {
          box.innerHTML = '<p class="hint" style="margin-top:.7rem">Nothing attached yet.</p>';
          return;
        }
        box.innerHTML = '<table style="margin-top:.8rem"><thead><tr><th>File</th><th>Size</th><th>Fingerprint</th><th>State</th></tr></thead><tbody>' +
          docs.map((d: any) => `<tr>
              <td>${esc(d.filename)}</td>
              <td>${(Number(d.fileSize) / 1024).toFixed(0)} KB</td>
              <td style="font-family:ui-monospace,Menlo,monospace;font-size:.66rem;word-break:break-all">${esc(String(d.sha256).slice(0, 24))}…</td>
              <td>${d.purgedAt ? `<span class="muted">removed ${esc(d.purgedAt)}</span>` : 'held'}</td>
            </tr>`).join('') +
          '</tbody></table>';
      } catch { box.innerHTML = ''; }
    }

    async function uploadDoc() {
      const out = $('d-out') as unknown as HTMLElement;
      const input = $('d-file') as HTMLInputElement;
      const file = input?.files?.[0];
      if (!current?.id) { show(out, 'Look up a receivable first.', 'note-loss'); return; }
      if (!file) { show(out, 'Choose a file first.', 'note-loss'); return; }
      show(out, 'Attaching…');
      try {
        const fd = new FormData();
        fd.append('receivableId', current.id);
        fd.append('file', file);
        const r = await fetch('/api/verify/receivables/document', { method: 'POST', body: fd });
        const j = await r.json();
        if (!j.ok) {
          const why = j.error === 'too_large' ? 'That file is over 5 MB.'
            : j.error === 'unsupported_type' ? 'PDF or image only.'
            : j.error === 'not_found' ? 'That receivable is not yours to attach to.'
            : 'Could not attach that file.';
          show(out, why, 'note-loss'); return;
        }
        input.value = '';
        show(out, `Attached. Fingerprint ${esc(String(j.doc.sha256).slice(0, 16))}…`, 'note-gain');
        loadDocs();
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    // ── Confirmation requests ───────────────────────────────────────────────
    async function loadConfirms() {
      const box = document.getElementById('k-list')!;
      if (!current?.id) { box.innerHTML = ''; return; }
      try {
        const r = await fetch('/api/verify/receivables/invite?receivableId=' + encodeURIComponent(current.id));
        const j = await r.json();
        const reqs = j.requests ?? [];
        if (!j.ok || !reqs.length) {
          box.innerHTML = '<p class="hint" style="margin-top:.7rem">Nobody asked yet.</p>';
          return;
        }
        box.innerHTML = '<table style="margin-top:.8rem"><thead><tr><th>Sent to</th><th>Status</th><th>Answered by</th><th></th></tr></thead><tbody>' +
          reqs.map((v: any) => {
            const link = `${location.origin}/verify/authenticate?token=${encodeURIComponent(v.token)}`;
            const who = v.sentTo || v.label || 'no address recorded';
            const state = v.status === 'answered' ? `<span class="ok">answered ${esc(String(v.answeredAt || '').slice(0, 10))}</span>`
              : v.status === 'expired' ? '<span class="muted">expired</span>'
              : v.status === 'revoked' ? '<span class="muted">revoked</span>'
              : `<span>pending, expires ${esc(String(v.expiresAt).slice(0, 10))}</span>`;
            const action = v.status === 'pending'
              ? `<button class="ghost" data-copy="${esc(link)}">Copy link</button>`
              : '';
            return `<tr>
              <td>${esc(who)}${v.label && v.sentTo ? `<div class="muted" style="font-size:.72rem">${esc(v.label)}</div>` : ''}</td>
              <td>${state}</td>
              <td>${esc(v.answeredBy || '—')}</td>
              <td>${action}</td>
            </tr>`;
          }).join('') +
          '</tbody></table>';
        box.querySelectorAll('button[data-copy]').forEach((b) => {
          b.addEventListener('click', () => {
            navigator.clipboard?.writeText((b as HTMLElement).dataset.copy || '');
            (b as HTMLElement).textContent = 'Copied';
          });
        });
      } catch { box.innerHTML = ''; }
    }

    async function createConfirmRequest() {
      const out = $('k-out') as unknown as HTMLElement;
      if (!current?.id) { show(out, 'Look up a receivable first.', 'note-loss'); return; }
      const email = val('k-email');
      if (!email) { show(out, 'An address is what records where the answer came from. Add one.', 'note-loss'); return; }
      show(out, 'Creating…');
      try {
        const r = await fetch('/api/verify/receivables/invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: 'buyer', receivableId: current.id, email, label: val('k-label') || null }),
        });
        const j = await r.json();
        if (!j.ok) { show(out, 'Could not create that link.', 'note-loss'); return; }
        const link = `${location.origin}/verify/authenticate?token=${encodeURIComponent(j.token)}`;
        await navigator.clipboard?.writeText(link).catch(() => {});
        ($('k-email') as HTMLInputElement).value = '';
        ($('k-label') as HTMLInputElement).value = '';
        show(out, `Link copied. Send it to ${esc(email)}. It works once and expires in 7 days.`, 'note-gain');
        loadConfirms();
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    // ── Counter-signature ───────────────────────────────────────────────────
    async function askClient(claimId: string) {
      const out = $('c-out') as unknown as HTMLElement;
      const email = prompt('Your client\u2019s email address. The link records where the answer came from.');
      if (email === null) return;
      if (!email.trim()) { show(out, 'An address is needed. It is what records where the answer came from.', 'note-loss'); return; }
      show(out, 'Creating\u2026');
      try {
        const r = await fetch('/api/verify/receivables/invite', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: 'borrower', receivableId: current.id, claimId, email: email.trim() }),
        });
        const j = await r.json();
        if (!j.ok) { show(out, 'Could not create that link.', 'note-loss'); return; }
        const link = `${location.origin}/verify/countersign?token=${encodeURIComponent(j.token)}`;
        await navigator.clipboard?.writeText(link).catch(() => {});
        show(out, `Link copied. Send it to ${esc(email.trim())}. Your claim shows as confirmed once he answers.`, 'note-gain');
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    document.getElementById('d-go')?.addEventListener('click', uploadDoc);
    document.getElementById('k-go')?.addEventListener('click', createConfirmRequest);

    document.getElementById('q-go')?.addEventListener('click', () => check());
    $('q-id')?.addEventListener('keydown', (e: any) => { if (e.key === 'Enter') check(); });
    document.getElementById('c-go')?.addEventListener('click', registerClaim);

    if (val('q-id')) check();
  </script>
</body>
</html>
