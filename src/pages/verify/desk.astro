---
// Almstins Verify — Financing Desk (financier-facing view).
//
// A role-scoped console over the same endpoints as /verify/registry. Where the registry
// page is a workbench showing every tool at once, this presents one job: decide whether
// to advance against a receivable, and record the claim if you do.
//
// The headline figure is the unencumbered headroom, because that is the number the
// financing decision turns on. The debtor's acknowledgment is surfaced as its own
// evidence row: it is the keystone a lender leans on, so its absence should be loud.
//
// Read-only against everything except this tenant's own claims. No tenant_id or identity
// is ever rendered — only self-chosen financier labels. Signed-in only: unauthenticated
// visitors are redirected to /login and returned here.
import '@/styles/tokens.css';
import { requireTenantSession } from '@/lib/requireTenantSession';
import { getAuthSession } from '@/lib/authSession';
import AccountMenu from '@/components/verify/AccountMenu.astro';
import { TERMS } from '@/lib/verifyTerms';

export const prerender = false;

// Both role desks require a signed-in account. The no-account public check still lives
// at /verify/registry; these are the working desks for named parties, so they sign in.
const sess = await requireTenantSession(Astro.request);
if (!sess) return Astro.redirect('/verify/login?next=/verify/desk', 302);

const authSession = await getAuthSession(Astro.request);
const email = authSession?.user?.email ?? null;

const prefillId = Astro.url.searchParams.get('id') ?? '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Financing Desk — Almstins Verify</title>
  <meta name="description" content="Check what is already claimed against a receivable before you advance against it." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon-verify.png" />
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--surface-bg); color: var(--text-primary); min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6; padding: 2rem 1.1rem 5rem;
    }
    .wrap { max-width: 60rem; margin: 0 auto; display: flex; flex-direction: column; gap: 1.15rem; }

    header { display: flex; flex-direction: column; gap: .35rem; margin-bottom: .35rem; }
    .head-top { display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
    .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
    h1 { font-size: clamp(1.6rem, 3.6vw, 2.1rem); line-height: 1.15; font-weight: 700; }
    .lede { color: var(--text-secondary); font-size: .95rem; max-width: 40rem; }

    .card { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: 14px; padding: 1.15rem 1.3rem; }
    .card h2 { font-size: 1.02rem; font-weight: 700; margin-bottom: .25rem; }
    .card .hint { font-size: .82rem; color: var(--text-muted); margin-bottom: .9rem; }

    .row { display: flex; gap: .6rem; flex-wrap: wrap; }
    input, select {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 9px;
      color: var(--text-primary); padding: .6rem .75rem; font-size: .9rem; font-family: inherit; min-width: 0;
    }
    input:focus, select:focus { outline: none; border-color: var(--accent); }
    input::placeholder { color: var(--text-muted); }
    .grow { flex: 1 1 16rem; }
    button {
      background: var(--accent); color: var(--surface-bg); border: none; border-radius: 9px;
      padding: .6rem 1.05rem; font-size: .88rem; font-weight: 700; cursor: pointer; font-family: inherit;
    }
    button:hover { filter: brightness(1.08); }
    button:disabled { opacity: .5; cursor: not-allowed; }
    button.ghost { background: transparent; border: 1px solid var(--border-bright); color: var(--text-secondary); font-weight: 600; }
    button.ghost:hover { background: var(--surface-hover); filter: none; }
    button.small { padding: .34rem .7rem; font-size: .78rem; }

    /* ── Decision banner: the number the call turns on ── */
    .verdict { border-radius: 13px; padding: 1.1rem 1.25rem; border: 1px solid; display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline; justify-content: space-between; }
    .verdict.clear { background: var(--gain-bg); border-color: var(--gain-border); }
    .verdict.partial { background: var(--warn-bg, var(--accent-soft)); border-color: var(--warn-border, var(--accent-glow)); }
    .verdict.blocked { background: var(--loss-bg); border-color: var(--loss-border); }
    .verdict__label { font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .85; }
    .verdict.clear .verdict__label { color: var(--gain); }
    .verdict.partial .verdict__label { color: var(--warning, var(--accent)); }
    .verdict.blocked .verdict__label { color: var(--loss); }
    .verdict__num { font-size: clamp(1.5rem, 4vw, 2.05rem); font-weight: 800; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .verdict__sub { font-size: .84rem; color: var(--text-secondary); }

    .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .85rem 1.1rem; margin-top: 1rem; }
    .fact__k { font-size: .68rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--text-muted); }
    .fact__v { font-size: .95rem; font-weight: 600; font-variant-numeric: tabular-nums; word-break: break-word; }

    /* Evidence rows — the debtor ack is the keystone, so absence is loud */
    .evidence { margin-top: 1.05rem; display: flex; flex-direction: column; gap: .5rem; }
    .ev { display: flex; gap: .7rem; align-items: flex-start; padding: .65rem .8rem; border-radius: 10px; border: 1px solid var(--border-subtle); background: var(--surface-card-2); }
    .ev.good { border-color: var(--gain-border); background: var(--gain-bg); }
    .ev.missing { border-color: var(--loss-border); background: var(--loss-bg); }
    .ev__icon { flex: 0 0 auto; font-size: .95rem; line-height: 1.5; }
    .ev__t { font-size: .88rem; font-weight: 700; }
    .ev__d { font-size: .8rem; color: var(--text-secondary); }

    table { width: 100%; border-collapse: collapse; font-size: .86rem; margin-top: .3rem; }
    th { text-align: right; font-size: .66rem; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); font-weight: 700; padding: .3rem .55rem; border-bottom: 1px solid var(--border-subtle); white-space: nowrap; }
    th:first-child { text-align: left; }
    td { padding: .5rem .55rem; border-bottom: 1px solid var(--border-subtle); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    td:first-child { text-align: left; white-space: normal; }
    tr.discharged td { opacity: .5; }
    .tag { font-size: .66rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: .1rem .45rem; border-radius: 99px; border: 1px solid; }
    .tag.active { color: var(--accent); border-color: var(--accent-glow); background: var(--accent-soft); }
    .tag.off { color: var(--text-muted); border-color: var(--border-subtle); background: var(--surface-card); }

    .note { border-radius: 10px; padding: .7rem .85rem; font-size: .86rem; margin-top: .8rem; display: none; }
    .note.show { display: block; }
    .note-gain { background: var(--gain-bg); border: 1px solid var(--gain-border); color: var(--text-primary); }
    .note-loss { background: var(--loss-bg); border: 1px solid var(--loss-border); color: var(--text-primary); }
    .note-info { background: var(--accent-soft); border: 1px solid var(--accent-glow); color: var(--text-primary); }
    .muted { color: var(--text-muted); font-size: .8rem; }
    button.term {
      background: none; border: none; padding: 0; cursor: help; font: inherit;
      color: var(--text-secondary); text-decoration: underline dotted; text-underline-offset: .18em;
    }
    button.term:hover { color: var(--accent); filter: none; }
    .tw { display: inline; }
    .termdef {
      display: block; margin-top: .5rem; padding: .6rem .75rem; font-size: .82rem;
      background: var(--surface-card-2); border: 1px solid var(--border-subtle);
      border-left: 2px solid var(--accent); border-radius: 8px; color: var(--text-secondary);
    }
    .termdef b { color: var(--text-primary); }

    /* Credit view */
    #credit .lead { font-size: .96rem; color: var(--text-primary); margin-bottom: 1rem; }
    .alloc { margin-bottom: 1.3rem; }
    .alloc__bar { display: flex; height: .85rem; border-radius: 99px; overflow: hidden; background: var(--surface-card-2); border: 1px solid var(--border-subtle); }
    .alloc__used { background: var(--loss); }
    .alloc__free { background: var(--gain); }
    .alloc__keys { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; margin-top: .55rem; font-size: .82rem; color: var(--text-secondary); }
    .alloc__keys b { color: var(--text-primary); font-variant-numeric: tabular-nums; }
    .alloc__keys .used b { color: var(--loss); }
    .alloc__keys .free b { color: var(--gain); }

    .two-col { display: grid; grid-template-columns: 1fr; gap: 1.4rem; }
    @media (min-width: 860px) { .two-col { grid-template-columns: 1.15fr 1fr; gap: 2rem; } }
    .col-h { font-size: .66rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--gain); margin-bottom: .7rem; }
    .col-h--warn { color: var(--text-muted); }

    .ck { display: flex; gap: .6rem; align-items: flex-start; padding: .45rem 0; }
    .ck__i { flex: 0 0 auto; width: 1.15rem; height: 1.15rem; border-radius: 99px; display: flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 700; margin-top: .12rem; }
    .ck__i.yes { color: var(--gain); background: var(--gain-bg); border: 1px solid var(--gain-border); }
    .ck__i.no  { color: var(--loss); background: var(--loss-bg); border: 1px solid var(--loss-border); }
    .ck__i.na  { color: var(--text-muted); background: var(--surface-card-2); border: 1px solid var(--border-subtle); }
    .ck__l { font-size: .88rem; font-weight: 650; }
    .ck__d { font-size: .8rem; color: var(--text-secondary); }

    .nk { padding: .45rem 0; border-bottom: 1px solid var(--border-subtle); }
    .nk:last-child { border-bottom: none; }
    .nk__l { font-size: .85rem; font-weight: 650; color: var(--text-secondary); }
    .nk__d { font-size: .78rem; color: var(--text-muted); }
    select#cs-claim {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 9px;
      color: var(--text-primary); padding: .55rem .7rem; font-size: .9rem; font-family: inherit;
    }
    select#cs-claim:focus { outline: none; border-color: var(--accent); }
    /* The intake tin. Wider than the reading cards because it is a form, capped so it does
       not stretch to 2000px on a desktop monitor. */
    .card.tin { width: 100%; max-width: 62rem; padding: 1.5rem 1.65rem; }
    @media (min-width: 1100px) { .card.tin { width: 80%; } }

    details.more { margin-top: .9rem; border-top: 1px solid var(--border-subtle); padding-top: .8rem; }
    details.more > summary {
      cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: .5rem;
      font-size: .8rem; font-weight: 650; color: var(--text-secondary); user-select: none;
    }
    details.more > summary::-webkit-details-marker { display: none; }
    details.more > summary:hover { color: var(--accent); }
    .more__i {
      width: 1.25rem; height: 1.25rem; border-radius: 6px; display: inline-flex;
      align-items: center; justify-content: center; font-weight: 700;
      border: 1px solid var(--border-bright); color: var(--text-secondary); font-size: .9rem;
    }
    details.more[open] > summary .more__i { color: var(--accent); border-color: var(--accent-glow); background: var(--accent-soft); }
    details.more[open] > summary .more__i::after { content: ''; }
    .sep { border-top: 1px solid var(--border-subtle); margin: 1.1rem 0 .9rem; }

    .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: .7rem; }
    .fld {
      display: flex; flex-direction: column; gap: .28rem;
      font-size: .68rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--text-muted);
    }
    .fld input, .fld select {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 8px;
      color: var(--text-primary); padding: .5rem .6rem; font-size: .9rem; font-family: inherit;
      font-weight: 400; letter-spacing: normal; text-transform: none; width: 100%;
    }
    .fld input:focus, .fld select:focus { outline: none; border-color: var(--accent); }
    .req { color: var(--accent); font-size: .58rem; letter-spacing: .06em; }
    .xrow { display: flex; gap: .5rem; align-items: center; margin-bottom: .5rem; }
    .xrow input { flex: 1 1 0; min-width: 0; }
    .xrow button {
      background: transparent; border: 1px solid var(--border-subtle); color: var(--text-muted);
      border-radius: 8px; padding: .4rem .6rem; font-size: .85rem; line-height: 1; cursor: pointer;
    }
    .ok { color: var(--gain); font-weight: 600; }
    /* The book reads as an inbox: a scrolling pane with a sticky header, so twenty deals
       do not push the rest of the desk off the screen. */
    .inbox { max-height: 22rem; overflow-y: auto; border: 1px solid var(--border-subtle); border-radius: 10px; }
    .inbox table { margin-top: 0; }
    .inbox thead th { position: sticky; top: 0; background: var(--surface-card); z-index: 1; padding: .5rem .55rem; }
    .inbox td { padding: .45rem .55rem; }
    tr.book-row { cursor: pointer; }
    tr.book-row:hover td { background: var(--surface-hover); }
    td.dt { color: var(--text-muted); font-size: .8rem; }
    td.idcell { white-space: nowrap; text-align: right; }
    button.idlink {
      background: transparent; border: none; padding: 0 .3rem 0 0; cursor: pointer;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .76rem;
      color: var(--accent); font-weight: 600;
    }
    button.idlink:hover { text-decoration: underline; filter: none; }
    button.idcopy {
      background: transparent; border: 1px solid var(--border-subtle); border-radius: 6px;
      color: var(--text-muted); cursor: pointer; font-size: .8rem; line-height: 1;
      padding: .2rem .35rem;
    }
    button.idcopy:hover { color: var(--accent); border-color: var(--accent-glow); background: var(--surface-hover); filter: none; }
    input[type=file] {
      background: var(--surface-card-2); border: 1px solid var(--border-subtle); border-radius: 9px;
      color: var(--text-secondary); padding: .5rem .6rem; font-size: .85rem; font-family: inherit;
    }
    input[type=file]::file-selector-button {
      background: transparent; border: 1px solid var(--border-bright); border-radius: 7px;
      color: var(--text-secondary); padding: .3rem .6rem; margin-right: .6rem;
      font-family: inherit; font-size: .8rem; font-weight: 600; cursor: pointer;
    }
    .foot { margin-top: 1.4rem; font-size: .77rem; color: var(--text-muted); border-top: 1px solid var(--border-subtle); padding-top: 1rem; }
    .foot a { color: var(--accent); }
    #panel { display: none; }
    #panel.show { display: block; }
  </style>
</head>
<body>
  <div class="wrap">

    <header>
      <div class="head-top">
        <div>
          <div class="eyebrow">Almstins Verify</div>
          <h1>Financing Desk</h1>
        </div>
        <AccountMenu tenantId={sess.tenantId} email={email} current="desk" />
      </div>
      <p class="lede">Record a client's deal, attach the paperwork, and see everything already standing against it before you advance.</p>
    </header>

    <div class="card" id="waiting-card" style="display:none">
      <h2>Waiting on someone</h2>
      <p class="hint">Requests nobody has answered yet, across every deal. Lapsed ones are recorded as unanswered on the record itself.</p>
      <div id="waiting-list"></div>
    </div>

    <div class="card">
      <h2>Your book</h2>
      <p class="hint">
        Every deal you have recorded, newest first. Click a row to open it, click an ID to check
        its status, or copy the ID to hand to another financier.
      </p>
      <div class="row" style="margin-bottom:.6rem">
        <input id="book-q" class="grow" placeholder="Filter by client, debtor or invoice number" autocomplete="off" />
      </div>
      <div id="book-list" class="inbox"></div>
    </div>

    <div class="card tin">
      <h2>New client</h2>
      <p class="hint">
        He is across the desk with his paperwork. Record what he is owed, scan the papers in, and
        send both confirmations without leaving this card. Only the four marked fields are required.
      </p>

      <div class="grid2">
        <label class="fld">Client <span class="req">required</span>
          <input id="n-sup" placeholder="Who you are financing" autocomplete="off" />
        </label>
        <label class="fld">Debtor <span class="req">required</span>
          <input id="n-buy" placeholder="Who owes him the money" autocomplete="off" />
        </label>
        <label class="fld">Invoice number <span class="req">required</span>
          <input id="n-inv" placeholder="INV-2093" autocomplete="off" />
        </label>
        <label class="fld">Face value <span class="req">required</span>
          <input id="n-face" type="number" step="0.01" min="0" placeholder="50000000" />
        </label>
        <label class="fld">Currency
          <select id="n-ccy">
            <option value="NGN">NGN</option><option value="USD">USD</option>
            <option value="GBP">GBP</option><option value="EUR">EUR</option>
            <option value="GHS">GHS</option><option value="KES">KES</option>
            <option value="ZAR">ZAR</option>
          </select>
        </label>
      </div>

      <details class="more">
        <summary><span class="more__i">+</span> More from the contract</summary>
        <div class="grid2" style="margin-top:.8rem">
        <label class="fld">Debtor's own reference
          <input id="n-ref" placeholder="Their PO or contract no." autocomplete="off" />
        </label>
        <label class="fld">Invoice date<input id="n-idate" type="date" /></label>
        <label class="fld">Delivery date<input id="n-ddate" type="date" /></label>
        <label class="fld">Due date<input id="n-due" type="date" /></label>
        <label class="fld">Terms
          <select id="n-terms">
            <option value="">not stated</option>
            <option>Net 30</option><option>Net 45</option><option>Net 60</option>
            <option>Net 90</option><option>Due on receipt</option>
          </select>
        </label>
      </div>

      <label class="fld" style="margin-top:.7rem">Goods or services
        <input id="n-goods" placeholder="What was supplied" autocomplete="off" />
      </label>
      <label class="fld" style="margin-top:.7rem">Payment instructions
        <input id="n-pay" placeholder="Where the debtor is to pay" autocomplete="off" />
      </label>

        <div id="n-extra" style="margin-top:.9rem"></div>
        <div class="row" style="margin-top:.6rem">
          <button class="small ghost" id="n-add" type="button">+ Add a field</button>
        </div>
      </details>

      <div class="sep"></div>

      <label class="fld">The paperwork
        <input id="n-file" type="file" multiple accept="application/pdf,image/png,image/jpeg,image/gif,image/webp" />
      </label>
      <p class="hint" style="margin:.4rem 0 0">
        Scan the promissory note or contract he brought in. Fingerprinted on upload, shown to both
        people you ask, then deleted once they have answered.
      </p>

      <div class="grid2" style="margin-top:.9rem">
        <label class="fld">Email the debtor <span class="req">to confirm the debt</span>
          <input id="n-demail" type="email" placeholder="accounts@their-company.com" autocomplete="off" />
        </label>
        <label class="fld">Email the client <span class="req">to confirm the record</span>
          <input id="n-cemail" type="email" placeholder="him@his-company.com" autocomplete="off" />
        </label>
      </div>
      <p class="hint" style="margin:.4rem 0 0">
        Leave either blank to skip it. You can always send it later from the record.
      </p>

      <div class="row" style="margin-top:1rem">
        <button id="n-go">Record, sign &amp; send</button>
      </div>
      <div id="n-out" class="note"></div>
    </div>

    <div class="card">
      <h2>Check a receivable</h2>
      <p class="hint">Nothing here reveals who holds the record, only what stands against it.</p>
      <div class="row">
        <input id="q-id" class="grow" placeholder="Receivable ID" value={prefillId} spellcheck="false" autocomplete="off" />
        <button id="q-go">Check</button>
      </div>
      <div id="q-out" class="note"></div>
    </div>

    <script type="application/json" id="terms-data" set:html={JSON.stringify(TERMS)}></script>

    <div id="panel">
      <div id="verdict"></div>

      <div class="card" id="credit" style="margin-top:1.15rem">
        <h2>Before you advance</h2>
        <p class="hint">
          Everything the decision turns on, and what none of it proves.
          Any underlined word explains itself: <span class="tw" id="tw-head"></span>,
          <span class="tw" id="tw-claim"></span>, <span class="tw" id="tw-conf"></span>.
        </p>
        <div id="credit-body"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>The record</h2>
        <p class="hint">What the parties have put their name to.</p>
        <div id="facts" class="facts"></div>
        <div id="evidence" class="evidence"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>Claims standing against it</h2>
        <p class="hint">Every advance registered by any financier holding this ID.</p>
        <div id="claims"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>The paperwork</h2>
        <p class="hint">
          The promissory note or contract your client brought in. PDF or photo, 5 MB each, as many as you need.
          It is shown to whoever you ask to confirm, then removed once they have all replied. The fingerprint stays.
        </p>
        <div class="row">
          <input id="d-file" type="file" accept="application/pdf,image/png,image/jpeg,image/gif,image/webp" class="grow" />
          <button id="d-go">Attach</button>
        </div>
        <div id="d-list"></div>
        <div id="d-out" class="note"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>Ask the debtor to confirm</h2>
        <p class="hint">
          Each request is its own single-use link. Ask more than one person if the amount warrants it:
          one reply from an address your client supplied proves less than two that agree, and two that
          disagree is the most useful answer you can get. They need no account.
        </p>
        <div class="row">
          <input id="k-email" class="grow" type="email" placeholder="accounts@feed-n-seed.com" autocomplete="off" />
          <input id="k-label" placeholder="Who this is (optional)" style="flex:0 1 14rem" autocomplete="off" />
          <button id="k-send">Create &amp; email</button>
          <button id="k-go" class="ghost">Create link only</button>
        </div>
        <div id="k-list"></div>
        <div id="k-out" class="note"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>Offer terms to your client</h2>
        <p class="hint">
          Sent once the debtor has confirmed. His acceptance is signed and timestamped before any
          money moves, which is when his signature is worth most: he accepts because that is how he
          gets funded. Nothing here moves money or stops you advancing when you judge it right.
        </p>
        <div class="row">
          <input id="o-fin" class="grow" placeholder="Your firm" autocomplete="off" />
          <input id="o-amt" type="number" step="0.01" min="0" placeholder="Amount he receives" style="flex:0 1 13rem" />
        </div>
        <div class="row" style="margin-top:.6rem">
          <input id="o-price" class="grow" placeholder="What it costs him, e.g. 3% of face deducted upfront" autocomplete="off" />
          <select id="o-rec" style="flex:0 1 15rem">
            <option value="recourse">With recourse — he repays if the debtor does not</option>
            <option value="non_recourse">Non-recourse — you carry the loss</option>
          </select>
        </div>
        <div class="row" style="margin-top:.6rem">
          <input id="o-repay" class="grow" placeholder="How it is repaid, e.g. the debtor pays us direct on the due date" autocomplete="off" />
          <input id="o-days" type="number" min="1" max="90" placeholder="Open for (days)" style="flex:0 1 11rem" />
        </div>
        <div class="row" style="margin-top:.6rem">
          <input id="o-email" class="grow" type="email" placeholder="him@his-company.com" autocomplete="off" />
          <button id="o-send">Create &amp; email</button>
          <button id="o-go" class="ghost">Create link only</button>
        </div>
        <div id="o-list"></div>
        <div id="o-out" class="note"></div>
      </div>

      <div class="card" style="margin-top:1.15rem">
        <h2>Register your claim</h2>
        <p class="hint">Signed and timestamped to Bitcoin. A claim over the remaining headroom is refused.</p>
        <div class="row">
          <input id="c-fin" class="grow" placeholder="Your firm" autocomplete="off" />
          <input id="c-amt" type="number" step="0.01" min="0" placeholder="Amount advanced" style="flex:0 1 12rem" />
          <input id="c-date" type="date" style="flex:0 1 11rem" />
        </div>
        <div class="row" style="margin-top:.6rem">
          <button id="c-go">Sign, register &amp; timestamp</button>
        </div>
        <div id="c-out" class="note"></div>
      </div>

      <div class="card" id="cs-card" style="margin-top:1.15rem">
        <h2>Ask your client to confirm receipt</h2>
        <p class="hint">
          Registering a claim is your own word that you advanced the money. Your client confirming he
          received it is what makes it evidence, and it is what stops anyone registering an advance
          they never made. He needs no account.
        </p>
        <p class="hint" id="cs-none" style="display:none">
          Register your claim above first. This asks your client to confirm he received that money.
        </p>
        <div id="cs-controls" style="display:none">
          <div class="row">
            <select id="cs-claim" style="flex:1 1 14rem"></select>
          </div>
          <div class="row" style="margin-top:.6rem">
            <input id="cs-email" class="grow" type="email" placeholder="john@123trucking.com" autocomplete="off" />
            <button id="cs-send">Create &amp; email</button>
            <button id="cs-go" class="ghost">Create link only</button>
          </div>
          <div id="cs-list"></div>
        </div>
        <div id="cs-out" class="note"></div>
      </div>
    </div>

    <p class="foot">
      This desk records and proves. It does not confirm that goods shipped or money moved, and it never says who anyone is.
      New here? Read the <a href="/verify/guide">user's guide</a>. See <a href="/verify/changelog">what changed</a>. Full workbench at <a href="/verify/registry">/verify/registry</a>.
    </p>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const val = (id: string) => ($(id)?.value ?? '').trim();
    function esc(s: unknown) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>
      )[c]!);
    }
    function money(n: number, ccy: string) {
      const v = Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `${ccy} ${v}`;
    }
    function show(el: HTMLElement, html: string, cls = 'note-info') {
      el.className = `note show ${cls}`; el.innerHTML = html;
    }
    function hide(el: HTMLElement) { el.className = 'note'; el.innerHTML = ''; }

    let current: any = null;
    let book: any[] = [];

    async function check(id?: string) {
      const rid = (id ?? val('q-id')).trim();
      const out = $('q-out') as unknown as HTMLElement;
      const panel = document.getElementById('panel')!;
      if (!rid) { show(out, 'Paste a receivable ID first.', 'note-loss'); return; }
      show(out, 'Checking…');
      try {
        const r = await fetch('/api/verify/receivables/lookup?id=' + encodeURIComponent(rid));
        const j = await r.json();
        if (!j.ok || !j.found) {
          hide(out); show(out, 'No receivable found for that ID. Check it with whoever sent it.', 'note-loss');
          panel.classList.remove('show'); current = null; return;
        }
        hide(out);
        current = j.receivable;
        render(current);
        panel.classList.add('show');
        loadDocs();
        loadConfirms();
        loadOffers();
      } catch (e) {
        show(out, 'Could not reach the registry. Try again.', 'note-loss');
      }
    }

    function render(r: any) {
      const ccy = r.currency || 'NGN';
      const avail = Number(r.available || 0);
      const claimed = Number(r.claimed || 0);

      // ── Decision banner ──
      let cls = 'clear', label = 'Unfinanced', sub = 'Nothing is claimed against this receivable.';
      if (r.settled) { cls = 'blocked'; label = 'Settled'; sub = 'This receivable is closed.'; }
      else if (r.status === 'over_financed') { cls = 'blocked'; label = 'Over-financed'; sub = 'Claims exceed the face value. Do not advance.'; }
      else if (avail <= 0) { cls = 'blocked'; label = 'Fully financed'; sub = 'No headroom remains. A further advance would be a duplicate.'; }
      else if (claimed > 0) { cls = 'partial'; label = 'Partially financed'; sub = `${money(claimed, ccy)} is already claimed by another financier.`; }
      document.getElementById('verdict')!.innerHTML = `
        <div class="verdict ${cls}">
          <div>
            <div class="verdict__label">${esc(label)} &middot; unencumbered headroom</div>
            <div class="verdict__num">${esc(money(Math.max(0, avail), ccy))}</div>
            <div class="verdict__sub">${esc(sub)}</div>
          </div>
          <div style="text-align:right">
            <div class="verdict__label">Face value</div>
            <div class="verdict__num" style="font-size:1.15rem">${esc(money(r.face, ccy))}</div>
          </div>
        </div>`;

      const tw = (id: string, key: string) => {
        const el = document.getElementById(id);
        if (el && !el.innerHTML) el.innerHTML = termSpan(key);
      };
      tw('tw-head', 'headroom');
      tw('tw-claim', 'claim');
      tw('tw-conf', 'receipt-confirmation');

      renderCreditView(r, ccy, claimed, avail);

      // ── Facts ──
      const f = (k: string, v: string) => `<div><div class="fact__k">${esc(k)}</div><div class="fact__v">${esc(v)}</div></div>`;
      const det = r.details || {};
      document.getElementById('facts')!.innerHTML =
        f('Client', r.supplier) + f('Debtor', r.buyer) + f('Invoice', r.invoiceNo) +
        (det.buyerRef ? f("Debtor's ref", det.buyerRef) : '') +
        (det.invoiceDate ? f('Invoiced', det.invoiceDate) : '') +
        (det.deliveryDate ? f('Delivered', det.deliveryDate) : '') +
        f('Terms', r.terms || 'not stated') + f('Due', r.dueDate || 'not stated') +
        f('Recorded', String(r.createdAt || '').slice(0, 10)) +
        (det.goods ? f('Goods or services', det.goods) : '') +
        (det.paymentInstructions ? f('Payment instructions', det.paymentInstructions) : '') +
        (Array.isArray(det.extra) ? det.extra.map((e: any) => f(e.label, e.value)).join('') : '');

      // ── Evidence: the debtor's acknowledgment is the keystone ──
      const buyerAck = (r.attestations || []).find((a: any) => a.role === 'buyer') || null;
      const acked = !!buyerAck || !!r.acknowledgedAt;
      const ackWhen = buyerAck?.date || r.acknowledgedAt || '';
      const ev: string[] = [];
      ev.push(acked
        ? `<div class="ev good"><div class="ev__icon">&#10003;</div><div><div class="ev__t">Debtor acknowledged the debt</div><div class="ev__d">${esc(buyerAck ? buyerAck.label : r.buyer)} confirmed this obligation${ackWhen ? ' on ' + esc(String(ackWhen).slice(0, 10)) : ''}. This is the evidence that does not come from the client.</div></div></div>`
        : `<div class="ev missing"><div class="ev__icon">!</div><div><div class="ev__t">No debtor acknowledgment</div><div class="ev__d">Nobody on the paying side has confirmed this debt. You are relying on the client's paperwork alone.</div></div></div>`);
      // A dispute is filed under the 'other' role so it can never sit in the buyer slot.
      // It still has to be the loudest thing on the page.
      const disputes = (r.attestations || []).filter((a: any) => String(a.statement || '').startsWith('DISPUTED'));
      disputes.forEach((d: any) => {
        ev.push(`<div class="ev missing"><div class="ev__icon">!</div><div><div class="ev__t">Disputed by ${esc(d.label)}</div><div class="ev__d">${esc(d.statement)}</div></div></div>`);
      });

      ev.push(r.anchored
        ? `<div class="ev good"><div class="ev__icon">&#9939;</div><div><div class="ev__t">Timestamped to Bitcoin</div><div class="ev__d">${r.anchoredAt ? 'Confirmed in a block on ' + esc(String(r.anchoredAt).slice(0, 10)) + '. The record\'s date cannot be forged or backdated.' : 'Submitted, pending a block. Once confirmed the date cannot be moved.'}</div></div></div>`
        : `<div class="ev"><div class="ev__icon">&middot;</div><div><div class="ev__t">Not yet timestamped</div><div class="ev__d">The record is signed but its date is not yet anchored publicly.</div></div></div>`);
      document.getElementById('evidence')!.innerHTML = ev.join('');

      // ── Claims ──
      const claims = r.claims || [];
      document.getElementById('claims')!.innerHTML = claims.length === 0
        ? `<p class="muted">No claims registered. The full face value is unencumbered.</p>`
        : `<table><thead><tr><th>Financier</th><th>Amount</th><th>Registered</th><th>Receipt</th><th>Status</th><th></th></tr></thead><tbody>` +
          claims.map((c: any) => {
            // "Claimed" has never meant "funded". Until the client counter-signs, this
            // row is one firm's word, and the desk says so rather than implying otherwise.
            const receipt = c.affirmed
              ? `<span class="ok">confirmed by ${esc(c.affirmedBy || 'the client')}</span>`
              : `<span class="muted">not confirmed</span>`;
            const ask = c.affirmed || c.status === 'discharged'
              ? ''
              : `<button class="small ghost" data-ask="${esc(c.id)}">Ask client</button>`;
            return `
            <tr class="${c.status === 'discharged' ? 'discharged' : ''}">
              <td>${esc(c.financier)}${c.anchored ? ' <span class="muted">&#9939;</span>' : ''}</td>
              <td>${esc(money(c.amount, c.currency || ccy))}</td>
              <td>${esc(String(c.registeredAt || '').slice(0, 10))}</td>
              <td>${receipt}</td>
              <td><span class="tag ${c.status === 'discharged' ? 'off' : 'active'}">${esc(c.status === 'discharged' ? 'discharged' : 'active')}</span></td>
              <td>${ask}${c.status === 'discharged' ? '' : ` <button class="small ghost" data-discharge="${esc(c.id)}">Mark repaid</button>`}</td>
            </tr>`;
          }).join('') + `</tbody></table>`;

      document.getElementById('claims')!.querySelectorAll('[data-discharge]').forEach((b) => {
        b.addEventListener('click', () => discharge((b as HTMLElement).dataset.discharge as string));
      });
      document.getElementById('claims')!.querySelectorAll('[data-ask]').forEach((b) => {
        b.addEventListener('click', () => askClient((b as HTMLElement).dataset.ask as string));
      });
      renderCountersignCard(claims, ccy);

      // Prefill the claim amount with the remaining headroom
      const amt = $('c-amt'); if (amt && !amt.value && avail > 0) amt.value = String(avail);
      const d = $('c-date'); if (d && !d.value) d.value = new Date().toISOString().slice(0, 10);
    }

    async function registerClaim() {
      const out = $('c-out') as unknown as HTMLElement;
      if (!current) { show(out, 'Check a receivable first.', 'note-loss'); return; }
      const financier = val('c-fin'), amount = Number(val('c-amt'));
      if (!financier) { show(out, 'Enter your firm name.', 'note-loss'); return; }
      if (!amount || amount <= 0) { show(out, 'Enter the amount you are advancing.', 'note-loss'); return; }
      show(out, 'Signing and registering…');
      try {
        const r = await fetch('/api/verify/receivables/claim', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ receivableId: current.id, financier, amount, date: val('c-date') || undefined }),
        });
        const j = await r.json();
        if (r.status === 401) { show(out, 'Your session ended. <a href="/verify/login?next=/verify/desk" style="color:var(--accent)">Sign in again</a> to register the claim.', 'note-loss'); return; }
        if (!j.ok) {
          if (j.error === 'exceeds_available') {
            show(out, `<b>Refused. This would be a duplicate.</b><br>Only ${esc(money(Number(j.available || 0), current.currency || 'NGN'))} is unencumbered, and you tried to claim ${esc(money(amount, current.currency || 'NGN'))}. The write was rejected before any money moved.`, 'note-loss');
          } else {
            show(out, 'Could not register that claim: ' + esc(j.error || 'unknown error'), 'note-loss');
          }
          await check(current.id);
          return;
        }
        show(out, `<b>Claim registered and signed.</b> Now ${esc(money(Number(j.claimed || 0), current.currency || 'NGN'))} claimed, ${esc(money(Math.max(0, Number(j.available || 0)), current.currency || 'NGN'))} unencumbered.<br><span id="k-anchor">&#9203; Timestamping to Bitcoin…</span>`, 'note-gain');
        try {
          const a = await (await fetch('/api/verify/receivables/anchor', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ kind: 'claim', id: j.claimId }),
          })).json();
          const el = document.getElementById('k-anchor');
          if (el) el.textContent = a && a.ok
            ? '⏳ Timestamp submitted to Bitcoin, pending a block (~1-2h). Its date can no longer be forged or backdated.'
            : 'Signed. The Bitcoin timestamp did not submit; you can anchor it from the workbench.';
        } catch { /* non-fatal */ }
        await check(current.id);
      } catch (e) {
        show(out, 'Could not reach the registry. Try again.', 'note-loss');
      }
    }

    // Releasing a claim once the debtor has paid frees the headroom again, so no phantom
    // lien outlives the payment. Only the financier who registered it can discharge it —
    // the API enforces that, since the public record never says whose claim is whose.
    async function discharge(claimId: string) {
      const out = $('c-out') as unknown as HTMLElement;
      if (!confirm('Mark this claim repaid? That releases it and frees the headroom.')) return;
      show(out, 'Releasing…');
      try {
        const r = await fetch('/api/verify/receivables/discharge', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ claimId }),
        });
        const j = await r.json();
        if (r.status === 401) { show(out, 'Your session ended. <a href="/verify/login?next=/verify/desk" style="color:var(--accent)">Sign in again</a>.', 'note-loss'); return; }
        if (!j.ok) {
          show(out, j.error === 'not_found'
            ? 'That claim was registered by another financier, so only they can release it.'
            : 'Could not release that claim: ' + esc(j.error || 'unknown error'), 'note-loss');
          return;
        }
        show(out, `<b>Claim released.</b> ${esc(money(Math.max(0, Number(j.available || 0)), current?.currency || 'NGN'))} is unencumbered again.`, 'note-gain');
        if (current) await check(current.id);
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    // ── Vocabulary, in place ────────────────────────────────────────────────
    //
    // The pilot financier had not read the guide and said he would not have. So the words
    // explain themselves where they appear: a dotted term opens its definition underneath,
    // from the same source the guide uses. Nobody has to leave the screen holding money.
    const TERMS: Array<{ key: string; term: string; def: string }> =
      JSON.parse(document.getElementById('terms-data')?.textContent || '[]');

    function termSpan(key: string, text?: string) {
      const t = TERMS.find((x) => x.key === key);
      if (!t) return esc(text ?? key);
      return `<button class="term" data-term="${esc(key)}" title="What this means">${esc(text ?? t.term)}</button>`;
    }

    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement)?.closest?.('button.term') as HTMLElement | null;
      if (!b) return;
      const t = TERMS.find((x) => x.key === b.dataset.term);
      if (!t) return;
      const existing = b.parentElement?.querySelector('.termdef');
      if (existing) { existing.remove(); return; }
      const d = document.createElement('div');
      d.className = 'termdef';
      d.innerHTML = `<b>${esc(t.term)}</b> ${esc(t.def)}`;
      b.parentElement?.appendChild(d);
    });

    // ── The credit view ─────────────────────────────────────────────────────
    //
    // One screen to decide from, per the pilot financier's review: the money split
    // visually, every piece of evidence as present or absent, and an explicit list of what
    // the platform does NOT prove sitting beside it. That last column is the point. A
    // lender who discovers the limits himself, after advancing, stops trusting the rest.
    function renderCreditView(r: any, ccy: string, claimed: number, avail: number) {
      const face = Number(r.face || 0);
      const atts = r.attestations || [];
      const claims = r.claims || [];

      const ack = atts.find((a: any) => a.role === 'buyer') || null;
      const acked = !!ack || !!r.acknowledgedAt;
      const disputes = atts.filter((a: any) => String(a.statement || '').startsWith('DISPUTED'));
      const active = claims.filter((c: any) => c.status !== 'discharged');
      const unconfirmed = active.filter((c: any) => !c.affirmed);
      const docs = Number(r.documentCount || 0);

      const pct = (n: number) => face > 0 ? Math.max(0, Math.min(100, (n / face) * 100)) : 0;

      // Plain English, not a label. "Headroom" means nothing to a first-time user.
      const headline = r.settled
        ? `This receivable is settled. Nothing further can be financed against it.`
        : avail <= 0
        ? `Nothing is available. The full ${money(face, ccy)} is already claimed, so a further advance would duplicate an existing one.`
        : claimed > 0
        ? `${money(avail, ccy)} is still available to finance. ${money(claimed, ccy)} is already claimed by a financier holding this ID.`
        : `The full ${money(face, ccy)} is available to finance. Nobody has registered a claim against it.`;

      const row = (ok: boolean | null, label: string, detail: string) => `
        <div class="ck">
          <span class="ck__i ${ok === true ? 'yes' : ok === false ? 'no' : 'na'}">${ok === true ? '&#10003;' : ok === false ? '&#9888;' : '&middot;'}</span>
          <div><div class="ck__l">${esc(label)}</div><div class="ck__d">${esc(detail)}</div></div>
        </div>`;

      const proven = [
        row(acked, acked ? 'Debtor acknowledged the debt' : 'Debtor has not acknowledged',
            acked
              ? `${ack ? ack.label : r.buyer} confirmed it${ack?.date ? ' on ' + String(ack.date).slice(0, 10) : ''}.`
              : 'Nobody on the paying side has confirmed. You have the client\u2019s paperwork only.'),
        row(disputes.length === 0, disputes.length === 0 ? 'No disputes recorded' : `${disputes.length} dispute${disputes.length > 1 ? 's' : ''} recorded`,
            disputes.length === 0 ? 'Nobody asked has contradicted the record.' : 'Someone asked has contradicted this record. Read it before advancing.'),
        row(active.length > 0 ? true : null, active.length ? `${active.length} financing claim${active.length > 1 ? 's' : ''} registered` : 'No financing claims registered',
            active.length ? `${money(claimed, ccy)} claimed of ${money(face, ccy)}.` : 'The full face value is unencumbered.'),
        row(unconfirmed.length === 0 ? (active.length ? true : null) : false,
            unconfirmed.length === 0 ? (active.length ? 'Every advance confirmed received' : 'No advance to confirm yet') : `${unconfirmed.length} advance${unconfirmed.length > 1 ? 's' : ''} not confirmed received`,
            unconfirmed.length === 0
              ? (active.length ? 'Each lender\u2019s client has confirmed the money arrived.' : 'Nothing has been advanced against this yet.')
              : 'A registered claim is one firm\u2019s word until the client confirms the money reached him.'),
        row(!!r.anchored, r.anchored ? 'Timestamped to Bitcoin' : 'Not yet timestamped',
            r.anchored
              ? (r.anchoredAt ? `Confirmed in a block on ${String(r.anchoredAt).slice(0, 10)}. The date cannot be moved.` : 'Submitted, pending a block. Once confirmed the date cannot be moved.')
              : 'The record is signed but its date is not anchored publicly.'),
        row(docs > 0, docs > 0 ? `${docs} document${docs > 1 ? 's' : ''} on file` : 'No supporting document attached',
            docs > 0 ? 'Fingerprinted, and named in any confirmation given while it was visible.' : 'Nothing was attached, so nobody confirming has seen the paperwork.'),
      ].join('');

      // Stated as flatly as the evidence. These are the questions a lender must answer
      // from outside this system, and pretending otherwise is how a registry gets trusted
      // for something it never claimed.
      const notProven = [
        ['Who actually answered', 'A confirmation proves someone holding the link answered. It does not prove which officer of that company, or that they had authority to bind it.'],
        ['That the goods were delivered', 'Nothing here inspects a warehouse. The debtor\u2019s acknowledgment is the closest evidence, and it is their word.'],
        ['Claims made outside this registry', 'A prior assignment recorded elsewhere, or a floating charge over all receivables, is invisible here.'],
        ['Legal priority', 'Priority is set by law, filing and notice. An anchored date is evidence in that contest, not the thing that decides it.'],
        ['That the invoice is not a near-duplicate', 'Change any field and you get a separate record with separate headroom. Nothing yet matches two records describing one obligation.'],
      ].map(([t, d]) => `<div class="nk"><div class="nk__l">${esc(t)}</div><div class="nk__d">${esc(d)}</div></div>`).join('');

      document.getElementById('credit-body')!.innerHTML = `
        <p class="lead">${esc(headline)}</p>
        <div class="alloc">
          <div class="alloc__bar">
            <span class="alloc__used" style="width:${pct(claimed)}%"></span>
            <span class="alloc__free" style="width:${pct(Math.max(0, avail))}%"></span>
          </div>
          <div class="alloc__keys">
            <span><b>${esc(money(face, ccy))}</b> face value</span>
            <span class="used"><b>${esc(money(claimed, ccy))}</b> financed</span>
            <span class="free"><b>${esc(money(Math.max(0, avail), ccy))}</b> available</span>
          </div>
        </div>
        <div class="two-col">
          <div>
            <div class="col-h">What this platform proves</div>
            ${proven}
          </div>
          <div>
            <div class="col-h col-h--warn">What it does not prove</div>
            ${notProven}
          </div>
        </div>`;
    }

    // ── Intake: record a new deal ───────────────────────────────────────────
    //
    // The banker-led flow: the client is across the desk with his paperwork, so the record
    // is created here rather than on a page written in the client's voice. On success it
    // loads straight into the panel below, so attaching papers and asking the debtor are
    // the next two clicks and nobody has to re-paste an ID.
    function addExtraRow(label = '', value = '') {
      const box = document.getElementById('n-extra')!;
      const row = document.createElement('div');
      row.className = 'xrow';
      const l = document.createElement('input'); l.placeholder = 'Field name'; l.value = label;
      const v = document.createElement('input'); v.placeholder = 'Value'; v.value = value;
      const x = document.createElement('button'); x.type = 'button'; x.textContent = '\u2715';
      x.setAttribute('aria-label', 'Remove this field');
      x.addEventListener('click', () => row.remove());
      row.append(l, v, x);
      box.appendChild(row);
      l.focus();
    }

    function readExtras(): Array<{ label: string; value: string }> {
      return Array.from(document.querySelectorAll('#n-extra .xrow')).map((r) => {
        const [l, v] = Array.from(r.querySelectorAll('input')) as HTMLInputElement[];
        return { label: (l?.value ?? '').trim(), value: (v?.value ?? '').trim() };
      }).filter((e) => e.label && e.value);
    }

    async function createDeal() {
      const out = $('n-out') as unknown as HTMLElement;
      const supplier = val('n-sup'), buyer = val('n-buy'), invoiceNo = val('n-inv');
      const face = Number(val('n-face'));
      if (!supplier || !buyer || !invoiceNo) {
        show(out, 'Client, debtor and invoice number are all needed.', 'note-loss'); return;
      }
      if (!face || face <= 0) { show(out, 'Enter the face value of the invoice.', 'note-loss'); return; }

      show(out, 'Signing and recording…');
      try {
        const r = await fetch('/api/verify/receivables', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            supplier, buyer, invoiceNo, face,
            currency: val('n-ccy') || 'NGN',
            terms: val('n-terms') || null,
            dueDate: val('n-due') || null,
            details: {
              invoiceDate: val('n-idate') || null,
              deliveryDate: val('n-ddate') || null,
              buyerRef: val('n-ref') || null,
              goods: val('n-goods') || null,
              paymentInstructions: val('n-pay') || null,
              extra: readExtras(),
            },
          }),
        });
        const j = await r.json();
        if (!j.ok) { show(out, esc(j.message || 'Could not record that.'), 'note-loss'); return; }

        show(out, 'Recording…', 'note-gain');
        const anchorNote = () => { void (async () => {
          try {
            const a = await (await fetch('/api/verify/receivables/anchor', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ kind: 'receivable', id: j.id }),
            })).json();
            const el = document.getElementById('n-anchor');
            if (el) el.textContent = a && a.ok
              ? '⏳ Timestamp submitted to Bitcoin, pending a block (~1-2h). Its date can no longer be forged or backdated.'
              : 'Signed. The Bitcoin timestamp did not submit; you can anchor it from the workbench.';
          } catch { /* non-fatal */ }
        })(); };

        // Everything the banker has in the room, in one submission: the papers he just
        // scanned and the two people he already knows how to reach. Making him come back
        // for those is how they quietly never happen.
        const done: string[] = ['recorded and signed'];
        const failed: string[] = [];

        const files = ($('n-file') as HTMLInputElement)?.files;
        if (files && files.length) {
          for (const f of Array.from(files)) {
            try {
              const fd = new FormData();
              fd.append('receivableId', j.id);
              fd.append('file', f);
              const dr = await (await fetch('/api/verify/receivables/document', { method: 'POST', body: fd })).json();
              if (!dr.ok) failed.push(`could not attach ${f.name}`);
            } catch { failed.push(`could not attach ${f.name}`); }
          }
          const n = files.length - failed.length;
          if (n > 0) done.push(`${n} document${n > 1 ? 's' : ''} attached`);
        }

        // Both requests, minted then sent. Role decides which page the link opens.
        const ask = async (role: string, email: string, label: string) => {
          if (!email) return;
          try {
            const ir = await (await fetch('/api/verify/receivables/invite', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ role, receivableId: j.id, email }),
            })).json();
            if (!ir.ok) { failed.push(`could not create the ${label} request`); return; }
            const sr = await (await fetch('/api/verify/receivables/send', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token: ir.token }),
            })).json();
            done.push(sr.ok ? `${label} emailed` : `${label} request created, but the email did not send`);
            if (!sr.ok && sr.detail) failed.push(String(sr.detail));
          } catch { failed.push(`could not send the ${label} request`); }
        };
        await ask('buyer', val('n-demail'), 'debtor');
        await ask('borrower', val('n-cemail'), 'client');

        show(out,
          `<b>Done.</b> ${esc(done.join(', '))}.` +
          (failed.length ? `<br><span class="muted">${esc(failed.join('; '))}</span>` : '') +
          `<br><span id="n-anchor">&#9203; Timestamping to Bitcoin…</span>`,
          failed.length ? 'note-loss' : 'note-gain');
        anchorNote();

        ['n-sup','n-buy','n-inv','n-face','n-ref','n-goods','n-pay','n-demail','n-cemail'].forEach((id) => {
          const el = $(id) as HTMLInputElement; if (el) el.value = '';
        });
        const fi = $('n-file') as HTMLInputElement; if (fi) fi.value = '';

        ($('q-id') as HTMLInputElement).value = j.id;
        await check(j.id);
        loadBook();
        document.getElementById('panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    document.querySelector('details.more')?.addEventListener('toggle', (e) => {
      const d = e.currentTarget as HTMLDetailsElement;
      const i = d.querySelector('.more__i');
      if (i) i.textContent = d.open ? '\u2212' : '+';
    });

    document.getElementById('n-add')?.addEventListener('click', () => addExtraRow());
    document.getElementById('n-go')?.addEventListener('click', createDeal);

    // ── Documents ───────────────────────────────────────────────────────────
    async function loadDocs() {
      const box = document.getElementById('d-list')!;
      if (!current?.id) { box.innerHTML = ''; return; }
      try {
        const r = await fetch('/api/verify/receivables/document?receivableId=' + encodeURIComponent(current.id));
        const j = await r.json();
        const docs = j.documents ?? [];
        if (!j.ok || !docs.length) {
          box.innerHTML = '<p class="hint" style="margin-top:.7rem">Nothing attached yet.</p>';
          return;
        }
        box.innerHTML = '<table style="margin-top:.8rem"><thead><tr><th>File</th><th>Size</th><th>Fingerprint</th><th>State</th></tr></thead><tbody>' +
          docs.map((d: any) => `<tr>
              <td>${esc(d.filename)}</td>
              <td>${(Number(d.fileSize) / 1024).toFixed(0)} KB</td>
              <td style="font-family:ui-monospace,Menlo,monospace;font-size:.66rem;word-break:break-all">${esc(String(d.sha256).slice(0, 24))}…</td>
              <td>${d.purgedAt ? `<span class="muted">removed ${esc(d.purgedAt)}</span>` : 'held'}</td>
            </tr>`).join('') +
          '</tbody></table>';
      } catch { box.innerHTML = ''; }
    }

    async function uploadDoc() {
      const out = $('d-out') as unknown as HTMLElement;
      const input = $('d-file') as HTMLInputElement;
      const file = input?.files?.[0];
      if (!current?.id) { show(out, 'Look up a receivable first.', 'note-loss'); return; }
      if (!file) { show(out, 'Choose a file first.', 'note-loss'); return; }
      show(out, 'Attaching…');
      try {
        const fd = new FormData();
        fd.append('receivableId', current.id);
        fd.append('file', file);
        const r = await fetch('/api/verify/receivables/document', { method: 'POST', body: fd });
        const j = await r.json();
        if (!j.ok) {
          const why = j.error === 'too_large' ? 'That file is over 5 MB.'
            : j.error === 'unsupported_type' ? 'PDF or image only.'
            : j.error === 'not_found' ? 'That receivable is not yours to attach to.'
            : 'Could not attach that file.';
          show(out, why, 'note-loss'); return;
        }
        input.value = '';
        show(out, `Attached. Fingerprint ${esc(String(j.doc.sha256).slice(0, 16))}…`, 'note-gain');
        loadDocs();
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
    }

    // ── Confirmation requests ───────────────────────────────────────────────
    async function loadConfirms() {
      const box = document.getElementById('k-list')!;
      if (!current?.id) { box.innerHTML = ''; return; }
      try {
        const r = await fetch('/api/verify/receivables/invite?receivableId=' + encodeURIComponent(current.id));
        const j = await r.json();
        const reqs = j.requests ?? [];
        if (!j.ok || !reqs.length) {
          box.innerHTML = '<p class="hint" style="margin-top:.7rem">Nobody asked yet.</p>';
          return;
        }
        box.innerHTML = '<table style="margin-top:.8rem"><thead><tr><th>Sent to</th><th>Status</th><th>Answered by</th><th></th></tr></thead><tbody>' +
          reqs.map((v: any) => {
            const link = `${location.origin}/verify/authenticate?token=${encodeURIComponent(v.token)}`;
            const who = v.sentTo || v.label || 'no address recorded';
            const state = v.status === 'answered' ? `<span class="ok">answered ${esc(String(v.answeredAt || '').slice(0, 10))}</span>`
              : v.status === 'expired' ? '<span class="muted">expired</span>'
              : v.status === 'revoked' ? '<span class="muted">revoked</span>'
              : `<span>pending, expires ${esc(String(v.expiresAt).slice(0, 10))}</span>`;
            const action = v.status === 'pending'
              ? `<button class="ghost small" data-copy="${esc(link)}">Copy link</button>`
                + ` <button class="ghost small" data-resend="${esc(v.token)}">Resend</button>`
              : '';
            return `<tr>
              <td>${esc(who)}${v.label && v.sentTo ? `<div class="muted" style="font-size:.72rem">${esc(v.label)}</div>` : ''}</td>
              <td>${state}</td>
              <td>${esc(v.answeredBy || '—')}</td>
              <td>${action}</td>
            </tr>`;
          }).join('') +
          '</tbody></table>';
        box.querySelectorAll('button[data-copy]').forEach((b) => {
          b.addEventListener('click', () => {
            navigator.clipboard?.writeText((b as HTMLElement).dataset.copy || '');
            (b as HTMLElement).textContent = 'Copied';
          });
        });
        box.querySelectorAll('button[data-resend]').forEach((b) => {
          b.addEventListener('click', () =>
            emailRequest((b as HTMLElement).dataset.resend as string, $('k-out') as unknown as HTMLElement, 'the debtor'));
        });
      } catch { box.innerHTML = ''; }
    }

    async function createConfirmRequest() {
      const out = $('k-out') as unknown as HTMLElement;
      if (!current?.id) { show(out, 'Look up a receivable first.', 'note-loss'); return; }
      const email = val('k-email');
      if (!email) { show(out, 'An address is what records where the answer came from. Add one.', 'note-loss'); return; }
      show(out, 'Creating…');
      try {
        const r = await fetch('/api/verify/receivables/invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: 'buyer', receivableId: current.id, email, label: val('k-label') || null }),
        });
        const j = await r.json();
        if (!j.ok) { show(out, 'Could not create that link.', 'note-loss'); return; }
        const link = `${location.origin}/verify/authenticate?token=${encodeURIComponent(j.token)}`;
        await navigator.clipboard?.writeText(link).catch(() => {});
        ($('k-email') as HTMLInputElement).value = '';
        ($('k-label') as HTMLInputElement).value = '';
        show(out, `Link copied. Send it to ${esc(email)}. It works once and expires in 7 days.`, 'note-gain');
        loadConfirms();
        return j.token as string;
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
      return null;
    }

    // Sending is a separate, explicit act from minting the link. That keeps "resend the
    // reminder" possible without issuing a second token, and keeps a financier who would
    // rather send from his own mail client able to just copy.
    async function emailRequest(token: string, out: HTMLElement, who: string) {
      show(out, 'Sending\u2026');
      try {
        const r = await fetch('/api/verify/receivables/send', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });
        const j = await r.json();
        if (!j.ok) {
          const why = j.error === 'rate_limited' ? 'Too many requests in the last hour. Try again shortly.'
            : j.error === 'not_found' ? 'That request is not yours to send, or is no longer open. Requests can only be emailed from the account that created them.'
            : j.error === 'email_not_configured' ? 'Email is not configured on this server. Use Create link only and send it yourself.'
            : j.error === 'send_failed' ? `The mail server refused it. Copy the link and send it yourself.${j.detail ? `<br><span class="muted">${esc(j.code ? j.code + ': ' : '')}${esc(j.detail)}</span>` : ''}`
            : 'Could not send that.';
          show(out, why, 'note-loss'); return false;
        }
        show(out, `Sent to ${esc(j.sentTo)}. Replies come back to you, not to Almstins.`, 'note-gain');
        return true;
      } catch { show(out, 'Could not reach the registry. Copy the link and send it yourself.', 'note-loss'); return false; }
    }

    // ── Offers ──────────────────────────────────────────────────────────────
    async function loadOffers() {
      const box = document.getElementById('o-list')!;
      if (!current?.id) { box.innerHTML = ''; return; }
      try {
        const j = await (await fetch('/api/verify/receivables/offer?receivableId=' + encodeURIComponent(current.id))).json();
        const rows = j.offers ?? [];
        if (!j.ok || !rows.length) { box.innerHTML = '<p class="hint" style="margin-top:.7rem">No terms offered yet.</p>'; return; }
        box.innerHTML = '<table style="margin-top:.8rem"><thead><tr><th>Offered</th><th>Amount</th><th>Terms</th><th>State</th></tr></thead><tbody>' +
          rows.map((o: any) => {
            const state = o.acceptedAt ? `<span class="ok">accepted ${esc(String(o.acceptedAt).slice(0, 10))} by ${esc(o.acceptedBy || '')}</span>`
              : o.declinedAt ? `<span style="color:var(--loss)">declined ${esc(String(o.declinedAt).slice(0, 10))}</span>`
              : String(o.expiresAt) < new Date().toISOString().replace('T', ' ').slice(0, 19) ? '<span class="muted">expired</span>'
              : `<span>open until ${esc(String(o.expiresAt).slice(0, 10))}</span>`;
            return `<tr>
              <td>${esc(String(o.createdAt).slice(0, 10))}</td>
              <td>${esc(money(Number(o.amount), o.currency || ccyOf()))}</td>
              <td>${esc(o.recourse === 'non_recourse' ? 'non-recourse' : 'with recourse')}${o.price ? `<div class="muted" style="font-size:.74rem">${esc(o.price)}</div>` : ''}</td>
              <td>${state}</td>
            </tr>`;
          }).join('') + '</tbody></table>';
      } catch { box.innerHTML = ''; }
    }
    const ccyOf = () => current?.currency || 'NGN';

    async function createOffer(): Promise<string | null> {
      const out = $('o-out') as unknown as HTMLElement;
      if (!current?.id) { show(out, 'Look up a receivable first.', 'note-loss'); return null; }
      const financier = val('o-fin'), amount = Number(val('o-amt'));
      if (!financier) { show(out, 'Enter your firm name.', 'note-loss'); return null; }
      if (!amount || amount <= 0) { show(out, 'Enter the amount he receives.', 'note-loss'); return null; }
      show(out, 'Signing…');
      try {
        const j = await (await fetch('/api/verify/receivables/offer', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            receivableId: current.id, financier, amount,
            price: val('o-price') || null,
            recourse: val('o-rec') || 'recourse',
            repayment: val('o-repay') || null,
            validDays: val('o-days') ? Number(val('o-days')) : undefined,
          }),
        })).json();
        if (!j.ok) { show(out, esc(j.message || 'Could not create that offer.'), 'note-loss'); return null; }

        const ir = await (await fetch('/api/verify/receivables/invite', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: 'borrower', receivableId: current.id, offerId: j.offerId, email: val('o-email') || null }),
        })).json();
        if (!ir.ok) { show(out, 'Offer signed, but the link could not be created.', 'note-loss'); return null; }

        const link = `${location.origin}/verify/offer?token=${encodeURIComponent(ir.token)}`;
        await navigator.clipboard?.writeText(link).catch(() => {});
        show(out, `<b>Offer signed and link copied.</b> He sees the amount, the charge, the recourse terms and how it is repaid.`, 'note-gain');
        loadOffers();
        return ir.token as string;
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
      return null;
    }

    document.getElementById('o-go')?.addEventListener('click', createOffer);
    document.getElementById('o-send')?.addEventListener('click', async () => {
      const out = $('o-out') as unknown as HTMLElement;
      if (!val('o-email')) { show(out, 'An address is needed to email it. Use "Create link only" otherwise.', 'note-loss'); return; }
      const token = await createOffer();
      if (token) await emailRequest(token, out, 'your client');
    });

    // ── Counter-signature ───────────────────────────────────────────────────
    // The card only makes sense while an unconfirmed advance exists, so it is hidden
    // otherwise. Its select lists exactly those, which also keeps the banker from asking
    // about a claim his client has already answered.
    function renderCountersignCard(claims: any[], ccy: string) {
      const controls = document.getElementById('cs-controls')!;
      const none = document.getElementById('cs-none')!;
      const open = claims.filter((c: any) => !c.affirmed && c.status !== 'discharged');
      // The card always shows. Only the controls come and go, so the step is visible
      // before it is usable rather than appearing out of nowhere once a claim exists.
      if (!open.length) {
        controls.style.display = 'none';
        none.style.display = 'block';
        none.textContent = claims.length
          ? 'Every advance on this receivable has been confirmed by your client.'
          : 'Register your claim above first. This asks your client to confirm he received that money.';
        return;
      }
      none.style.display = 'none';
      controls.style.display = 'block';
      const sel = $('cs-claim') as unknown as HTMLSelectElement;
      const keep = sel.value;
      sel.innerHTML = open.map((c: any) =>
        `<option value="${esc(c.id)}">${esc(money(c.amount, c.currency || ccy))} to ${esc(c.financier)}, registered ${esc(String(c.registeredAt || '').slice(0, 10))}</option>`
      ).join('');
      if (keep && open.some((c: any) => c.id === keep)) sel.value = keep;
      loadCountersigns();
    }

    async function loadCountersigns() {
      const box = document.getElementById('cs-list')!;
      const claimId = (($('cs-claim') as unknown as HTMLSelectElement)?.value ?? '').trim();
      if (!claimId) { box.innerHTML = ''; return; }
      try {
        const r = await fetch('/api/verify/receivables/invite?claimId=' + encodeURIComponent(claimId));
        const j = await r.json();
        const reqs = j.requests ?? [];
        if (!j.ok || !reqs.length) {
          box.innerHTML = '<p class="hint" style="margin-top:.7rem">Not asked yet for this advance.</p>';
          return;
        }
        box.innerHTML = '<table style="margin-top:.8rem"><thead><tr><th>Sent to</th><th>Status</th><th>Answered by</th><th></th></tr></thead><tbody>' +
          reqs.map((v: any) => {
            const link = `${location.origin}/verify/countersign?token=${encodeURIComponent(v.token)}`;
            const state = v.status === 'answered' ? `<span class="ok">answered ${esc(String(v.answeredAt || '').slice(0, 10))}</span>`
              : v.status === 'expired' ? '<span class="muted">expired</span>'
              : v.status === 'revoked' ? '<span class="muted">revoked</span>'
              : `<span>pending, expires ${esc(String(v.expiresAt).slice(0, 10))}</span>`;
            const action = v.status === 'pending'
              ? `<button class="ghost small" data-copy="${esc(link)}">Copy link</button>`
                + ` <button class="ghost small" data-resend="${esc(v.token)}">Resend</button>`
              : '';
            return `<tr><td>${esc(v.sentTo || 'no address recorded')}</td><td>${state}</td><td>${esc(v.answeredBy || '\u2014')}</td><td>${action}</td></tr>`;
          }).join('') + '</tbody></table>';
        box.querySelectorAll('button[data-copy]').forEach((b) => {
          b.addEventListener('click', () => {
            navigator.clipboard?.writeText((b as HTMLElement).dataset.copy || '');
            (b as HTMLElement).textContent = 'Copied';
          });
        });
        box.querySelectorAll('button[data-resend]').forEach((b) => {
          b.addEventListener('click', () =>
            emailRequest((b as HTMLElement).dataset.resend as string, $('cs-out') as unknown as HTMLElement, 'your client'));
        });
      } catch { box.innerHTML = ''; }
    }

    async function createCountersignRequest() {
      const out = $('cs-out') as unknown as HTMLElement;
      const claimId = (($('cs-claim') as unknown as HTMLSelectElement)?.value ?? '').trim();
      const email = val('cs-email');
      if (!claimId) { show(out, 'No unconfirmed advance to ask about.', 'note-loss'); return; }
      if (!email) { show(out, 'An address is needed. It is what records where the answer came from.', 'note-loss'); return; }
      show(out, 'Creating\u2026');
      try {
        const r = await fetch('/api/verify/receivables/invite', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: 'borrower', receivableId: current.id, claimId, email }),
        });
        const j = await r.json();
        if (!j.ok) { show(out, 'Could not create that link.', 'note-loss'); return; }
        const link = `${location.origin}/verify/countersign?token=${encodeURIComponent(j.token)}`;
        await navigator.clipboard?.writeText(link).catch(() => {});
        ($('cs-email') as HTMLInputElement).value = '';
        show(out, `Link copied. Send it to ${esc(email)} from your own email. The claim shows as confirmed once he answers.`, 'note-gain');
        loadCountersigns();
        return j.token as string;
      } catch { show(out, 'Could not reach the registry. Try again.', 'note-loss'); }
      return null;
    }

    // The row button is a shortcut into the card, not a second way of doing it.
    function askClient(claimId: string) {
      const card = document.getElementById('cs-card')!;
      document.getElementById('cs-controls')!.style.display = 'block';
      const sel = $('cs-claim') as unknown as HTMLSelectElement;
      if (sel) { sel.value = claimId; loadCountersigns(); }
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      ($('cs-email') as HTMLInputElement)?.focus();
    }

    document.getElementById('cs-go')?.addEventListener('click', createCountersignRequest);
    document.getElementById('cs-send')?.addEventListener('click', async () => {
      const token = await createCountersignRequest();
      if (token) await emailRequest(token, $('cs-out') as unknown as HTMLElement, 'your client');
    });
    $('cs-claim')?.addEventListener('change', loadCountersigns);

    document.getElementById('d-go')?.addEventListener('click', uploadDoc);
    document.getElementById('k-go')?.addEventListener('click', createConfirmRequest);
    document.getElementById('k-send')?.addEventListener('click', async () => {
      const token = await createConfirmRequest();
      if (token) await emailRequest(token, $('k-out') as unknown as HTMLElement, 'the debtor');
    });

    // A financier with twenty deals should not have to hoard 64-character IDs to reach his
    // own records. "Check a receivable" stays, because it is how he opens somebody else's.
    async function loadBook() {
      const box = document.getElementById('book-list')!;
      try {
        const r = await fetch('/api/verify/receivables');
        const j = await r.json();
        const rows = j.receivables ?? [];
        if (!j.ok || !rows.length) {
          box.innerHTML = '<p class="muted" style="margin-top:.6rem">Nothing recorded yet. Start with New deal above.</p>';
          return;
        }
        book = rows;
        renderBook();
      } catch { box.innerHTML = ''; }
    }

    function renderBook() {
      const box = document.getElementById('book-list')!;
      const q = (val('book-q') || '').toLowerCase();
      const rows = !q ? book : book.filter((v: any) =>
        [v.supplier, v.buyer, v.invoiceNo].some((f: any) => String(f || '').toLowerCase().includes(q)));

      if (!rows.length) {
        box.innerHTML = `<p class="muted" style="margin-top:.6rem">${q ? 'Nothing matches that.' : 'Nothing recorded yet. Start with New deal above.'}</p>`;
        return;
      }

      box.innerHTML = '<table><thead><tr><th>Recorded</th><th>Client</th><th>Debtor</th><th>Invoice</th><th>Face</th><th>Receivable ID</th><th>State</th></tr></thead><tbody>' +
        rows.map((v: any) => {
          const id = String(v.id);
          const short = `${id.slice(0, 10)}\u2026${id.slice(-6)}`;
          return `<tr class="book-row">
            <td class="dt">${esc(String(v.createdAt || '').slice(0, 10))}</td>
            <td><b>${esc(v.supplier)}</b></td>
            <td>${esc(v.buyer)}</td>
            <td>${esc(v.invoiceNo)}</td>
            <td>${esc(money(Number(v.face), v.currency || 'NGN'))}</td>
            <td class="idcell">
              <button class="idlink" data-open="${esc(id)}" title="Check this receivable">${esc(short)}</button>
              <button class="idcopy" data-copyid="${esc(id)}" title="Copy the full ID" aria-label="Copy receivable ID">&#10697;</button>
            </td>
            <td>${v.settled ? '<span class="muted">settled</span>' : '<span class="ok">open</span>'}</td>
          </tr>`;
        }).join('') + '</tbody></table>';

      const open = (id: string) => {
        ($('q-id') as HTMLInputElement).value = id;
        check(id);
        document.getElementById('panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      box.querySelectorAll('[data-open]').forEach((b) =>
        b.addEventListener('click', () => open((b as HTMLElement).dataset.open as string)));
      box.querySelectorAll('.book-row').forEach((tr) => {
        tr.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('button')) return;
          const id = tr.querySelector('[data-open]') as HTMLElement;
          if (id) open(id.dataset.open as string);
        });
      });
      box.querySelectorAll('[data-copyid]').forEach((b) => {
        b.addEventListener('click', () => {
          navigator.clipboard?.writeText((b as HTMLElement).dataset.copyid || '');
          const el = b as HTMLElement;
          const was = el.innerHTML;
          el.innerHTML = '&#10003;';
          setTimeout(() => { el.innerHTML = was; }, 1200);
        });
      });
    }

    $('book-q')?.addEventListener('input', renderBook);
    loadBook();

    // Nothing rots unseen: what is still outstanding, and what already lapsed.
    async function loadWaiting() {
      const card = document.getElementById('waiting-card')!;
      const box = document.getElementById('waiting-list')!;
      try {
        const j = await (await fetch('/api/verify/receivables/invite?outstanding=1')).json();
        const rows = j.outstanding ?? [];
        if (!j.ok || !rows.length) { card.style.display = 'none'; return; }
        card.style.display = 'block';
        const who = (v: any) => v.role === 'buyer' ? 'Debtor' : v.claimId ? 'Client, receipt' : 'Client, record';
        box.innerHTML = '<table style="margin-top:.6rem"><thead><tr><th>Waiting on</th><th>Deal</th><th>Sent to</th><th>State</th></tr></thead><tbody>' +
          rows.map((v: any) => `<tr class="book-row" data-id="${esc(v.receivableId)}" style="cursor:pointer">
              <td>${esc(who(v))}</td>
              <td>${esc(v.supplier)} &rarr; ${esc(v.buyer)}<div class="muted" style="font-size:.74rem">${esc(v.invoiceNo)}</div></td>
              <td>${esc(v.email || 'no address')}</td>
              <td>${v.state === 'lapsed'
                ? `<span style="color:var(--loss)">lapsed ${esc(String(v.expiresAt).slice(0, 10))}</span>`
                : `<span class="muted">expires ${esc(String(v.expiresAt).slice(0, 10))}</span>`}</td>
            </tr>`).join('') + '</tbody></table>';
        box.querySelectorAll('.book-row').forEach((tr) => tr.addEventListener('click', () => {
          const id = (tr as HTMLElement).dataset.id as string;
          ($('q-id') as HTMLInputElement).value = id;
          check(id);
          document.getElementById('panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }));
      } catch { card.style.display = 'none'; }
    }
    loadWaiting();

    document.getElementById('q-go')?.addEventListener('click', () => check());
    $('q-id')?.addEventListener('keydown', (e: any) => { if (e.key === 'Enter') check(); });
    document.getElementById('c-go')?.addEventListener('click', registerClaim);

    if (val('q-id')) check();
  </script>
</body>
</html>
