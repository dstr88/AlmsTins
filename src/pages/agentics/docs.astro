---
// The destination check, documented for the people wiring payment agents.
//
// Not a feature tour and not merchant copy: an agent builder should leave this page
// knowing the one call to make, the one rule for reading its answer (proceed only on
// status proven + level verified + expect passed), and why everything else is a hold.
// Public and indexable — this page IS the distribution.
//
// C5/S7b: status now comes from level first — proven and mismatch only ever come back
// with level verified, unanchored always comes with level claimed, unknown always with
// level null — so status alone already tells an agent which of the four to expect; the
// AND-level-is-verified half of the rule is now redundant with status but kept anyway, as
// belt-and-suspenders against a future bug, not as a hedge against today's behavior. domain
// is now always the domain that actually vouches for the destination (or null), never the
// account's business name on its own, so the caveats this comment used to list are gone.
// tests/verify/agentDocs.test.ts pins the rule and the field/status contract so they
// cannot silently regress.
// Verify warns and flags; the payer decides. Keep the verbs to hold / flag / escalate.
//
// No interactive "try it" widget here on purpose — a random address almost
// always comes back "unknown" (nobody's published proof for it), which read
// as broken rather than correct. The static example under "The call" carries
// that job instead. The Verify landing page's Agents tile links to this page
// plainly (no anchor) rather than to a demo widget.
//
// "Your vault" documents the one field a keyed call gains when its key is linked to an agent in the
// vault (src/lib/agentVault/checkLog.ts, VaultBlock), and "Copy and paste" writes the rule out in curl,
// JavaScript and Python. tests/verify/agentDocs.test.ts holds the vault field to the type that builds it,
// and runs the JavaScript against a stand-in for fetch.
//
// The document shell and the look come from the docs kit: ApiDocsLayout (head, Analytics, the
// column), AnswerCards (the answers below) and DocsFaq (the FAQ container). The copy stays
// literal in this file, the description meta included, because the test above reads it here.
import ApiDocsLayout from '@/layouts/ApiDocsLayout.astro';
import AnswerCards from '@/components/docs/AnswerCards.astro';
import DocsFaq from '@/components/docs/DocsFaq.astro';

export const prerender = false;

const ANSWERS = [
  {
    code: 'proven',
    cls: 'good',
    h: 'The only answer to proceed on',
    p: "level is verified, and (you passed no expect, or the domain that anchors this destination matches it). Proceed under your own policy, and only when you passed expect: without it you only learn that some proof exists, not that it's your payee.",
    sample: '{ "status": "proven", "level": "verified", "domain": "acme.com" }',
  },
  {
    code: 'mismatch',
    cls: 'bad',
    h: 'A domain stands behind this destination, and it is not the one you expected',
    p: "level is verified — a domain currently vouches for this destination — but it is not the one you passed. The loudest signal this API can emit: your records say one business, the destination belongs to another. Hold the payment, flag it, and escalate to a human as a discrepancy to confirm with the payee through a channel you already trust, not as confirmed fraud: it can also come back when the payee genuinely operates more than one proven domain and you had the wrong one, or when you passed a subdomain that is not actually a subdomain of the one they proved.",
    sample: '{ "status": "mismatch", "level": "verified", "domain": "not-the-domain-you-expected.com" }',
  },
  {
    code: 'unanchored',
    cls: 'warn',
    h: 'Something is on record, but no domain currently vouches for it',
    p: "level is claimed: control was proven (a self-send for a crypto address) or a payment link was registered to an account, but no domain backs it right now — never listed, removed from a listing, not re-confirmed within the last 24 hours, or (a payment link) the account holds no verified business name. Not fraud: a payee who has not reached Level 2, or whose proof has gone stale. Hold and confirm the destination with the payee through a channel you already trust.",
    sample: '{ "status": "unanchored", "level": "claimed", "domain": null }',
  },
  {
    code: 'unknown',
    cls: 'warn',
    h: 'No current proof on record',
    p: 'level is null: no proof of this destination is on record at all — it was never proven, or the listing that was its only proof lapsed or was withdrawn. Not an accusation, just an absence: treat it the way a browser treats a site with no certificate. Fail closed: hold and escalate.',
    sample: '{ "status": "unknown", "level": null, "domain": null }',
  },
] as const;

const FIELDS = [
  ['status', "proven, mismatch, unanchored or unknown. proven and mismatch always come with level verified; unanchored always comes with level claimed; unknown always with level null — so status alone tells you which, but the rule below still checks level too, as belt-and-suspenders. Treat a status you do not recognize as a hold."],
  ['level', 'verified when a proof is current: for a crypto address, a listing on a proven domain re-confirmed within the last 24 hours; for a platform\'s list, a list refreshed within the last 24 hours; for a payment link, an account that holds a domain-verified business name (no ownership proof specific to the link, and no freshness check unless the link is monitored). claimed when control was proven by a self-send, or a payment link was registered, but no domain currently vouches for the destination. null when status is unknown.'],
  ['domain', "The domain that actually vouches for this destination right now — what your expect was matched against — or null when status is unanchored or unknown. Never the payee's business name on its own if it isn't also what anchors this destination, and never a payment link's own host (stripe.com, buy.stripe.com — that names the processor, not the payee)."],
  ['label', "A business name, shown only alongside a proven or mismatch answer, and only when it derives from domain — never the payee's raw freeform text, which we never treat as an identity. null otherwise, including whenever status is unanchored or unknown. Display it if you like, but never decide on it."],
  ['chain', 'The rail the destination is on: usually ethereum, polygon, avalanche, bitcoin, solana or litecoin, though a platform\'s published list may use its own chain names. url for any payment link or payment QR (EMV and UPI payloads included), or null.'],
  ['since', 'The date of the proof behind level (YYYY-MM-DD). For a verified crypto address, the date its listing on a proven domain was first confirmed, never an older self-send date; for a claimed one, the date control was proven. For a payment link, the date it was registered; for a platform\'s list, the date the platform proved its domain. Or null. It follows level: when an address drops from verified to claimed, since moves to the date control was proven, which can be earlier.'],
  ['proofAgeDays', 'Whole days since since. This is not freshness: an old proof can still be verified, and a lapsed listing reads claimed or unknown. Freshness lives in level. Because since follows level, proofAgeDays can jump when level changes.'],
  ['checkedAt', 'When this answer was computed (ISO 8601, UTC).'],
];

const VAULT_FIELDS = [
  ['cleared', "true when the address is on this agent's trusted list and nothing we ran flagged it; false when it is not on the list, is still pending, or is flagged; null when the vault could not be read. It is never a statement that an address is safe or legitimate."],
  ['answer', "What this agent was told, with its registry taken into account. proven: on the trusted list, and a domain currently vouches for it. consistent-with-history: on the trusted list, nothing flagged it, and this agent has asked about it before (sameness, never ownership). flagged: the registry flagged it, or a different domain than the one you expected vouches for it. unknown: everything else, including an address that is not on the list, whatever the public proof says. An address you trusted that has no domain proof and that this agent has not asked about before reads unknown with cleared true: your say-so is the only support it has yet. null when the vault could not be read."],
  ['registry', 'Where the address stands in this agent\'s registry: trusted, flagged, pending (added, but a check could not finish) or none (not registered). null when the vault could not be read.'],
  ['history', 'consistent when the address is trusted and this agent has asked about it before; none otherwise. It proves the address has not changed, not who owns it. null when the vault could not be read.'],
  ['eventId', 'The id of the ledger row this check was written as, or null when nothing was written.'],
  ['logged', 'Whether the check was written to the ledger. false when it could not be, or when the agent had reached its daily limit (see reason).'],
  ['reason', 'Present only when logged is false because the agent reached its daily limit of recorded checks: log_limit. The Free plan records 5,000 checks per agent per UTC day. The check itself still answers in full.'],
];

const PRINCIPLES = [
  ['Proof, never reputation.', 'We answer "is there a current proof tying this destination to a domain," never "is this party good." No risk scores, no success counts, no endorsements. A verified answer means a domain stands behind the destination, not that the deal is wise. The check is proof-only: it does not screen for sanctions or scams, so a verified destination has not been screened. Run your own screening, or the free wallet checker at almstins.com/wallet-checker, separately.'],
  ['Always pass expect.', 'Without it you only learn that some proof exists for this destination. With it you learn whether it is tied to the party you intend to pay. The second is the product, and the rule above requires it. Take expect from your own records, never from the page that supplied the address.'],
  ['503 is not unknown.', 'A 200 with status unknown means the registry has no current proof: act on your fail-closed policy and hold. A 503 means the check itself is unavailable: retry with backoff, honoring Retry-After. Treat any other 5xx the same way. We will never disguise an outage as an absence of proof.'],
  ['Nobody approves anybody.', 'Payees prove their own destinations (a self-send, a file on their own domain) or register payment links to their own accounts. We maintain no list of legitimate businesses and decide nothing. We check proofs the way a browser checks certificates.'],
  ['The contract is additive-only.', 'Fields are added, never removed or repurposed. New status values may be added: treat any status you do not recognize as a hold. The v field bumps only on a breaking change, which we intend never to ship.'],
];

const TOC = [
  ['the-call', 'The call'],
  ['the-rule', 'The rule'],
  ['answers', 'The answers'],
  ['specs', 'Specs'],
  ['limits', 'Limits & keys'],
  ['vault', 'Your vault'],
  ['kit', 'Copy and paste'],
  ['faq', 'FAQ'],
  ['for-payees', 'For payees'],
];

const FAQ = [
  ['Is there an SDK or client library?', "No — it's a single unauthenticated GET that returns JSON. Fetch or curl it directly from any language; there's nothing to install. The rule above is written out in curl, JavaScript and Python under Copy and paste."],
  ['What does the API return if value or expect is malformed?', "A 400, with a JSON body naming the problem — { error: 'invalid address format' } for a value that isn't a recognized address or link, or { error: 'expect must be a domain' } for an expect that isn't domain-shaped. Neither is a proof answer: treat any non-200 as a hold, same as everywhere else on this page."],
  ['Do I need to normalize expect myself — strip https://, www., a trailing slash?', 'No. expect accepts a bare domain or a full URL (acme.com, https://acme.com/pay, WWW.Acme.com.) and normalizes it the same way before comparing. Pass whatever format your own records already have.'],
  ['Why isn’t there a live "try it" widget on this page?', "Because a random address almost always comes back unknown — nobody has published proof for it yet — and that reads as broken rather than correct. The static example under \"The call\" shows the real shape of a proven answer instead. Once you or a payee you know has proven a real destination, check that one for real."],
  ['Does checking a destination notify the payee, or cost them anything?', "No. A check only reads proof state that's already public, silently and for free. It never contacts, involves, or bills the party being checked."],
  ['Is there a sandbox or test destination I can safely check?', "No dedicated sandbox — the static example on this page is the fixed reference for what a proven answer looks like. To see a real one, prove a destination yourself for free (2 wallets, no card) and check that."],
  ['Can I call this directly from a browser?', 'Yes — the response includes Access-Control-Allow-Origin: *, so client-side agents and demos can call it cross-origin without a server in between.'],
];
---
<ApiDocsLayout title="Destination check for payment agents — Almstins Verify">
  <Fragment slot="head">
    <meta name="description" content="One GET before your agent authorizes a payment: does the business you intend to pay vouch for this destination? Proceed only when status is proven, level is verified, and you passed expect. Hold everything else for a human." />
  </Fragment>

  <header>
    <div class="eyebrow">Almstins Verify · for agent builders</div>
    <h1>Call this before you authorize.</h1>
    <p class="lede">
      One GET answers the question your agent cannot feel its way through:
      <b>does the business I intend to pay vouch for this destination?</b>
      Proceed only when <b>status is proven</b>, <b>level is verified</b>, and you passed
      <b>expect</b>. Hold everything else for a human.
    </p>
  </header>

  <section class="hero-tiles">
    <div class="hero-tile">
      <h2 class="hero-tile__title">Get started</h2>
      <p class="hero-tile__body">
        Free and anonymous to try — 30 checks a minute, no login. Building a
        fleet? Mint your own key with one DNS record for 300 a minute.
      </p>
      <a class="hero-tile__cta" href="/verify/login?next=/verify/agent-keys">Log in to get started <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-tile">
      <h2 class="hero-tile__title">How this works</h2>
      <ul class="hero-tile__list">
        <li>
          <span class="hero-tile__num" aria-hidden="true">01</span>
          <div><p class="hero-tile__item-title">One free GET request</p><p class="hero-tile__item-desc">Pass the address and the domain you expect — anonymous, no key required.</p></div>
        </li>
        <li>
          <span class="hero-tile__num" aria-hidden="true">02</span>
          <div><p class="hero-tile__item-title">Proceed only when proven + verified</p><p class="hero-tile__item-desc">Anything else is a hold for a human — never a guess.</p></div>
        </li>
        <li>
          <span class="hero-tile__num" aria-hidden="true">03</span>
          <div><p class="hero-tile__item-title">Nobody approves anybody</p><p class="hero-tile__item-desc">Payees prove their own destinations. We only check the proof.</p></div>
        </li>
        <li>
          <span class="hero-tile__num" aria-hidden="true">04</span>
          <div><p class="hero-tile__item-title">Cache your results</p><p class="hero-tile__item-desc">Proof state changes slowly — a few minutes is safe.</p></div>
        </li>
      </ul>
    </div>
  </section>

  <nav class="toc" aria-label="Page sections">
    {TOC.map(([id, label]) => (<a href={`#${id}`}>{label}</a>))}
  </nav>

  <section id="the-call">
    <h2>The call</h2>
    <pre><b>GET</b> https://almstins.com/api/verify/check?value=&lt;address or payment URL&gt;&amp;expect=&lt;domain&gt;</pre>
    <p class="body">
      <b>value</b> is a crypto address, a payment link (Stripe, PayPal), or an EMV/UPI payload.
      <b>expect</b> is the domain of the business your agent intends to pay, taken from your own
      vendor record or the order you placed, never from the invoice, message or page that supplied
      the address: whoever swaps the address on an invoice can swap the domain on it too. Pass the
      payee's own domain at its registrable level (acme.com rather than pay.acme.com). expect also
      matches any subdomain of it, so never pass a processor, hosting or platform domain (stripe.com,
      github.io, pages.dev and similar); for a payee hosted on one, pass their full host. expect is
      optional in the API, and an empty expect is ignored, but the rule below requires it: always pass it.
    </p>
    <div class="term">
      <div class="term__bar">
        <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
        <span class="term__title">GET /api/verify/check</span>
      </div>
      <pre>{`{
  // proceed only if status is "proven" AND level is "verified" AND you passed expect
  "v": 1,
  "status": "proven",          // or "mismatch" | "unanchored" | "unknown"
  "level": "verified",         // "verified" | "claimed" | null — follows status; see below
  "domain": "x-capital.com",   // the domain that vouches for this destination, or null
  "label": null,               // a business name derived from domain, or null: display only, never decide on it
  "chain": "ethereum",
  "since": "2026-07-14",       // date of the proof behind level (verified address: when its listing was first confirmed)
  "proofAgeDays": 59,          // age of that proof, not freshness (freshness lives in level)
  "checkedAt": "2026-09-11T14:30:00Z"
}`}</pre>
    </div>
  </section>

  <section id="the-rule">
    <h2>The rule: proceed only when all three hold</h2>
    <ol class="rule">
      <li>You passed <b>expect=&lt;the payee's domain&gt;</b>, taken from your own records. Never take it from the page that supplied the address, and never pass a processor, hosting or platform domain (such as stripe.com). The API ignores an empty expect and then answers proven for any domain, so your agent must hold when it has no domain to pass.</li>
      <li><b>status</b> is <b>proven</b>.</li>
      <li><b>level</b> is <b>verified</b>.</li>
    </ol>
    <pre>{`// payeeDomain: the payee's registrable domain from YOUR records, e.g. 'acme.com'
const want = String(payeeDomain ?? '').trim().toLowerCase();
if (!want) return holdForReview({ reason: 'no expect' });  // the API ignores an empty expect
const url = 'https://almstins.com/api/verify/check'
  + '?value=' + encodeURIComponent(value)
  + '&expect=' + encodeURIComponent(want);                 // always pass expect
let res;
try { res = await fetch(url); } catch { return retryWithBackoff(); }
if (res.status >= 500 || res.status === 429) return retryWithBackoff(res.headers.get('Retry-After'));
let body;
try { body = await res.json(); } catch { return holdForReview({ reason: 'unreadable answer' }); }
const got = String(body.domain ?? '').toLowerCase();
const mayProceed = res.ok
  && body.status === 'proven' && body.level === 'verified'
  && (got === want || got.endsWith('.' + want));           // the answer is about your payee
if (!mayProceed) return holdForReview(body);               // flag it and escalate to a human`}</pre>
    <p class="body">
      Anything else is a hold: flag the payment and escalate to a human, or confirm the destination
      with the payee through a channel you already trust. proven and mismatch already only ever
      come back with level <b>verified</b> — checking level again costs nothing and protects your
      agent against a future bug in this API, so the sample above still checks both. The last line
      of mayProceed also checks that the answer's domain is the one you passed (or a subdomain of
      it), so an expect lost along the way cannot pass.
    </p>
  </section>

  <section id="answers">
    <h2>The answers, read with level</h2>
    <AnswerCards items={ANSWERS} />
  </section>

  <section>
    <h2>What verified covers today</h2>
    <p class="body">
      verified means something different for each kind of destination. The rule above holds for all
      of them; this is what you rely on when you proceed.
    </p>
    <ul class="pr">
      <li><b>A crypto address a payee listed.</b> The address is in the address file on a domain the payee's account proved, and that listing was re-confirmed within the last 24 hours. domain is that file's domain. An address the payee first proved by a self-send becomes verified the same way, once the file lists it. A listing not re-confirmed in 24 hours reads unanchored. An address removed from the file reads unanchored if a self-send also proved it, and unknown if the file was its only proof.</li>
      <li><b>A platform's published list.</b> The address is on the list a platform serves from its own proven domain, refreshed within the last 24 hours. domain is that platform's domain. A list that goes stale reads unknown, not unanchored.</li>
      <li><b>A payment link or payment QR.</b> Weaker today, and the one place domain is still not link-specific: verified means the account that registered the link separately holds a domain-verified business name (not re-checked unless the link is monitored, and never the account's business name on its own — see the next line), and domain is that name's domain. Read it as the account's registration plus its own separate identity proof, not a proof that this exact link belongs to them. If your policy needs a current link-ownership proof, hold payment-link answers for a human for now.</li>
      <li><b>domain itself.</b> Always the domain that actually anchors the destination when status is proven or mismatch — the file's domain for a listed address, the platform's own domain for its list, or (payment links only, see above) the registering account's business-name domain. Never a domain the destination merely happens to share an account with, and never a payment link's own host.</li>
    </ul>
  </section>

  <section>
    <h2>Reading the fields</h2>
    <ul class="pr">
      {FIELDS.map(([f, d]) => (<li><code>{f}</code> {d}</li>))}
    </ul>
  </section>

  <section id="specs">
    <h2>Technical specs</h2>
    <p class="body">Quick reference — the sections around this one carry the full explanation and the nuance a table can't.</p>

    <div class="spec-wrap">
      <table class="spec">
        <caption>Endpoint</caption>
        <tr><th>Method</th><td><code>GET</code></td></tr>
        <tr><th>URL</th><td><code>https://almstins.com/api/verify/check</code></td></tr>
        <tr><th>Auth</th><td>None required for anonymous use. Optional <code>Authorization: Bearer &lt;key&gt;</code> for a raised rate limit, and for the record in your vault when the key is linked to one of your agents.</td></tr>
        <tr><th>Query params</th><td><code>value</code> (required), <code>expect</code> (optional in the API, required by the rule above)</td></tr>
        <tr><th>Response</th><td><code>application/json</code>, always <code>v: 1</code> today — additive-only, never a breaking change</td></tr>
      </table>
    </div>

    <div class="spec-wrap">
      <table class="spec">
        <caption>Rate limits</caption>
        <tr><th>Anonymous</th><td>30 requests / minute / IP</td></tr>
        <tr><th>With a key</th><td>300 requests / minute — <a href="#limits">self-served, see Limits &amp; keys</a></td></tr>
        <tr><th>Over limit</th><td><code>429</code> with a <code>Retry-After</code> header — honor it</td></tr>
      </table>
    </div>

    <div class="spec-wrap">
      <table class="spec">
        <caption>HTTP status codes</caption>
        <tr><th><code>200</code></th><td>Always an answer — read <code>status</code> and <code>level</code>, never the HTTP code alone</td></tr>
        <tr><th><code>401</code></th><td>Key revoked or malformed — never a silent downgrade to anonymous</td></tr>
        <tr><th><code>429</code></th><td>Rate limited — retry after the <code>Retry-After</code> header</td></tr>
        <tr><th><code>503</code></th><td>The check itself is unavailable — retry with backoff; this is <b>not</b> the same signal as <code>status: "unknown"</code></td></tr>
      </table>
    </div>

    <div class="spec-wrap">
      <table class="spec">
        <caption>Supported value types</caption>
        <tr><th>Crypto addresses</th><td>Ethereum, Polygon, Avalanche, Bitcoin, Solana, Litecoin (plus whatever chain names a platform's own published list uses)</td></tr>
        <tr><th>Payment links</th><td>Stripe, PayPal</td></tr>
        <tr><th>QR payloads</th><td>EMV and UPI</td></tr>
      </table>
    </div>

    <div class="spec-wrap">
      <table class="spec">
        <caption>Caching</caption>
        <tr><th>Safe to cache</th><td><code>proven</code> + <code>verified</code>, for 5–15 minutes, keyed by <code>value</code> plus <code>expect</code></td></tr>
        <tr><th>Never cache past</th><td>a <code>mismatch</code> or an <code>unanchored</code> answer</td></tr>
        <tr><th>On a <code>503</code></th><td>retry with backoff; your policy may reasonably honor a recently cached <code>proven</code> answer while the check is unavailable</td></tr>
      </table>
    </div>
  </section>

  <section>
    <h2>Principles the contract keeps</h2>
    <ul class="pr">
      {PRINCIPLES.map(([b, p]) => (<li><b>{b}</b> {p}</li>))}
    </ul>
  </section>

  <section id="limits">
    <h2>Limits and keys</h2>
    <p class="body">
      Anonymous calls are free and stay free: 30 requests per minute per IP, enough for a human-paced
      agent. For fleets, <a href="/verify/agent-keys">a key raises that to 300 per minute</a>, and you
      issue it yourself: claim your domain from a free account, publish one DNS TXT record carrying the
      challenge, and the key mints. Nobody reviews an application, because there is no application.
      Send it as <b>Authorization: Bearer &lt;key&gt;</b>. A revoked or malformed key gets 401, never a
      silent downgrade, so your fleet knows the moment a key stops working.
    </p>
    <p class="note">Rate-limited calls return 429 with Retry-After. The check makes no outbound requests and reads only proof state that is already public — which is why keys can be self-served: a leaked key is a quota nuisance, not a breach.</p>
    <p class="body">
      <b>Cache your results.</b> Proof state changes slowly, so a <b>proven</b> answer with level
      <b>verified</b> is safe to cache for a few minutes (we suggest 5 to 15, keyed by value plus
      expect) rather than re-checking the same destination on every invoice in a batch. On a 503,
      retry with backoff, and your policy may reasonably honor a recently cached proven
      answer while the check is unavailable. Never cache your way past a <b>mismatch</b> or an
      <b>unanchored</b>, and never treat a 503 as <b>unknown</b>: an outage is not an absence of proof,
      which is exactly why the two are different signals.
    </p>
  </section>

  <section id="vault">
    <h2>Your vault (optional)</h2>
    <p class="body">
      The check works without an account. If you run agents that move money, you can also keep a
      dated record of what each one asked and what it was answered. Sign in free at
      <a href="/agentics">almstins.com/agentics</a>, add an agent in your vault, register the addresses it
      may pay (each is checked when you add it: sanctions lists, scam screening and domain proofs), and
      link one of your keys to the agent. From then on every call that carries that key is also written
      to the agent's ledger, and the answer gains one more field, <code>vault</code>. The Free plan covers
      3 agents and 15 addresses.
    </p>
    <div class="term">
      <div class="term__bar">
        <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
        <span class="term__title">the vault field, on a call with a linked key</span>
      </div>
      <pre>{`{
  "cleared": true,           // on this agent's trusted list, and nothing we ran flagged it (not a statement that it is safe)
  "answer": "proven",        // "proven" | "consistent-with-history" | "flagged" | "unknown"
  "registry": "trusted",     // "trusted" | "flagged" | "pending" | "none"
  "history": "consistent",   // "consistent" | "none"
  "eventId": "6f1c0a52-9d3e-4b7a-8c10-2e5d7a9b4f31",  // the ledger row this check was written as, or null
  "logged": true             // false when nothing was written; then see reason
}`}</pre>
    </div>
    <ul class="pr">
      {VAULT_FIELDS.map(([f, d]) => (<li><code>{f}</code> {d}</li>))}
    </ul>
    <p class="body">
      <b>The rule above does not change.</b> The vault field is the answer about your own registry; it does
      not loosen the public one. Use it to apply your own policy to the addresses you registered, and decide
      for yourself what each answer is worth: consistent-with-history proves sameness, never ownership. An
      address that is not in your registry never clears, whatever the public proof says. If any part of the
      field is null, the vault could not be read: treat it as not cleared. Hold and escalate to a person
      whatever is not cleared, exactly as before.
    </p>
    <p class="body">
      <b>What is recorded.</b> For each call on a linked key: the address as you asked, the time, the answer,
      the registry's word, which key asked, and the caller's network address kept only as a salted one-way
      hash. Calls with no key, and keys not linked to an agent, are never recorded. Rows are never edited or
      removed. You read the ledger on the agent's page, get a daily report you can download as a signed PDF,
      and export a signed file that anyone can check at <a href="/verify-record">/verify-record</a>.
    </p>
    <p class="body">
      <b>What the vault does not see.</b> It records the addresses you register. A transfer to an address
      you did not register is not seen: the protection is the check before the agent sends. Once a day, or
      when you press Read the chain on the agent's page, the vault reads Ethereum, Polygon and Avalanche for
      direct transfers between your agent's own wallets and your trusted addresses, and ties each one to
      the check that came before it. A payment routed through a swap or a router contract is a transfer to
      that contract and is not seen.
    </p>
  </section>

  <section id="kit">
    <h2>Copy and paste</h2>
    <p class="body">
      The rule above, written out for three common places. Each one proceeds only when every part of the
      rule holds, retries a 5xx or a 429 with the delay the answer asks for, and treats an answer it
      cannot read as a hold. A hold means your agent flags the payment and asks a person; none of these
      sends anything or decides for you. Keep your key in an environment variable on your server, out of
      any page that runs in a browser, and take the payee's domain from your own records.
    </p>
    <h3>curl and jq</h3>
    <pre>{`# Exit status 0: the rule holds. Anything else: hold for a person.
# PAYEE_DOMAIN comes from your own records, never from the invoice.
VALUE="0x..."
PAYEE_DOMAIN="acme.com"
[ -n "$PAYEE_DOMAIN" ] || { echo "hold: no expect"; exit 1; }
curl -sS --max-time 10 --retry 3 --retry-all-errors \\
  -H "Authorization: Bearer $ALMSTINS_KEY" \\
  --get --data-urlencode "value=$VALUE" --data-urlencode "expect=$PAYEE_DOMAIN" \\
  https://almstins.com/api/verify/check \\
| jq -e --arg want "$PAYEE_DOMAIN" \\
  '.status == "proven" and .level == "verified" and (.domain == $want or ((.domain // "") | endswith("." + $want)))' \\
  > /dev/null && echo "proceed" || { echo "hold for a person"; exit 1; }`}</pre>
    <h3>JavaScript</h3>
    <pre>{`// Node 18+ or any runtime with fetch. Resolves true only when the rule holds.
async function mayProceed(value, payeeDomain, key) {
  const want = String(payeeDomain ?? '').trim().toLowerCase();
  if (!want) return false;                                   // the API ignores an empty expect: hold
  const url = 'https://almstins.com/api/verify/check'
    + '?value=' + encodeURIComponent(value)
    + '&expect=' + encodeURIComponent(want);
  const headers = key ? { Authorization: 'Bearer ' + key } : {};
  for (let attempt = 0; attempt < 3; attempt++) {
    let res;
    try { res = await fetch(url, { headers }); }
    catch { await sleep(2 ** attempt * 1000); continue; }    // no answer: try again
    if (res.status >= 500 || res.status === 429) {
      await sleep(Number(res.headers.get('Retry-After')) * 1000 || 2 ** attempt * 1000);
      continue;
    }
    if (!res.ok) return false;                               // 400, 401 and the rest: hold
    let body;
    try { body = await res.json(); } catch { return false; } // unreadable: hold
    const got = String(body.domain ?? '').toLowerCase();
    return body.status === 'proven' && body.level === 'verified'
      && (got === want || got.endsWith('.' + want));         // and it is about your payee
  }
  return false;                                              // still no answer: hold
}
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));`}</pre>
    <h3>Python</h3>
    <pre>{`# Standard library only. Returns True only when the rule holds.
import json, time, urllib.error, urllib.parse, urllib.request

def may_proceed(value, payee_domain, key=None, tries=3):
    want = (payee_domain or "").strip().lower()
    if not want:
        return False                          # the API ignores an empty expect: hold
    url = ("https://almstins.com/api/verify/check?value=" + urllib.parse.quote(value, safe="")
           + "&expect=" + urllib.parse.quote(want, safe=""))
    headers = {"Authorization": "Bearer " + key} if key else {}
    for attempt in range(tries):
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=10) as res:
                body = json.load(res)
        except urllib.error.HTTPError as e:
            if e.code >= 500 or e.code == 429:
                time.sleep(int(e.headers.get("Retry-After") or 2 ** attempt))
                continue
            return False                      # 400, 401 and the rest: hold
        except (urllib.error.URLError, TimeoutError, ValueError):
            time.sleep(2 ** attempt)          # no answer, or one that cannot be read: try again
            continue
        got = (body.get("domain") or "").lower()
        return (body.get("status") == "proven" and body.get("level") == "verified"
                and (got == want or got.endswith("." + want)))   # and it is about your payee
    return False                              # still no answer: hold`}</pre>
