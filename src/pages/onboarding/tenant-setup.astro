---
import Layout from '@/layouts/LoginLayout.astro';
import { getAuthSession } from '@/lib/authSession';
import { ensureTenantForUser } from '@/lib/tenants';

const session = await getAuthSession(Astro.request);
if (!session?.user?.id) {
	return Astro.redirect('/login?error=missing', 303);
}

let setupError = '';
try {
	const tenantId = await ensureTenantForUser(String(session.user.id), 'Primary');
	if (tenantId) {
		return Astro.redirect('/dashboard/vault', 303);
	}
} catch (error) {
	setupError = error instanceof Error ? error.message : 'Unable to set up your tenant.';
}
---

<Layout title="Tenant Setup">
	<main class="tenant-setup">
		<section class="tenant-setup__card">
			<h1>Setting up your workspace</h1>
			<p>
				Your account is signed in, but we could not attach an active tenant yet.
				Use retry to run setup again.
			</p>
			{setupError ? <p class="tenant-setup__error">Error: {setupError}</p> : null}
			<div class="tenant-setup__actions">
				<a class="tenant-setup__button" href="/onboarding/tenant-setup">Retry setup</a>
				<a class="tenant-setup__button tenant-setup__button--ghost" href="/api/logout">Sign out</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.tenant-setup {
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 2rem;
		background: linear-gradient(135deg, #0b1320, #111827);
	}

	.tenant-setup__card {
		width: min(560px, 100%);
		background: rgba(10, 15, 26, 0.92);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 16px;
		padding: 2rem;
		color: #f7f2eb;
	}

	.tenant-setup__card h1 {
		margin: 0 0 0.75rem;
		font-size: 1.6rem;
	}

	.tenant-setup__card p {
		margin: 0 0 1rem;
		line-height: 1.5;
	}

	.tenant-setup__error {
		color: #ffb4b4;
		font-size: 0.95rem;
	}

	.tenant-setup__actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.tenant-setup__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		background: #f8b45d;
		color: #121212;
	}

	.tenant-setup__button--ghost {
		background: transparent;
		color: #f7f2eb;
		border: 1px solid rgba(255, 255, 255, 0.25);
	}
</style>
