---
import Layout from "@/layouts/LoginLayout.astro";
import { getAuthSession } from "../lib/authSession";
import { getPostLoginRedirect } from "../lib/postLoginRedirect";
import Logo from "../assets/logo.jpeg";
import PortfolioPreviewCard from "@/components/PortfolioPreviewCard";

const { searchParams } = Astro.url;
const error = searchParams.get("error");
const next = searchParams.get("next");
const callbackParam = searchParams.get("callbackUrl");
const nextPath =
  typeof next === "string"
    ? next
    : typeof callbackParam === "string"
      ? callbackParam
      : null;

const callbackUrl = getPostLoginRedirect(nextPath);
const safeCallbackUrl = callbackUrl.startsWith("/") ? callbackUrl : "/dashboard/vault";

const message =
  error === "missing"
    ? ""
    : error === "Configuration"
      ? "El inicio de sesión no está disponible temporalmente. Por favor intenta de nuevo."
      : error === "OAuthAccountNotLinked"
        ? "LOCKED_OUT"
        : error
          ? "Error al iniciar sesión. Por favor intenta de nuevo."
          : "";

const signup = searchParams.get("signup");
const verified = searchParams.get("verified");
const notice =
  signup === "success"
    ? "Cuenta creada. Revisa tu bandeja de entrada para verificar tu email."
    : verified === "success"
      ? "Email verificado. Ya puedes iniciar sesión."
      : verified === "expired"
        ? "El enlace de verificación expiró. Inicia sesión para solicitar uno nuevo."
        : verified === "failed"
          ? "La verificación falló. Por favor intenta de nuevo."
          : "";

const session = await getAuthSession(Astro.request);

let csrfToken = "";
try {
  const authBase = process.env.AUTH_URL
    ? (/^https?:\/\//i.test(process.env.AUTH_URL)
        ? process.env.AUTH_URL.replace(/\/$/, "")
        : `https://${process.env.AUTH_URL}`)
    : Astro.url.origin;
  const csrfResponse = await fetch(`${authBase}/api/auth/csrf`, {
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  if (csrfResponse.ok) {
    const data = await csrfResponse.json();
    csrfToken = data?.csrfToken ?? "";
  }
} catch (error) {
  console.warn("Failed to load CSRF token server-side", error);
}

const hasAlert = error === "missing" || (message && message !== "LOCKED_OUT") || !!notice;
---

<Layout>

  <a href="/" class="lang-toggle" aria-label="Switch to English">EN</a>

  <!-- ── Fixed sign-in pill — top-right ───────────────────────────────── -->
  <div class="signin-pill-wrap" id="signinPillWrap">
    <button
      class="signin-pill"
      id="signinPill"
      type="button"
      aria-expanded={hasAlert ? "true" : "false"}
      aria-haspopup="true"
      aria-controls="signinDropdown"
    >
      Iniciar sesión
      <svg class="pill-chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true" width="12" height="8">
        <path d="M1 1.5l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="signin-dropdown" id="signinDropdown" role="menu" hidden={!hasAlert || undefined}>
      <button class="dropdown-close" id="signinDropdownClose" aria-label="Cerrar panel">✕</button>

      {session?.user?.id ? (
        <a class="dropdown-cta" href={safeCallbackUrl}>Ir al panel →</a>
      ) : (
        <>
          <div class="dropdown-info">
            <p class="dropdown-info-primary">Sin registro — solo inicia sesión.</p>
            <p class="dropdown-info-sub">Creamos tu cuenta automáticamente la primera vez.</p>
          </div>
          {message && message !== "LOCKED_OUT" && (
            <p class="dropdown-notice">{message}</p>
          )}
          {notice && <p class="dropdown-notice dropdown-notice--success">{notice}</p>}

          <!-- Google -->
          <form id="login-google" class="provider-form" method="POST" action="/api/auth/signin/google">
            <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button class="provider-button google" type="submit" data-provider="google"
              data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
              <svg class="provider-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#fff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="rgba(255,255,255,0.8)" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="rgba(255,255,255,0.6)" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                <path fill="rgba(255,255,255,0.7)" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              <span class="provider-label">Continuar con Google</span>
              <span class="last-used-badge" data-badge="google" hidden>Último usado</span>
            </button>
          </form>

          <!-- GitHub -->
          <form id="login-github" class="provider-form" method="POST" action="/api/auth/signin/github">
            <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button class="provider-button github" type="submit" data-provider="github"
              data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
              <svg class="provider-icon" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span class="provider-label">Continuar con GitHub</span>
              <span class="last-used-badge" data-badge="github" hidden>Último usado</span>
            </button>
          </form>

          <div class="dropdown-divider"></div>

          <!-- Email -->
          <div class="email-toggle-wrap">
            <button class="email-toggle-btn" id="emailToggle" type="button" aria-expanded="false">
              Iniciar sesión con email <span class="toggle-chevron">›</span>
            </button>
            <div class="email-panel" id="emailPanel" hidden>
              <div class="email-tabs" role="tablist">
                <button class="email-tab active" id="tabPass" role="tab" aria-selected="true" type="button">Contraseña</button>
                <button class="email-tab" id="tabMagic" role="tab" aria-selected="false" type="button">Enlace mágico</button>
              </div>
              <form id="login-email-password" class="stack email-tab-panel" method="POST" action="/api/auth/callback/credentials">
                <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
                <input type="hidden" name="csrfToken" value={csrfToken} />
                <label>
                  <span>Correo electrónico</span>
                  <input type="email" name="email" placeholder="tu@ejemplo.com" required autocomplete="email" />
                </label>
                <label>
                  <span>Contraseña</span>
                  <input type="password" name="password" minlength="10" required autocomplete="current-password" />
                </label>
                <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
                  Iniciar sesión con email
                </button>
              </form>
              <form id="login-magic-link" class="stack email-tab-panel" method="POST" action="/api/auth/signin/email" hidden>
                <input type="hidden" name="callbackUrl" value={safeCallbackUrl} />
                <input type="hidden" name="csrfToken" value={csrfToken} />
                <label>
                  <span>Correo electrónico</span>
                  <input type="email" name="email" placeholder="tu@ejemplo.com" required autocomplete="email" />
                </label>
                <button type="submit" data-needs-csrf={!csrfToken || undefined} disabled={!csrfToken || undefined}>
                  Enviar enlace mágico
                </button>
              </form>
            </div>
          </div>

        </>
      )}
    </div>
  </div>

  <!-- ── Main layout ───────────────────────────────────────────────────── -->
  <main class="landing">
    <div class="landing__hero">

      <!-- Left column — copy + CTA -->
      <div class="landing__left">

        <!-- Logo -->
        <a href="/" class="wordmark" aria-label="Almstins inicio">
          <img src={Logo.src} width="44" height="44" alt="Almstins logo" class="wordmark-img" />
          <span class="wordmark-text">Almstins</span>
        </a>

        <!-- Headline + subhead -->
        <div class="hero__copy">
          <h1 class="hero__headline">Por fin entiende<br/>qué pasó en<br/>tu billetera.</h1>
          <p class="hero__subheadline">Transacciones perdidas, brechas inexplicables, sorpresas fiscales — rastrea cada movimiento en tu historial crypto para saber exactamente qué pasó y por qué.</p>
        </div>

        <!-- Wallet demo input -->
        <div class="landing__demo">
          <span class="landing__demo-label">DEMO — Ingresa cualquier billetera — ve su historial gratis</span>
          <form class="landing__demo-form" id="demoForm">
            <input
              class="landing__demo-input"
              type="text"
              placeholder="0x… o dirección"
              aria-label="Dirección de billetera"
              autocomplete="off"
              spellcheck="false"
            />
            <button class="landing__demo-submit" type="submit" aria-label="Ir">→</button>
          </form>
          <p class="landing__demo-hint" id="demoHint">Ve transacciones, brechas marcadas y lo que el fisco te preguntará. Sin registro.</p>
          <div class="landing__demo-samples">
            <span class="landing__demo-samples-label">O prueba una muestra:</span>
            <button class="landing__demo-sample" type="button" data-demo-addr="1">1 — Billetera ETH</button>
            <button class="landing__demo-sample" type="button" data-demo-addr="2">2 — Billetera SOL</button>
            <button class="landing__demo-sample" type="button" data-demo-addr="3">3 — Billetera DeFi</button>
          </div>
          <p class="landing__demo-signup">Iniciar sesión crea una cuenta gratis.</p>
        </div>

        <!-- Feature cards -->
        <div class="feature-stack">
          <div class="feature-card">
            <span class="fc-icon">🔐</span>
            <div>
              <div class="fc-title">Solo lectura, siempre</div>
              <div class="fc-desc">Solo direcciones públicas. Sin claves, sin riesgo — nunca.</div>
            </div>
          </div>
          <div class="feature-card">
            <span class="fc-icon">🔍</span>
            <div>
              <div class="fc-title">Conoce tu exposición fiscal</div>
              <div class="fc-desc">Cada ganancia, brecha marcada y base de costo faltante — antes de que llegue el fisco.</div>
            </div>
          </div>
          <div class="feature-card">
            <span class="fc-icon">🏫</span>
            <div>
              <div class="fc-title">Hecho por un educador</div>
              <div class="fc-desc">Privacidad desde el primer día. Nunca vendido. Nunca compartido.</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right column — portfolio preview card -->
      <div class="landing__right">
        <PortfolioPreviewCard client:visible />
      </div>

    </div>
  </main>

  <!-- ── Hesitation modal ────────── -->
  <div class="hesitation-overlay hidden" id="hesitationOverlay" role="dialog" aria-modal="true" aria-labelledby="hesitationTitle">
    <div class="hesitation-modal">
      <button class="hesitation-close" id="hesitationClose" aria-label="Cerrar">✕</button>
      <h3 id="hesitationTitle">¿Tienes una pregunta antes de registrarte?</h3>
      <p>Leemos todo — las mejores preguntas terminan en el FAQ.</p>
      <form id="contact-form" autocomplete="off" novalidate>
        <input id="contact-subject" type="text" name="subject" maxlength="120"
          placeholder="Asunto" class="contact-input" required />
        <div class="contact-body-wrap">
          <textarea id="contact-body" name="body" maxlength="500" rows="4"
            placeholder="Tu pregunta o comentario…" class="contact-input contact-textarea" required></textarea>
          <div class="contact-char"><span id="contact-char-count">0</span> / 500</div>
        </div>
        <button type="submit" class="contact-submit">Enviar anónimamente</button>
        <p id="contact-status" class="contact-status" hidden></p>
      </form>
    </div>
  </div>

  {message === "LOCKED_OUT" && (
    <div class="session-overlay" id="session-overlay">
      <div class="session-popup" role="alertdialog" aria-modal="true" aria-labelledby="session-title">
        <div class="session-popup__icon">🔐</div>
        <h2 id="session-title">Ya tienes una sesión activa</h2>
        <p>Parece que tienes una sesión activa en otro navegador o dispositivo. Cierra sesión primero y vuelve a intentarlo.</p>
        <div class="session-popup__actions">
          <a class="session-popup__btn session-popup__btn--primary" href="/api/auth/signout">Cerrar sesión e intentar de nuevo</a>
          <button class="session-popup__btn session-popup__btn--ghost" id="session-dismiss">Descartar</button>
        </div>
      </div>
    </div>
    <script is:inline>
      document.getElementById('session-dismiss')?.addEventListener('click', function() {
        document.getElementById('session-overlay')?.remove();
      });
    </script>
  )}

  <script>
    // ── CSRF refresh ──────────────────────────────────────────────────
    (async () => {
      try {
        const res = await fetch("/api/auth/csrf", { credentials: "same-origin" });
        if (!res.ok) return;
        const data = await res.json();
        if (!data?.csrfToken) return;
        document.querySelectorAll('input[name="csrfToken"]').forEach((el) => {
          (el as HTMLInputElement).value = data.csrfToken;
        });
        document.querySelectorAll("button[data-needs-csrf]").forEach((b) => {
          b.removeAttribute("disabled");
        });
      } catch (e) {
        console.warn("[login] csrf fetch failed", e);
      }
    })();

    // ── Last-used provider badge ──────────────────────────────────────
    (() => {
      const STORAGE_KEY = 'alms_last_provider';
      const lastProvider = localStorage.getItem(STORAGE_KEY);
      if (lastProvider) {
        const badge = document.querySelector(`[data-badge="${lastProvider}"]`);
        if (badge) {
          badge.removeAttribute('hidden');
          (badge.closest('button') as HTMLElement | null)?.classList.add('last-used');
        }
      }
      document.querySelectorAll('button[data-provider]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const provider = btn.getAttribute('data-provider');
          if (provider) localStorage.setItem(STORAGE_KEY, provider);
        });
      });
    })();

    // ── Sign-in pill toggle ───────────────────────────────────────────
    (() => {
      const pill     = document.getElementById('signinPill') as HTMLButtonElement | null;
      const dropdown = document.getElementById('signinDropdown') as HTMLElement | null;
      const wrap     = document.getElementById('signinPillWrap') as HTMLElement | null;

      if (!pill || !dropdown) return;

      function openDropdown() {
        dropdown!.hidden = false;
        pill!.setAttribute('aria-expanded', 'true');
        pill!.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
          document.addEventListener('click', outsideClick, { once: true });
        }, 0);
      }

      function closeDropdown() {
        dropdown!.hidden = true;
        pill!.setAttribute('aria-expanded', 'false');
        pill!.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      function outsideClick(e: MouseEvent) {
        if (wrap && !wrap.contains(e.target as Node)) {
          closeDropdown();
        } else if (!dropdown!.hidden) {
          setTimeout(() => {
            document.addEventListener('click', outsideClick, { once: true });
          }, 0);
        }
      }

      pill.addEventListener('click', () => {
        dropdown.hidden ? openDropdown() : closeDropdown();
      });

      document.getElementById('signinDropdownClose')?.addEventListener('click', closeDropdown);

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && !dropdown.hidden) closeDropdown();
      });

      if (pill.getAttribute('aria-expanded') === 'true') {
        openDropdown();
      }
    })();

    // ── Email toggle ──────────────────────────────────────────────────
    (() => {
      const toggleBtn  = document.getElementById('emailToggle') as HTMLButtonElement;
      const panel      = document.getElementById('emailPanel');
      const tabPass    = document.getElementById('tabPass') as HTMLButtonElement;
      const tabMagic   = document.getElementById('tabMagic') as HTMLButtonElement;
      const formPass   = document.getElementById('login-email-password');
      const formMagic  = document.getElementById('login-magic-link');
      const chevron    = toggleBtn?.querySelector('.toggle-chevron') as HTMLElement;

      toggleBtn?.addEventListener('click', () => {
        const open = !panel?.hidden;
        if (panel) panel.hidden = open;
        toggleBtn.setAttribute('aria-expanded', String(!open));
        if (chevron) chevron.textContent = open ? '›' : '‹';
        toggleBtn.classList.toggle('active', !open);
        if (!open) panel?.querySelector('input')?.focus();
      });

      function switchTab(showPass: boolean) {
        tabPass?.classList.toggle('active', showPass);
        tabMagic?.classList.toggle('active', !showPass);
        tabPass?.setAttribute('aria-selected', String(showPass));
        tabMagic?.setAttribute('aria-selected', String(!showPass));
        if (formPass) (formPass as HTMLElement).hidden = !showPass;
        if (formMagic) (formMagic as HTMLElement).hidden = showPass;
      }

      tabPass?.addEventListener('click', () => switchTab(true));
      tabMagic?.addEventListener('click', () => switchTab(false));
    })();

    // ── Hesitation modal ─────────────────────────────────────────────
    (() => {
      const overlay = document.getElementById('hesitationOverlay');
      const closeBtn = document.getElementById('hesitationClose');
      const form     = document.getElementById('contact-form') as HTMLFormElement | null;
      const body     = document.getElementById('contact-body') as HTMLTextAreaElement | null;
      const counter  = document.getElementById('contact-char-count');
      const status   = document.getElementById('contact-status');

      if (!overlay) return;

      let timer: ReturnType<typeof setTimeout>;
      const DELAY = 30_000;
      let shown = false;

      function showModal() {
        if (shown) return;
        shown = true;
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function resetTimer() {
        clearTimeout(timer);
        if (!shown) timer = setTimeout(showModal, DELAY);
      }

      function dismiss() {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }

      closeBtn?.addEventListener('click', dismiss);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) dismiss();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') dismiss();
      });

      ['click','keydown','scroll','mousemove','touchstart'].forEach(ev => {
        document.addEventListener(ev, resetTimer, { passive: true });
      });
      resetTimer();

      body?.addEventListener('input', () => {
        if (counter) counter.textContent = String(body.value.length);
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value.trim();
        const bodyVal = body?.value.trim();
        if (!subject || !bodyVal) return;
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Enviando…';
        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subject, body: bodyVal }),
          });
          const data = await res.json();
          if (data.ok) {
            form.reset();
            if (counter) counter.textContent = '0';
            if (status) {
              status.textContent = '✓ Enviado — ¡gracias!';
              (status as HTMLElement).style.color = '#4ade80';
              status.hidden = false;
            }
            setTimeout(dismiss, 2500);
          } else { throw new Error(data.error ?? 'Error al enviar'); }
        } catch (err: unknown) {
          if (status) {
            status.textContent = err instanceof Error ? err.message : 'Algo salió mal';
            (status as HTMLElement).style.color = '#f87171';
            status.hidden = false;
          }
        } finally {
          btn.disabled = false;
          btn.textContent = 'Enviar anónimamente';
        }
      });
    })();

    // ── Portfolio card tilt ──────────────────────────────────────────
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.matchMedia('(max-width: 64rem)').matches) return;
      const card = document.getElementById('portfolioPreviewCard');
      const right = card?.closest('.landing__right') as HTMLElement | null;
      if (!card || !right) return;
      right.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = right.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width  - 0.5) * 14;
        const y = ((e.clientY - rect.top)  / rect.height - 0.5) * -10;
        (card as HTMLElement).style.transform = `perspective(600px) rotateY(${x}deg) rotateX(${y}deg) translateY(var(--float-offset, 0px))`;
      });
      right.addEventListener('mouseleave', () => {
        (card as HTMLElement).style.transform = '';
      });
    })();

    // ── Wallet demo input ─────────────────────────────────────────────
    (() => {
      const EVM_RE        = /^0x[a-fA-F0-9]{40}$/;
      const BTC_BECH_RE   = /^bc1[a-zA-HJ-NP-Z0-9]{25,}$/;
      const BTC_LEGACY_RE = /^[13][a-zA-HJ-NP-Z0-9]{25,34}$/;
      const LTC_BECH_RE   = /^ltc1[a-zA-HJ-NP-Z0-9]{25,}$/;
      const LTC_LEGACY_RE = /^[LM][a-zA-HJ-NP-Z0-9]{25,34}$/;
      const SOL_RE        = /^[1-9A-HJ-NP-Za-km-z]{32,44}$/;

      const DEMO_WALLET_ADDRS = new Set(['1', '2', '3']);
      function isKnownAddress(addr: string): boolean {
        if (DEMO_WALLET_ADDRS.has(addr)) return true;
        return EVM_RE.test(addr) || BTC_BECH_RE.test(addr) || BTC_LEGACY_RE.test(addr)
          || LTC_BECH_RE.test(addr) || LTC_LEGACY_RE.test(addr) || SOL_RE.test(addr);
      }

      const form  = document.getElementById('demoForm') as HTMLFormElement | null;
      const hint  = document.getElementById('demoHint') as HTMLElement | null;
      if (!form) return;

      const input = form.querySelector('.landing__demo-input') as HTMLInputElement | null;

      document.querySelectorAll<HTMLButtonElement>('[data-demo-addr]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const addr = btn.dataset.demoAddr ?? '';
          if (input) {
            input.value = addr;
            input.focus();
            if (hint) {
              hint.textContent = 'Sin registro. Ve un portafolio real en 5 segundos. Inicia sesión después para guardarlo.';
              hint.style.color = '';
            }
          }
        });
      });

      input?.addEventListener('input', () => {
        if (hint) {
          hint.textContent = 'Sin registro. Ve un portafolio real en 5 segundos. Inicia sesión después para guardarlo.';
          hint.style.color = '';
        }
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const btn     = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const address = input?.value.trim() ?? '';

        if (address && !isKnownAddress(address)) {
          if (hint) {
            hint.textContent = '⚠ Dirección no reconocida — prueba una dirección Ethereum (0x…), Bitcoin o Solana.';
            hint.style.color = 'var(--loss)';
          }
          return;
        }

        if (btn) btn.disabled = true;
        const dest = address
          ? `/api/demo/start?address=${encodeURIComponent(address)}`
          : '/api/demo/start';
        window.location.href = dest;
      });
    })();
  </script>

