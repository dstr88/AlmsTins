---
// Shared chrome for PetroTins legal pages (Terms, Privacy).
// Standalone + amber-themed to match the PetroTins brand; PetroTins is a
// separate product from Almstins and is intentionally English-only.
export interface Props {
	title: string;
	description?: string;
	effectiveDate?: string;
}
const { title, description = '', effectiveDate = 'June 15, 2026' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title} · PetroTins</title>
	{description && <meta name="description" content={description} />}
	<link rel="icon" type="image/webp" href="/favicon.webp" />
	<link rel="icon" href="/favicon.ico" sizes="any" />
	<style>
		:root { color-scheme: light; }
		* { margin: 0; padding: 0; box-sizing: border-box; }
		body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 15px; line-height: 1.65; color: #1f2937; background: #f9fafb; }
		.wrap { max-width: 820px; margin: 0 auto; padding: 0 20px; }
		header.pt-legal { background: linear-gradient(135deg, #1c1407 0%, #0f0a03 100%); color: #fff; padding: 48px 0 34px; border-bottom: 3px solid #f59e0b; margin-bottom: 32px; }
		.eyebrow { color: #fbbf24; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78em; }
		header.pt-legal h1 { font-size: 2em; margin: 6px 0 8px; }
		header.pt-legal .date { opacity: 0.8; font-size: 0.9em; }
		a.back { color: #fbbf24; text-decoration: none; font-size: 0.9em; display: inline-block; margin-top: 14px; }
		a.back:hover { text-decoration: underline; }
		main.wrap { padding-bottom: 60px; }
		h2 { font-size: 1.2em; color: #92400e; margin: 28px 0 10px; }
		h3 { font-size: 1.02em; color: #374151; margin: 18px 0 6px; }
		p { margin-bottom: 14px; }
		ul { margin: 12px 0 14px 26px; }
		li { margin-bottom: 7px; }
		.notice { background: #fffbeb; border: 1px solid #fcd34d; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 14px 18px; margin: 18px 0; }
		.xmark { color: #ef4444; font-weight: bold; }
		.checkmark { color: #10b981; font-weight: bold; }
		footer.pt-legal { border-top: 1px solid #e5e7eb; margin-top: 44px; padding-top: 20px; color: #6b7280; font-size: 0.9em; text-align: center; }
		footer.pt-legal a { color: #b45309; text-decoration: none; }
		footer.pt-legal a:hover { text-decoration: underline; }
	</style>
</head>
<body>
	<header class="pt-legal">
		<div class="wrap">
			<div class="eyebrow">PetroTins</div>
			<h1>{title}</h1>
			<div class="date">Effective date: {effectiveDate}</div>
			<a class="back" href="/petro-tins">← Back to PetroTins</a>
		</div>
	</header>
	<main class="wrap">
		<slot />
		<footer class="pt-legal">
			PetroTins · a TitaniumHut product · <a href="/petro-tins/terms">Terms</a> · <a href="/petro-tins/privacy">Privacy</a> · <a href="https://tradfitins.com" target="_blank" rel="noopener">tradfitins.com</a>
		</footer>
	</main>
</body>
</html>
