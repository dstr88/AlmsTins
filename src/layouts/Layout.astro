---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Control Center</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="chrome">
			<header class="chrome__header">
				<div>
					<p class="brand">Titanium Hut</p>
					<strong>Private investor dashboard</strong>
				</div>
				<nav>
					<a href="/dashboard/bookkeeping" class={`nav-link ${isActive('/dashboard/bookkeeping') ? 'active' : ''}`}>Bookkeeping</a>
					<a href="/dashboard/vault" class={`nav-link ${isActive('/dashboard/vault') ? 'active' : ''}`}>Vault</a>
					<a class="nav-link disabled">Events</a>
					<form class="nav-form" method="post" action="/api/logout">
						<button class="nav-button" type="submit">Log out</button>
					</form>
				</nav>
			</header>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: radial-gradient(circle at top, #0c1224, #05070f 60%);
		color: #f5f8ff;
		min-height: 100vh;
		font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	.chrome {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.chrome__header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		backdrop-filter: blur(12px);
		position: sticky;
		top: 0;
		background: rgba(4, 6, 12, 0.75);
		z-index: 10;
	}

	.brand {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.55);
	}

	.chrome__header strong {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.8);
	}

	nav {
		display: flex;
		gap: 1rem;
		align-items: center;
		font-size: 0.9rem;
	}

	.nav-form {
		margin: 0;
	}

	nav a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav-button {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.85);
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		font: inherit;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.nav-button:hover {
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.3);
		color: #fff;
	}

	nav a:hover {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}

	nav a.disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	nav a.active {
		background: rgba(255, 255, 255, 0.18);
		color: #fff;
		font-weight: 600;
	}

	main {
		flex: 1;
		display: flex;
	}

	:global(.hero-bleed) {
		width: 100vw;
		margin-left: 50%;
		transform: translateX(-50%);
		padding: 0;
		max-width: none;
	}

	:global(html, body) {
		overflow-x: hidden;
	}

	@media (max-width: 720px) {
		.chrome__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		nav {
			flex-wrap: wrap;
		}
	}
</style>
