---
import Footer from "@/components/Footer.astro";
import { getAuthSession } from '@/lib/authSession';

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

const session = await getAuthSession(Astro.request).catch(() => null);
const user = session?.user ?? null;
const tenantId = session?.tenantId ?? null;

// Avatar: use OAuth profile image if available, otherwise derive initials
const initials = user?.name
  ? user.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase()
  : user?.email?.[0]?.toUpperCase() ?? '?';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Control Center</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="chrome">
			<header class="chrome__header">
				<div>
					<p class="brand">Titanium Hut</p>
					<a class="dashboard-link" href="/dashboard/vault">Private investor dashboard</a>
				</div>
				<nav>
					<a href="/dashboard/bookkeeping" class={`nav-link ${isActive('/dashboard/bookkeeping') ? 'active' : ''}`}>Bookkeeping</a>
					<a href="/dashboard/vault" class={`nav-link ${isActive('/dashboard/vault') ? 'active' : ''}`}>Vault</a>
					<a class="nav-link disabled">Events</a>

					<!-- Account dropdown -->
					<details class="account-menu">
						<summary class="account-trigger">
							{user?.image ? (
								<img class="account-avatar" src={user.image} alt={user.name ?? 'Account'} referrerpolicy="no-referrer" />
							) : (
								<span class="account-initials">{initials}</span>
							)}
							<span class="account-label">Account</span>
							<span class="account-caret" aria-hidden="true">▾</span>
						</summary>

						<div class="account-dropdown">
							<!-- Identity -->
							<div class="account-identity">
								{user?.image ? (
									<img class="account-avatar account-avatar--lg" src={user.image} alt={user.name ?? ''} referrerpolicy="no-referrer" />
								) : (
									<span class="account-initials account-initials--lg">{initials}</span>
								)}
								<div class="account-info">
									{user?.name && <p class="account-name">{user.name}</p>}
									{user?.email && <p class="account-email">{user.email}</p>}
								</div>
							</div>

							<hr class="account-divider" />

							<!-- Tenant ID (subtle, useful for admin) -->
							{tenantId && (
								<p class="account-meta">Tenant: <code>{tenantId.slice(0, 8)}&hellip;</code></p>
							)}

							<hr class="account-divider" />

							<!-- Logout -->
							<form method="post" action="/api/logout">
								<button class="account-logout" type="submit">Log out</button>
							</form>
						</div>
					</details>
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: radial-gradient(circle at top, #0c1224, #05070f 60%);
		color: #f5f8ff;
		min-height: 100vh;
		font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	.chrome {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.chrome__header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		backdrop-filter: blur(12px);
		position: sticky;
		top: 0;
		background: rgba(4, 6, 12, 0.75);
		z-index: 10;
	}

	.brand {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.55);
	}

	.dashboard-link {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		position: relative;
		z-index: 1;
	}

	.dashboard-link:hover,
	.dashboard-link:focus-visible {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	nav {
		display: flex;
		gap: 1rem;
		align-items: center;
		font-size: 0.9rem;
	}

	.nav-form {
		margin: 0;
	}

	nav a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav-button {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.85);
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		font: inherit;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.nav-button:hover {
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.3);
		color: #fff;
	}

	nav a:hover {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}

	nav a.disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	nav a.active {
		background: rgba(255, 255, 255, 0.18);
		color: #fff;
		font-weight: 600;
	}

	main {
		flex: 1;
		display: flex;
	}

	:global(.hero-bleed) {
		width: 100vw;
		margin-left: 50%;
		transform: translateX(-50%);
		padding: 0;
		max-width: none;
	}

	:global(html, body) {
		overflow-x: hidden;
	}

	/* === Account dropdown === */
	.account-menu {
		position: relative;
	}

	/* Hide native triangle marker */
	.account-menu > summary {
		list-style: none;
	}
	.account-menu > summary::-webkit-details-marker {
		display: none;
	}

	.account-trigger {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.85);
		padding: 0.35rem 0.75rem 0.35rem 0.45rem;
		border-radius: 999px;
		cursor: pointer;
		font: inherit;
		font-size: 0.9rem;
		transition: background 0.2s, border-color 0.2s, color 0.2s;
		user-select: none;
	}

	.account-trigger:hover,
	.account-menu[open] .account-trigger {
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.3);
		color: #fff;
	}

	.account-avatar {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.account-initials {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.18);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		flex-shrink: 0;
		line-height: 1;
	}

	.account-label {
		font-weight: 500;
	}

	.account-caret {
		font-size: 0.7rem;
		opacity: 0.6;
		transition: transform 0.2s;
	}

	.account-menu[open] .account-caret {
		transform: rotate(180deg);
	}

	/* Dropdown panel */
	.account-dropdown {
		position: absolute;
		top: calc(100% + 0.6rem);
		right: 0;
		min-width: 260px;
		background: rgba(14, 20, 38, 0.97);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 14px;
		padding: 1rem;
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(16px);
		z-index: 100;
		animation: dropdown-in 0.15s ease;
	}

	@keyframes dropdown-in {
		from { opacity: 0; transform: translateY(-6px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	/* Identity row */
	.account-identity {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.account-avatar--lg {
		width: 44px;
		height: 44px;
		flex-shrink: 0;
	}

	.account-initials--lg {
		width: 44px;
		height: 44px;
		font-size: 1rem;
	}

	.account-info {
		min-width: 0;
	}

	.account-name {
		margin: 0 0 0.2rem;
		font-weight: 600;
		font-size: 0.95rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.account-email {
		margin: 0;
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.55);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.account-divider {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		margin: 0.75rem 0;
	}

	.account-meta {
		margin: 0 0 0.25rem;
		font-size: 0.72rem;
		color: rgba(255, 255, 255, 0.35);
	}

	.account-meta code {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.45);
	}

	.account-logout {
		width: 100%;
		padding: 0.55rem 0.9rem;
		background: rgba(239, 68, 68, 0.12);
		border: 1px solid rgba(239, 68, 68, 0.25);
		color: #fca5a5;
		border-radius: 8px;
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		text-align: center;
		transition: background 0.2s, border-color 0.2s, color 0.2s;
	}

	.account-logout:hover {
		background: rgba(239, 68, 68, 0.22);
		border-color: rgba(239, 68, 68, 0.45);
		color: #fecaca;
	}

	@media (max-width: 720px) {
		.chrome__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		nav {
			flex-wrap: wrap;
		}

		.account-dropdown {
			right: auto;
			left: 0;
		}
	}
</style>
