---
import Footer from "@/components/Footer.astro";
import DemoBanner from "@/components/DemoBanner.astro";
import { getAuthSession } from '@/lib/authSession';
import { db } from '@/lib/db';
import { isDemoRequest } from '@/lib/demo';
import kingSolomon from '@/assets/KingSolomon.png';

const isDemo = isDemoRequest(Astro.request);
import minerva from '@/assets/Minerva.png';
const GA_ID = import.meta.env.PUBLIC_GA_ID;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;

const session = await getAuthSession(Astro.request).catch(() => null);
const user = session?.user ?? null;
const tenantId = session?.tenantId ?? null;

// Avatar: use OAuth profile image if available, otherwise pick a random default
const defaultAvatars = [kingSolomon, minerva];
const defaultAvatar = defaultAvatars[Math.floor(Math.random() * defaultAvatars.length)];

// Pull last_login, email, and member-since from DB for the account dropdown
let lastLoginIso: string | null = null;
let memberSinceIso: string | null = null;
let dbEmail: string | null = null;
let alertEmail: string | null = null;
if (user?.id) {
  try {
    const [userRow, memberRow] = await Promise.all([
      db.execute({ sql: 'SELECT last_login, email, alert_email FROM auth_users WHERE id = ? LIMIT 1', args: [user.id] }),
      db.execute({ sql: 'SELECT created_at FROM tenant_memberships WHERE user_id = ? ORDER BY created_at ASC LIMIT 1', args: [user.id] }),
    ]);
    lastLoginIso = userRow.rows[0] ? String((userRow.rows[0] as any).last_login ?? '') || null : null;
    dbEmail = userRow.rows[0] ? String((userRow.rows[0] as any).email ?? '') || null : null;
    alertEmail = userRow.rows[0] ? String((userRow.rows[0] as any).alert_email ?? '') || null : null;
    memberSinceIso = memberRow.rows[0] ? String((memberRow.rows[0] as any).created_at ?? '') || null : null;
  } catch { /* non-fatal */ }
}

// Prefer session email, fall back to DB email
const displayEmail = user?.email || dbEmail;

// Admin check — tenant ID is checked first (always in JWT, no email dependency).
// Fall back to email match as a secondary check.
const _adminTenantIdsRaw =
  (process.env as any).ADMIN_TENANT_IDS ??
  (process.env as any).ADMIN_TENANT_ID ??
  '';
const ADMIN_TENANT_IDS = new Set(
  _adminTenantIdsRaw.split(',').map((id: string) => id.trim().toLowerCase()).filter(Boolean)
);
const _adminEmailsRaw =
  (process.env as any).ADMIN_EMAILS ??
  (process.env as any).ADMIN_EMAIL ??
  import.meta.env.ADMIN_EMAILS ??
  import.meta.env.ADMIN_EMAIL ??
  '';
const ADMIN_EMAILS = new Set(
  _adminEmailsRaw.split(',').map((e: string) => e.trim().toLowerCase()).filter(Boolean)
);
const isAdmin =
  (tenantId ? ADMIN_TENANT_IDS.has(String(tenantId).toLowerCase()) : false) ||
  Boolean(displayEmail && ADMIN_EMAILS.has(displayEmail.toLowerCase()));

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Almstins — Crypto Portfolio Tracker & Bookkeeping Tool',
  description = 'Track your crypto wallets, DeFi positions, and exchange accounts in one place. Calculate realized gains, download your Year Summary, and stay on top of your net worth.',
  canonical = Astro.url.href,
  image = 'https://almstins.com/og-default.png',
  noindex = false,
} = Astro.props;

const fmtDate = (iso: string | null) => {
  if (!iso) return null;
  try {
    return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(iso));
  } catch { return null; }
};

const lastLoginDisplay = fmtDate(lastLoginIso);
const memberSinceDisplay = memberSinceIso
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(memberSinceIso))
  : null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Almstins" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Favicon -->
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<link rel="icon" href="/favicon.ico" sizes="any" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

		<!-- Google Analytics -->
	<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', GA_ID);
</script>
	</head>
	<body>
		{isDemo && <DemoBanner />}
		<div class="chrome">
			<header class="chrome__header">
				<div>
					<p class="brand">Titanium Hut</p>
					{isAdmin
					? <a class="dashboard-link" href="/admin">Admin Dashboard</a>
					: <a class="dashboard-link" href={currentPath}>{
						currentPath.includes('/bookkeeping') ? 'Bookkeeping' :
						currentPath.includes('/wallets')     ? 'Wallets' :
						currentPath.includes('/research')    ? 'Research' :
						currentPath.includes('/billing')     ? 'Billing' :
						currentPath.includes('/wallet-checker') ? 'Scam Checker' :
						currentPath.includes('/admin')       ? 'Admin' :
						'Vault'
					}</a>
				}
				</div>
				<nav>
					<a href="/dashboard/bookkeeping" class={`nav-link ${isActive('/dashboard/bookkeeping') ? 'active' : ''}`}>Bookkeeping</a>
					<a href="/dashboard/vault" class={`nav-link ${isActive('/dashboard/vault') ? 'active' : ''}`}>Vault</a>
					<a href="/dashboard/wallets" class={`nav-link ${isActive('/dashboard/wallets') ? 'active' : ''}`}>Wallets</a>
					<a href="/wallet-checker" class={`nav-link ${isActive('/wallet-checker') ? 'active' : ''}`}>Scam Checker</a>
					<a href="/dashboard/research" class={`nav-link ${isActive('/dashboard/research') ? 'active' : ''}`}>Research</a>
				{isAdmin && (
					<a href="/admin" class={`nav-link nav-link--admin ${isActive('/admin') ? 'active' : ''}`}>Admin</a>
				)}

					<!-- Account dropdown -->
					<details class="account-menu">
						<summary class="account-trigger">
							{user?.image ? (
								<img class="account-avatar" src={user.image} alt={user.name ?? 'Account'} referrerpolicy="no-referrer" />
							) : (
								<img class="account-avatar account-avatar--default" src={defaultAvatar.src} alt="Account" />
							)}
							<span class="account-label">Account</span>
							<span class="account-caret" aria-hidden="true">▾</span>
						</summary>

						<div class="account-dropdown">
							<!-- Identity -->
							<div class="account-identity">
								{user?.image ? (
									<img class="account-avatar account-avatar--lg" src={user.image} alt={user.name ?? ''} referrerpolicy="no-referrer" />
								) : (
									<img class="account-avatar account-avatar--lg account-avatar--default" src={defaultAvatar.src} alt="Account" />
								)}
								<div class="account-info">
									{user?.name && <p class="account-name">{user.name}</p>}
									<p class="account-email">{displayEmail ?? '—'}</p>
								</div>
							</div>

							<hr class="account-divider" />

							<!-- Meta: email, tenant ID, last login, member since -->
							<div class="account-meta-block">
								<div class="account-meta-row">
									<span class="account-meta-label">Account email</span>
									<span class="account-meta-value account-meta-email">{displayEmail ?? '—'}</span>
								</div>
								<div class="account-meta-row">
									<span class="account-meta-label">Alert email</span>
									<span id="alert-email-display" class="account-meta-value">
										{alertEmail
											? <span id="alert-email-text">{alertEmail}</span>
											: <em id="alert-email-text" class="account-meta-unset">not set</em>
										}
										<button type="button" id="alert-email-edit-btn" class="account-inline-edit" title="Edit alert email" aria-label="Edit alert email">✏</button>
									</span>
									<form id="alert-email-form" class="alert-email-form" hidden>
										<input
											type="email"
											id="alert-email-input"
											name="alertEmail"
											placeholder={displayEmail ?? 'you@example.com'}
											value={alertEmail ?? ''}
											autocomplete="email"
										/>
										<div class="alert-email-actions">
											<button type="submit" class="alert-email-save">Save</button>
											<button type="button" id="alert-email-cancel" class="alert-email-cancel">Cancel</button>
										</div>
									</form>
								</div>
								{tenantId && (
									<div class="account-meta-row">
										<span class="account-meta-label">Tenant ID</span>
										<span class="account-meta-value">
											<code>{tenantId.slice(0, 8)}&hellip;</code>
											<button
												class="copy-btn"
												type="button"
												data-copy={tenantId}
												aria-label="Copy tenant ID"
												title="Copy full tenant ID"
											>
												<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
											</button>
										</span>
									</div>
								)}
								{lastLoginDisplay && (
									<div class="account-meta-row">
										<span class="account-meta-label">Last login</span>
										<span class="account-meta-value">{lastLoginDisplay}</span>
									</div>
								)}
								{memberSinceDisplay && (
									<div class="account-meta-row">
										<span class="account-meta-label">Member since</span>
										<span class="account-meta-value">{memberSinceDisplay}</span>
									</div>
								)}
							</div>

							<hr class="account-divider" />

							<a href="/dashboard/billing" class="account-billing-link">Billing &amp; Plan</a>

							<hr class="account-divider" />

							<!-- Logout -->
							<form id="logout" method="post" action="/api/logout">
								<button class="account-logout" type="submit">Log out</button>
							</form>
						</div>
					</details>
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: radial-gradient(circle at top, #0c1224, #05070f 60%);
		color: #f5f8ff;
		min-height: 100vh;
		font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.chrome {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.chrome__header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		backdrop-filter: blur(12px);
		position: sticky;
		top: 0;
		background: rgba(4, 6, 12, 0.75);
		z-index: 10;
	}

	.brand {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.55);
	}

	.dashboard-link {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		position: relative;
		z-index: 1;
	}

	.dashboard-link:hover,
	.dashboard-link:focus-visible {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	nav {
		display: flex;
		gap: 1rem;
		align-items: center;
		font-size: 0.9rem;
	}

	.nav-form {
		margin: 0;
	}

	nav a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav-button {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.85);
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		font: inherit;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.nav-button:hover {
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.3);
		color: #fff;
	}

	nav a:hover {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}

	nav a.disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.nav-link--admin {
		color: #a78bfa !important;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}
	.nav-link--admin:hover {
		background: rgba(139, 92, 246, 0.15) !important;
		color: #c4b5fd !important;
	}

	nav a.active {
		background: rgba(255, 255, 255, 0.18);
		color: #fff;
		font-weight: 600;
	}

	main {
		flex: 1;
		display: flex;
	}

	:global(.hero-bleed) {
		width: 100vw;
		margin-left: 50%;
		transform: translateX(-50%);
		padding: 0;
		max-width: none;
	}

	:global(html, body) {
		overflow-x: hidden;
	}

	/* === Account dropdown === */
	.account-menu {
		position: relative;
	}

	/* Hide native triangle marker */
	.account-menu > summary {
		list-style: none;
	}
	.account-menu > summary::-webkit-details-marker {
		display: none;
	}

	.account-trigger {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: rgba(255, 255, 255, 0.85);
		padding: 0.35rem 0.75rem 0.35rem 0.45rem;
		border-radius: 999px;
		cursor: pointer;
		font: inherit;
		font-size: 0.9rem;
		transition: background 0.2s, border-color 0.2s, color 0.2s;
		user-select: none;
	}

	.account-trigger:hover,
	.account-menu[open] .account-trigger {
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.3);
		color: #fff;
	}

	.account-avatar {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}

	.account-avatar--default {
		object-position: top center;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	.account-initials {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.18);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		flex-shrink: 0;
		line-height: 1;
	}

	.account-label {
		font-weight: 500;
	}

	.account-caret {
		font-size: 0.7rem;
		opacity: 0.6;
		transition: transform 0.2s;
	}

	.account-menu[open] .account-caret {
		transform: rotate(180deg);
	}

	/* Dropdown panel */
	.account-dropdown {
		position: absolute;
		top: calc(100% + 0.6rem);
		right: 0;
		min-width: 260px;
		background: rgba(14, 20, 38, 0.97);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 14px;
		padding: 1rem;
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(16px);
		z-index: 100;
		animation: dropdown-in 0.15s ease;
	}

	@keyframes dropdown-in {
		from { opacity: 0; transform: translateY(-6px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	/* Identity row */
	.account-identity {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.account-avatar--lg {
		width: 44px;
		height: 44px;
		flex-shrink: 0;
	}

	.account-initials--lg {
		width: 44px;
		height: 44px;
		font-size: 1rem;
	}

	.account-info {
		min-width: 0;
	}

	.account-name {
		margin: 0 0 0.2rem;
		font-weight: 600;
		font-size: 0.95rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.account-email {
		margin: 0;
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.75);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.account-divider {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		margin: 0.75rem 0;
	}

	.account-meta-block {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.account-meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.72rem;
	}

	.account-meta-label {
		color: rgba(255, 255, 255, 0.35);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.account-meta-value {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		color: rgba(255, 255, 255, 0.75);
		text-align: right;
	}

	.account-meta-value code {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.5);
	}

	.account-meta-email {
		max-width: 170px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		display: block;
	}

	.copy-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		padding: 2px;
		cursor: pointer;
		color: rgba(255, 255, 255, 0.35);
		border-radius: 4px;
		transition: color 0.15s, background 0.15s;
		line-height: 1;
	}

	.copy-btn:hover {
		color: rgba(255, 255, 255, 0.75);
		background: rgba(255, 255, 255, 0.08);
	}

	.copy-btn.copied {
		color: #4ade80;
	}

	.account-billing-link {
		display: block;
		padding: 0.55rem 0.9rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: #94a3b8;
		text-decoration: none;
		border-radius: 8px;
		transition: background 0.15s, color 0.15s;
	}
	.account-billing-link:hover {
		background: rgba(99, 102, 241, 0.15);
		color: #a5b4fc;
	}

	.account-logout {
		width: 100%;
		padding: 0.55rem 0.9rem;
		background: rgba(239, 68, 68, 0.12);
		border: 1px solid rgba(239, 68, 68, 0.25);
		color: #fca5a5;
		border-radius: 8px;
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		text-align: center;
		transition: background 0.2s, border-color 0.2s, color 0.2s;
	}

	.account-logout:hover {
		background: rgba(239, 68, 68, 0.22);
		border-color: rgba(239, 68, 68, 0.45);
		color: #fecaca;
	}

	/* ── Alert email inline editor ───────────────────────────────────────── */
	.account-meta-unset {
		color: rgba(255, 255, 255, 0.35);
		font-style: italic;
		font-size: 0.82rem;
	}

	.account-inline-edit {
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.4);
		cursor: pointer;
		font-size: 0.75rem;
		padding: 0 0.2rem;
		margin-left: 0.25rem;
		line-height: 1;
		transition: color 0.15s;
		vertical-align: middle;
	}
	.account-inline-edit:hover { color: #a5b4fc; }

	.alert-email-form {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0.4rem;
		width: 100%;
	}

	.alert-email-form input[type="email"] {
		width: 100%;
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 8px;
		color: #fff;
		font-size: 0.82rem;
		padding: 0.45rem 0.7rem;
		outline: none;
		transition: border-color 0.15s;
	}
	.alert-email-form input[type="email"]:focus {
		border-color: rgba(99, 102, 241, 0.6);
	}

	.alert-email-actions {
		display: flex;
		gap: 0.4rem;
	}

	.alert-email-save {
		flex: 1;
		padding: 0.35rem 0.6rem;
		border-radius: 6px;
		border: none;
		background: rgba(99, 102, 241, 0.25);
		color: #a5b4fc;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.15s;
	}
	.alert-email-save:hover { background: rgba(99, 102, 241, 0.4); }

	.alert-email-cancel {
		padding: 0.35rem 0.6rem;
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: transparent;
		color: rgba(255, 255, 255, 0.45);
		font-size: 0.8rem;
		cursor: pointer;
		transition: background 0.15s;
	}
	.alert-email-cancel:hover { background: rgba(255, 255, 255, 0.06); }

	@media (max-width: 720px) {
		.chrome__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		nav {
			flex-wrap: wrap;
		}

		.account-dropdown {
			right: auto;
			left: 0;
		}
	}
</style>

<script>
	// Copy-to-clipboard for tenant ID button
	// Attach directly to each button so the click is treated as a user gesture
	// (document-level delegation can lose transient activation in strict Chrome contexts).
	function initCopyBtn(btn: HTMLButtonElement) {
		btn.addEventListener('click', (e) => {
			e.stopPropagation(); // prevent details from toggling
			const text = btn.dataset.copy ?? '';
			if (!text) return;

			const checkmark = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;

			const showFeedback = () => {
				const prev = btn.innerHTML;
				const origTitle = btn.title;
				btn.classList.add('copied');
				btn.title = 'Copied!';
				btn.innerHTML = checkmark;
				setTimeout(() => {
					btn.classList.remove('copied');
					btn.title = origTitle;
					btn.innerHTML = prev;
				}, 2000);
			};

			if (navigator.clipboard?.writeText) {
				navigator.clipboard.writeText(text).then(showFeedback).catch(() => {
					// fallback
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
					document.body.appendChild(ta);
					ta.select();
					document.execCommand('copy');
					document.body.removeChild(ta);
					showFeedback();
				});
			} else {
				const ta = document.createElement('textarea');
				ta.value = text;
				ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
				document.body.appendChild(ta);
				ta.select();
				document.execCommand('copy');
				document.body.removeChild(ta);
				showFeedback();
			}
		});
	}

	document.querySelectorAll<HTMLButtonElement>('.copy-btn[data-copy]').forEach(initCopyBtn);

	// ── Alert email inline editor ────────────────────────────────────────────
	(() => {
		const editBtn   = document.getElementById('alert-email-edit-btn') as HTMLButtonElement | null;
		const cancelBtn = document.getElementById('alert-email-cancel')   as HTMLButtonElement | null;
		const form      = document.getElementById('alert-email-form')     as HTMLFormElement   | null;
		const display   = document.getElementById('alert-email-display')  as HTMLElement       | null;
		const input     = document.getElementById('alert-email-input')    as HTMLInputElement  | null;

		if (!editBtn || !form || !display || !input) return;

		editBtn.addEventListener('click', () => {
			display.hidden = true;
			form.hidden = false;
			input.focus();
		});

		cancelBtn?.addEventListener('click', () => {
			form.hidden = true;
			display.hidden = false;
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const saveBtn = form.querySelector<HTMLButtonElement>('.alert-email-save');
			if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving\u2026'; }

			try {
				const res = await fetch('/api/account/alert-email', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ alertEmail: input.value.trim() }),
				});
				const data = await res.json();
				if (!data.ok) throw new Error(data.error ?? 'Save failed');

				// Update display text without a page reload
				const textEl = document.getElementById('alert-email-text');
				if (textEl) {
					const newVal = data.alertEmail ?? '';
					if (textEl.tagName === 'EM') {
						const span = document.createElement('span');
						span.id = 'alert-email-text';
						span.textContent = newVal || 'not set';
						textEl.replaceWith(span);
					} else {
						textEl.textContent = newVal || 'not set';
					}
				}
				form.hidden = true;
				display.hidden = false;
			} catch (err: any) {
				alert(err?.message ?? 'Could not save alert email. Please try again.');
			} finally {
				if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save'; }
			}
		});
	})();
</script>
